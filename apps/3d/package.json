{
  "name": "shenzhen-3d",
  "version": "0.1.9",
  "description": "CAD, mesh and drawing viewer",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:cad": "node scripts/test-cad.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:gpu": "node scripts/perf/browser-benchmark.mjs",
    "tauri": "tauri",
    "build:mac": "tauri build --bundles app,dmg",
    "build:android": "tauri android build --apk",
    "build:ios": "tauri ios build",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "postinstall": "node scripts/prepare-assets.mjs",
    "electron:dev": "electron electron/main.cjs",
    "package:electron:mac": "node electron/package-mac.mjs",
    "build:electron:mac": "npm run package:electron:mac",
    "test:electron": "node --test electron/*.test.cjs && node electron/smoke.mjs",
    "test:viewer": "node scripts/perf/check-viewer-correctness.mjs --software",
    "benchmark:startup": "node tests/startup-browser.mjs",
    "benchmark:startup:electron": "node electron/startup.mjs",
    "build:dmg:artwork": "node scripts/build-dmg-artwork.mjs",
    "setup:friends": "scripts/friends/setup-friends.sh",
    "test:friends": "node --test electron/friends-bridge.test.cjs electron/friends-files.test.cjs electron/friends-host.test.cjs electron/friends-share-menu.test.cjs && vitest run tests/friends-views.test.ts tests/friends-panel.test.ts tests/friends-download-link.test.ts tests/friends-drops.test.ts && node electron/friends-smoke.mjs",
    "test:friends:package": "node electron/friends-package-smoke.mjs",
    "test:updates": "node --test electron/update-manager.test.cjs && node electron/updates-ui.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@mlightcad/libredwg-web": "^0.8.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tx-code/occt-js": "^0.1.7",
    "dxf-parser": "^1.1.2",
    "electron-updater": "6.8.9",
    "fflate": "^0.8.3",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "three-gpu-pathtracer": "0.0.27",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true
}
