<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Shenzhen Friends on iPhone and iPad, merged into the app's Info.plist by src-tauri/friends/phones.conf.json: the
  questions iOS asks when the person turns Friends on (the Mac helper's own words), the Bonjour type Friends
  browses for, and the scheme of Friends links (shenzhen3d://friends/link#…), which open the link's card.
-->
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Friends uses your local network to find people near you and to send them messages and files directly.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Friends uses Bluetooth to find people near you, and to reach them when Wi-Fi can't.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_szfriends._tcp</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.shenzhen3d.viewer.friends-link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>shenzhen3d</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
