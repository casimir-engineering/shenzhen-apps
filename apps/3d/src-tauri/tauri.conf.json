{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Shenzhen 3D",
  "version": "0.2.1",
  "identifier": "com.shenzhen3d.viewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Shenzhen 3D",
        "width": 1440,
        "height": 960,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 360,
        "minHeight": 560,
        "backgroundColor": "#101719",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost 'self' blob: data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "category": "GraphicsAndDesign",
    "shortDescription": "Measure and explore CAD, meshes and drawings",
    "longDescription": "A local-first 3D viewer for CAD assemblies, meshes and engineering drawings, with intuitive point and feature measurements.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "fileAssociations": [
      {
        "ext": ["step"],
        "name": "STEP model",
        "description": "STEP model",
        "mimeType": "model/step",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["stp"],
        "name": "STEP model",
        "description": "STEP model",
        "mimeType": "model/step",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["iges"],
        "name": "IGES model",
        "description": "IGES model",
        "mimeType": "model/iges",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["igs"],
        "name": "IGES model",
        "description": "IGES model",
        "mimeType": "model/iges",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["brep"],
        "name": "Boundary representation model",
        "description": "Boundary representation model",
        "mimeType": "application/x-brep",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["brp"],
        "name": "Boundary representation model",
        "description": "Boundary representation model",
        "mimeType": "application/x-brep",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["stl"],
        "name": "STL mesh",
        "description": "STL mesh",
        "mimeType": "model/stl",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["obj"],
        "name": "OBJ mesh",
        "description": "OBJ mesh",
        "mimeType": "model/obj",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["glb"],
        "name": "Binary glTF model",
        "description": "Binary glTF model",
        "mimeType": "model/gltf-binary",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["gltf"],
        "name": "glTF model",
        "description": "glTF model",
        "mimeType": "model/gltf+json",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["3mf"],
        "name": "3D Manufacturing model",
        "description": "3D Manufacturing model",
        "mimeType": "model/3mf",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["ply"],
        "name": "PLY mesh",
        "description": "PLY mesh",
        "mimeType": "application/x-ply",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["off"],
        "name": "OFF mesh",
        "description": "OFF mesh",
        "mimeType": "model/x-off",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["fbx"],
        "name": "FBX model",
        "description": "FBX model",
        "mimeType": "application/x-fbx",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["dae"],
        "name": "COLLADA model",
        "description": "COLLADA model",
        "mimeType": "model/vnd.collada+xml",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["wrl"],
        "name": "VRML model",
        "description": "VRML model",
        "mimeType": "model/vrml",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["vrml"],
        "name": "VRML model",
        "description": "VRML model",
        "mimeType": "model/vrml",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["dxf"],
        "name": "DXF drawing",
        "description": "DXF drawing",
        "mimeType": "image/vnd.dxf",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["dwg"],
        "name": "DWG drawing",
        "description": "DWG drawing",
        "mimeType": "image/vnd.dwg",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["svg"],
        "name": "SVG drawing",
        "description": "SVG drawing",
        "mimeType": "image/svg+xml",
        "role": "Viewer",
        "rank": "Alternate",
        "contentTypes": ["public.svg-image"]
      },
      {
        "ext": ["sz3d"],
        "name": "Shenzhen 3D project",
        "description": "Shenzhen 3D project",
        "mimeType": "application/x-shenzhen3d-project",
        "role": "Viewer",
        "rank": "Owner",
        "contentTypes": ["com.shenzhen3d.project"],
        "exportedType": {
          "identifier": "com.shenzhen3d.project",
          "conformsTo": ["public.zip-archive", "public.data"]
        }
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzREE1NTIyQTI4M0JDMDAKUldRQXZJT2lJbFhhQTl4UkJlUmNHMWVFRE5lRUFZRmhqVGJMNXVhVXVjcHFiMFYxV3RJTGhSSisK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
