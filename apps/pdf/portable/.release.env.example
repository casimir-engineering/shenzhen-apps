# Developer ID (direct-download) signing config — example.
#
# Copy this to `.release.env` (git-ignored) and fill in your values.
# build-mac-release.sh sources it automatically.
#
# MAC_SIGN_IDENTITY: your "Developer ID Application" certificate, exactly as it
#   appears in:  security find-identity -v -p codesigning
# NOTARY_PROFILE: the name you gave the notarytool credential created with:
#   xcrun notarytool store-credentials <name> --apple-id <id> --team-id <TEAM> --password <app-specific-password>
#
export MAC_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"
export NOTARY_PROFILE="your-notarytool-profile"
