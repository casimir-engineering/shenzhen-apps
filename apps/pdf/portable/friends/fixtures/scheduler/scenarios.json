{
  "about": "ADR 0018 § 7 scheduler scenarios (WP2). Both schedulers (Rust szfriends-core transfer/scheduler.rs, Objective-C service/transfer/) run each through their simulator and must meet `expect`. Rates in Mbit/s (10^6 bits), times in ms; a lane with \"up_ms\": null comes up only when the scheduler asks for its route, dial_ms later. Silences: nothing moves either way, as a route out of range looks to TCP. A cut closes the lane, noticed detect_ms later (400 by default). expect.mbit: the useful rate the transfer must average at least (size over completion time); max_s: completion at the latest; idle: routes that must carry no byte; max_tail_ms: how long the fastest lane may sit idle before completion; max_wasted_mib: bytes sent twice at most; requests: lane requests that must be made.",
  "scenarios": [
    {"name": "lan", "mib": 1024,
     "lanes": [{"route": "lan", "mbit": 940, "rtt_ms": 2}],
     "expect": {"mbit": 900, "max_tail_ms": 20, "max_wasted_mib": 0}},
    {"name": "lan and direct wifi", "mib": 1024, "direct_wifi_keeps_internet": true,
     "lanes": [{"route": "lan", "mbit": 940, "rtt_ms": 2}, {"route": "direct-wifi", "mbit": 300, "rtt_ms": 4}],
     "expect": {"mbit": 1150, "max_tail_ms": 50, "max_wasted_mib": 4}},
    {"name": "lan, direct wifi and internet", "mib": 512, "direct_wifi_keeps_internet": true,
     "lanes": [{"route": "lan", "mbit": 100, "rtt_ms": 2}, {"route": "direct-wifi", "mbit": 300, "rtt_ms": 4},
               {"route": "internet", "mbit": 50, "rtt_ms": 40}],
     "expect": {"mbit": 420, "max_tail_ms": 150, "max_wasted_mib": 4}},
    {"name": "two lanes on the lan", "mib": 1024,
     "lanes": [{"route": "lan", "mbit": 4000, "rtt_ms": 1}, {"route": "lan", "mbit": 4000, "rtt_ms": 1}],
     "expect": {"mbit": 7400, "max_tail_ms": 20, "max_wasted_mib": 4}},
    {"name": "slow lan and bluetooth", "mib": 100,
     "lanes": [{"route": "lan", "mbit": 16, "rtt_ms": 5}, {"route": "bluetooth", "mbit": 1.4, "rtt_ms": 30}],
     "expect": {"mbit": 16.6, "max_tail_ms": 600}},
    {"name": "slow lan, bluetooth asked for", "mib": 100,
     "lanes": [{"route": "lan", "mbit": 16, "rtt_ms": 5}, {"route": "bluetooth", "mbit": 1.4, "rtt_ms": 30, "up_ms": null}],
     "expect": {"mbit": 16.5, "max_tail_ms": 600, "requests": ["open bluetooth"]}},
    {"name": "slow lan, bluetooth lossy", "mib": 100,
     "lanes": [{"route": "lan", "mbit": 16, "rtt_ms": 5}, {"route": "bluetooth", "mbit": 1.4, "rtt_ms": 30, "loss": 0.05}],
     "expect": {"mbit": 16.2, "max_tail_ms": 600}},
    {"name": "slow lan, bluetooth out of range half-way", "mib": 100,
     "lanes": [{"route": "lan", "mbit": 16, "rtt_ms": 5},
               {"route": "bluetooth", "mbit": 1.4, "rtt_ms": 30, "silences_ms": [[25000, 1000000000]]}],
     "expect": {"max_s": 53.0, "max_tail_ms": 600}},
    {"name": "slow lan, bluetooth flapping", "mib": 100,
     "lanes": [{"route": "lan", "mbit": 16, "rtt_ms": 5},
               {"route": "bluetooth", "mbit": 1.4, "rtt_ms": 30,
                "flapping_ms": {"from": 3000, "period": 4000, "off": 2500, "until": 120000}}],
     "expect": {"max_s": 53.0, "max_tail_ms": 600}},
    {"name": "fast lan, bluetooth unused", "mib": 256,
     "lanes": [{"route": "lan", "mbit": 940, "rtt_ms": 2}, {"route": "bluetooth", "mbit": 1.4, "rtt_ms": 30}],
     "expect": {"mbit": 900, "idle": ["bluetooth"]}},
    {"name": "bluetooth alone", "mib": 4,
     "lanes": [{"route": "bluetooth", "mbit": 1.4, "rtt_ms": 30}],
     "expect": {"mbit": 1.35}},
    {"name": "internet, relay unused", "mib": 100,
     "lanes": [{"route": "internet", "mbit": 50, "rtt_ms": 40}, {"route": "relay", "mbit": 5, "rtt_ms": 80}],
     "expect": {"mbit": 47, "idle": ["relay"]}},
    {"name": "relay alone", "mib": 16,
     "lanes": [{"route": "relay", "mbit": 5, "rtt_ms": 80}],
     "expect": {"mbit": 4.7}},
    {"name": "relay, then the lan", "mib": 256,
     "lanes": [{"route": "relay", "mbit": 5, "rtt_ms": 80}, {"route": "lan", "mbit": 940, "rtt_ms": 2, "up_ms": 2000}],
     "expect": {"max_s": 4.5, "max_tail_ms": 100}},
    {"name": "direct wifi without its own network stays unused", "mib": 256,
     "lanes": [{"route": "lan", "mbit": 100, "rtt_ms": 2}, {"route": "direct-wifi", "mbit": 300, "rtt_ms": 4}],
     "expect": {"mbit": 95, "idle": ["direct-wifi"]}},
    {"name": "direct wifi cut half-way", "mib": 1024, "direct_wifi_keeps_internet": true,
     "lanes": [{"route": "lan", "mbit": 940, "rtt_ms": 2}, {"route": "direct-wifi", "mbit": 300, "rtt_ms": 4, "cut_ms": 3500}],
     "expect": {"max_s": 8.6, "max_tail_ms": 50, "max_wasted_mib": 4}},
    {"name": "direct wifi silent half-way", "mib": 1024, "direct_wifi_keeps_internet": true,
     "lanes": [{"route": "lan", "mbit": 940, "rtt_ms": 2},
               {"route": "direct-wifi", "mbit": 300, "rtt_ms": 4, "silences_ms": [[3500, 1000000000]]}],
     "expect": {"max_s": 9.4, "max_tail_ms": 50, "max_wasted_mib": 4}},
    {"name": "lan flapping beside direct wifi", "mib": 512, "direct_wifi_keeps_internet": true,
     "lanes": [{"route": "lan", "mbit": 940, "rtt_ms": 2,
                "flapping_ms": {"from": 1000, "period": 2000, "off": 1000, "until": 60000}},
               {"route": "direct-wifi", "mbit": 300, "rtt_ms": 4}],
     "expect": {"max_s": 8.0, "max_tail_ms": 1100}},
    {"name": "phone, lan and direct wifi", "mib": 512, "phone": true, "direct_wifi_keeps_internet": true,
     "lanes": [{"route": "lan", "mbit": 400, "rtt_ms": 6}, {"route": "direct-wifi", "mbit": 200, "rtt_ms": 8}],
     "expect": {"mbit": 560, "max_tail_ms": 80}}
  ]
}
