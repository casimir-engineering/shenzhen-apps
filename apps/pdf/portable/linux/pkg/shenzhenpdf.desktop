[Desktop Entry]
Type=Application
Name=ShenzhenPDF
GenericName=PDF Reader
Comment=Fast, tabbed PDF reader with on-device OCR and offline translation
Exec=shenzhenpdf %U
TryExec=shenzhenpdf
Icon=shenzhenpdf
Terminal=false
Categories=Office;Viewer;Graphics;
MimeType=application/pdf;application/oxps;application/vnd.ms-xpsdocument;application/epub+zip;application/x-mobipocket-ebook;application/x-cbz;application/x-cbr;application/x-fictionbook+xml;image/jpeg;image/png;image/x-canon-cr2;image/x-canon-cr3;image/x-canon-crw;image/x-nikon-nef;image/x-nikon-nrw;image/x-sony-arw;image/x-sony-sr2;image/x-sony-srf;image/x-olympus-orf;image/x-fuji-raf;image/x-panasonic-rw2;image/x-pentax-pef;image/x-adobe-dng;image/x-sigma-x3f;x-scheme-handler/szpdf;
StartupNotify=true
StartupWMClass=com.intuition.shenzhenpdf
SingleMainWindow=false
