<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  spdf_win.manifest: the application manifest embedded by spdf_win.rc.

  DPI: PerMonitorV2, the same context spdf_win_enable_dpi_awareness() asks for
  at runtime with SetProcessDpiAwarenessContext. Declaring it here makes the
  runtime call redundant (it then returns ERROR_ACCESS_DENIED, which the caller
  ignores), and that redundancy is the point: the manifest sets the context
  before the first window class is registered, and the runtime call keeps the
  behaviour for a build made without this resource. Both say the same thing.

  longPathAware: paths beyond MAX_PATH reach CreateFileW without the \\?\
  prefix on Windows 10 1607+ when the machine policy allows it.

  Common Controls 6: task dialogs and visual styles for the few classic
  controls the About box and the properties dialog create.

  The version here must move with src\spdf_win_about_version.h.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="CasimirEngineering.ShenzhenPDF" version="26.9.2.1" processorArchitecture="*"/>
  <description>Shenzhen PDF</description>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
