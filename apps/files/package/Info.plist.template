<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Shenzhen Files</string>
    <key>CFBundleExecutable</key>
    <string>nautilus-launcher</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>com.intuition.shenzhenfiles</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Shenzhen Files</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>26.9.12</string>
    <key>CFBundleVersion</key>
    <string>26091201</string>
    <key>SZFReleaseTag</key>
    <string>26.9.12-1</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <!-- Shenzhen Friends finds people nearby over the local network and Bluetooth
         from its helper (Contents/Helpers/Shenzhen Friends.app). macOS holds this
         app responsible for the helper it starts, so its permission prompts name
         Shenzhen Files and show these strings: without them a prompt explains
         nothing, browsing _szfriends._tcp can be refused, and asking for Bluetooth
         ends the helper. The helper's own Info.plist carries them too. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Friends uses your local network to find people near you and to send them messages and files directly.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Friends uses Bluetooth to find people near you, and to reach them when Wi-Fi can't.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_szfriends._tcp</string>
    </array>
    <!-- Shenzhen Friends links: a friend link's or download link's web page
         opens shenzhenfiles://friends/link#<payload> (shenzhen-pdf
         portable/friends/PROTOCOL.md § Links). GTK hands the URL to the
         application's open handler, which passes it to Friends
         (src/nautilus-friends-links.c); nothing happens until the person
         presses the card Friends then shows. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.intuition.shenzhenfiles.friends-link</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>shenzhenfiles</string>
            </array>
        </dict>
    </array>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!-- Passive "Open in Shenzhen Files" Services-menu entry (right-click a
         file or folder in Finder ▸ Services). Backed by the NSServices
         provider registered in src/nautilus-macos-integration.m (NSMessage ↔
         selector openInNautilus:userData:error:). Declaring it changes
         nothing until the user invokes it; harmless in standalone use. -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Open in Shenzhen Files</string>
            </dict>
            <key>NSMessage</key>
            <string>openInNautilus</string>
            <key>NSPortName</key>
            <string>Shenzhen Files</string>
            <key>NSSendFileTypes</key>
            <array>
                <string>public.item</string>
            </array>
        </dict>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Folder</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.folder</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
