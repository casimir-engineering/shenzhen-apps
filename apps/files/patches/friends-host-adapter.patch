diff --git a/test/friends/meson.build b/test/friends/meson.build
new file mode 100644
index 0000000..327c3a7
--- /dev/null
+++ b/test/friends/meson.build
@@ -0,0 +1,45 @@
+# The Shenzhen Friends host adapter's tests (src/nautilus-friends*.c and
+# src/nautilus-macos-friends.m). Run them with tools/test-friends-adapter.sh
+# from the repository root, which also builds Files without Friends.
+
+# No display, no helper, no network: the host description, received files,
+# the lifecycle through counting fakes, `#` on scratch folders, the app
+# bundle and the signing policy.
+friends_test = executable(
+  'test-nautilus-friends',
+  'test-nautilus-friends.c',
+  'test-nautilus-friends-bundle.c',
+  'test-nautilus-friends-files.c',
+  'test-nautilus-friends-links.c',
+  dependencies: [libnautilus_dep],
+)
+test(
+  'test-nautilus-friends',
+  friends_test,
+  env: [test_env],
+  timeout: 60,
+  suite: ['friends'],
+)
+
+# The Friends button placed in a window's header bars and the Friends
+# Preferences page, rendered offscreen. GDK needs the display, so the probe
+# links the Friends views' interposer, which keeps the process out of the
+# Dock and away from focus. It takes the directory for its renders as its
+# argument, so the wrapper runs it rather than meson test.
+friends_frameworks = dependency('appleframeworks', modules: ['ApplicationServices'])
+friends_quiet = shared_library(
+  'szfriends-gtk-quiet',
+  friends_root / 'portable' / 'friends' / 'gtk' / 'tests' / 'szfriends_gtk_quiet.c',
+  # Upstream's own file, written without a separate prototype.
+  c_args: ['-Wno-missing-prototypes'],
+  dependencies: friends_frameworks,
+)
+executable(
+  'test-nautilus-friends-toolbar',
+  'test-nautilus-friends-toolbar.c',
+  'test-nautilus-friends-placement.c',
+  'test-nautilus-friends-preferences.c',
+  'test-nautilus-friends-menu.c',
+  dependencies: [libnautilus_dep, friends_frameworks],
+  link_with: friends_quiet,
+)
diff --git a/test/friends/test-nautilus-friends-bundle.c b/test/friends/test-nautilus-friends-bundle.c
new file mode 100644
index 0000000..272d981
--- /dev/null
+++ b/test/friends/test-nautilus-friends-bundle.c
@@ -0,0 +1,185 @@
+/*
+ * test-nautilus-friends-bundle.c: the app bundle and the signing policy.
+ *
+ * Scratch bundles in the release and development layouts give the helper's path and version keys and the
+ * NAUTILUS_FRIENDS_HELPER override; this test's own signature (linker-signed, like an ad hoc build) gives the
+ * signing policy and the peer verifier. Scratch folders live under TMPDIR, as in test-nautilus-friends-files.c.
+ */
+
+#include <config.h>
+
+#include "test-nautilus-friends.h"
+
+#include <mach/mach.h>
+#include <string.h>
+#include <sys/stat.h>
+
+#include "client/szfriends_client.h"
+
+/* ---- The app bundle ------------------------------------------------------------------------------------------ */
+
+static void
+write_info (const char *bundle,
+            const char *short_version,
+            const char *build)
+{
+    g_autofree char *contents = g_build_filename (bundle, "Contents", NULL);
+    g_autofree char *path = g_build_filename (contents, "Info.plist", NULL);
+    g_autoptr (GString) plist = g_string_new ("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+                                              "<plist version=\"1.0\"><dict>");
+
+    if (short_version != NULL)
+    {
+        g_string_append_printf (plist, "<key>CFBundleShortVersionString</key><string>%s</string>", short_version);
+    }
+    if (build != NULL)
+    {
+        g_string_append_printf (plist, "<key>CFBundleVersion</key><string>%s</string>", build);
+    }
+    g_string_append (plist, "</dict></plist>\n");
+    g_assert_cmpint (g_mkdir_with_parents (contents, 0700), ==, 0);
+    g_assert_true (g_file_set_contents (path, plist->str, -1, NULL));
+}
+
+/* A Shenzhen Friends.app at @app: its version keys, its executable (when @runnable) and its own animal set. */
+static void
+make_helper (const char *app,
+             const char *short_version,
+             const char *build,
+             gboolean    runnable,
+             gboolean    animals)
+{
+    g_autofree char *macos = g_build_filename (app, "Contents", "MacOS", NULL);
+    g_autofree char *executable = g_build_filename (macos, "Shenzhen Friends", NULL);
+
+    write_info (app, short_version, build);
+    g_assert_cmpint (g_mkdir_with_parents (macos, 0700), ==, 0);
+    g_assert_true (g_file_set_contents (executable, "#!/bin/sh\nexit 0\n", -1, NULL));
+    g_assert_cmpint (chmod (executable, runnable ? 0700 : 0600), ==, 0);
+    if (animals)
+    {
+        g_autofree char *set = g_build_filename (app, "Contents", "Resources", "Friends", "animals", NULL);
+        g_autofree char *manifest = g_build_filename (set, "manifest.json", NULL);
+
+        g_assert_cmpint (g_mkdir_with_parents (set, 0700), ==, 0);
+        g_assert_true (g_file_set_contents (manifest, "{}", -1, NULL));
+    }
+}
+
+static void
+test_bundle_reading (void)
+{
+    g_autofree char *dir = friends_test_scratch_dir ();
+    g_autofree char *app = g_build_filename (dir, "Shenzhen Files.app", NULL);
+    g_autofree char *embedded = g_build_filename (app, NAUTILUS_FRIENDS_HELPER_BUNDLE, NULL);
+    g_autofree char *embedded_exe = g_build_filename (embedded, NAUTILUS_FRIENDS_HELPER_EXECUTABLE, NULL);
+    g_autofree char *build_dir = g_build_filename (dir, "build", "src", NULL);
+    g_autofree char *standalone = g_build_filename (dir, "dev", "Shenzhen Friends.app", NULL);
+    g_autofree char *standalone_exe = g_build_filename (standalone, NAUTILUS_FRIENDS_HELPER_EXECUTABLE, NULL);
+    g_autofree char *manifest = g_build_filename (standalone, "Contents/Resources/Friends/animals/manifest.json",
+                                                  NULL);
+    g_autofree char *odd = g_build_filename (dir, "Odd.app", NULL);
+    g_autofree char *odd_helper = g_build_filename (odd, NAUTILUS_FRIENDS_HELPER_BUNDLE, NULL);
+    NautilusFriendsBundle bundle;
+
+    write_info (app, "26.9.14", "26091401");
+    /* With a set of its own, as a standalone build has: the embedded one still uses the app's. */
+    make_helper (embedded, "26.10.11", "26101101", TRUE, TRUE);
+    make_helper (standalone, "26.10.12", "26101201", TRUE, TRUE);
+    g_assert_cmpint (g_mkdir_with_parents (build_dir, 0700), ==, 0);
+
+    /* The release layout: the embedded helper and its stamped keys; the development override cannot replace it. */
+    nautilus_friends_bundle_read (app, standalone, TRUE, &bundle);
+    g_assert_cmpstr (bundle.app_version, ==, "26.9.14");
+    g_assert_cmpstr (bundle.helper_path, ==, embedded_exe);
+    g_assert_cmpstr (bundle.helper_version, ==, "26.10.11");
+    g_assert_cmpuint (bundle.helper_build_number, ==, 26101101);
+    g_assert_null (bundle.animals_manifest_path);
+    nautilus_friends_bundle_clear (&bundle);
+
+    /* A development run: the standalone helper and its own animal set, only while overrides are allowed. */
+    nautilus_friends_bundle_read (build_dir, standalone, TRUE, &bundle);
+    g_assert_cmpstr (bundle.app_version, ==, PACKAGE_VERSION);
+    g_assert_cmpstr (bundle.helper_path, ==, standalone_exe);
+    g_assert_cmpstr (bundle.helper_version, ==, "26.10.12");
+    g_assert_cmpuint (bundle.helper_build_number, ==, 26101201);
+    g_assert_cmpstr (bundle.animals_manifest_path, ==, manifest);
+    nautilus_friends_bundle_clear (&bundle);
+    nautilus_friends_bundle_read (build_dir, standalone, FALSE, &bundle);
+    g_assert_null (bundle.helper_path);
+    g_assert_null (bundle.helper_version);
+    g_assert_cmpuint (bundle.helper_build_number, ==, 0);
+    nautilus_friends_bundle_clear (&bundle);
+    nautilus_friends_bundle_read (build_dir, "dev/Shenzhen Friends.app", TRUE, &bundle);
+    g_assert_null (bundle.helper_path);
+    nautilus_friends_bundle_clear (&bundle);
+    nautilus_friends_bundle_read (NULL, NULL, TRUE, &bundle);
+    g_assert_cmpstr (bundle.app_version, ==, PACKAGE_VERSION);
+    g_assert_null (bundle.helper_path);
+    nautilus_friends_bundle_clear (&bundle);
+
+    /* Keys that are not a build number, or a number without a version, never claim a handover. */
+    make_helper (odd_helper, "26.10.11", "26.10.11", TRUE, FALSE);
+    nautilus_friends_bundle_read (odd, NULL, FALSE, &bundle);
+    g_assert_nonnull (bundle.helper_path);
+    g_assert_null (bundle.helper_version);
+    g_assert_cmpuint (bundle.helper_build_number, ==, 0);
+    nautilus_friends_bundle_clear (&bundle);
+    make_helper (odd_helper, NULL, "26101101", TRUE, FALSE);
+    nautilus_friends_bundle_read (odd, NULL, FALSE, &bundle);
+    g_assert_null (bundle.helper_version);
+    g_assert_cmpuint (bundle.helper_build_number, ==, 0);
+    nautilus_friends_bundle_clear (&bundle);
+
+    /* An embedded helper that cannot run is no helper; the override is then used where allowed. */
+    make_helper (odd_helper, "26.10.11", "26101101", FALSE, FALSE);
+    nautilus_friends_bundle_read (odd, NULL, TRUE, &bundle);
+    g_assert_null (bundle.helper_path);
+    nautilus_friends_bundle_clear (&bundle);
+    nautilus_friends_bundle_read (odd, standalone, TRUE, &bundle);
+    g_assert_cmpstr (bundle.helper_path, ==, standalone_exe);
+    nautilus_friends_bundle_clear (&bundle);
+
+    friends_test_remove_tree (dir);
+}
+
+/* ---- The signing policy ------------------------------------------------------------------------------------- */
+
+static void
+test_signing_policy (void)
+{
+    audit_token_t token;
+    guint8 longer[sizeof (audit_token_t) + 8] = { 0 };
+    mach_msg_type_number_t count = TASK_AUDIT_TOKEN_COUNT;
+    g_autofree char *team = nautilus_friends_own_team_identifier ();
+
+    /* This test is linker-signed, like an ad hoc development build: no team, so no policy, and the client
+     * library keeps honouring SZFRIENDS_STATE_DIR. */
+    g_assert_null (team);
+    nautilus_friends_prepare_signing ();
+    nautilus_friends_prepare_signing ();
+    g_assert_true (szfriends_environment_overrides_allowed ());
+
+    /* The verifier, on this process's own audit token. */
+    g_assert_cmpint (task_info (mach_task_self (), TASK_AUDIT_TOKEN, (task_info_t) &token, &count), ==,
+                     KERN_SUCCESS);
+    g_assert_true (nautilus_friends_verify_peer (NULL, &token, sizeof token, "always"));
+    g_assert_false (nautilus_friends_verify_peer (NULL, &token, sizeof token, "never"));
+    g_assert_false (nautilus_friends_verify_peer (NULL, &token, sizeof token,
+                                                  "anchor apple generic and certificate leaf[subject.OU] = "
+                                                  "\"ABCDE12345\""));
+    g_assert_false (nautilus_friends_verify_peer (NULL, &token, sizeof token, "not a requirement"));
+    g_assert_false (nautilus_friends_verify_peer (NULL, &token, sizeof token, ""));
+    g_assert_false (nautilus_friends_verify_peer (NULL, &token, sizeof token, NULL));
+    g_assert_false (nautilus_friends_verify_peer (NULL, &token, sizeof token - 1, "always"));
+    memcpy (longer, &token, sizeof token);
+    g_assert_false (nautilus_friends_verify_peer (NULL, longer, sizeof longer, "always"));
+    g_assert_false (nautilus_friends_verify_peer (NULL, NULL, sizeof token, "always"));
+}
+
+void
+friends_test_add_bundle_tests (void)
+{
+    g_test_add_func ("/friends/bundle/reading", test_bundle_reading);
+    g_test_add_func ("/friends/signing/policy", test_signing_policy);
+}
diff --git a/test/friends/test-nautilus-friends-files.c b/test/friends/test-nautilus-friends-files.c
new file mode 100644
index 0000000..2decc22
--- /dev/null
+++ b/test/friends/test-nautilus-friends-files.c
@@ -0,0 +1,371 @@
+/*
+ * test-nautilus-friends-files.c: `#` on a real scratch folder.
+ *
+ * The folder is loaded through NautilusDirectory, as a tab loads it, and the adapter's items are checked for
+ * order, filtering, details, kind labels, links, the limit, and the asynchronous answer. Scratch folders live
+ * under TMPDIR, which tools/test-friends-adapter.sh points at a directory it always removes.
+ */
+
+#include "test-nautilus-friends.h"
+
+#include <ftw.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/time.h>
+#include <unistd.h>
+
+#include <nautilus-directory.h>
+#include <nautilus-enums.h>
+#include <nautilus-file.h>
+
+/* ---- Scratch folders ------------------------------------------------------------------------------------------ */
+
+static int
+remove_entry (const char        *path,
+              const struct stat *info,
+              int                flag,
+              struct FTW        *ftw)
+{
+    return remove (path);
+}
+
+void
+friends_test_remove_tree (const char *path)
+{
+    g_assert_cmpint (nftw (path, remove_entry, 16, FTW_DEPTH | FTW_PHYS), ==, 0);
+}
+
+char *
+friends_test_scratch_dir (void)
+{
+    g_autoptr (GError) error = NULL;
+    char *dir = g_dir_make_tmp ("szf-friends-XXXXXX", &error);
+
+    g_assert_no_error (error);
+    return dir;
+}
+
+/* A file, and its own time (lutimes: a link keeps its own) @age seconds ago. */
+static void
+set_age (const char *path,
+         int         age)
+{
+    struct timeval times[2];
+
+    times[0].tv_sec = times[1].tv_sec = time (NULL) - age;
+    times[0].tv_usec = times[1].tv_usec = 0;
+    g_assert_cmpint (lutimes (path, times), ==, 0);
+}
+
+static void
+make_file (const char *dir,
+           const char *name,
+           int         age)
+{
+    g_autofree char *path = g_build_filename (dir, name, NULL);
+
+    g_assert_true (g_file_set_contents (path, name, -1, NULL));
+    set_age (path, age);
+}
+
+static void
+make_link (const char *dir,
+           const char *name,
+           const char *target,
+           int         age)
+{
+    g_autofree char *path = g_build_filename (dir, name, NULL);
+
+    g_assert_cmpint (symlink (target, path), ==, 0);
+    set_age (path, age);
+}
+
+typedef struct
+{
+    gboolean ready;
+    GList *files;
+} Loaded;
+
+/* The files live only through this callback unless someone holds them, as a tab's monitor does. */
+static void
+on_ready (NautilusDirectory *directory,
+          GList             *files,
+          gpointer           user_data)
+{
+    Loaded *loaded = user_data;
+
+    loaded->files = nautilus_file_list_copy (files);
+    loaded->ready = TRUE;
+}
+
+static void
+on_timeout (gpointer user_data)
+{
+    *(gboolean *) user_data = TRUE;
+}
+
+/* Runs the main loop until *done, at most 10 s. */
+static void
+wait_until (gboolean *done)
+{
+    gboolean timed_out = FALSE;
+    guint timeout = g_timeout_add_seconds_once (10, on_timeout, &timed_out);
+
+    while (!*done && !timed_out)
+    {
+        g_main_context_iteration (NULL, TRUE);
+    }
+    if (!timed_out)
+    {
+        g_source_remove (timeout);
+    }
+    g_assert_true (*done);
+}
+
+/* The folder as a tab sees it: every file with its info. */
+static GList *
+load_folder (const char *path)
+{
+    g_autoptr (GFile) location = g_file_new_for_path (path);
+    NautilusDirectory *directory = nautilus_directory_get (location);
+    Loaded loaded = { FALSE, NULL };
+
+    nautilus_directory_call_when_ready (directory, NAUTILUS_ATTRIBUTE_INFO | NAUTILUS_ATTRIBUTE_FILE_LIST,
+                                        on_ready, &loaded);
+    wait_until (&loaded.ready);
+    nautilus_directory_unref (directory);
+    return loaded.files;
+}
+
+static NautilusFile *
+find (GList      *files,
+      const char *name)
+{
+    for (GList *l = files; l != NULL; l = l->next)
+    {
+        if (g_strcmp0 (nautilus_file_get_name (l->data), name) == 0)
+        {
+            return l->data;
+        }
+    }
+    g_assert_not_reached ();
+}
+
+/* "title|detail|kind|path" per item, so a failure shows the whole list. */
+static char *
+describe (GPtrArray *items)
+{
+    GString *text = g_string_new (NULL);
+
+    for (guint i = 0; i < items->len; i++)
+    {
+        SZFriendsGtkHostItem *item = g_ptr_array_index (items, i);
+
+        g_assert_null (item->revision_json);
+        g_string_append_printf (text, "%s%s|%s|%s|%s", i > 0 ? "\n" : "", item->title, item->detail,
+                                item->kind_label, item->path);
+    }
+    return g_string_free (text, FALSE);
+}
+
+static void
+assert_items (GList      *selection,
+              GList      *files,
+              const char *query,
+              const char *expected)
+{
+    g_autoptr (GPtrArray) items = nautilus_friends_items_collect (selection, files, query);
+    g_autofree char *got = describe (items);
+
+    g_assert_cmpstr (got, ==, expected);
+}
+
+/* ---- `#` ---------------------------------------------------------------------------------------------------- */
+
+static void
+test_items_order_and_filter (void)
+{
+    g_autofree char *dir = friends_test_scratch_dir ();
+    g_autofree char *elsewhere = friends_test_scratch_dir ();
+    g_autofree char *base = g_path_get_basename (dir);
+    g_autofree char *secret = g_build_filename (elsewhere, "secret.txt", NULL);
+    g_autofree char *expected = NULL;
+    g_autofree char *sub = g_build_filename (dir, "sub", NULL);
+    g_autofree char *package = g_build_filename (dir, "Bundle.app", NULL);
+    g_autofree char *pipe = g_build_filename (dir, "pipe", NULL);
+    GList *files, *selection = NULL;
+
+    make_file (dir, "a.pdf", 300);
+    make_file (dir, "b.md", 100);
+    make_file (dir, "c.txt", 200);
+    make_file (dir, ".hidden.txt", 0);
+    make_file (dir, ".secret.txt", 0);
+    make_file (dir, "R\xc3\xa9sum\xc3\xa9 final.docx", 400);
+    make_file (elsewhere, "secret.txt", 500);
+    g_assert_cmpint (mkdir (sub, 0700), ==, 0);
+    g_assert_cmpint (mkdir (package, 0700), ==, 0);
+    g_assert_cmpint (mkfifo (pipe, 0600), ==, 0);
+    make_link (dir, "link-to-a", "a.pdf", 300);
+    make_link (dir, "dangling", "missing.pdf", 50);
+    /* Links named like documents, to a file outside the folder: one the person selected, one they did not. Sent,
+     * the outside file would go under the link's name, past the helper's and the drop's refusal of links. */
+    make_link (dir, "Picked.pdf", secret, 10);
+    make_link (dir, "Report.pdf", secret, 20);
+
+    files = load_folder (dir);
+    selection = g_list_append (selection, find (files, "c.txt"));
+    selection = g_list_append (selection, find (files, "Picked.pdf"));
+    selection = g_list_append (selection, find (files, "sub"));
+    selection = g_list_append (selection, find (files, ".hidden.txt"));
+
+    /* Selection first, in its order (a hidden file the person selected counts; a folder never does), then the
+     * folder's other files newest first; no folder, package, pipe, link (selected or not, wherever it points,
+     * dangling or not) or unselected hidden file. */
+    expected = g_strdup_printf ("c.txt|Selected in %s|Text|%s/c.txt\n"
+                                ".hidden.txt|Selected in %s|Text|%s/.hidden.txt\n"
+                                "b.md|In %s|Markdown|%s/b.md\n"
+                                "a.pdf|In %s|PDF|%s/a.pdf\n"
+                                "R\xc3\xa9sum\xc3\xa9 final.docx|In %s|DOCX|%s/R\xc3\xa9sum\xc3\xa9 final.docx",
+                                base, dir, base, dir, base, dir, base, dir, base, dir);
+    assert_items (selection, files, "", expected);
+    assert_items (selection, files, "   ", expected);
+    /* Searching for a link by name finds nothing, and its document-like name does not let it through. */
+    assert_items (selection, files, "link", "");
+    assert_items (selection, files, "Report", "");
+    g_free (expected);
+    expected = g_strdup_printf ("a.pdf|In %s|PDF|%s/a.pdf", base, dir);
+    assert_items (selection, files, ".pdf", expected);
+
+    /* The query narrows both parts: case, accents and surrounding blanks do not matter. */
+    g_free (expected);
+    expected = g_strdup_printf ("b.md|In %s|Markdown|%s/b.md", base, dir);
+    assert_items (selection, files, "  B.M ", expected);
+    g_free (expected);
+    expected = g_strdup_printf ("R\xc3\xa9sum\xc3\xa9 final.docx|In %s|DOCX|%s/R\xc3\xa9sum\xc3\xa9 final.docx",
+                                base, dir);
+    assert_items (selection, files, "resume", expected);
+    assert_items (selection, files, "RE\xcc\x81SUME\xcc\x81", expected);
+    g_free (expected);
+    expected = g_strdup_printf ("c.txt|Selected in %s|Text|%s/c.txt\n"
+                                ".hidden.txt|Selected in %s|Text|%s/.hidden.txt",
+                                base, dir, base, dir);
+    assert_items (selection, files, "txt", expected);
+    assert_items (selection, files, "zzz", "");
+    /* Nothing selected: the folder alone. */
+    g_free (expected);
+    expected = g_strdup_printf ("c.txt|In %s|Text|%s/c.txt", base, dir);
+    assert_items (NULL, files, "c.t", expected);
+
+    g_list_free (selection);
+    nautilus_file_list_free (files);
+    friends_test_remove_tree (dir);
+    friends_test_remove_tree (elsewhere);
+}
+
+static void
+test_items_limit (void)
+{
+    g_autofree char *dir = friends_test_scratch_dir ();
+    g_autoptr (GPtrArray) items = NULL;
+    GList *files, *selection = NULL;
+
+    for (int i = 0; i < 35; i++)
+    {
+        g_autofree char *name = g_strdup_printf ("f%02d.txt", i);
+
+        make_file (dir, name, 1000 - i);
+    }
+    files = load_folder (dir);
+    selection = g_list_append (selection, find (files, "f03.txt"));
+    selection = g_list_append (selection, find (files, "f01.txt"));
+    items = nautilus_friends_items_collect (selection, files, NULL);
+    g_assert_cmpuint (items->len, ==, NAUTILUS_FRIENDS_ATTACH_LIMIT);
+    g_assert_cmpstr (((SZFriendsGtkHostItem *) g_ptr_array_index (items, 0))->title, ==, "f03.txt");
+    g_assert_cmpstr (((SZFriendsGtkHostItem *) g_ptr_array_index (items, 1))->title, ==, "f01.txt");
+    /* The newest unselected file comes next. */
+    g_assert_cmpstr (((SZFriendsGtkHostItem *) g_ptr_array_index (items, 2))->title, ==, "f34.txt");
+
+    g_list_free (selection);
+    nautilus_file_list_free (files);
+    friends_test_remove_tree (dir);
+}
+
+static void
+test_name_matching_and_kinds (void)
+{
+    static const char *const kinds[][2] =
+    {
+        { "Site photos.pdf", "PDF" }, { "notes.markdown", "Markdown" }, { "photo.JPG", "JPEG" },
+        { "backup.tar.gz", "GZ" }, { "archive.zip", "ZIP" }, { "README", "File" }, { ".bashrc", "File" },
+        { "trailing.", "File" }, { "a.verylongext", "File" }, { "Version 2.final draft", "File" },
+    };
+
+    g_assert_true (nautilus_friends_name_matches ("R\xc3\xa9sum\xc3\xa9.pdf", "resume"));
+    g_assert_true (nautilus_friends_name_matches ("\xc3\x85NGSTR\xc3\x96M", "angstrom"));
+    g_assert_true (nautilus_friends_name_matches ("\xef\xac\x81le.txt", "file"));
+    g_assert_true (nautilus_friends_name_matches ("\xe4\xb8\xad\xe6\x96\x87\xe6\x96\x87\xe4\xbb\xb6",
+                                                  "\xe6\x96\x87\xe4\xbb\xb6"));
+    g_assert_true (nautilus_friends_name_matches ("abc", ""));
+    g_assert_true (nautilus_friends_name_matches ("abc", NULL));
+    g_assert_false (nautilus_friends_name_matches ("abc", "abd"));
+    for (gsize i = 0; i < G_N_ELEMENTS (kinds); i++)
+    {
+        g_autofree char *label = nautilus_friends_kind_label (kinds[i][0]);
+
+        g_assert_cmpstr (label, ==, kinds[i][1]);
+    }
+}
+
+typedef struct
+{
+    guint calls;
+    guint length;
+} ReadyRecord;
+
+static void
+on_items (GPtrArray *items,
+          gpointer   user_data)
+{
+    ReadyRecord *record = user_data;
+
+    record->calls++;
+    record->length = items->len;
+    g_ptr_array_unref (items);
+}
+
+static void
+test_attachable_items_async (void)
+{
+    ReadyRecord record = { 0 };
+    g_autoptr (GCancellable) cancelled = g_cancellable_new ();
+    gboolean done = FALSE;
+
+    /* No browser window: answered, empty, and never from inside the call. */
+    nautilus_friends_attachable_items (NULL, NULL, "x", NULL, on_items, &record);
+    g_assert_cmpuint (record.calls, ==, 0);
+    while (g_main_context_iteration (NULL, FALSE))
+    {
+    }
+    g_assert_cmpuint (record.calls, ==, 1);
+    g_assert_cmpuint (record.length, ==, 0);
+
+    /* Cancelled before the answer: never answered. */
+    g_cancellable_cancel (cancelled);
+    nautilus_friends_attachable_items (NULL, NULL, "x", cancelled, on_items, &record);
+    g_idle_add_once (on_timeout, &done);
+    wait_until (&done);
+    while (g_main_context_iteration (NULL, FALSE))
+    {
+    }
+    g_assert_cmpuint (record.calls, ==, 1);
+}
+
+void
+friends_test_add_file_tests (void)
+{
+    g_test_add_func ("/friends/items/order-and-filter", test_items_order_and_filter);
+    g_test_add_func ("/friends/items/limit", test_items_limit);
+    g_test_add_func ("/friends/items/matching-and-kinds", test_name_matching_and_kinds);
+    g_test_add_func ("/friends/items/async", test_attachable_items_async);
+}
diff --git a/test/friends/test-nautilus-friends-links.c b/test/friends/test-nautilus-friends-links.c
new file mode 100644
index 0000000..f5b95ce
--- /dev/null
+++ b/test/friends/test-nautilus-friends-links.c
@@ -0,0 +1,378 @@
+/*
+ * test-nautilus-friends-links.c: friend links and download links without a display or a helper.
+ *
+ * The strict check of shenzhenfiles://friends/link#<payload> (malformed, oversized and wrong-type payloads
+ * refused), a link waiting for Friends to attach and shown once it does, never shown when it fails the check, the
+ * question while Friends is off, and the Copy Download Link items with their expiry choice, which show and hide as
+ * the helper starts and stops offering links.
+ */
+
+#include "test-nautilus-friends.h"
+
+#include <nautilus-global-preferences.h>
+#include <string.h>
+
+/* ---- Payloads --------------------------------------------------------------------------------------------------- */
+
+static char *
+base64url (const guint8 *bytes,
+           gsize         length)
+{
+    g_autofree char *text = g_base64_encode (bytes, length);
+
+    g_strdelimit (text, "+", '-');
+    g_strdelimit (text, "/", '_');
+    if (strchr (text, '=') != NULL)
+    {
+        *strchr (text, '=') = '\0';
+    }
+    return g_steal_pointer (&text);
+}
+
+static char *
+download_payload (gsize length,
+                  guint8 version)
+{
+    g_autofree guint8 *bytes = g_malloc0 (length);
+
+    memset (bytes, 0x5a, length);
+    bytes[0] = version;
+    g_autofree char *body = base64url (bytes, length);
+    return g_strconcat ("d.", body, NULL);
+}
+
+static char *
+friend_payload (const char *friends_id,
+                const char *name,
+                const char *trailing)
+{
+    g_autoptr (GByteArray) bytes = g_byte_array_new ();
+    guint8 head[1 + 32 + 16], length;
+
+    /* The version, the identity key and the invite token, then the ID and the name with their lengths. */
+    memset (head, 0x33, sizeof head);
+    head[0] = 0x01;
+    g_byte_array_append (bytes, head, sizeof head);
+    length = (guint8) strlen (friends_id);
+    g_byte_array_append (bytes, &length, 1);
+    g_byte_array_append (bytes, (const guint8 *) friends_id, length);
+    length = (guint8) strlen (name);
+    g_byte_array_append (bytes, &length, 1);
+    g_byte_array_append (bytes, (const guint8 *) name, length);
+    g_byte_array_append (bytes, (const guint8 *) trailing, strlen (trailing));
+    g_autofree char *body = base64url (bytes->data, bytes->len);
+    return g_strconcat ("f.", body, NULL);
+}
+
+static void
+expect_refused (const char                 *uri,
+                NautilusFriendsLinkRefusal  expected)
+{
+    NautilusFriendsLinkRefusal refusal = NAUTILUS_FRIENDS_LINK_ACCEPTED;
+    g_autofree char *payload = nautilus_friends_link_payload (uri, &refusal);
+
+    if (payload != NULL || refusal != expected)
+    {
+        g_error ("%s: refusal %d, expected %d", uri, refusal, expected);
+    }
+}
+
+static void
+test_payloads (void)
+{
+    g_autofree char *download = download_payload (49, 0x01);
+    g_autofree char *friend = friend_payload ("brave-otter", "Mei Lin", "");
+    g_autofree char *download_uri = g_strconcat ("shenzhenfiles://friends/link#", download, NULL);
+    g_autofree char *friend_uri = g_strconcat ("ShenzhenFiles://friends/link#", friend, NULL);
+    g_autofree char *got = nautilus_friends_link_payload (download_uri, NULL);
+    g_autofree char *got_friend = nautilus_friends_link_payload (friend_uri, NULL);
+
+    g_assert_cmpstr (got, ==, download);
+    g_assert_cmpstr (got_friend, ==, friend);
+
+    expect_refused ("file:///Users/raph/a.pdf", NAUTILUS_FRIENDS_LINK_NOT_OURS);
+    expect_refused ("shenzhenpdf://friends/link#d.AAAA", NAUTILUS_FRIENDS_LINK_NOT_OURS);
+
+    g_autofree char *padding = g_strnfill (600, 'A');
+    g_autofree char *oversized = g_strconcat (download_uri, padding, NULL);
+    expect_refused (oversized, NAUTILUS_FRIENDS_LINK_OVERSIZED);
+
+    const char *body = download + 2;
+    const char *malformed_rests[] = { "//friend/link#", "//Friends/link#", "//friends/link/#", "//friends/link?x=1#",
+                                      "//friends:80/link#", "//mei@friends/link#", "friends/link#" };
+    for (gsize i = 0; i < G_N_ELEMENTS (malformed_rests); i++)
+    {
+        g_autofree char *uri = g_strconcat ("shenzhenfiles:", malformed_rests[i], download, NULL);
+        expect_refused (uri, NAUTILUS_FRIENDS_LINK_MALFORMED);
+    }
+    g_autofree char *with_hash = g_strconcat (download_uri, "#", NULL);
+    g_autofree char *padded = g_strconcat (download_uri, "=", NULL);
+    g_autofree char *one_mod_four = g_strconcat (download_uri, "AAA", NULL);
+    g_autofree char *escaped = g_strconcat ("shenzhenfiles://friends/link#d.%41", body + 1, NULL);
+    g_autofree char *trailing_bits = g_strdup (download_uri);
+    trailing_bits[strlen (trailing_bits) - 1] = 'z';
+    const char *malformed[] = { "shenzhenfiles://friends/link", "shenzhenfiles://friends/link#",
+                                "shenzhenfiles://friends/link#d.", "shenzhenfiles://friends/link#dd",
+                                with_hash, padded, one_mod_four, escaped, trailing_bits };
+    for (gsize i = 0; i < G_N_ELEMENTS (malformed); i++)
+    {
+        expect_refused (malformed[i], NAUTILUS_FRIENDS_LINK_MALFORMED);
+    }
+
+    g_autofree char *short_download = download_payload (48, 0x01);
+    g_autofree char *version_two = download_payload (49, 0x02);
+    g_autofree char *other_kind = g_strconcat ("x.", body, NULL);
+    g_autofree char *download_as_friend = g_strconcat ("f.", body, NULL);
+    g_autofree char *friend_as_download = g_strconcat ("d.", friend + 2, NULL);
+    char *wrong[] = {
+        short_download, version_two, other_kind, download_as_friend, friend_as_download,
+        friend_payload ("Brave-Otter", "Mei", ""), friend_payload ("brave--otter", "Mei", ""),
+        friend_payload ("ab", "Mei", ""), friend_payload ("brave-otter", "Mei\nOpen this", ""),
+        friend_payload ("brave-otter", "Mei\xc2\x85", ""), friend_payload ("brave-otter", "\xff\xfe", ""),
+        friend_payload ("brave-otter", "Mei", "x"),
+    };
+    for (gsize i = 0; i < G_N_ELEMENTS (wrong); i++)
+    {
+        g_autofree char *uri = g_strconcat ("shenzhenfiles://friends/link#", wrong[i], NULL);
+        expect_refused (uri, NAUTILUS_FRIENDS_LINK_WRONG_TYPE);
+        if (i >= 5)
+        {
+            g_free (wrong[i]);
+        }
+    }
+}
+
+/* ---- The lifecycle ---------------------------------------------------------------------------------------------- */
+
+static int link_storage;
+#define LINK ((SZFriendsGtkLink *) &link_storage)
+static GPtrArray *shown;
+static guint asked;
+
+static void nothing (void) {}
+static SZFriendsGtkLink *new_link (void) { return LINK; }
+static void start (SZFriendsGtkLink *link) { (void) link; }
+static void stop (SZFriendsGtkLink *link, gboolean disabled) { (void) link; (void) disabled; }
+static void add_window (SZFriendsGtkLink *link, GtkWindow *window) { (void) link; (void) window; }
+
+static void
+show_link (SZFriendsGtkLink *link,
+           const char       *payload)
+{
+    g_assert_true (link == LINK);
+    g_ptr_array_add (shown, g_strdup (payload));
+}
+
+static void
+ask_to_turn_on (void)
+{
+    asked++;
+}
+
+static const NautilusFriendsOps ops =
+{
+    .spawn_at_launch = nothing, .prepare_signing = nothing, .link_new = new_link, .link_start = start,
+    .link_stop = stop, .link_free = start, .add_window = add_window, .show_link = show_link,
+    .ask_to_turn_on = ask_to_turn_on,
+};
+
+static void
+set_enabled (gboolean enabled)
+{
+    g_settings_set_boolean (nautilus_preferences, NAUTILUS_PREFERENCES_FRIENDS_ENABLED, enabled);
+    while (g_main_context_iteration (NULL, FALSE))
+    {
+    }
+}
+
+static void
+test_opening (void)
+{
+    g_autofree char *download = download_payload (49, 0x01);
+    g_autofree char *uri = g_strconcat ("shenzhenfiles://friends/link#", download, NULL);
+    NautilusFriends *friends;
+
+    shown = g_ptr_array_new_with_free_func (g_free);
+    asked = 0;
+    set_enabled (TRUE);
+    friends = nautilus_friends_new (&ops, nautilus_preferences);
+
+    /* Not a link: the application opens it as a location. */
+    g_assert_false (nautilus_friends_take_link (friends, "file:///Users/raph"));
+    /* Launched by a link: it waits for the first paint, then shows once. */
+    g_assert_true (nautilus_friends_take_link (friends, uri));
+    g_assert_cmpuint (shown->len, ==, 0);
+    nautilus_friends_first_paint (friends);
+    g_assert_cmpuint (shown->len, ==, 1);
+    g_assert_cmpstr (g_ptr_array_index (shown, 0), ==, download);
+    /* Attached: shown at once. A link that fails the check is taken but never shown, and asks nothing. */
+    g_assert_true (nautilus_friends_take_link (friends, uri));
+    g_assert_cmpuint (shown->len, ==, 2);
+    g_assert_true (nautilus_friends_take_link (friends, "shenzhenfiles://friends/link#d.AAAA"));
+    g_assert_cmpuint (shown->len, ==, 2);
+    g_assert_cmpuint (asked, ==, 0);
+
+    /* Friends off: the person is asked, and the link opens once Friends is on again. */
+    set_enabled (FALSE);
+    g_assert_true (nautilus_friends_take_link (friends, uri));
+    g_assert_cmpuint (asked, ==, 1);
+    g_assert_cmpuint (shown->len, ==, 2);
+    set_enabled (TRUE);
+    g_assert_cmpuint (shown->len, ==, 3);
+
+    nautilus_friends_free (friends);
+    g_ptr_array_unref (shown);
+}
+
+/* ---- Copy Download Link ----------------------------------------------------------------------------------------- */
+
+static void
+test_menu_items (void)
+{
+    g_autoptr (GMenu) menu = g_menu_new ();
+    g_autoptr (GMenuModel) section = NULL, expiry = NULL;
+    g_autofree char *label = NULL;
+    const int days[] = { 7, 1, 30 };
+    const char *titles[] = { "For 7 Days", "For 1 Day", "For 30 Days" };
+
+    g_autofree char *submenu_action = NULL, *submenu_hidden = NULL;
+
+    nautilus_friends_add_link_items (menu, "Site photos.pdf");
+    g_assert_cmpint (g_menu_model_get_n_items (G_MENU_MODEL (menu)), ==, 0);
+
+    nautilus_friends_add_link_items (menu, "/Users/raph/Site photos.pdf");
+    g_assert_cmpint (g_menu_model_get_n_items (G_MENU_MODEL (menu)), ==, 1);
+    section = g_menu_model_get_item_link (G_MENU_MODEL (menu), 0, G_MENU_LINK_SECTION);
+    g_assert_nonnull (section);
+    g_assert_true (g_menu_model_get_item_attribute (section, 0, G_MENU_ATTRIBUTE_LABEL, "s", &label));
+    g_assert_cmpstr (label, ==, "Copy Download Link");
+    /* Built once, it shows and hides with its action. */
+    g_assert_true (g_menu_model_get_item_attribute (section, 0, G_MENU_ATTRIBUTE_ACTION, "s", &submenu_action));
+    g_assert_cmpstr (submenu_action, ==, "app." NAUTILUS_FRIENDS_LINKS_ACTION);
+    g_assert_true (g_menu_model_get_item_attribute (section, 0, "hidden-when", "s", &submenu_hidden));
+    g_assert_cmpstr (submenu_hidden, ==, "action-disabled");
+    expiry = g_menu_model_get_item_link (section, 0, G_MENU_LINK_SUBMENU);
+    g_assert_cmpint (g_menu_model_get_n_items (expiry), ==, 3);
+    for (int i = 0; i < 3; i++)
+    {
+        g_autofree char *title = NULL, *action = NULL, *hidden = NULL;
+        g_autoptr (GVariant) target = g_menu_model_get_item_attribute_value (expiry, i, G_MENU_ATTRIBUTE_TARGET,
+                                                                             G_VARIANT_TYPE ("(si)"));
+        const char *path = NULL;
+        gint32 chosen = 0;
+
+        g_assert_true (g_menu_model_get_item_attribute (expiry, i, G_MENU_ATTRIBUTE_LABEL, "s", &title));
+        g_assert_true (g_menu_model_get_item_attribute (expiry, i, G_MENU_ATTRIBUTE_ACTION, "s", &action));
+        g_assert_cmpstr (title, ==, titles[i]);
+        g_assert_cmpstr (action, ==, "app." NAUTILUS_FRIENDS_COPY_LINK_ACTION);
+        g_assert_true (g_menu_model_get_item_attribute (expiry, i, "hidden-when", "s", &hidden));
+        g_assert_cmpstr (hidden, ==, "action-disabled");
+        g_assert_nonnull (target);
+        g_variant_get (target, "(&si)", &path, &chosen);
+        g_assert_cmpstr (path, ==, "/Users/raph/Site photos.pdf");
+        g_assert_cmpint (chosen, ==, days[i]);
+    }
+}
+
+/* ---- The item follows the helper's offer ------------------------------------------------------------------------- */
+
+static gboolean offering;
+static NautilusFriendsLinksChanged links_changed;
+static gpointer links_changed_data;
+static guint watches, unwatches;
+
+static gboolean offers (SZFriendsGtkLink *link) { g_assert_true (link == LINK); return offering; }
+
+static guint
+watch (SZFriendsGtkLink            *link,
+       NautilusFriendsLinksChanged  changed,
+       gpointer                     data)
+{
+    g_assert_true (link == LINK);
+    g_assert_null (links_changed);
+    links_changed = changed;
+    links_changed_data = data;
+    return ++watches;
+}
+
+static void
+unwatch (SZFriendsGtkLink *link,
+         guint             id)
+{
+    g_assert_true (link == LINK);
+    g_assert_cmpuint (id, ==, watches);
+    links_changed = NULL;
+    unwatches++;
+}
+
+static void
+flip_offer (gboolean now)
+{
+    offering = now;
+    g_assert_nonnull (links_changed);
+    links_changed (links_changed_data);
+}
+
+static void
+assert_offered (GActionGroup *actions,
+                gboolean      offered)
+{
+    g_assert_true (g_action_group_has_action (actions, NAUTILUS_FRIENDS_LINKS_ACTION));
+    g_assert_true (g_action_group_has_action (actions, NAUTILUS_FRIENDS_COPY_LINK_ACTION));
+    g_assert_cmpint (g_action_group_get_action_enabled (actions, NAUTILUS_FRIENDS_LINKS_ACTION), ==, offered);
+    g_assert_cmpint (g_action_group_get_action_enabled (actions, NAUTILUS_FRIENDS_COPY_LINK_ACTION), ==, offered);
+}
+
+static void
+test_item_follows_offer (void)
+{
+    static const NautilusFriendsOps offering_ops =
+    {
+        .spawn_at_launch = nothing, .prepare_signing = nothing, .link_new = new_link, .link_start = start,
+        .link_stop = stop, .link_free = start, .add_window = add_window, .offers_links = offers,
+        .watch_links = watch, .unwatch_links = unwatch,
+    };
+    g_autoptr (GSimpleActionGroup) group = g_simple_action_group_new ();
+    GActionGroup *actions = G_ACTION_GROUP (group);
+    NautilusFriends *friends;
+
+    offering = FALSE;
+    links_changed = NULL;
+    watches = unwatches = 0;
+    set_enabled (TRUE);
+    friends = nautilus_friends_new (&offering_ops, nautilus_preferences);
+    nautilus_friends_set_actions (friends, G_ACTION_MAP (group));
+    assert_offered (actions, FALSE);
+
+    /* Attached: nothing offered until the helper says so, then the item follows each change. */
+    nautilus_friends_first_paint (friends);
+    g_assert_cmpuint (watches, ==, 1);
+    assert_offered (actions, FALSE);
+    flip_offer (TRUE);
+    assert_offered (actions, TRUE);
+    flip_offer (FALSE);
+    assert_offered (actions, FALSE);
+    flip_offer (TRUE);
+
+    /* Friends off: the item goes with it, and comes back once the helper offers links again. */
+    set_enabled (FALSE);
+    g_assert_cmpuint (unwatches, ==, 1);
+    assert_offered (actions, FALSE);
+    set_enabled (TRUE);
+    g_assert_cmpuint (watches, ==, 2);
+    assert_offered (actions, TRUE);
+    flip_offer (FALSE);
+    assert_offered (actions, FALSE);
+
+    nautilus_friends_free (friends);
+    g_assert_cmpuint (unwatches, ==, 2);
+}
+
+void
+friends_test_add_link_tests (void)
+{
+    g_test_add_func ("/friends/links/payloads", test_payloads);
+    g_test_add_func ("/friends/links/opening", test_opening);
+    g_test_add_func ("/friends/links/menu-items", test_menu_items);
+    g_test_add_func ("/friends/links/item-follows-offer", test_item_follows_offer);
+}
diff --git a/test/friends/test-nautilus-friends-menu.c b/test/friends/test-nautilus-friends-menu.c
new file mode 100644
index 0000000..498ab8d
--- /dev/null
+++ b/test/friends/test-nautilus-friends-menu.c
@@ -0,0 +1,177 @@
+/*
+ * test-nautilus-friends-menu.c: "Copy Download Link" in a selection menu built the way nautilus-files-view.c builds
+ * it: gtk_popover_menu_new_from_model (NULL), then the selection's model, with the items
+ * nautilus_friends_add_link_items appends and the actions on "app", as Files' application holds them.
+ *
+ * Checked through GTK's own menu widgets, never mapped: the item shows and hides with the helper's offer while the
+ * menu exists, and clicking it opens its expiry choice instead of closing the menu.
+ */
+
+#include <nautilus-friends.h>
+#include <nautilus-friends-private.h>
+
+#include "test-nautilus-friends-probe.h"
+
+#define LINK_LABEL "Copy Download Link"
+
+/* Every GtkModelButton under @widget whose text is @text. */
+static void
+find_buttons (GtkWidget  *widget,
+              const char *text,
+              GPtrArray  *found)
+{
+    GType model_button = g_type_from_name ("GtkModelButton");
+
+    if (model_button != 0 && G_TYPE_CHECK_INSTANCE_TYPE (widget, model_button))
+    {
+        g_autofree char *label = NULL;
+
+        g_object_get (widget, "text", &label, NULL);
+        if (g_strcmp0 (label, text) == 0)
+        {
+            g_ptr_array_add (found, widget);
+        }
+    }
+    for (GtkWidget *child = gtk_widget_get_first_child (widget); child != NULL;
+         child = gtk_widget_get_next_sibling (child))
+    {
+        find_buttons (child, text, found);
+    }
+}
+
+/* The one item labelled @text that the menu's page @name shows, or NULL when it shows none. A submenu's page also
+ * has a button with the submenu's label: the one that goes back. */
+static GtkWidget *
+shown_item (GtkStack   *stack,
+            const char *name,
+            const char *text)
+{
+    GtkWidget *menu = stack != NULL ? gtk_stack_get_child_by_name (stack, name) : NULL;
+    g_autoptr (GPtrArray) found = g_ptr_array_new ();
+    GtkWidget *shown = NULL;
+
+    if (menu == NULL)
+    {
+        return NULL;
+    }
+    find_buttons (menu, text, found);
+    for (guint i = 0; i < found->len; i++)
+    {
+        GtkWidget *button = g_ptr_array_index (found, i);
+        gboolean visible = TRUE;
+
+        for (GtkWidget *w = button; w != NULL && w != menu; w = gtk_widget_get_parent (w))
+        {
+            visible = visible && gtk_widget_get_visible (w);
+        }
+        if (visible)
+        {
+            EXPECT (shown == NULL, "page %s shows \"%s\" once", name, text);
+            shown = button;
+        }
+    }
+    return shown;
+}
+
+static GtkStack *
+find_stack (GtkWidget *widget)
+{
+    if (GTK_IS_STACK (widget))
+    {
+        return GTK_STACK (widget);
+    }
+    for (GtkWidget *child = gtk_widget_get_first_child (widget); child != NULL;
+         child = gtk_widget_get_next_sibling (child))
+    {
+        GtkStack *stack = find_stack (child);
+
+        if (stack != NULL)
+        {
+            return stack;
+        }
+    }
+    return NULL;
+}
+
+static int copies;
+
+static void
+count_copy (GSimpleAction *action,
+            GVariant      *parameter,
+            gpointer       data)
+{
+    (void) action;
+    (void) parameter;
+    (void) data;
+    copies++;
+}
+
+void
+probe_menu (void)
+{
+    g_autoptr (GSimpleActionGroup) app = g_simple_action_group_new ();
+    g_autoptr (GMenu) model = g_menu_new ();
+    g_autoptr (GMenu) open = g_menu_new ();
+    GtkWidget *box = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+    GtkWidget *window = probe_window (box);
+    GtkWidget *menu, *item;
+    GtkStack *stack;
+
+    /* As in Files: the actions exist, disabled, before any selection menu is built. */
+    nautilus_friends_sync_link_actions (G_ACTION_MAP (app), FALSE);
+    gtk_widget_insert_action_group (window, "app", G_ACTION_GROUP (app));
+
+    g_menu_append (open, "Open", "app.probe-open");
+    g_menu_append_section (model, NULL, G_MENU_MODEL (open));
+    nautilus_friends_add_link_items (model, "/tmp/report.pdf");
+
+    menu = gtk_popover_menu_new_from_model (NULL);
+    gtk_widget_set_parent (menu, box);
+    gtk_popover_set_has_arrow (GTK_POPOVER (menu), FALSE);
+    gtk_popover_menu_set_menu_model (GTK_POPOVER_MENU (menu), G_MENU_MODEL (model));
+    probe_pump ();
+
+    stack = find_stack (menu);
+    EXPECT (stack != NULL, "the menu has its stack of pages");
+    EXPECT (shown_item (stack, "main", LINK_LABEL) == NULL,
+            "\"" LINK_LABEL "\" hidden while the helper offers no links");
+
+    /* The helper starts offering links while the menu exists. */
+    nautilus_friends_sync_link_actions (G_ACTION_MAP (app), TRUE);
+    probe_pump ();
+    item = shown_item (stack, "main", LINK_LABEL);
+    EXPECT (item != NULL, "\"" LINK_LABEL "\" shows once the helper offers links");
+    EXPECT (item != NULL && gtk_widget_get_sensitive (item), "\"" LINK_LABEL "\" can be clicked");
+
+    /* Clicked as a person would: the expiry choice opens, and the menu stays up. */
+    gtk_widget_set_visible (menu, TRUE);
+    if (item != NULL)
+    {
+        g_signal_emit_by_name (item, "clicked");
+    }
+    probe_pump ();
+    EXPECT (gtk_widget_get_visible (menu), "clicking \"" LINK_LABEL "\" keeps the menu open");
+    EXPECT (stack != NULL && g_strcmp0 (gtk_stack_get_visible_child_name (stack), LINK_LABEL) == 0,
+            "clicking \"" LINK_LABEL "\" opens its expiry choice (page shown: %s)",
+            stack != NULL ? gtk_stack_get_visible_child_name (stack) : "none");
+
+    /* A choice copies: app.friends-copy-download-link with the file and the days. */
+    g_signal_connect (g_action_map_lookup_action (G_ACTION_MAP (app), NAUTILUS_FRIENDS_COPY_LINK_ACTION),
+                      "activate", G_CALLBACK (count_copy), NULL);
+    item = shown_item (stack, LINK_LABEL, "For 7 Days");
+    EXPECT (item != NULL, "\"For 7 Days\" is offered");
+    if (item != NULL)
+    {
+        g_signal_emit_by_name (item, "clicked");
+    }
+    probe_pump ();
+    EXPECT (copies == 1, "\"For 7 Days\" asks for a link once, asked %d times", copies);
+
+    /* The helper stops offering links: the item goes, even from a menu already built. */
+    nautilus_friends_sync_link_actions (G_ACTION_MAP (app), FALSE);
+    probe_pump ();
+    EXPECT (shown_item (stack, "main", LINK_LABEL) == NULL, "\"" LINK_LABEL "\" hidden again");
+
+    gtk_widget_unparent (menu);
+    gtk_window_destroy (GTK_WINDOW (window));
+}
diff --git a/test/friends/test-nautilus-friends-placement.c b/test/friends/test-nautilus-friends-placement.c
new file mode 100644
index 0000000..708961b
--- /dev/null
+++ b/test/friends/test-nautilus-friends-placement.c
@@ -0,0 +1,500 @@
+/*
+ * test-nautilus-friends-placement.c: where a window's Friends button sits, offscreen.
+ *
+ * A window built like nautilus-window.blp (the split view, the sidebar's header bar, the content's NautilusToolbar
+ * and the narrow breakpoint's setters), whose button the real views' link installs through the placement code a
+ * Files window uses (nautilus_friends_place_button). While the sidebar shows, the button is the last item of the
+ * sidebar's header bar, right of the window buttons and before the main view; while it is hidden, it is at the
+ * start of the content's header bar, right after the window buttons and the sidebar toggle. One button at a time,
+ * the same widget throughout, its popover still its own after each move, and none at all with Friends off.
+ */
+
+#include <string.h>
+
+#include <nautilus-application.h>
+#include <nautilus-friends.h>
+#include <nautilus-friends-private.h>
+#include <nautilus-toolbar.h>
+
+#include "test-nautilus-friends-probe.h"
+
+/* The header bars and some of the sidebar under them. */
+#define RENDER_HEIGHT 140
+
+typedef struct
+{
+    GtkWidget *window, *split_view, *sidebar_header_bar;
+    NautilusToolbar *toolbar;
+    int toolbar_empty_bins;        /* the toolbar's own placeholders, before any Friends button */
+} Frame;
+
+static int empty_bins (GtkWidget *widget);
+
+/* ---- A window like nautilus-window.blp ------------------------------------------------------------------------ */
+
+static void
+frame_install (gpointer   host_data,
+               GtkWindow *window,
+               GtkWidget *button)
+{
+    Frame *frame = g_object_get_data (G_OBJECT (window), "frame");
+
+    nautilus_friends_place_button (frame->split_view, frame->sidebar_header_bar, GTK_WIDGET (frame->toolbar), button);
+}
+
+static void
+frame_remove (gpointer   host_data,
+              GtkWindow *window,
+              GtkWidget *button)
+{
+    Frame *frame = g_object_get_data (G_OBJECT (window), "frame");
+
+    if (nautilus_friends_placed_button (frame->split_view) == button)
+    {
+        nautilus_friends_place_button (frame->split_view, frame->sidebar_header_bar, GTK_WIDGET (frame->toolbar),
+                                       NULL);
+    }
+}
+
+static void
+frame_init (Frame      *frame,
+            GMenuModel *menu)
+{
+    GtkWidget *sidebar = adw_toolbar_view_new (), *content = adw_toolbar_view_new ();
+
+    frame->split_view = adw_overlay_split_view_new ();
+    g_object_set (frame->split_view, "min-sidebar-width", 180.0, "max-sidebar-width", 240.0,
+                  "sidebar-width-unit", ADW_LENGTH_UNIT_PX, "sidebar-width-fraction", 0.999, NULL);
+    frame->sidebar_header_bar = adw_header_bar_new ();
+    adw_header_bar_set_show_title (ADW_HEADER_BAR (frame->sidebar_header_bar), FALSE);
+    gtk_widget_add_css_class (frame->sidebar_header_bar, "flat");
+    adw_toolbar_view_add_top_bar (ADW_TOOLBAR_VIEW (sidebar), frame->sidebar_header_bar);
+    adw_toolbar_view_set_content (ADW_TOOLBAR_VIEW (sidebar), gtk_box_new (GTK_ORIENTATION_VERTICAL, 0));
+    frame->toolbar = g_object_new (NAUTILUS_TYPE_TOOLBAR, "show-view-controls", TRUE, "show-history-controls", TRUE,
+                                   "show-app-menu-button", TRUE, "show-end-search-button", TRUE,
+                                   "show-friends-button", TRUE, "app-menu-model", menu, NULL);
+    g_object_bind_property (frame->split_view, "show-sidebar", frame->toolbar, "sidebar-button-active",
+                            G_BINDING_SYNC_CREATE | G_BINDING_BIDIRECTIONAL);
+    adw_toolbar_view_add_top_bar (ADW_TOOLBAR_VIEW (content), GTK_WIDGET (frame->toolbar));
+    adw_toolbar_view_set_content (ADW_TOOLBAR_VIEW (content), gtk_box_new (GTK_ORIENTATION_VERTICAL, 0));
+    adw_overlay_split_view_set_sidebar (ADW_OVERLAY_SPLIT_VIEW (frame->split_view), sidebar);
+    adw_overlay_split_view_set_content (ADW_OVERLAY_SPLIT_VIEW (frame->split_view), content);
+
+    frame->window = probe_window (frame->split_view);
+    gtk_widget_add_css_class (frame->window, "view");
+    /* Drawn as the window in front: never mapped, it would otherwise draw its traffic lights grey. */
+    gtk_widget_unset_state_flags (frame->window, GTK_STATE_FLAG_BACKDROP);
+    g_object_set_data (G_OBJECT (frame->window), "frame", frame);
+    frame->toolbar_empty_bins = empty_bins (GTK_WIDGET (frame->toolbar));
+}
+
+/* The setters of nautilus-window.blp's narrow breakpoint (max-width: 682sp), applied directly: an AdwBreakpointBin
+ * hides its child after a change until the next frame, which an unmapped window never gets. */
+static void
+frame_set_narrow (Frame    *frame,
+                  gboolean  narrow)
+{
+    adw_overlay_split_view_set_collapsed (ADW_OVERLAY_SPLIT_VIEW (frame->split_view), narrow);
+    g_object_set (frame->toolbar, "show-sidebar-button", narrow, "show-view-controls", !narrow,
+                  "show-history-controls", !narrow, NULL);
+}
+
+/* GTK draws the window buttons, as nautilus-application.c makes it do on every map and sidebar change (GTK #7964:
+ * AppKit's own buttons hang on macOS 26). */
+static void
+disable_native_window_buttons (GtkWidget *widget)
+{
+    if (GTK_IS_WINDOW_CONTROLS (widget))
+    {
+        gtk_window_controls_set_use_native_controls (GTK_WINDOW_CONTROLS (widget), FALSE);
+    }
+    for (GtkWidget *child = gtk_widget_get_first_child (widget); child != NULL;
+         child = gtk_widget_get_next_sibling (child))
+    {
+        disable_native_window_buttons (child);
+    }
+}
+
+/* At @width, laid out twice as the frames after a change would: a header bar shows or hides its window buttons
+ * when its split view tells it to, after the allocation that saw the change. */
+static void
+frame_layout (Frame *frame,
+              int    width)
+{
+    for (int pass = 0; pass < 2; pass++)
+    {
+        probe_pump ();
+        disable_native_window_buttons (frame->window);
+        probe_layout (frame->window, width, -1);
+    }
+}
+
+/* ---- What a check looks at ------------------------------------------------------------------------------------ */
+
+static gboolean
+bounds_in (GtkWidget       *widget,
+           GtkWidget       *target,
+           graphene_rect_t *out)
+{
+    return widget != NULL && gtk_widget_get_mapped (widget) && gtk_widget_compute_bounds (widget, target, out);
+}
+
+/* The right edge of the shown window buttons at the start of @bar, -1 when there are none. */
+static float
+window_buttons_end (GtkWidget *widget,
+                    GtkWidget *bar)
+{
+    float end = -1;
+    graphene_rect_t bounds;
+
+    if (GTK_IS_WINDOW_CONTROLS (widget) && gtk_window_controls_get_side (GTK_WINDOW_CONTROLS (widget)) ==
+        GTK_PACK_START && !gtk_window_controls_get_empty (GTK_WINDOW_CONTROLS (widget)) &&
+        bounds_in (widget, bar, &bounds) && bounds.size.width > 0)
+    {
+        return bounds.origin.x + bounds.size.width;
+    }
+    for (GtkWidget *child = gtk_widget_get_first_child (widget); child != NULL;
+         child = gtk_widget_get_next_sibling (child))
+    {
+        end = MAX (end, window_buttons_end (child, bar));
+    }
+    return end;
+}
+
+static GtkWidget *
+find_icon (GtkWidget  *widget,
+           const char *icon)
+{
+    if ((GTK_IS_BUTTON (widget) && g_strcmp0 (gtk_button_get_icon_name (GTK_BUTTON (widget)), icon) == 0) ||
+        (GTK_IS_MENU_BUTTON (widget) &&
+         g_strcmp0 (gtk_menu_button_get_icon_name (GTK_MENU_BUTTON (widget)), icon) == 0))
+    {
+        return widget;
+    }
+    for (GtkWidget *child = gtk_widget_get_first_child (widget); child != NULL;
+         child = gtk_widget_get_next_sibling (child))
+    {
+        GtkWidget *found = find_icon (child, icon);
+
+        if (found != NULL)
+        {
+            return found;
+        }
+    }
+    return NULL;
+}
+
+static GtkWidget *
+find_type (GtkWidget *widget,
+           GType      type)
+{
+    if (G_TYPE_CHECK_INSTANCE_TYPE (widget, type))
+    {
+        return widget;
+    }
+    for (GtkWidget *child = gtk_widget_get_first_child (widget); child != NULL;
+         child = gtk_widget_get_next_sibling (child))
+    {
+        GtkWidget *found = find_type (child, type);
+
+        if (found != NULL)
+        {
+            return found;
+        }
+    }
+    return NULL;
+}
+
+/* The badge and the drop target are the button's own: they are there wherever it goes. */
+static gboolean
+has_drop_target (GtkWidget *button)
+{
+    g_autoptr (GListModel) controllers = gtk_widget_observe_controllers (button);
+
+    for (guint i = 0; i < g_list_model_get_n_items (controllers); i++)
+    {
+        g_autoptr (GObject) controller = g_list_model_get_item (controllers, i);
+
+        if (GTK_IS_DROP_TARGET (controller))
+        {
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+/* Shown AdwBins under @widget with nothing in them. */
+static int
+empty_bins (GtkWidget *widget)
+{
+    int count = ADW_IS_BIN (widget) && gtk_widget_get_visible (widget) && adw_bin_get_child (ADW_BIN (widget)) == NULL;
+
+    for (GtkWidget *child = gtk_widget_get_first_child (widget); child != NULL;
+         child = gtk_widget_get_next_sibling (child))
+    {
+        count += empty_bins (child);
+    }
+    return count;
+}
+
+/* Wherever the Friends button is, the search button stays at the end of the main bar, just before the menu. */
+static void
+check_search_at_end (Frame      *frame,
+                     const char *when)
+{
+    GtkWidget *bar = GTK_WIDGET (frame->toolbar);
+    graphene_rect_t search, menu, path;
+
+    EXPECT (bounds_in (find_icon (bar, "edit-find-symbolic"), bar, &search) &&
+            bounds_in (find_icon (bar, "open-menu-symbolic"), bar, &menu) &&
+            bounds_in (find_type (bar, g_type_from_name ("NautilusPathBar")), bar, &path) &&
+            path.origin.x + path.size.width <= search.origin.x &&
+            search.origin.x + search.size.width <= menu.origin.x &&
+            menu.origin.x - (search.origin.x + search.size.width) <= 12,
+            "%s: the search button ends the main bar, after the path bar, just before the menu", when);
+    EXPECT (!bounds_in (find_icon (bar, "nautilus-folder-search-symbolic"), bar, &path),
+            "%s: no second search button", when);
+}
+
+/* Exactly one place holds a button, and it is @button; an empty slot takes no room in either bar. */
+static void
+check_one (Frame      *frame,
+           GtkWidget  *button,
+           const char *when)
+{
+    GtkWidget *in_toolbar = nautilus_toolbar_get_friends_button (frame->toolbar);
+    gboolean in_sidebar = button != NULL && gtk_widget_is_ancestor (button, frame->sidebar_header_bar);
+
+    EXPECT (nautilus_friends_placed_button (frame->split_view) == button, "%s: the window's button", when);
+    EXPECT ((in_toolbar != NULL) + in_sidebar == (button != NULL), "%s: %s", when,
+            button != NULL ? "one button, in one place" : "no button anywhere");
+    EXPECT (in_toolbar == NULL || in_toolbar == button, "%s: the toolbar holds the window's own button", when);
+    EXPECT (in_sidebar || find_type (frame->sidebar_header_bar, GTK_TYPE_MENU_BUTTON) == NULL,
+            "%s: no menu button in the sidebar's bar", when);
+    EXPECT (empty_bins (frame->sidebar_header_bar) == 0 &&
+            empty_bins (GTK_WIDGET (frame->toolbar)) == frame->toolbar_empty_bins, "%s: no empty slot shows", when);
+    if (button != NULL)
+    {
+        EXPECT (gtk_widget_get_root (button) == GTK_ROOT (frame->window) && has_drop_target (button),
+                "%s: the button is in the window with its drop target", when);
+    }
+    check_search_at_end (frame, when);
+}
+
+/* The last item of the sidebar's bar: right of the window buttons, ending where the sidebar ends. */
+static void
+check_in_sidebar (Frame      *frame,
+                  GtkWidget  *button,
+                  gboolean    docked,
+                  const char *when)
+{
+    GtkWidget *bar = frame->sidebar_header_bar;
+    graphene_rect_t own, sidebar, content;
+    float buttons_end = window_buttons_end (bar, bar);
+
+    check_one (frame, button, when);
+    EXPECT (gtk_widget_is_ancestor (button, bar), "%s: the button is in the sidebar's header bar", when);
+    EXPECT (bounds_in (button, bar, &own), "%s: the button is shown", when);
+    EXPECT (buttons_end > 0, "%s: the sidebar's bar shows the window buttons", when);
+    EXPECT (own.size.width >= 24 && own.origin.x >= buttons_end, "%s: the button (x %.0f, width %.0f) is right of "
+            "the window buttons (end %.0f)", when, own.origin.x, own.size.width, buttons_end);
+    EXPECT (own.origin.x + own.size.width <= gtk_widget_get_width (bar) &&
+            gtk_widget_get_width (bar) - (own.origin.x + own.size.width) <= 12,
+            "%s: the button ends %.0f px before the sidebar's edge", when,
+            gtk_widget_get_width (bar) - (own.origin.x + own.size.width));
+    if (docked && bounds_in (bar, frame->split_view, &sidebar) &&
+        bounds_in (GTK_WIDGET (frame->toolbar), frame->split_view, &content))
+    {
+        EXPECT (sidebar.origin.x + sidebar.size.width <= content.origin.x + 1,
+                "%s: the main view starts after the sidebar's bar", when);
+    }
+}
+
+/* The start of the content's bar: after the window buttons and the sidebar toggle, before everything else. */
+static void
+check_in_toolbar (Frame      *frame,
+                  GtkWidget  *button,
+                  gboolean    with_toggle,
+                  const char *when)
+{
+    GtkWidget *bar = GTK_WIDGET (frame->toolbar);
+    GtkWidget *toggle = find_icon (bar, "sidebar-show-symbolic");
+    GtkWidget *path_bar = find_type (bar, g_type_from_name ("NautilusPathBar"));
+    graphene_rect_t own, other;
+    float buttons_end = window_buttons_end (bar, bar);
+
+    check_one (frame, button, when);
+    EXPECT (nautilus_toolbar_get_friends_button (frame->toolbar) == button, "%s: the button is in the toolbar",
+            when);
+    EXPECT (bounds_in (button, bar, &own), "%s: the button is shown", when);
+    EXPECT (buttons_end > 0 && own.origin.x >= buttons_end, "%s: the button (x %.0f) is right of the window "
+            "buttons (end %.0f)", when, own.origin.x, buttons_end);
+    EXPECT (with_toggle == bounds_in (toggle, bar, &other), "%s: the sidebar toggle is %s", when,
+            with_toggle ? "shown" : "hidden");
+    if (with_toggle)
+    {
+        EXPECT (other.origin.x + other.size.width <= own.origin.x && own.origin.x - (other.origin.x +
+                other.size.width) <= 12, "%s: the button comes right after the sidebar toggle", when);
+    }
+    EXPECT (own.origin.x - MAX (buttons_end, with_toggle ? other.origin.x + other.size.width : 0) <= 20,
+            "%s: nothing comes between them and the button", when);
+    EXPECT (bounds_in (path_bar, bar, &other) && own.origin.x + own.size.width <= other.origin.x,
+            "%s: the path bar is right of the button", when);
+}
+
+/* The menu button's popover stays its own across a move, open as it was. */
+static void
+check_popover_moves (Frame     *frame,
+                     GtkWidget *button)
+{
+    GtkMenuButton *menu = GTK_MENU_BUTTON (find_type (button, GTK_TYPE_MENU_BUTTON));
+    GtkPopover *popover;
+
+    gtk_menu_button_popup (menu);
+    popover = gtk_menu_button_get_popover (menu);
+    EXPECT (popover != NULL && gtk_widget_get_visible (GTK_WIDGET (popover)), "the dropdown opens");
+    adw_overlay_split_view_set_show_sidebar (ADW_OVERLAY_SPLIT_VIEW (frame->split_view), FALSE);
+    frame_layout (frame, 900);
+    EXPECT (gtk_menu_button_get_popover (menu) == popover && gtk_widget_get_parent (GTK_WIDGET (popover)) ==
+            GTK_WIDGET (menu) && gtk_widget_get_visible (GTK_WIDGET (popover)) &&
+            gtk_widget_is_ancestor (GTK_WIDGET (menu), GTK_WIDGET (frame->toolbar)),
+            "moved to the toolbar, the open dropdown is still the button's");
+    adw_overlay_split_view_set_show_sidebar (ADW_OVERLAY_SPLIT_VIEW (frame->split_view), TRUE);
+    frame_layout (frame, 900);
+    EXPECT (gtk_menu_button_get_popover (menu) == popover && gtk_widget_get_visible (GTK_WIDGET (popover)) &&
+            gtk_widget_is_ancestor (GTK_WIDGET (menu), frame->sidebar_header_bar),
+            "moved back to the sidebar, the open dropdown is still the button's");
+    gtk_menu_button_popdown (menu);
+    probe_pump ();
+}
+
+/* ---- The probe ------------------------------------------------------------------------------------------------ */
+
+static void
+probe_dark (SZFriendsGtkLink *link,
+            GMenuModel       *menu)
+{
+    Frame frame;
+    GtkWidget *button;
+
+    probe_set_dark (TRUE);
+    frame_init (&frame, menu);
+    szfriends_gtk_link_add_window (link, GTK_WINDOW (frame.window));
+    button = nautilus_friends_placed_button (frame.split_view);
+    frame_layout (&frame, 900);
+    check_in_sidebar (&frame, button, TRUE, "dark");
+    probe_render (frame.window, 900, RENDER_HEIGHT, "window-sidebar-shown-dark");
+    adw_overlay_split_view_set_show_sidebar (ADW_OVERLAY_SPLIT_VIEW (frame.split_view), FALSE);
+    frame_layout (&frame, 900);
+    check_in_toolbar (&frame, button, FALSE, "dark, sidebar hidden");
+    probe_render (frame.window, 900, RENDER_HEIGHT, "window-sidebar-hidden-dark");
+    szfriends_gtk_link_remove_window (link, GTK_WINDOW (frame.window));
+    check_one (&frame, NULL, "dark, remove_window");
+    gtk_window_destroy (GTK_WINDOW (frame.window));
+    probe_set_dark (FALSE);
+}
+
+void
+probe_placement (void)
+{
+    static NautilusFriendsBundle bundle = { .app_version = "26.9.14" };
+    g_autoptr (GMenu) menu = g_menu_new ();
+    SZFriendsGtkHost host;
+    SZFriendsGtkLink *link;
+    GtkWidget *button;
+    Frame frame;
+
+    /* The app's chrome: window buttons at the top left, drawn as traffic lights. No animations: an unmapped
+     * window has no frame clock, so the sidebar would stop halfway through sliding in or out. */
+    nautilus_application_setup_macos_window_chrome ();
+    g_object_set (gtk_settings_get_default (), "gtk-enable-animations", FALSE, NULL);
+    probe_set_dark (FALSE);
+    g_menu_append (menu, "Preferences", "app.preferences");
+    frame_init (&frame, G_MENU_MODEL (menu));
+    frame_layout (&frame, 900);
+    check_one (&frame, NULL, "before Friends attaches");
+    probe_render (frame.window, 900, RENDER_HEIGHT, "window-friends-off-light");
+
+    /* The app's host description, with placement aimed at this window. */
+    nautilus_friends_host_init (&host, &bundle, NULL);
+    host.install_button = frame_install;
+    host.remove_button = frame_remove;
+    link = szfriends_gtk_link_new (&host);
+    EXPECT (link != NULL, "the views take Files' host description");
+    szfriends_gtk_link_start (link);
+    szfriends_gtk_link_add_window (link, GTK_WINDOW (frame.window));
+    probe_pump ();
+    button = nautilus_friends_placed_button (frame.split_view);
+    EXPECT (button != NULL, "Friends on: the window has a button");
+    if (button == NULL)
+    {
+        szfriends_gtk_link_free (link);
+        gtk_window_destroy (GTK_WINDOW (frame.window));
+        return;
+    }
+    frame_layout (&frame, 900);
+    check_in_sidebar (&frame, button, TRUE, "wide");
+    probe_render (frame.window, 900, RENDER_HEIGHT, "window-sidebar-shown-light");
+    check_popover_moves (&frame, button);
+
+    /* The sidebar hidden in a wide window. */
+    adw_overlay_split_view_set_show_sidebar (ADW_OVERLAY_SPLIT_VIEW (frame.split_view), FALSE);
+    frame_layout (&frame, 900);
+    check_in_toolbar (&frame, button, FALSE, "wide, sidebar hidden");
+    probe_render (frame.window, 900, RENDER_HEIGHT, "window-sidebar-hidden-light");
+    /* Only the browser window's toolbar shows it. */
+    g_object_set (frame.toolbar, "show-friends-button", FALSE, NULL);
+    EXPECT (!gtk_widget_get_visible (gtk_widget_get_parent (button)), "show-friends-button off hides the slot");
+    g_object_set (frame.toolbar, "show-friends-button", TRUE, NULL);
+    adw_overlay_split_view_set_show_sidebar (ADW_OVERLAY_SPLIT_VIEW (frame.split_view), TRUE);
+    frame_layout (&frame, 900);
+    check_in_sidebar (&frame, button, TRUE, "wide, sidebar shown again");
+
+    /* Narrow: the breakpoint collapses the split view, which hides the sidebar; the sidebar toggle shows. */
+    frame_set_narrow (&frame, TRUE);
+    frame_layout (&frame, 500);
+    check_in_toolbar (&frame, button, TRUE, "narrow");
+    probe_render (frame.window, 500, RENDER_HEIGHT, "window-narrow-light");
+    /* The sidebar shown over the files: its bar covers the start of the main one, so the button goes with it. */
+    adw_overlay_split_view_set_show_sidebar (ADW_OVERLAY_SPLIT_VIEW (frame.split_view), TRUE);
+    frame_layout (&frame, 500);
+    check_in_sidebar (&frame, button, FALSE, "narrow, sidebar shown over the files");
+    probe_render (frame.window, 500, RENDER_HEIGHT, "window-narrow-sidebar-shown-light");
+    adw_overlay_split_view_set_show_sidebar (ADW_OVERLAY_SPLIT_VIEW (frame.split_view), FALSE);
+    frame_layout (&frame, 500);
+    check_in_toolbar (&frame, button, TRUE, "narrow, sidebar hidden again");
+    /* Wide again: the split view shows the sidebar, and the button goes back. */
+    frame_set_narrow (&frame, FALSE);
+    frame_layout (&frame, 900);
+    check_in_sidebar (&frame, button, TRUE, "wide again");
+    EXPECT (nautilus_friends_placed_button (frame.split_view) == button, "the same button throughout");
+
+    probe_dark (link, G_MENU_MODEL (menu));
+
+    /* Turned off: link_stop(TRUE) takes the button away, from wherever it is. */
+    adw_overlay_split_view_set_show_sidebar (ADW_OVERLAY_SPLIT_VIEW (frame.split_view), FALSE);
+    szfriends_gtk_link_stop (link, TRUE);
+    probe_pump ();
+    frame_layout (&frame, 900);
+    check_one (&frame, NULL, "Friends off, sidebar hidden");
+    adw_overlay_split_view_set_show_sidebar (ADW_OVERLAY_SPLIT_VIEW (frame.split_view), TRUE);
+    frame_layout (&frame, 900);
+    check_one (&frame, NULL, "Friends off, sidebar shown");
+    probe_render (frame.window, 900, RENDER_HEIGHT, "window-friends-off-again-light");
+
+    /* Turned on again: it comes back, in the sidebar's bar. */
+    szfriends_gtk_link_start (link);
+    szfriends_gtk_link_add_window (link, GTK_WINDOW (frame.window));
+    probe_pump ();
+    button = nautilus_friends_placed_button (frame.split_view);
+    EXPECT (button != NULL, "Friends on again: the button is back");
+    frame_layout (&frame, 900);
+    if (button != NULL)
+    {
+        check_in_sidebar (&frame, button, TRUE, "on again");
+    }
+
+    szfriends_gtk_link_free (link);
+    gtk_window_destroy (GTK_WINDOW (frame.window));
+    probe_pump ();
+}
diff --git a/test/friends/test-nautilus-friends-preferences.c b/test/friends/test-nautilus-friends-preferences.c
new file mode 100644
index 0000000..e9fb670
--- /dev/null
+++ b/test/friends/test-nautilus-friends-preferences.c
@@ -0,0 +1,328 @@
+/*
+ * test-nautilus-friends-preferences.c: the Friends page of Files' Preferences, offscreen.
+ *
+ * The switch is bound both ways to friends-enabled and its title is plain text; the disclosure reads as agreed
+ * with ShenzhenPDF, secondary but at 4.5:1 or more in light and dark, and stronger, 7:1 or more, with high contrast
+ * on; the page renders in all four. The views'
+ * Settings section follows the lifecycle: absent until Friends attaches, gone when Friends is turned off, back
+ * with a new one when it is turned on, driven through the real link (never connected to a helper: no helper_path,
+ * and a scratch SZFRIENDS_STATE_DIR).
+ */
+
+#include <math.h>
+#include <string.h>
+
+#include <nautilus-friends.h>
+#include <nautilus-friends-private.h>
+#include <nautilus-global-preferences.h>
+
+#include "test-nautilus-friends-probe.h"
+
+static AdwSwitchRow *
+find_switch_row (GtkWidget *widget)
+{
+    if (ADW_IS_SWITCH_ROW (widget))
+    {
+        return ADW_SWITCH_ROW (widget);
+    }
+    for (GtkWidget *child = gtk_widget_get_first_child (widget); child != NULL;
+         child = gtk_widget_get_next_sibling (child))
+    {
+        AdwSwitchRow *found = find_switch_row (child);
+
+        if (found != NULL)
+        {
+            return found;
+        }
+    }
+    return NULL;
+}
+
+#define DISCLOSURE "Shenzhen Files connects to the Friends server whenever it is open and Friends is on. The " \
+                   "server sees your network address, your Friends ID and when Shenzhen Files is open. It never " \
+                   "sees your name, messages or files."
+
+static GtkWidget *
+find_label (GtkWidget  *widget,
+            const char *text)
+{
+    if (GTK_IS_LABEL (widget) && g_strcmp0 (gtk_label_get_label (GTK_LABEL (widget)), text) == 0)
+    {
+        return widget;
+    }
+    for (GtkWidget *child = gtk_widget_get_first_child (widget); child != NULL;
+         child = gtk_widget_get_next_sibling (child))
+    {
+        GtkWidget *found = find_label (child, text);
+
+        if (found != NULL)
+        {
+            return found;
+        }
+    }
+    return NULL;
+}
+
+static gboolean
+has_label (GtkWidget  *widget,
+           const char *text)
+{
+    GtkWidget *label = find_label (widget, text);
+
+    return label != NULL && !gtk_label_get_use_markup (GTK_LABEL (label));
+}
+
+/* WCAG relative luminance of an sRGB channel triple, 0 to 255 each. */
+static double
+luminance (double r,
+           double g,
+           double b)
+{
+    double c[3] = { r / 255, g / 255, b / 255 };
+
+    for (int i = 0; i < 3; i++)
+    {
+        c[i] = c[i] <= 0.04045 ? c[i] / 12.92 : pow ((c[i] + 0.055) / 1.055, 2.4);
+    }
+    return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
+}
+
+/* The contrast of @label's text with the page: its strongest pixel, where a stem covers it fully, against the
+ * background painted under the render. */
+static double
+text_contrast (GtkWidget *window,
+               GtkWidget *label)
+{
+    GtkWidget *page = gtk_window_get_child (GTK_WINDOW (window));
+    g_autoptr (GdkTexture) texture = probe_texture (window, 640, 420);
+    int width = gdk_texture_get_width (texture), height = gdk_texture_get_height (texture);
+    g_autofree guchar *pixels = g_malloc ((gsize) width * height * 4);
+    graphene_rect_t bounds;
+    GdkRGBA paper;
+    double background, best = 1;
+
+    probe_background (&paper);
+    background = luminance (paper.red * 255, paper.green * 255, paper.blue * 255);
+    if (!gtk_widget_compute_bounds (label, page, &bounds))
+    {
+        return 0;
+    }
+    gdk_texture_download (texture, pixels, (gsize) width * 4); /* B, G, R, A; opaque, so not premultiplied */
+    for (int y = MAX (0, (int) (bounds.origin.y * 2)); y < MIN (height, (int) ((bounds.origin.y +
+                                                                              bounds.size.height) * 2)); y++)
+    {
+        for (int x = MAX (0, (int) (bounds.origin.x * 2)); x < MIN (width, (int) ((bounds.origin.x +
+                                                                                 bounds.size.width) * 2)); x++)
+        {
+            const guchar *p = pixels + ((gsize) y * width + x) * 4;
+            double l = luminance (p[2], p[1], p[0]);
+
+            best = MAX (best, (MAX (l, background) + 0.05) / (MIN (l, background) + 0.05));
+        }
+    }
+    return best;
+}
+
+/* Secondary but readable: at least 4.5:1 against the page, as body text needs, in light and in dark. */
+static double
+check_disclosure_contrast (GtkWidget  *window,
+                           const char *scheme)
+{
+    GtkWidget *label = find_label (gtk_window_get_child (GTK_WINDOW (window)), DISCLOSURE);
+    double contrast = label != NULL ? text_contrast (window, label) : 0;
+
+    EXPECT (contrast >= 4.5, "%s: the disclosure reads at %.2f:1, under 4.5:1", scheme, contrast);
+    EXPECT (contrast < 12, "%s: the disclosure (%.2f:1) is secondary, not as strong as the titles", scheme, contrast);
+    return contrast;
+}
+
+/* libadwaita's own test override of the system setting (exported, not in its installed headers): what Increase
+ * Contrast in macOS turns on, as AdwStyleManager:high-contrast. */
+typedef struct _AdwSettings AdwSettings;
+AdwSettings *adw_settings_get_default (void);
+void         adw_settings_start_override (AdwSettings *self);
+void         adw_settings_override_high_contrast (AdwSettings *self,
+                                                  gboolean     high_contrast);
+void         adw_settings_end_override (AdwSettings *self);
+
+static void
+set_high_contrast (gboolean on)
+{
+    if (on)
+    {
+        adw_settings_start_override (adw_settings_get_default ());
+        adw_settings_override_high_contrast (adw_settings_get_default (), TRUE);
+    }
+    else
+    {
+        adw_settings_end_override (adw_settings_get_default ());
+    }
+    probe_pump ();
+    EXPECT (adw_style_manager_get_high_contrast (adw_style_manager_get_default ()) == on, "high contrast %s",
+            on ? "on" : "off");
+}
+
+/* With high contrast on, the disclosure follows libadwaita's secondary text: stronger than without, 7:1 or more. */
+static void
+check_high_contrast (gboolean dark,
+                     double   normal)
+{
+    const char *scheme = dark ? "dark, high contrast" : "light, high contrast";
+    GtkWidget *window, *label;
+    double contrast;
+
+    set_high_contrast (TRUE);
+    window = probe_window (GTK_WIDGET (nautilus_friends_preferences_page_new ()));
+    label = find_label (gtk_window_get_child (GTK_WINDOW (window)), DISCLOSURE);
+    contrast = label != NULL ? text_contrast (window, label) : 0;
+    EXPECT (contrast >= 7 && contrast > normal + 1, "%s: the disclosure reads at %.2f:1 (%.2f:1 without), under 7:1",
+            scheme, contrast, normal);
+    probe_render (window, 640, 420, dark ? "preferences-friends-dark-high-contrast" :
+                  "preferences-friends-light-high-contrast");
+    gtk_window_destroy (GTK_WINDOW (window));
+    set_high_contrast (FALSE);
+}
+
+static void
+render_page (gboolean    dark,
+             const char *name)
+{
+    GtkWidget *window;
+    double normal;
+
+    probe_set_dark (dark);
+    window = probe_window (GTK_WIDGET (nautilus_friends_preferences_page_new ()));
+    normal = check_disclosure_contrast (window, dark ? "dark" : "light");
+    probe_render (window, 640, 420, name);
+    gtk_window_destroy (GTK_WINDOW (window));
+    check_high_contrast (dark, normal);
+    probe_set_dark (FALSE);
+}
+
+static void
+probe_page (void)
+{
+    AdwPreferencesPage *page = nautilus_friends_preferences_page_new ();
+    GtkWidget *window = probe_window (GTK_WIDGET (page));
+    AdwSwitchRow *row = find_switch_row (GTK_WIDGET (page));
+
+    EXPECT (g_strcmp0 (adw_preferences_page_get_title (page), "Friends") == 0, "the page is titled Friends");
+    EXPECT (row != NULL, "the page has the switch");
+    if (row == NULL)
+    {
+        return;
+    }
+    EXPECT (g_strcmp0 (adw_preferences_row_get_title (ADW_PREFERENCES_ROW (row)), "Enable Shenzhen Friends") == 0,
+            "the switch reads Enable Shenzhen Friends");
+    EXPECT (!adw_preferences_row_get_use_markup (ADW_PREFERENCES_ROW (row)), "the switch's title is plain text");
+    /* What the server sees and what it never sees, in sentences of their own, so neither list reads into the
+     * other ("when Shenzhen Files is open, never your name"); ShenzhenPDF's is split the same way. */
+    EXPECT (has_label (GTK_WIDGET (page), DISCLOSURE),
+            "the disclosure, in plain text, says what the server sees and, apart, what it never sees");
+
+    /* Bound both ways to friends-enabled, on by default. */
+    g_settings_reset (nautilus_preferences, NAUTILUS_PREFERENCES_FRIENDS_ENABLED);
+    probe_pump ();
+    EXPECT (adw_switch_row_get_active (row), "on by default");
+    adw_switch_row_set_active (row, FALSE);
+    probe_pump ();
+    EXPECT (!g_settings_get_boolean (nautilus_preferences, NAUTILUS_PREFERENCES_FRIENDS_ENABLED),
+            "turning the switch off turns Friends off");
+    g_settings_set_boolean (nautilus_preferences, NAUTILUS_PREFERENCES_FRIENDS_ENABLED, TRUE);
+    probe_pump ();
+    EXPECT (adw_switch_row_get_active (row), "the switch follows the setting");
+
+    gtk_window_destroy (GTK_WINDOW (window));
+    render_page (FALSE, "preferences-friends-light");
+    render_page (TRUE, "preferences-friends-dark");
+    probe_pump ();
+}
+
+/* ---- The views' Settings section ---------------------------------------------------------------------------- */
+
+static SZFriendsGtkHost section_host;
+static NautilusFriendsBundle section_bundle = { .app_version = "26.9.14" };
+
+static void
+no_op (void)
+{
+}
+
+static SZFriendsGtkLink *
+section_link_new (void)
+{
+    return szfriends_gtk_link_new (&section_host);
+}
+
+/* The real link; the launch spawn and the signing policy are the app's alone. */
+static const NautilusFriendsOps section_ops =
+{
+    no_op, no_op, section_link_new, szfriends_gtk_link_start, szfriends_gtk_link_stop, szfriends_gtk_link_free,
+    szfriends_gtk_link_add_window, NULL, NULL,
+};
+
+static GtkWidget *
+find_section (GtkWidget *widget)
+{
+    if (g_strcmp0 (gtk_widget_get_name (widget), "szfriends.settings") == 0)
+    {
+        return widget;
+    }
+    for (GtkWidget *child = gtk_widget_get_first_child (widget); child != NULL;
+         child = gtk_widget_get_next_sibling (child))
+    {
+        GtkWidget *found = find_section (child);
+
+        if (found != NULL)
+        {
+            return found;
+        }
+    }
+    return NULL;
+}
+
+static void
+set_enabled (gboolean enabled)
+{
+    g_settings_set_boolean (nautilus_preferences, NAUTILUS_PREFERENCES_FRIENDS_ENABLED, enabled);
+    probe_pump ();
+}
+
+static void
+probe_settings_section (void)
+{
+    AdwPreferencesGroup *group = ADW_PREFERENCES_GROUP (adw_preferences_group_new ());
+    GtkWidget *window = probe_window (GTK_WIDGET (group));
+    NautilusFriends *friends;
+    GtkWidget *first;
+
+    nautilus_friends_host_init (&section_host, &section_bundle, NULL);
+    set_enabled (TRUE);
+    friends = nautilus_friends_new (&section_ops, nautilus_preferences);
+    nautilus_friends_add_settings_group (friends, group);
+    EXPECT (!gtk_widget_get_visible (GTK_WIDGET (group)) && find_section (GTK_WIDGET (group)) == NULL,
+            "before Friends attaches: no section");
+
+    nautilus_friends_first_paint (friends);
+    first = find_section (GTK_WIDGET (group));
+    EXPECT (gtk_widget_get_visible (GTK_WIDGET (group)) && first != NULL, "attached: the views' section is shown");
+
+    set_enabled (FALSE);
+    EXPECT (!gtk_widget_get_visible (GTK_WIDGET (group)) && find_section (GTK_WIDGET (group)) == NULL,
+            "Friends off: the section is gone");
+
+    set_enabled (TRUE);
+    EXPECT (gtk_widget_get_visible (GTK_WIDGET (group)) && find_section (GTK_WIDGET (group)) != NULL,
+            "Friends on again: a section is back");
+
+    nautilus_friends_free (friends);
+    gtk_window_destroy (GTK_WINDOW (window));
+    probe_pump ();
+}
+
+void
+probe_preferences (void)
+{
+    probe_page ();
+    probe_settings_section ();
+}
diff --git a/test/friends/test-nautilus-friends-probe.h b/test/friends/test-nautilus-friends-probe.h
new file mode 100644
index 0000000..2993b53
--- /dev/null
+++ b/test/friends/test-nautilus-friends-probe.h
@@ -0,0 +1,49 @@
+/* test-nautilus-friends-probe.h: shared by the files of test-nautilus-friends-toolbar. */
+
+#pragma once
+
+#include <adwaita.h>
+#include <stdio.h>
+
+/* A failed check is counted and printed, and the probe carries on, so one run reports every failure. */
+extern int probe_failures;
+
+#define EXPECT(condition, ...) \
+    G_STMT_START { \
+        if (!(condition)) \
+        { \
+            probe_failures++; \
+            fprintf (stderr, "FAIL %s:%d: ", __FILE__, __LINE__); \
+            fprintf (stderr, __VA_ARGS__); \
+            fprintf (stderr, "\n"); \
+        } \
+    } G_STMT_END
+
+/* Runs the main loop for 50 ms. */
+void       probe_pump (void);
+/* A window realized for its style, never mapped; the probe maps and allocates @child itself. */
+GtkWidget *probe_window (GtkWidget *child);
+void       probe_layout (GtkWidget *window,
+                         int        width,
+                         int        height);
+/* Light or dark from now on. Widgets take the scheme when created: an unmapped window never restyles. */
+void       probe_set_dark (gboolean dark);
+/* Renders the window's child at scale 2 to <renders>/<name>.png. */
+void        probe_render (GtkWidget  *window,
+                          int         width,
+                          int         height,
+                          const char *name);
+/* The same render, returned; the colour painted under it. */
+GdkTexture *probe_texture (GtkWidget *window,
+                           int        width,
+                           int        height);
+void        probe_background (GdkRGBA *color);
+
+/* test-nautilus-friends-placement.c */
+void       probe_placement (void);
+
+/* test-nautilus-friends-preferences.c */
+void       probe_preferences (void);
+
+/* test-nautilus-friends-menu.c */
+void       probe_menu (void);
diff --git a/test/friends/test-nautilus-friends-toolbar.c b/test/friends/test-nautilus-friends-toolbar.c
new file mode 100644
index 0000000..ef96729
--- /dev/null
+++ b/test/friends/test-nautilus-friends-toolbar.c
@@ -0,0 +1,197 @@
+/*
+ * test-nautilus-friends-toolbar.c: the Friends button in Files' header bars and the Friends Preferences page,
+ * rendered offscreen.
+ *
+ * The real views' link hands a real Friends button to the same placement code a Files window uses, here given a
+ * window built like nautilus-window.blp (test-nautilus-friends-placement.c), since a NautilusWindow needs a
+ * running NautilusApplication. PNGs of the header bars (sidebar shown, hidden, narrow, dark, Friends off) and of
+ * the Preferences page (test-nautilus-friends-preferences.c) go to the directory named on the command line.
+ * Copy Download Link in a selection menu built like Files' own is checked too (test-nautilus-friends-menu.c).
+ *
+ * Needs a logged-in session for GDK's display, never maps a window, and links the Friends views' quiet interposer
+ * (shenzhen-pdf gtk/tests/szfriends_gtk_quiet.c), so GDK never puts this process in the Dock or takes focus. The
+ * link never spawns a helper (no helper_path) and looks for one only in a scratch SZFRIENDS_STATE_DIR.
+ *
+ * Usage: test-nautilus-friends-toolbar <renders dir>; run by tools/test-friends-adapter.sh.
+ */
+
+#include <ApplicationServices/ApplicationServices.h>
+#include <glib/gstdio.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <nautilus-file-utilities.h>
+#include <nautilus-friends.h>
+#include <nautilus-friends-private.h>
+#include <nautilus-global-preferences.h>
+#include <nautilus-resources.h>
+#include <nautilus-toolbar.h>
+
+#include "test-nautilus-friends-probe.h"
+
+int szfriends_gtk_quiet_transform_calls (void); /* the interposer */
+
+int probe_failures;
+static const char *renders;
+
+void
+probe_pump (void)
+{
+    gint64 until = g_get_monotonic_time () + 50 * 1000;
+
+    while (g_get_monotonic_time () < until)
+    {
+        g_main_context_iteration (NULL, FALSE);
+    }
+}
+
+/* Realized for its style, never mapped: the probe maps and allocates the child itself. */
+GtkWidget *
+probe_window (GtkWidget *child)
+{
+    GtkWidget *window = gtk_window_new ();
+
+    gtk_window_set_child (GTK_WINDOW (window), child);
+    gtk_widget_realize (window);
+    return window;
+}
+
+void
+probe_layout (GtkWidget *window,
+              int        width,
+              int        height)
+{
+    GtkWidget *child = gtk_window_get_child (GTK_WINDOW (window));
+    int minimum = 0, natural = 0;
+
+    if (!gtk_widget_get_mapped (child))
+    {
+        gtk_widget_map (child);
+    }
+    gtk_widget_measure (child, GTK_ORIENTATION_VERTICAL, width, &minimum, &natural, NULL, NULL);
+    gtk_widget_allocate (child, width, height > 0 ? MAX (height, minimum) : natural, -1, NULL);
+}
+
+static GskRenderer *
+renderer (void)
+{
+    static GskRenderer *shared;
+
+    if (shared == NULL)
+    {
+        shared = gsk_cairo_renderer_new ();
+        EXPECT (gsk_renderer_realize_for_display (shared, gdk_display_get_default (), NULL), "renderer realized");
+    }
+    return shared;
+}
+
+void
+probe_set_dark (gboolean dark)
+{
+    adw_style_manager_set_color_scheme (adw_style_manager_get_default (),
+                                        dark ? ADW_COLOR_SCHEME_FORCE_DARK : ADW_COLOR_SCHEME_FORCE_LIGHT);
+    probe_pump ();
+}
+
+void
+probe_background (GdkRGBA *color)
+{
+    gboolean dark = adw_style_manager_get_dark (adw_style_manager_get_default ());
+
+    *color = dark ? (GdkRGBA) { 0.14f, 0.14f, 0.15f, 1 } : (GdkRGBA) { 0.98f, 0.98f, 0.98f, 1 };
+}
+
+/* At scale 2, over the window background colour. */
+GdkTexture *
+probe_texture (GtkWidget *window,
+               int        width,
+               int        height)
+{
+    GtkWidget *child = gtk_window_get_child (GTK_WINDOW (window));
+    GtkSnapshot *snapshot = gtk_snapshot_new ();
+    GskRenderNode *node;
+    GdkTexture *texture;
+    GdkRGBA background;
+    int h;
+
+    probe_layout (window, width, height);
+    h = gtk_widget_get_height (child);
+    EXPECT (!gtk_widget_get_mapped (window), "the window itself is never mapped");
+    probe_background (&background);
+    gtk_snapshot_scale (snapshot, 2, 2);
+    gtk_snapshot_append_color (snapshot, &background, &GRAPHENE_RECT_INIT (0, 0, (float) width, (float) h));
+    gtk_widget_snapshot_child (window, child, snapshot);
+    node = gtk_snapshot_free_to_node (snapshot);
+    texture = gsk_renderer_render_texture (renderer (), node,
+                                           &GRAPHENE_RECT_INIT (0, 0, (float) width * 2, (float) h * 2));
+    gsk_render_node_unref (node);
+    return texture;
+}
+
+/* Saves <renders>/<name>.png. */
+void
+probe_render (GtkWidget  *window,
+              int         width,
+              int         height,
+              const char *name)
+{
+    g_autofree char *file = g_strdup_printf ("%s/%s.png", renders, name);
+    GdkTexture *texture = probe_texture (window, width, height);
+
+    EXPECT (gdk_texture_save_to_png (texture, file), "%s written", file);
+    g_object_unref (texture);
+}
+
+int
+main (int   argc,
+      char *argv[])
+{
+    g_autoptr (GError) error = NULL;
+    g_autofree char *state = NULL;
+    int before;
+
+    if (argc != 2)
+    {
+        fprintf (stderr, "usage: %s <renders dir>\n", argv[0]);
+        return 2;
+    }
+    renders = argv[1];
+    g_mkdir_with_parents (renders, 0755);
+
+    /* Before GDK opens the display: prove the interposer will keep this process out of the Dock. */
+    before = szfriends_gtk_quiet_transform_calls ();
+    TransformProcessType (NULL, 0);
+    if (szfriends_gtk_quiet_transform_calls () != before + 1)
+    {
+        fprintf (stderr, "test-nautilus-friends-toolbar: the interposer is not active; not opening a display\n");
+        return 2;
+    }
+    /* The link looks for a helper only here, and finds none. */
+    state = g_dir_make_tmp ("szf-state-XXXXXX", &error);
+    g_assert_no_error (error);
+    g_setenv ("SZFRIENDS_STATE_DIR", state, TRUE);
+
+    if (!gtk_init_check ())
+    {
+        fprintf (stderr, "test-nautilus-friends-toolbar: no display; the probe needs a logged-in session\n");
+        return 1;
+    }
+    adw_init ();
+    EXPECT (szfriends_gtk_quiet_transform_calls () >= before + 2, "GDK's own TransformProcessType was intercepted");
+    nautilus_register_resource ();
+    nautilus_ensure_extension_points ();
+    nautilus_global_preferences_init ();
+
+    probe_placement ();
+    probe_preferences ();
+    probe_menu ();
+
+    g_rmdir (state);
+    if (probe_failures > 0)
+    {
+        fprintf (stderr, "test-nautilus-friends-toolbar: %d failure(s)\n", probe_failures);
+        return 1;
+    }
+    printf ("test-nautilus-friends-toolbar passed\n");
+    return 0;
+}
diff --git a/test/friends/test-nautilus-friends.c b/test/friends/test-nautilus-friends.c
new file mode 100644
index 0000000..0681b0e
--- /dev/null
+++ b/test/friends/test-nautilus-friends.c
@@ -0,0 +1,457 @@
+/*
+ * test-nautilus-friends.c: the Shenzhen Friends host adapter without a display or a helper.
+ *
+ * Here: the host description Shenzhen Files hands the views, where a received file is shown, and the lifecycle
+ * (launch spawn, attach after the first paint, buttons on and off with the preference, shutdown), driven through
+ * counting fakes in place of the views. test-nautilus-friends-files.c covers `#` on a scratch folder, and
+ * test-nautilus-friends-bundle.c the app bundle and the signing policy. Run with tools/test-friends-adapter.sh,
+ * which builds Files with and without Friends first.
+ */
+
+#include "test-nautilus-friends.h"
+
+#include <nautilus-file-utilities.h>
+#include <nautilus-global-preferences.h>
+#include <string.h>
+
+/* ---- The host ------------------------------------------------------------------------------------------------ */
+
+static NautilusFriendsBundle sample_bundle =
+{
+    .app_version = "26.9.14",
+    .helper_path = "/Applications/Shenzhen Files.app/Contents/Helpers/Shenzhen Friends.app/Contents/MacOS/"
+                   "Shenzhen Friends",
+    .helper_version = "26.10.11",
+    .helper_build_number = 26101101,
+    .animals_manifest_path = NULL,
+};
+
+static void
+test_host_description (void)
+{
+    SZFriendsGtkHost host;
+    int host_data;
+
+    memset (&host, 0xA5, sizeof host);
+    nautilus_friends_host_init (&host, &sample_bundle, &host_data);
+
+    /* struct_size is this build's own size, so the views read every member Files sets and none it does not. */
+    g_assert_cmpuint (host.struct_size, ==, sizeof (SZFriendsGtkHost));
+    g_assert_cmpuint (host.struct_size, >=, SZFRIENDS_GTK_HOST_MIN_SIZE);
+    g_assert_true (host.host_data == &host_data);
+
+    g_assert_cmpstr (host.app_id, ==, "com.intuition.shenzhenfiles");
+    g_assert_cmpstr (host.app_name, ==, "Shenzhen Files");
+    g_assert_cmpstr (host.app_version, ==, "26.9.14");
+    g_assert_cmpstr (host.reveal_in_name, ==, "Shenzhen Files");
+    g_assert_cmpstr (host.helper_path, ==, sample_bundle.helper_path);
+    g_assert_cmpstr (host.helper_version, ==, "26.10.11");
+    g_assert_cmpuint (host.helper_build_number, ==, 26101101);
+    g_assert_null (host.animals_manifest_path);
+
+    /* Capabilities come from what Files implements; it opens no format in place. */
+    g_assert_null (host.capabilities);
+    g_assert_nonnull (host.open_formats);
+    g_assert_null (host.open_formats[0]);
+    g_assert_cmpstr (host.attach_placeholder, ==, "Search selected files and this folder");
+
+    g_assert_nonnull (host.install_button);
+    g_assert_nonnull (host.remove_button);
+    g_assert_true (host.attachable_items == nautilus_friends_attachable_items);
+    g_assert_nonnull (host.open_received_file);
+    g_assert_nonnull (host.reveal_file);
+
+    /* Files only: no tab drags, no veto, the views' own look, nothing of ShenzhenPDF's assistant or Markdown. */
+    g_assert_null (host.extra_drop_types);
+    g_assert_cmpuint (host.n_extra_drop_types, ==, 0);
+    g_assert_null (host.items_from_drop);
+    g_assert_null (host.button_accepts_drop);
+    g_assert_null (host.appearance_css);
+    g_assert_cmpint (host.title_bar_button_size, ==, 0);
+    g_assert_cmpint (host.dropdown_width, ==, 0);
+    g_assert_cmpint (host.dropdown_max_height, ==, 0);
+    g_assert_null (host.render_markdown);
+    g_assert_null (host.assistant);
+    g_assert_null (host.services_available);
+    g_assert_null (host.services_unavailable);
+}
+
+static void
+test_host_accepted_by_views (void)
+{
+    SZFriendsGtkHost host;
+    SZFriendsGtkLink *link;
+
+    nautilus_friends_host_init (&host, &sample_bundle, NULL);
+    link = szfriends_gtk_link_new (&host);
+    g_assert_nonnull (link);
+    szfriends_gtk_link_free (link);
+
+    /* An app version is required; outside a bundle the reader supplies PACKAGE_VERSION, never NULL. */
+    host.app_version = NULL;
+    g_assert_null (szfriends_gtk_link_new (&host));
+}
+
+/* ---- Received files ------------------------------------------------------------------------------------------- */
+
+static void
+assert_target (const char *path,
+               const char *folder,
+               const char *selection)
+{
+    g_autoptr (GFile) got_folder = NULL;
+    g_autoptr (GFile) got_selection = NULL;
+    g_autofree char *folder_path = NULL;
+    g_autofree char *selection_path = NULL;
+
+    g_assert_true (nautilus_friends_reveal_target (path, &got_folder, &got_selection));
+    folder_path = g_file_get_path (got_folder);
+    selection_path = got_selection != NULL ? g_file_get_path (got_selection) : NULL;
+    g_assert_cmpstr (folder_path, ==, folder);
+    g_assert_cmpstr (selection_path, ==, selection);
+}
+
+static void
+test_reveal_target (void)
+{
+    GFile *folder = (GFile *) 0x1;
+    GFile *selection = (GFile *) 0x1;
+
+    assert_target ("/Users/mei/Downloads/Shenzhen Friends/Site photos.pdf", "/Users/mei/Downloads/Shenzhen Friends",
+                   "/Users/mei/Downloads/Shenzhen Friends/Site photos.pdf");
+    assert_target ("/Users/mei/Downloads/../Desktop/a.txt", "/Users/mei/Desktop", "/Users/mei/Desktop/a.txt");
+    assert_target ("/", "/", NULL);
+
+    g_assert_false (nautilus_friends_reveal_target (NULL, &folder, &selection));
+    g_assert_null (folder);
+    g_assert_null (selection);
+    g_assert_false (nautilus_friends_reveal_target ("", &folder, &selection));
+    g_assert_false (nautilus_friends_reveal_target ("Downloads/a.pdf", &folder, &selection));
+}
+
+typedef struct
+{
+    guint calls;
+    gpointer host_data;
+    char *folder;
+    char *selection;
+} OpenRecord;
+
+static OpenRecord opened;
+
+static void
+record_open (gpointer  host_data,
+             GFile    *folder,
+             GFile    *selection)
+{
+    opened.calls++;
+    opened.host_data = host_data;
+    g_free (opened.folder);
+    g_free (opened.selection);
+    opened.folder = g_file_get_path (folder);
+    opened.selection = selection != NULL ? g_file_get_path (selection) : NULL;
+}
+
+static void
+test_received_files_show_in_files (void)
+{
+    SZFriendsGtkHost host;
+    int app;
+
+    nautilus_friends_host_init (&host, &sample_bundle, &app);
+    nautilus_friends_host_set_opener (record_open);
+
+    /* "Show in Shenzhen Files": the folder, with the file selected, in this app. */
+    host.reveal_file (host.host_data, NULL, "/Users/mei/Downloads/contract.pdf");
+    g_assert_cmpuint (opened.calls, ==, 1);
+    g_assert_true (opened.host_data == &app);
+    g_assert_cmpstr (opened.folder, ==, "/Users/mei/Downloads");
+    g_assert_cmpstr (opened.selection, ==, "/Users/mei/Downloads/contract.pdf");
+
+    /* "Open" does the same: Files opens nothing in place and never hands a received file to another app. */
+    host.open_received_file (host.host_data, NULL, "/Users/mei/Downloads/notes.md");
+    g_assert_cmpuint (opened.calls, ==, 2);
+    g_assert_cmpstr (opened.folder, ==, "/Users/mei/Downloads");
+    g_assert_cmpstr (opened.selection, ==, "/Users/mei/Downloads/notes.md");
+
+    g_test_expect_message ("nautilus-friends", G_LOG_LEVEL_WARNING, "*absolute path*");
+    host.reveal_file (host.host_data, NULL, "notes.md");
+    g_test_assert_expected_messages ();
+    g_assert_cmpuint (opened.calls, ==, 2);
+
+    nautilus_friends_host_set_opener (NULL);
+    g_clear_pointer (&opened.folder, g_free);
+    g_clear_pointer (&opened.selection, g_free);
+    memset (&opened, 0, sizeof opened);
+}
+
+/* ---- Lifecycle ------------------------------------------------------------------------------------------------ */
+
+typedef struct
+{
+    guint spawn, prepare, link_new, start, stop, stop_disabled, free;
+    GPtrArray *added; /* windows handed to add_window, in order */
+} Calls;
+
+static Calls calls;
+static int fake_link_storage;
+#define FAKE_LINK ((SZFriendsGtkLink *) &fake_link_storage)
+
+static void
+fake_spawn (void)
+{
+    calls.spawn++;
+}
+
+static void
+fake_prepare (void)
+{
+    calls.prepare++;
+}
+
+static SZFriendsGtkLink *
+fake_link_new (void)
+{
+    calls.link_new++;
+    return FAKE_LINK;
+}
+
+static void
+fake_start (SZFriendsGtkLink *link)
+{
+    g_assert_true (link == FAKE_LINK);
+    /* The policy is in place before the first connect. */
+    g_assert_cmpuint (calls.prepare, >, 0);
+    calls.start++;
+}
+
+static void
+fake_stop (SZFriendsGtkLink *link,
+           gboolean          friends_disabled)
+{
+    g_assert_true (link == FAKE_LINK);
+    calls.stop++;
+    calls.stop_disabled += friends_disabled ? 1 : 0;
+}
+
+static void
+fake_free (SZFriendsGtkLink *link)
+{
+    g_assert_true (link == FAKE_LINK);
+    calls.free++;
+}
+
+static void
+fake_add_window (SZFriendsGtkLink *link,
+                 GtkWindow        *window)
+{
+    g_assert_true (link == FAKE_LINK);
+    g_ptr_array_add (calls.added, window);
+}
+
+static const NautilusFriendsOps fake_ops =
+{
+    fake_spawn, fake_prepare, fake_link_new, fake_start, fake_stop, fake_free, fake_add_window, NULL, NULL,
+};
+
+static void
+reset_calls (void)
+{
+    g_clear_pointer (&calls.added, g_ptr_array_unref);
+    memset (&calls, 0, sizeof calls);
+    calls.added = g_ptr_array_new ();
+}
+
+static void
+set_enabled (gboolean enabled)
+{
+    g_settings_set_boolean (nautilus_preferences, NAUTILUS_PREFERENCES_FRIENDS_ENABLED, enabled);
+    while (g_main_context_iteration (NULL, FALSE))
+    {
+    }
+}
+
+/* Windows are only remembered and handed on, so plain objects stand in for them. */
+static GtkWindow *
+fake_window (void)
+{
+    return (GtkWindow *) g_object_new (G_TYPE_OBJECT, NULL);
+}
+
+static void
+test_lifecycle_enabled (void)
+{
+    NautilusFriends *friends;
+    GtkWindow *first = fake_window (), *second = fake_window (), *third = fake_window ();
+
+    reset_calls ();
+    set_enabled (TRUE);
+    friends = nautilus_friends_new (&fake_ops, nautilus_preferences);
+
+    /* Launch: the spawn, and nothing that connects or draws. */
+    nautilus_friends_launch (friends);
+    g_assert_cmpuint (calls.spawn, ==, 1);
+    nautilus_friends_add_window (friends, first);
+    nautilus_friends_add_window (friends, second);
+    nautilus_friends_add_window (friends, first);
+    g_assert_cmpuint (calls.link_new + calls.start + calls.added->len, ==, 0);
+    g_assert_null (nautilus_friends_get_link (friends));
+
+    /* After the first paint: one link, started, and one button per window. */
+    nautilus_friends_first_paint (friends);
+    g_assert_cmpuint (calls.link_new, ==, 1);
+    g_assert_cmpuint (calls.start, ==, 1);
+    g_assert_cmpuint (calls.added->len, ==, 2);
+    g_assert_true (g_ptr_array_index (calls.added, 0) == first);
+    g_assert_true (g_ptr_array_index (calls.added, 1) == second);
+    g_assert_true (nautilus_friends_get_link (friends) == FAKE_LINK);
+    nautilus_friends_first_paint (friends);
+    g_assert_cmpuint (calls.start, ==, 1);
+
+    /* A window opened later gets its button at once. */
+    nautilus_friends_add_window (friends, third);
+    g_assert_cmpuint (calls.added->len, ==, 3);
+
+    /* Turned off: `disable` and every button removed, by link_stop(link, TRUE). */
+    set_enabled (FALSE);
+    g_assert_cmpuint (calls.stop, ==, 1);
+    g_assert_cmpuint (calls.stop_disabled, ==, 1);
+    g_assert_null (nautilus_friends_get_link (friends));
+
+    /* A window closed while Friends was off does not come back. */
+    g_object_unref (second);
+    g_ptr_array_set_size (calls.added, 0);
+
+    /* Turned on again: the same link restarts and the open windows get buttons again. */
+    set_enabled (TRUE);
+    g_assert_cmpuint (calls.link_new, ==, 1);
+    g_assert_cmpuint (calls.start, ==, 2);
+    g_assert_cmpuint (calls.added->len, ==, 2);
+    g_assert_true (g_ptr_array_index (calls.added, 0) == first);
+    g_assert_true (g_ptr_array_index (calls.added, 1) == third);
+    set_enabled (TRUE);
+    g_assert_cmpuint (calls.start, ==, 2);
+
+    /* Shutdown: freed, never stopped with `disable`. */
+    nautilus_friends_free (friends);
+    g_assert_cmpuint (calls.free, ==, 1);
+    g_assert_cmpuint (calls.stop, ==, 1);
+    g_assert_cmpuint (calls.spawn, ==, 1);
+
+    /* Nothing listens any more. */
+    set_enabled (FALSE);
+    g_assert_cmpuint (calls.stop, ==, 1);
+    g_object_unref (first);
+    g_object_unref (third);
+}
+
+static void
+test_lifecycle_disabled (void)
+{
+    NautilusFriends *friends;
+    GtkWindow *window = fake_window ();
+
+    reset_calls ();
+    set_enabled (FALSE);
+    friends = nautilus_friends_new (&fake_ops, nautilus_preferences);
+
+    /* Off: nothing at all, through launch, windows and the first paint. */
+    nautilus_friends_launch (friends);
+    nautilus_friends_add_window (friends, window);
+    nautilus_friends_first_paint (friends);
+    g_assert_cmpuint (calls.spawn + calls.prepare + calls.link_new + calls.start + calls.added->len, ==, 0);
+
+    /* Turned on after the window painted: attaches at once; the link spawns the helper itself. */
+    set_enabled (TRUE);
+    g_assert_cmpuint (calls.spawn, ==, 0);
+    g_assert_cmpuint (calls.link_new, ==, 1);
+    g_assert_cmpuint (calls.start, ==, 1);
+    g_assert_cmpuint (calls.added->len, ==, 1);
+    g_assert_true (g_ptr_array_index (calls.added, 0) == window);
+
+    nautilus_friends_free (friends);
+    g_assert_cmpuint (calls.free, ==, 1);
+    g_assert_cmpuint (calls.stop, ==, 0);
+    g_object_unref (window);
+    set_enabled (TRUE);
+}
+
+static void
+test_lifecycle_before_first_paint (void)
+{
+    NautilusFriends *friends;
+    GtkWindow *window = fake_window ();
+
+    reset_calls ();
+    set_enabled (TRUE);
+    friends = nautilus_friends_new (&fake_ops, nautilus_preferences);
+    nautilus_friends_launch (friends);
+    nautilus_friends_add_window (friends, window);
+    /* Turned off and on again before any window painted: still nothing beyond the launch spawn. */
+    set_enabled (FALSE);
+    set_enabled (TRUE);
+    g_assert_cmpuint (calls.spawn, ==, 1);
+    g_assert_cmpuint (calls.prepare + calls.link_new + calls.start + calls.stop + calls.added->len, ==, 0);
+    /* The first paint attaches as usual. */
+    nautilus_friends_first_paint (friends);
+    g_assert_cmpuint (calls.link_new, ==, 1);
+    g_assert_cmpuint (calls.added->len, ==, 1);
+    nautilus_friends_free (friends);
+    g_object_unref (window);
+}
+
+static void
+test_lifecycle_never_attached (void)
+{
+    NautilusFriends *friends;
+
+    reset_calls ();
+    set_enabled (TRUE);
+    friends = nautilus_friends_new (&fake_ops, nautilus_preferences);
+    nautilus_friends_launch (friends);
+    /* Turned off before any window painted: nothing to stop, nothing to free. */
+    set_enabled (FALSE);
+    nautilus_friends_free (friends);
+    g_assert_cmpuint (calls.spawn, ==, 1);
+    g_assert_cmpuint (calls.link_new + calls.stop + calls.free, ==, 0);
+    set_enabled (TRUE);
+}
+
+static void
+test_preference_default_on (void)
+{
+    g_settings_reset (nautilus_preferences, NAUTILUS_PREFERENCES_FRIENDS_ENABLED);
+    g_assert_true (g_settings_get_boolean (nautilus_preferences, NAUTILUS_PREFERENCES_FRIENDS_ENABLED));
+}
+
+int
+main (int   argc,
+      char *argv[])
+{
+    int status;
+
+    g_test_init (&argc, &argv, NULL);
+    nautilus_ensure_extension_points ();
+    nautilus_global_preferences_init ();
+
+    g_test_add_func ("/friends/host/description", test_host_description);
+    g_test_add_func ("/friends/host/accepted-by-views", test_host_accepted_by_views);
+    g_test_add_func ("/friends/received/reveal-target", test_reveal_target);
+    g_test_add_func ("/friends/received/show-in-files", test_received_files_show_in_files);
+    g_test_add_func ("/friends/preference/default-on", test_preference_default_on);
+    g_test_add_func ("/friends/lifecycle/enabled", test_lifecycle_enabled);
+    g_test_add_func ("/friends/lifecycle/disabled", test_lifecycle_disabled);
+    g_test_add_func ("/friends/lifecycle/before-first-paint", test_lifecycle_before_first_paint);
+    g_test_add_func ("/friends/lifecycle/never-attached", test_lifecycle_never_attached);
+    friends_test_add_file_tests ();
+    friends_test_add_bundle_tests ();
+    friends_test_add_link_tests ();
+
+    status = g_test_run ();
+    g_clear_pointer (&calls.added, g_ptr_array_unref);
+    if (status == 0)
+    {
+        printf ("test-nautilus-friends passed\n");
+    }
+    return status;
+}
