diff --git a/src/nautilus-command-palette.c b/src/nautilus-command-palette.c
new file mode 100644
index 0000000..63967ba
--- /dev/null
+++ b/src/nautilus-command-palette.c
@@ -0,0 +1,619 @@
+/*
+ * nautilus-command-palette.c: Cmd+K in a browser window (nautilus-command-palette.h).
+ *
+ * A dialog over the window: a search field and the commands that match what is typed. The commands are a handful
+ * of the window's own actions, shown with the shortcut the menu bar shows for them, and Shenzhen Friends' while it
+ * is on in the window (nautilus_friends_add_commands). A command runs once the palette has closed and given the
+ * keyboard back to the window, so what it opens can take the keyboard itself.
+ *
+ * Copyright (C) 2026 The Nautilus authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#define G_LOG_DOMAIN "nautilus-command-palette"
+
+#include "nautilus-command-palette.h"
+
+#include <glib/gi18n.h>
+#include <string.h>
+
+#include "nautilus-application.h"
+#include "nautilus-friends.h"
+
+#define PALETTE_KEY "nautilus-command-palette"
+
+/* ---- Commands ------------------------------------------------------------------------------------------------- */
+
+NautilusCommand *
+nautilus_command_new (const char         *title,
+                      const char         *keywords,
+                      const char         *action,
+                      const char         *accel,
+                      const char         *accel_action,
+                      NautilusCommandRun  run,
+                      gpointer            run_data)
+{
+    NautilusCommand *command = g_new0 (NautilusCommand, 1);
+
+    command->title = g_strdup (title);
+    command->keywords = g_strdup (keywords);
+    command->action = g_strdup (action);
+    command->accel = g_strdup (accel);
+    command->accel_action = g_strdup (accel_action);
+    command->run = run;
+    command->run_data = run_data;
+    return command;
+}
+
+void
+nautilus_command_free (NautilusCommand *command)
+{
+    if (command == NULL)
+    {
+        return;
+    }
+    g_free (command->title);
+    g_free (command->keywords);
+    g_free (command->action);
+    g_free (command->accel);
+    g_free (command->accel_action);
+    g_free (command);
+}
+
+/* The words of @text, case-folded and without accents: runs of letters and digits. */
+static GPtrArray *
+fold_words (const char *text)
+{
+    GPtrArray *words = g_ptr_array_new_with_free_func (g_free);
+    g_autofree char *normalized = NULL;
+    g_autofree char *folded = NULL;
+    GString *word = g_string_new (NULL);
+
+    if (text == NULL)
+    {
+        g_string_free (word, TRUE);
+        return words;
+    }
+    normalized = g_utf8_normalize (text, -1, G_NORMALIZE_ALL);
+    folded = g_utf8_casefold (normalized != NULL ? normalized : "", -1);
+    for (const char *p = folded; *p != '\0'; p = g_utf8_next_char (p))
+    {
+        gunichar c = g_utf8_get_char (p);
+
+        if (g_unichar_ismark (c))
+        {
+            continue;
+        }
+        if (g_unichar_isalnum (c))
+        {
+            g_string_append_unichar (word, c);
+        }
+        else if (word->len > 0)
+        {
+            g_ptr_array_add (words, g_strdup (word->str));
+            g_string_truncate (word, 0);
+        }
+    }
+    if (word->len > 0)
+    {
+        g_ptr_array_add (words, g_strdup (word->str));
+    }
+    g_string_free (word, TRUE);
+    return words;
+}
+
+static gboolean
+starts_a_word (GPtrArray  *words,
+               const char *prefix)
+{
+    for (guint i = 0; i < words->len; i++)
+    {
+        if (g_str_has_prefix (g_ptr_array_index (words, i), prefix))
+        {
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+gboolean
+nautilus_command_matches (const NautilusCommand *command,
+                          const char            *query,
+                          gboolean              *in_title)
+{
+    g_autoptr (GPtrArray) query_words = fold_words (query);
+    g_autoptr (GPtrArray) title_words = fold_words (command->title);
+    g_autoptr (GPtrArray) keyword_words = fold_words (command->keywords);
+    gboolean all_in_title = TRUE;
+
+    for (guint i = 0; i < query_words->len; i++)
+    {
+        const char *word = g_ptr_array_index (query_words, i);
+        gboolean title = starts_a_word (title_words, word);
+
+        if (!title && !starts_a_word (keyword_words, word))
+        {
+            return FALSE;
+        }
+        all_in_title = all_in_title && title;
+    }
+    if (in_title != NULL)
+    {
+        *in_title = all_in_title;
+    }
+    return TRUE;
+}
+
+GPtrArray *
+nautilus_command_palette_filter (GPtrArray  *commands,
+                                 const char *query)
+{
+    GPtrArray *listed = g_ptr_array_new ();
+    g_autoptr (GPtrArray) by_keyword = g_ptr_array_new ();
+
+    for (guint i = 0; i < commands->len; i++)
+    {
+        NautilusCommand *command = g_ptr_array_index (commands, i);
+        gboolean in_title = FALSE;
+
+        if (nautilus_command_matches (command, query, &in_title))
+        {
+            g_ptr_array_add (in_title ? listed : by_keyword, command);
+        }
+    }
+    g_ptr_array_extend (listed, by_keyword, NULL, NULL);
+    return listed;
+}
+
+/* Files' own commands, with the shortcuts the menu bar shows for them. Application and window actions show the
+ * accelerator the application has for them; the files view's and the tab's keys live in their own controllers, so
+ * those are spelled out, as the menu bar spells them. */
+#ifdef __APPLE__
+#define MAC_OR(mac, other) (mac)
+#else
+#define MAC_OR(mac, other) (other)
+#endif
+
+GPtrArray *
+nautilus_command_palette_commands (GtkWindow *window)
+{
+    GPtrArray *commands = g_ptr_array_new_with_free_func ((GDestroyNotify) nautilus_command_free);
+    const char *new_tab = MAC_OR ("app.new-tab", "win.new-tab");
+
+#define ADD(title, keywords, action, accel) \
+        g_ptr_array_add (commands, nautilus_command_new ((title), (keywords), (action), (accel), \
+                                                         (accel) == NULL ? (action) : NULL, NULL, NULL))
+
+    ADD (_("New Window"), "open", "app.clone-window", NULL);
+    ADD (_("New Tab"), "open", new_tab, NULL);
+    ADD (_("New Folder"), "create make directory", "view.new-folder", MAC_OR ("<Meta><Shift>n", "<Control><Shift>n"));
+#ifdef __APPLE__
+    ADD (_("Enter Location…"), "go to path address folder", "win.macos-edit-location", "<Meta><Shift>g");
+#endif
+    ADD (_("Find"), "search filter", "slot.focus-search", MAC_OR ("<Meta>f", "<Control>f"));
+    ADD (_("Search Everywhere"), "find", "slot.search-global", MAC_OR ("<Meta><Shift>f", "<Control><Shift>f"));
+    ADD (_("Show Hidden Files"), "hide dotfiles", "view.show-hidden-files",
+         MAC_OR ("<Meta><Shift>period", "<Control>h"));
+    ADD (_("Preferences…"), "settings options", "app.preferences", NULL);
+    ADD (_("Keyboard Shortcuts"), "keys help", "app.shortcuts", NULL);
+
+#undef ADD
+
+    nautilus_friends_add_commands (window, commands);
+    return commands;
+}
+
+#undef MAC_OR
+
+/* ---- The palette ---------------------------------------------------------------------------------------------- */
+
+typedef struct
+{
+    GtkWindow *window;          /* weak */
+    GtkWidget *entry;
+    GtkWidget *list;
+    GtkWidget *scroller;
+    GtkWidget *empty;
+    GPtrArray *commands;        /* NautilusCommand, owned */
+    GPtrArray *listed;          /* borrowed from commands, in row order */
+    NautilusCommand *chosen;    /* runs once the palette has closed */
+} Palette;
+
+typedef struct
+{
+    GtkWindow *window;          /* weak */
+    NautilusCommand *command;   /* owned */
+} PendingRun;
+
+static void
+palette_free (gpointer data)
+{
+    Palette *palette = data;
+
+    g_clear_weak_pointer (&palette->window);
+    g_clear_pointer (&palette->listed, g_ptr_array_unref);
+    g_clear_pointer (&palette->commands, g_ptr_array_unref);
+    g_free (palette);
+}
+
+static Palette *
+palette_of (AdwDialog *dialog)
+{
+    return dialog != NULL ? g_object_get_data (G_OBJECT (dialog), PALETTE_KEY) : NULL;
+}
+
+static char *
+shortcut_for (GtkWindow             *window,
+              const NautilusCommand *command)
+{
+    GtkApplication *application = window != NULL ? gtk_window_get_application (window) : NULL;
+    g_auto (GStrv) accels = NULL;
+
+    if (command->accel != NULL)
+    {
+        return g_strdup (command->accel);
+    }
+    if (command->accel_action == NULL || application == NULL)
+    {
+        return NULL;
+    }
+    accels = gtk_application_get_accels_for_action (application, command->accel_action);
+    return accels != NULL && accels[0] != NULL ? g_strdup (accels[0]) : NULL;
+}
+
+static GtkWidget *
+row_new (GtkWindow             *window,
+         const NautilusCommand *command)
+{
+    GtkWidget *row = gtk_list_box_row_new ();
+    GtkWidget *box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 12);
+    GtkWidget *title = gtk_label_new (command->title);
+    g_autofree char *accel = shortcut_for (window, command);
+
+    gtk_label_set_xalign (GTK_LABEL (title), 0);
+    gtk_label_set_ellipsize (GTK_LABEL (title), PANGO_ELLIPSIZE_END);
+    gtk_widget_set_hexpand (title, TRUE);
+    gtk_box_append (GTK_BOX (box), title);
+    if (accel != NULL)
+    {
+        gtk_box_append (GTK_BOX (box), adw_shortcut_label_new (accel));
+    }
+    gtk_list_box_row_set_child (GTK_LIST_BOX_ROW (row), box);
+    return row;
+}
+
+static void
+refilter (Palette *palette)
+{
+    const char *query = gtk_editable_get_text (GTK_EDITABLE (palette->entry));
+    GtkWidget *child;
+
+    while ((child = gtk_widget_get_first_child (palette->list)) != NULL)
+    {
+        gtk_list_box_remove (GTK_LIST_BOX (palette->list), child);
+    }
+    g_clear_pointer (&palette->listed, g_ptr_array_unref);
+    palette->listed = nautilus_command_palette_filter (palette->commands, query);
+    for (guint i = 0; i < palette->listed->len; i++)
+    {
+        gtk_list_box_append (GTK_LIST_BOX (palette->list),
+                             row_new (palette->window, g_ptr_array_index (palette->listed, i)));
+    }
+    gtk_list_box_select_row (GTK_LIST_BOX (palette->list),
+                             gtk_list_box_get_row_at_index (GTK_LIST_BOX (palette->list), 0));
+    gtk_widget_set_visible (palette->scroller, palette->listed->len > 0);
+    gtk_widget_set_visible (palette->empty, palette->listed->len == 0);
+}
+
+static void
+on_search_changed (GtkSearchEntry *entry,
+                   gpointer        data)
+{
+    refilter (data);
+}
+
+static void
+run_pending (gpointer data)
+{
+    PendingRun *pending = data;
+    NautilusCommand *command = pending->command;
+
+    if (pending->window != NULL)
+    {
+        if (command->run != NULL)
+        {
+            command->run (pending->window, command->run_data);
+        }
+        else if (command->action != NULL)
+        {
+            g_autofree char *name = NULL;
+            g_autoptr (GVariant) target = NULL;
+            g_autoptr (GError) error = NULL;
+
+            if (g_action_parse_detailed_name (command->action, &name, &target, &error))
+            {
+                gtk_widget_activate_action_variant (GTK_WIDGET (pending->window), name, target);
+            }
+            else
+            {
+                g_warning ("%s: %s", command->action, error->message);
+            }
+        }
+    }
+    g_clear_weak_pointer (&pending->window);
+    nautilus_command_free (pending->command);
+    g_free (pending);
+}
+
+static void
+on_closed (AdwDialog *dialog,
+           gpointer   data)
+{
+    Palette *palette = data;
+    PendingRun *pending;
+
+    if (palette->chosen == NULL || palette->window == NULL)
+    {
+        return;
+    }
+    pending = g_new0 (PendingRun, 1);
+    g_set_weak_pointer (&pending->window, palette->window);
+    pending->command = nautilus_command_new (palette->chosen->title, palette->chosen->keywords,
+                                             palette->chosen->action, NULL, NULL,
+                                             palette->chosen->run, palette->chosen->run_data);
+    palette->chosen = NULL;
+    /* After the dialog has given the keyboard back to the window. */
+    g_idle_add_once (run_pending, pending);
+}
+
+static void
+choose (Palette   *palette,
+        AdwDialog *dialog,
+        int        index)
+{
+    if (index < 0 || (guint) index >= palette->listed->len)
+    {
+        return;
+    }
+    palette->chosen = g_ptr_array_index (palette->listed, index);
+    adw_dialog_close (dialog);
+}
+
+static void
+on_activate (GtkEntry *entry,
+             gpointer  data)
+{
+    AdwDialog *dialog = data;
+    Palette *palette = palette_of (dialog);
+    GtkListBoxRow *row = gtk_list_box_get_selected_row (GTK_LIST_BOX (palette->list));
+
+    choose (palette, dialog, row != NULL ? gtk_list_box_row_get_index (row) : -1);
+}
+
+static void
+on_row_activated (GtkListBox    *list,
+                  GtkListBoxRow *row,
+                  gpointer       data)
+{
+    AdwDialog *dialog = data;
+
+    choose (palette_of (dialog), dialog, gtk_list_box_row_get_index (row));
+}
+
+static void
+on_stop_search (GtkSearchEntry *entry,
+                gpointer        data)
+{
+    adw_dialog_close (data);
+}
+
+/* Up and Down move the selection while the keyboard stays in the field. */
+static gboolean
+on_key_pressed (GtkEventControllerKey *controller,
+                guint                  keyval,
+                guint                  keycode,
+                GdkModifierType        state,
+                gpointer               data)
+{
+    Palette *palette = data;
+    GtkListBox *list = GTK_LIST_BOX (palette->list);
+    GtkListBoxRow *selected = gtk_list_box_get_selected_row (list);
+    int index = selected != NULL ? gtk_list_box_row_get_index (selected) : -1;
+    int count = palette->listed != NULL ? (int) palette->listed->len : 0;
+    GtkListBoxRow *row;
+
+    if (count == 0 || (state & (GDK_CONTROL_MASK | GDK_ALT_MASK | GDK_META_MASK | GDK_SHIFT_MASK)) != 0)
+    {
+        return GDK_EVENT_PROPAGATE;
+    }
+    if (keyval == GDK_KEY_Down || keyval == GDK_KEY_KP_Down)
+    {
+        index = MIN (index + 1, count - 1);
+    }
+    else if (keyval == GDK_KEY_Up || keyval == GDK_KEY_KP_Up)
+    {
+        index = MAX (index - 1, 0);
+    }
+    else
+    {
+        return GDK_EVENT_PROPAGATE;
+    }
+    row = gtk_list_box_get_row_at_index (list, index);
+    gtk_list_box_select_row (list, row);
+    /* Keeps the selected row in view without taking the keyboard from the field. */
+    {
+        graphene_rect_t bounds;
+        GtkAdjustment *adjustment = gtk_scrolled_window_get_vadjustment (GTK_SCROLLED_WINDOW (palette->scroller));
+
+        if (gtk_widget_compute_bounds (GTK_WIDGET (row), palette->list, &bounds))
+        {
+            gtk_adjustment_clamp_page (adjustment, bounds.origin.y, bounds.origin.y + bounds.size.height);
+        }
+    }
+    return GDK_EVENT_STOP;
+}
+
+AdwDialog *
+nautilus_command_palette_get_open (GtkWindow *window)
+{
+    return window != NULL ? g_object_get_data (G_OBJECT (window), PALETTE_KEY) : NULL;
+}
+
+static void
+forget_palette (gpointer  data,
+                GObject  *where_the_dialog_was)
+{
+    GtkWindow *window = data;
+
+    if (g_object_get_data (G_OBJECT (window), PALETTE_KEY) == where_the_dialog_was)
+    {
+        g_object_set_data (G_OBJECT (window), PALETTE_KEY, NULL);
+    }
+}
+
+static void
+on_palette_closed_forget (AdwDialog *dialog,
+                          gpointer   data)
+{
+    Palette *palette = palette_of (dialog);
+
+    if (palette != NULL && palette->window != NULL &&
+        g_object_get_data (G_OBJECT (palette->window), PALETTE_KEY) == dialog)
+    {
+        g_object_weak_unref (G_OBJECT (dialog), forget_palette, palette->window);
+        g_object_set_data (G_OBJECT (palette->window), PALETTE_KEY, NULL);
+    }
+}
+
+void
+nautilus_command_palette_present (GtkWindow *window)
+{
+    AdwDialog *dialog = nautilus_command_palette_get_open (window);
+    Palette *palette;
+    GtkWidget *box;
+    GtkEventController *keys;
+
+    g_return_if_fail (GTK_IS_WINDOW (window));
+
+    if (dialog != NULL)
+    {
+        gtk_widget_grab_focus (palette_of (dialog)->entry);
+        return;
+    }
+    /* Friends' dropdown floats above the window and would cover the palette. */
+    nautilus_friends_close_dropdown (window);
+
+    palette = g_new0 (Palette, 1);
+    g_set_weak_pointer (&palette->window, window);
+    palette->commands = nautilus_command_palette_commands (window);
+
+    dialog = adw_dialog_new ();
+    /* Not shown: what assistive technology calls the palette. */
+    adw_dialog_set_title (dialog, _("Search Commands"));
+    adw_dialog_set_content_width (dialog, 440);
+    adw_dialog_set_follows_content_size (dialog, TRUE);
+    adw_dialog_set_presentation_mode (dialog, ADW_DIALOG_FLOATING);
+    g_object_set_data_full (G_OBJECT (dialog), PALETTE_KEY, palette, palette_free);
+
+    box = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+    gtk_widget_set_margin_top (box, 12);
+    gtk_widget_set_margin_bottom (box, 12);
+    gtk_widget_set_margin_start (box, 12);
+    gtk_widget_set_margin_end (box, 12);
+
+    palette->entry = gtk_search_entry_new ();
+    gtk_search_entry_set_placeholder_text (GTK_SEARCH_ENTRY (palette->entry), _("Search commands"));
+    gtk_search_entry_set_search_delay (GTK_SEARCH_ENTRY (palette->entry), 0);
+    gtk_box_append (GTK_BOX (box), palette->entry);
+
+    palette->list = gtk_list_box_new ();
+    gtk_list_box_set_selection_mode (GTK_LIST_BOX (palette->list), GTK_SELECTION_BROWSE);
+    gtk_widget_add_css_class (palette->list, "navigation-sidebar");
+    palette->scroller = gtk_scrolled_window_new ();
+    gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (palette->scroller), GTK_POLICY_NEVER,
+                                    GTK_POLICY_AUTOMATIC);
+    gtk_scrolled_window_set_propagate_natural_height (GTK_SCROLLED_WINDOW (palette->scroller), TRUE);
+    gtk_scrolled_window_set_max_content_height (GTK_SCROLLED_WINDOW (palette->scroller), 320);
+    gtk_scrolled_window_set_child (GTK_SCROLLED_WINDOW (palette->scroller), palette->list);
+    gtk_box_append (GTK_BOX (box), palette->scroller);
+
+    palette->empty = gtk_label_new (_("No matching commands"));
+    gtk_widget_add_css_class (palette->empty, "dim-label");
+    gtk_widget_set_margin_top (palette->empty, 12);
+    gtk_widget_set_margin_bottom (palette->empty, 12);
+    gtk_box_append (GTK_BOX (box), palette->empty);
+    adw_dialog_set_child (dialog, box);
+
+    g_signal_connect (palette->entry, "search-changed", G_CALLBACK (on_search_changed), palette);
+    g_signal_connect (palette->entry, "activate", G_CALLBACK (on_activate), dialog);
+    g_signal_connect (palette->entry, "stop-search", G_CALLBACK (on_stop_search), dialog);
+    g_signal_connect (palette->list, "row-activated", G_CALLBACK (on_row_activated), dialog);
+    keys = gtk_event_controller_key_new ();
+    gtk_event_controller_set_propagation_phase (keys, GTK_PHASE_CAPTURE);
+    g_signal_connect (keys, "key-pressed", G_CALLBACK (on_key_pressed), palette);
+    gtk_widget_add_controller (palette->entry, keys);
+    g_signal_connect (dialog, "closed", G_CALLBACK (on_palette_closed_forget), NULL);
+    g_signal_connect (dialog, "closed", G_CALLBACK (on_closed), palette);
+
+    refilter (palette);
+    adw_dialog_set_focus (dialog, palette->entry);
+
+    g_object_set_data (G_OBJECT (window), PALETTE_KEY, dialog);
+    g_object_weak_ref (G_OBJECT (dialog), forget_palette, window);
+    adw_dialog_present (dialog, GTK_WIDGET (window));
+    gtk_widget_grab_focus (palette->entry);
+}
+
+GtkWidget *
+nautilus_command_palette_get_entry (AdwDialog *dialog)
+{
+    Palette *palette = palette_of (dialog);
+
+    return palette != NULL ? palette->entry : NULL;
+}
+
+GStrv
+nautilus_command_palette_get_listed (AdwDialog *dialog)
+{
+    Palette *palette = palette_of (dialog);
+    g_autoptr (GStrvBuilder) builder = g_strv_builder_new ();
+
+    for (guint i = 0; palette != NULL && palette->listed != NULL && i < palette->listed->len; i++)
+    {
+        NautilusCommand *command = g_ptr_array_index (palette->listed, i);
+
+        g_strv_builder_add (builder, command->title);
+    }
+    return g_strv_builder_end (builder);
+}
+
+/* ---- The window's action -------------------------------------------------------------------------------------- */
+
+static void
+action_command_palette (GSimpleAction *action,
+                        GVariant      *parameter,
+                        gpointer       data)
+{
+    nautilus_command_palette_present (GTK_WINDOW (data));
+}
+
+void
+nautilus_command_palette_install (GtkWindow *window)
+{
+    g_autoptr (GSimpleAction) action = g_simple_action_new ("command-palette", NULL);
+    GApplication *application = G_APPLICATION (gtk_window_get_application (window));
+
+    g_return_if_fail (G_IS_ACTION_MAP (window));
+
+    g_signal_connect_object (action, "activate", G_CALLBACK (action_command_palette), window, 0);
+    g_action_map_add_action (G_ACTION_MAP (window), G_ACTION (action));
+    if (application == NULL)
+    {
+        application = g_application_get_default ();
+    }
+    if (application != NULL)
+    {
+        nautilus_application_set_accelerator (application, "win.command-palette", "<Primary>k");
+    }
+}
diff --git a/src/nautilus-command-palette.h b/src/nautilus-command-palette.h
new file mode 100644
index 0000000..81d4bd1
--- /dev/null
+++ b/src/nautilus-command-palette.h
@@ -0,0 +1,67 @@
+/*
+ * nautilus-command-palette.h: Cmd+K (Ctrl+K elsewhere) in a browser window, a search field over the window's
+ * commands. Typing filters them, the arrow keys move, Return runs the selected one and Escape closes.
+ *
+ * Copyright (C) 2026 The Nautilus authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#pragma once
+
+#include <adwaita.h>
+
+G_BEGIN_DECLS
+
+typedef void (*NautilusCommandRun) (GtkWindow *window,
+                                    gpointer   data);
+
+/* One command. It runs @action (a detailed action name) on the window, or @run. Its shortcut is @accel, or the
+ * application's first accelerator for @accel_action. */
+typedef struct
+{
+    char *title;
+    char *keywords;      /* words, separated by spaces */
+    char *action;
+    char *accel;
+    char *accel_action;
+    NautilusCommandRun run;
+    gpointer run_data;
+} NautilusCommand;
+
+NautilusCommand *nautilus_command_new (const char         *title,
+                                       const char         *keywords,
+                                       const char         *action,
+                                       const char         *accel,
+                                       const char         *accel_action,
+                                       NautilusCommandRun  run,
+                                       gpointer            run_data);
+void             nautilus_command_free (NautilusCommand *command);
+
+/* Every word of @query, ignoring case and accents, starts a word of the title or of the keywords. An empty query
+ * matches everything. @in_title (optional): every word matched in the title alone. */
+gboolean         nautilus_command_matches (const NautilusCommand *command,
+                                           const char            *query,
+                                           gboolean              *in_title);
+
+/* What the palette offers in @window now: Files' own commands, then those of Shenzhen Friends while it is on in
+ * that window. NautilusCommand pointers, freed with the array. */
+GPtrArray       *nautilus_command_palette_commands (GtkWindow *window);
+
+/* Those of @commands that match @query: title matches first, each group in the order given. Borrowed pointers. */
+GPtrArray       *nautilus_command_palette_filter (GPtrArray  *commands,
+                                                  const char *query);
+
+/* Adds win.command-palette to @window (a GtkApplicationWindow) and binds it to Cmd+K (<Primary>k, which
+ * nautilus_application_set_accelerator turns into Command on macOS). */
+void             nautilus_command_palette_install (GtkWindow *window);
+
+/* Opens the palette over @window, or focuses its field when it is already open. */
+void             nautilus_command_palette_present (GtkWindow *window);
+
+/* For the tests: the open palette, its search field and the titles it lists now, in order. */
+AdwDialog       *nautilus_command_palette_get_open (GtkWindow *window);
+GtkWidget       *nautilus_command_palette_get_entry (AdwDialog *palette);
+GStrv            nautilus_command_palette_get_listed (AdwDialog *palette);
+
+G_END_DECLS
