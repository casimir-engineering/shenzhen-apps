diff --git a/src/nautilus-friends-host.c b/src/nautilus-friends-host.c
new file mode 100644
index 0000000..b138a65
--- /dev/null
+++ b/src/nautilus-friends-host.c
@@ -0,0 +1,230 @@
+/*
+ * nautilus-friends-host.c: what Shenzhen Files tells the Friends views (gtk/szfriends_gtk_host.h).
+ *
+ * Identity for the helper's hello, where each window's button goes, the files `#` offers, and how a received file
+ * is shown. Everything else Friends shows comes from the helper's snapshots and its string catalog.
+ */
+
+#define G_LOG_DOMAIN "nautilus-friends"
+
+#include "nautilus-friends-private.h"
+
+#include <glib/gi18n.h>
+#include <string.h>
+
+#include "nautilus-application.h"
+#include "nautilus-directory.h"
+#include "nautilus-dnd.h"
+#include "nautilus-file.h"
+#include "nautilus-window.h"
+#include "nautilus-window-slot.h"
+
+/* ---- Buttons ------------------------------------------------------------------------------------------------ */
+
+static void
+install_button (gpointer   host_data,
+                GtkWindow *window,
+                GtkWidget *button)
+{
+    /* GTK spells Finder's file URLs file%3A///… in text/uri-list; Nautilus registers its repair lazily from its
+     * own drop targets, so without this a first drop on the Friends button would carry broken paths. */
+    nautilus_dnd_init_macos ();
+    if (NAUTILUS_IS_WINDOW (window))
+    {
+        nautilus_window_set_friends_button (NAUTILUS_WINDOW (window), button);
+    }
+}
+
+static void
+remove_button (gpointer   host_data,
+               GtkWindow *window,
+               GtkWidget *button)
+{
+    if (NAUTILUS_IS_WINDOW (window) &&
+        nautilus_window_get_friends_button (NAUTILUS_WINDOW (window)) == button)
+    {
+        nautilus_window_set_friends_button (NAUTILUS_WINDOW (window), NULL);
+    }
+}
+
+/* ---- Received files ----------------------------------------------------------------------------------------- */
+
+gboolean
+nautilus_friends_reveal_target (const char  *path,
+                                GFile      **folder,
+                                GFile      **selection)
+{
+    g_autoptr (GFile) file = NULL;
+    GFile *parent;
+
+    *folder = NULL;
+    *selection = NULL;
+    if (path == NULL || !g_path_is_absolute (path))
+    {
+        return FALSE;
+    }
+    file = g_file_new_for_path (path);
+    parent = g_file_get_parent (file);
+    if (parent == NULL)
+    {
+        *folder = g_steal_pointer (&file);
+        return TRUE;
+    }
+    *folder = parent;
+    *selection = g_steal_pointer (&file);
+    return TRUE;
+}
+
+static void
+open_in_files (gpointer  host_data,
+               GFile    *folder,
+               GFile    *selection)
+{
+    /* A window already showing the folder is reused, as --select does; otherwise a new one opens. */
+    nautilus_application_open_location (NAUTILUS_APPLICATION (host_data), folder, selection, NULL);
+}
+
+static NautilusFriendsOpener opener;
+
+void
+nautilus_friends_host_set_opener (NautilusFriendsOpener replacement)
+{
+    opener = replacement;
+}
+
+/* Both "Open" and "Show in Shenzhen Files" land here. A file manager opens no format in place (open_formats is
+ * empty), so a received file is shown where it is, selected, one double-click from its own app. */
+static void
+show_received_file (gpointer    host_data,
+                    GtkWindow  *window,
+                    const char *path)
+{
+    g_autoptr (GFile) folder = NULL;
+    g_autoptr (GFile) selection = NULL;
+
+    if (!nautilus_friends_reveal_target (path, &folder, &selection))
+    {
+        g_warning ("not showing a received file without an absolute path");
+        return;
+    }
+    (opener != NULL ? opener : open_in_files) (host_data, folder, selection);
+}
+
+/* ---- `#` ------------------------------------------------------------------------------------------------------ */
+
+typedef struct
+{
+    NautilusDirectory *directory; /* NULL: the tab shows no folder yet */
+    GList *selection;             /* NautilusFile */
+    char *query;
+    GCancellable *cancellable;
+    SZFriendsGtkItemsReady ready;
+    gpointer ready_data;
+} ItemsRequest;
+
+static void
+items_request_finish (ItemsRequest *request,
+                      GList        *folder_files)
+{
+    /* A cancelled request never answers: the views have moved on to another query. */
+    if (request->cancellable == NULL || !g_cancellable_is_cancelled (request->cancellable))
+    {
+        request->ready (nautilus_friends_items_collect (request->selection, folder_files, request->query),
+                        request->ready_data);
+    }
+    g_clear_object (&request->directory);
+    nautilus_file_list_free (request->selection);
+    g_free (request->query);
+    g_clear_object (&request->cancellable);
+    g_free (request);
+}
+
+static void
+on_directory_ready (NautilusDirectory *directory,
+                    GList             *files,
+                    gpointer           user_data)
+{
+    items_request_finish (user_data, files);
+}
+
+static void
+on_no_directory (gpointer user_data)
+{
+    items_request_finish (user_data, NULL);
+}
+
+void
+nautilus_friends_attachable_items (gpointer                host_data,
+                                   GtkWindow              *window,
+                                   const char             *query,
+                                   GCancellable           *cancellable,
+                                   SZFriendsGtkItemsReady  ready,
+                                   gpointer                ready_data)
+{
+    g_autoptr (NautilusWindowSlot) slot = NULL;
+    ItemsRequest *request = g_new0 (ItemsRequest, 1);
+    GFile *location = NULL;
+
+    request->query = g_strdup (query != NULL ? query : "");
+    request->cancellable = cancellable != NULL ? g_object_ref (cancellable) : NULL;
+    request->ready = ready;
+    request->ready_data = ready_data;
+    if (NAUTILUS_IS_WINDOW (window))
+    {
+        g_object_get (window, "active-slot", &slot, NULL);
+    }
+    if (slot != NULL)
+    {
+        request->selection = nautilus_file_list_copy (nautilus_window_slot_get_selection (slot));
+        location = nautilus_window_slot_get_location (slot);
+    }
+    if (location != NULL)
+    {
+        /* The tab already lists this folder, so this is normally ready on the next turn of the main loop. */
+        request->directory = nautilus_directory_get (location);
+        nautilus_directory_call_when_ready (request->directory,
+                                            NAUTILUS_ATTRIBUTE_INFO | NAUTILUS_ATTRIBUTE_FILE_LIST,
+                                            on_directory_ready, request);
+    }
+    else
+    {
+        /* Always answered later, never from inside this call, so the views see one behaviour. */
+        g_idle_add_once (on_no_directory, request);
+    }
+}
+
+/* ---- The host ------------------------------------------------------------------------------------------------ */
+
+static const char *const no_formats[] = { NULL };
+
+void
+nautilus_friends_host_init (SZFriendsGtkHost            *host,
+                            const NautilusFriendsBundle *bundle,
+                            gpointer                     host_data)
+{
+    memset (host, 0, sizeof *host);
+    host->struct_size = sizeof *host;
+    host->host_data = host_data;
+
+    host->app_id = NAUTILUS_FRIENDS_APP_ID;
+    host->app_name = NAUTILUS_FRIENDS_APP_NAME;
+    host->app_version = bundle->app_version;
+    /* Received files offer "Show in Shenzhen Files". */
+    host->reveal_in_name = NAUTILUS_FRIENDS_APP_NAME;
+    host->helper_path = bundle->helper_path;
+    host->helper_version = bundle->helper_version;
+    host->helper_build_number = bundle->helper_build_number;
+    /* NULL: the views claim what this host implements (attach.items, drop.files), and later what they draw. */
+    host->capabilities = NULL;
+    host->open_formats = no_formats;
+    host->attach_placeholder = _("Search selected files and this folder");
+
+    host->install_button = install_button;
+    host->remove_button = remove_button;
+    host->attachable_items = nautilus_friends_attachable_items;
+    host->open_received_file = show_received_file;
+    host->reveal_file = show_received_file;
+    /* Files only: no extra drop types, no veto, the views' own look and metrics, no Markdown, `/` or export. */
+
+    host->animals_manifest_path = bundle->animals_manifest_path;
+}
diff --git a/src/nautilus-friends-items.c b/src/nautilus-friends-items.c
new file mode 100644
index 0000000..b7fa38e
--- /dev/null
+++ b/src/nautilus-friends-items.c
@@ -0,0 +1,217 @@
+/*
+ * nautilus-friends-items.c: the files `#` offers in Shenzhen Files.
+ *
+ * The brief's port note says `#` lists "the selected files and the current folder" (shenzhen-pdf
+ * docs/plans/shenzhen-friends.md § Containment and porting). Only files can be sent in this version, so "the
+ * current folder" means its files: the selection first, as the person chose it, then the folder's other files,
+ * newest first, since the file just saved is the one most likely meant. Matching follows ShenzhenPDF's `#`: a
+ * case- and accent-insensitive substring of the name.
+ *
+ * Only regular files are offered, never a link: the helper refuses links, since what a link names is not the file
+ * that was offered and checked, and a dropped link is refused too. Offering the file a link points to would send
+ * that file, wherever it lives, under the link's name.
+ */
+
+#define G_LOG_DOMAIN "nautilus-friends"
+
+#include "nautilus-friends-private.h"
+
+#include <glib/gi18n.h>
+#include <string.h>
+#include <sys/stat.h>
+
+#include "nautilus-file.h"
+
+/* ---- Matching ------------------------------------------------------------------------------------------------ */
+
+/* Compatibility-decomposed, marks dropped, case-folded: "Résumé" and "resume" fold alike. */
+static char *
+fold (const char *text)
+{
+    g_autofree char *decomposed = g_utf8_normalize (text != NULL ? text : "", -1, G_NORMALIZE_ALL);
+    g_autoptr (GString) bare = g_string_new (NULL);
+
+    for (const char *p = decomposed != NULL ? decomposed : ""; *p != '\0'; p = g_utf8_next_char (p))
+    {
+        gunichar c = g_utf8_get_char (p);
+        GUnicodeType type = g_unichar_type (c);
+
+        if (type != G_UNICODE_NON_SPACING_MARK && type != G_UNICODE_SPACING_MARK &&
+            type != G_UNICODE_ENCLOSING_MARK)
+        {
+            g_string_append_unichar (bare, c);
+        }
+    }
+    return g_utf8_casefold (bare->str, (gssize) bare->len);
+}
+
+static char *
+fold_query (const char *query)
+{
+    g_autofree char *trimmed = g_strstrip (g_strdup (query != NULL ? query : ""));
+
+    return fold (trimmed);
+}
+
+static gboolean
+folded_matches (const char *name,
+                const char *needle)
+{
+    g_autofree char *folded = NULL;
+
+    if (*needle == '\0')
+    {
+        return TRUE;
+    }
+    folded = fold (name);
+    return strstr (folded, needle) != NULL;
+}
+
+gboolean
+nautilus_friends_name_matches (const char *name,
+                               const char *query)
+{
+    g_autofree char *needle = fold_query (query);
+
+    return folded_matches (name, needle);
+}
+
+/* ---- Kind labels -------------------------------------------------------------------------------------------- */
+
+/* ShenzhenPDF's names for its formats (SPDFMacFriendsKindLabel), so a file reads the same in both apps. */
+static const struct
+{
+    const char *extension;
+    const char *label;
+} kind_names[] =
+{
+    { "pdf", "PDF" }, { "md", "Markdown" }, { "markdown", "Markdown" }, { "mdown", "Markdown" },
+    { "epub", "EPUB" }, { "xps", "XPS" }, { "oxps", "XPS" }, { "txt", "Text" },
+    { "jpg", "JPEG" }, { "jpeg", "JPEG" }, { "tif", "TIFF" }, { "tiff", "TIFF" },
+};
+
+char *
+nautilus_friends_kind_label (const char *name)
+{
+    const char *dot = name != NULL ? strrchr (name, '.') : NULL;
+    g_autofree char *extension = NULL;
+
+    /* "File" for no extension, a dot file, or something after the dot that is not an extension. */
+    if (dot == NULL || dot == name || dot[1] == '\0' || strlen (dot + 1) > 8 || strpbrk (dot + 1, " \t") != NULL)
+    {
+        return g_strdup (_("File"));
+    }
+    extension = g_utf8_strdown (dot + 1, -1);
+    for (gsize i = 0; i < G_N_ELEMENTS (kind_names); i++)
+    {
+        if (strcmp (extension, kind_names[i].extension) == 0)
+        {
+            return g_strdup (kind_names[i].label);
+        }
+    }
+    return g_utf8_strup (dot + 1, -1);
+}
+
+/* ---- Items ------------------------------------------------------------------------------------------------- */
+
+/* The path of @file when it is a regular file itself; NULL for a link (lstat: the link, not what it points to),
+ * a folder, a pipe or a device, and for files with no local path (another computer, the trash). */
+static char *
+sendable_path (NautilusFile *file)
+{
+    g_autoptr (GFile) location = nautilus_file_get_activation_location (file);
+    g_autofree char *path = location != NULL ? g_file_get_path (location) : NULL;
+    struct stat info;
+
+    if (path == NULL || lstat (path, &info) != 0 || !S_ISREG (info.st_mode))
+    {
+        return NULL;
+    }
+    return g_steal_pointer (&path);
+}
+
+/* "Downloads" for a file in ~/Downloads: the folder as Files names it in its own title. */
+static char *
+folder_name (NautilusFile *file)
+{
+    g_autoptr (NautilusFile) parent = nautilus_file_get_parent (file);
+
+    return g_strdup (parent != NULL ? nautilus_file_get_display_name (parent) : "");
+}
+
+static void
+maybe_add (GPtrArray    *items,
+           NautilusFile *file,
+           gboolean      selected)
+{
+    g_autofree char *path = NULL;
+    g_autofree char *folder = NULL;
+    g_autofree char *detail = NULL;
+    g_autofree char *kind = NULL;
+    const char *title;
+
+    if (nautilus_file_is_directory (file) || (path = sendable_path (file)) == NULL)
+    {
+        return;
+    }
+    title = nautilus_file_get_display_name (file);
+    folder = folder_name (file);
+    /* Says why each file is offered: the person picked it, or it sits in the folder they are looking at. */
+    detail = selected ? g_strdup_printf (_("Selected in %s"), folder) : g_strdup_printf (_("In %s"), folder);
+    kind = nautilus_friends_kind_label (title);
+    g_ptr_array_add (items, szfriends_gtk_host_item_new (title, detail, kind, path, NULL));
+}
+
+static gint
+newest_first (gconstpointer a,
+              gconstpointer b)
+{
+    NautilusFile *first = *(NautilusFile * const *) a;
+    NautilusFile *second = *(NautilusFile * const *) b;
+    time_t first_time = nautilus_file_get_mtime (first);
+    time_t second_time = nautilus_file_get_mtime (second);
+
+    if (first_time != second_time)
+    {
+        return first_time > second_time ? -1 : 1;
+    }
+    return g_utf8_collate (nautilus_file_get_display_name (first), nautilus_file_get_display_name (second));
+}
+
+GPtrArray *
+nautilus_friends_items_collect (GList      *selection,
+                                GList      *folder_files,
+                                const char *query)
+{
+    g_autofree char *needle = fold_query (query);
+    g_autoptr (GHashTable) selected = g_hash_table_new (NULL, NULL);
+    g_autoptr (GPtrArray) others = g_ptr_array_new ();
+    GPtrArray *items = g_ptr_array_new_with_free_func ((GDestroyNotify) szfriends_gtk_host_item_free);
+
+    for (GList *l = selection; l != NULL; l = l->next)
+    {
+        g_hash_table_add (selected, l->data);
+        if (items->len < NAUTILUS_FRIENDS_ATTACH_LIMIT &&
+            folded_matches (nautilus_file_get_display_name (l->data), needle))
+        {
+            maybe_add (items, l->data, TRUE);
+        }
+    }
+    for (GList *l = folder_files; l != NULL; l = l->next)
+    {
+        NautilusFile *file = l->data;
+
+        /* Hidden files stay hidden unless the person selected them; folders and packages cannot be sent. */
+        if (!g_hash_table_contains (selected, file) && !nautilus_file_is_hidden_file (file) &&
+            !nautilus_file_is_directory (file) && folded_matches (nautilus_file_get_display_name (file), needle))
+        {
+            g_ptr_array_add (others, file);
+        }
+    }
+    g_ptr_array_sort (others, newest_first);
+    for (guint i = 0; i < others->len && items->len < NAUTILUS_FRIENDS_ATTACH_LIMIT; i++)
+    {
+        maybe_add (items, g_ptr_array_index (others, i), FALSE);
+    }
+    return items;
+}
diff --git a/src/nautilus-friends-links.c b/src/nautilus-friends-links.c
new file mode 100644
index 0000000..e39423a
--- /dev/null
+++ b/src/nautilus-friends-links.c
@@ -0,0 +1,428 @@
+/*
+ * nautilus-friends-links.c: friend links and download links in Shenzhen Files (shenzhen-pdf
+ * portable/friends/PROTOCOL.md § Links).
+ *
+ * A link's web page opens shenzhenfiles://friends/link#<payload>; GTK hands that URL to the application's open
+ * handler like a file, which passes it here first. It is checked on its bytes, strictly, before anything else sees
+ * it, as ShenzhenPDF checks shenzhenpdf: (portable/mac/friends/SPDFMacFriendsLinkURL.mm there): a URL that fails is
+ * dropped without a word, and one that passes is only a question for the helper, whose card the person has to press
+ * before anything happens. Copy Download Link is a file's context-menu item, shown while the helper offers links.
+ */
+
+#define G_LOG_DOMAIN "nautilus-friends"
+
+#include "nautilus-friends.h"
+#include "nautilus-friends-private.h"
+
+#include <glib/gi18n.h>
+#include <string.h>
+
+#include "nautilus-file.h"
+
+/* ---- The URL ------------------------------------------------------------------------------------------------- */
+
+static int
+base64url_value (unsigned char c)
+{
+    if (c >= 'A' && c <= 'Z')
+    {
+        return c - 'A';
+    }
+    if (c >= 'a' && c <= 'z')
+    {
+        return c - 'a' + 26;
+    }
+    if (c >= '0' && c <= '9')
+    {
+        return c - '0' + 52;
+    }
+    return c == '-' ? 62 : c == '_' ? 63 : -1;
+}
+
+/* Unpadded base64url that decodes canonically (no '=', no length of 1 mod 4, unused trailing bits zero), so exactly
+ * one spelling of each payload exists. NULL otherwise. */
+static GByteArray *
+decode_canonical (const char *text)
+{
+    gsize length = strlen (text);
+    g_autoptr (GByteArray) bytes = g_byte_array_new ();
+    guint32 buffer = 0;
+    int bits = 0;
+
+    if (length == 0 || length % 4 == 1)
+    {
+        return NULL;
+    }
+    for (const char *p = text; *p != '\0'; p++)
+    {
+        int value = base64url_value ((unsigned char) *p);
+        guint8 byte;
+
+        if (value < 0)
+        {
+            return NULL;
+        }
+        buffer = (buffer << 6) | (guint32) value;
+        bits += 6;
+        if (bits >= 8)
+        {
+            bits -= 8;
+            byte = (guint8) ((buffer >> bits) & 0xff);
+            g_byte_array_append (bytes, &byte, 1);
+        }
+    }
+    return (buffer & ((1u << bits) - 1)) == 0 ? g_steal_pointer (&bytes) : NULL;
+}
+
+/* Lowercase ASCII words joined by single hyphens, 3 to 64 bytes. */
+static gboolean
+is_friends_id (const guint8 *bytes,
+               gsize         length)
+{
+    if (length < 3 || length > 64 || bytes[0] == '-' || bytes[length - 1] == '-')
+    {
+        return FALSE;
+    }
+    for (gsize i = 0; i < length; i++)
+    {
+        if (bytes[i] == '-' ? bytes[i - 1] == '-' : (bytes[i] < 'a' || bytes[i] > 'z'))
+        {
+            return FALSE;
+        }
+    }
+    return TRUE;
+}
+
+/* Valid UTF-8 without control characters (C0, DEL, C1). */
+static gboolean
+is_plain_name (const guint8 *bytes,
+               gsize         length)
+{
+    const char *end = NULL;
+
+    if (!g_utf8_validate ((const char *) bytes, (gssize) length, &end))
+    {
+        return FALSE;
+    }
+    for (const char *p = (const char *) bytes; p < (const char *) bytes + length; p = g_utf8_next_char (p))
+    {
+        gunichar c = g_utf8_get_char (p);
+
+        if (c < 0x20 || (c >= 0x7f && c <= 0x9f))
+        {
+            return FALSE;
+        }
+    }
+    return TRUE;
+}
+
+static NautilusFriendsLinkRefusal
+check_layout (char              kind,
+              const GByteArray *bytes)
+{
+    gsize at = 1 + 32 + 16, id_length, name_length;
+
+    if (bytes->len == 0 || bytes->data[0] != 0x01)
+    {
+        return NAUTILUS_FRIENDS_LINK_WRONG_TYPE;
+    }
+    if (kind == 'd')
+    {
+        return bytes->len == 1 + 16 + 32 ? NAUTILUS_FRIENDS_LINK_ACCEPTED : NAUTILUS_FRIENDS_LINK_WRONG_TYPE;
+    }
+    if (bytes->len < at + 1)
+    {
+        return NAUTILUS_FRIENDS_LINK_WRONG_TYPE;
+    }
+    id_length = bytes->data[at++];
+    if (bytes->len < at + id_length + 1 || !is_friends_id (bytes->data + at, id_length))
+    {
+        return NAUTILUS_FRIENDS_LINK_WRONG_TYPE;
+    }
+    at += id_length;
+    name_length = bytes->data[at++];
+    if (name_length > 160 || bytes->len != at + name_length || !is_plain_name (bytes->data + at, name_length))
+    {
+        return NAUTILUS_FRIENDS_LINK_WRONG_TYPE;
+    }
+    return NAUTILUS_FRIENDS_LINK_ACCEPTED;
+}
+
+char *
+nautilus_friends_link_payload (const char                 *uri,
+                               NautilusFriendsLinkRefusal *refusal)
+{
+    static const char own[] = NAUTILUS_FRIENDS_LINK_SCHEME ":";
+    static const char rest[] = "//friends/link#";
+    NautilusFriendsLinkRefusal ignored;
+    g_autoptr (GByteArray) bytes = NULL;
+    const char *payload;
+
+    if (refusal == NULL)
+    {
+        refusal = &ignored;
+    }
+    *refusal = NAUTILUS_FRIENDS_LINK_NOT_OURS;
+    if (uri == NULL || g_ascii_strncasecmp (uri, own, strlen (own)) != 0)
+    {
+        return NULL;
+    }
+    if (strlen (uri) > NAUTILUS_FRIENDS_LINK_MAX_BYTES)
+    {
+        *refusal = NAUTILUS_FRIENDS_LINK_OVERSIZED;
+        return NULL;
+    }
+    *refusal = NAUTILUS_FRIENDS_LINK_MALFORMED;
+    if (strncmp (uri + strlen (own), rest, strlen (rest)) != 0)
+    {
+        return NULL;
+    }
+    payload = uri + strlen (own) + strlen (rest);
+    if (strlen (payload) < 3 || payload[1] != '.' || (bytes = decode_canonical (payload + 2)) == NULL)
+    {
+        return NULL;
+    }
+    *refusal = payload[0] == 'f' || payload[0] == 'd' ? check_layout (payload[0], bytes)
+                                                      : NAUTILUS_FRIENDS_LINK_WRONG_TYPE;
+    return *refusal == NAUTILUS_FRIENDS_LINK_ACCEPTED ? g_strdup (payload) : NULL;
+}
+
+/* ---- Copy Download Link ------------------------------------------------------------------------------------ */
+
+void
+nautilus_friends_add_link_items (GMenu      *menu,
+                                 const char *path)
+{
+    g_autoptr (GMenu) section = NULL;
+    g_autoptr (GMenu) expiry = NULL;
+    g_autoptr (GMenuItem) submenu = NULL;
+    /* Whoever opens the link downloads from this Mac, so how long it keeps working is the one thing to choose;
+     * 7 days first, the default. ShenzhenPDF's menus say the same. */
+    static const struct { int days; const char *label; } choices[] = {
+        { 7, N_("For 7 Days") }, { 1, N_("For 1 Day") }, { 30, N_("For 30 Days") },
+    };
+
+    if (menu == NULL || path == NULL || !g_path_is_absolute (path))
+    {
+        return;
+    }
+    expiry = g_menu_new ();
+    for (gsize i = 0; i < G_N_ELEMENTS (choices); i++)
+    {
+        g_autoptr (GMenuItem) item = g_menu_item_new (_(choices[i].label), NULL);
+
+        g_menu_item_set_action_and_target_value (item, "app." NAUTILUS_FRIENDS_COPY_LINK_ACTION,
+                                                 g_variant_new ("(si)", path, choices[i].days));
+        g_menu_item_set_attribute (item, "hidden-when", "s", "action-disabled");
+        g_menu_append_item (expiry, item);
+    }
+    /* The menu is built before the helper may start or stop offering links: the item follows its action instead. */
+    submenu = g_menu_item_new_submenu (_("Copy Download Link"), G_MENU_MODEL (expiry));
+    g_menu_item_set_attribute (submenu, G_MENU_ATTRIBUTE_ACTION, "s", "app." NAUTILUS_FRIENDS_LINKS_ACTION);
+    g_menu_item_set_attribute (submenu, "hidden-when", "s", "action-disabled");
+    section = g_menu_new ();
+    g_menu_append_item (section, submenu);
+    g_menu_append_section (menu, NULL, G_MENU_MODEL (section));
+}
+
+#ifdef SZFRIENDS_GTK_LINKS
+/* The window's toast overlay, where Files says what an action did; NULL when it has none. */
+static AdwToastOverlay *
+find_toast_overlay (GtkWidget *widget)
+{
+    if (ADW_IS_TOAST_OVERLAY (widget))
+    {
+        return ADW_TOAST_OVERLAY (widget);
+    }
+    for (GtkWidget *child = gtk_widget_get_first_child (widget); child != NULL;
+         child = gtk_widget_get_next_sibling (child))
+    {
+        AdwToastOverlay *found = find_toast_overlay (child);
+
+        if (found != NULL)
+        {
+            return found;
+        }
+    }
+    return NULL;
+}
+
+/* Until when the link works, or why there is none: the helper's words. */
+static void
+link_copied (const char *message,
+             gboolean    copied,
+             gpointer    data)
+{
+    GWeakRef *ref = data;
+    g_autoptr (GtkWidget) window = g_weak_ref_get (ref);
+    AdwToastOverlay *overlay = window != NULL ? find_toast_overlay (window) : NULL;
+
+    if (overlay != NULL && message != NULL && *message != '\0')
+    {
+        adw_toast_overlay_add_toast (overlay, adw_toast_new (message));
+    }
+    else if (window != NULL && !copied)
+    {
+        gtk_widget_error_bell (window);
+    }
+    g_weak_ref_clear (ref);
+    g_free (ref);
+}
+#endif
+
+static void
+copy_link_activated (GSimpleAction *action,
+                     GVariant      *parameter,
+                     gpointer       data)
+{
+    GApplication *application = g_application_get_default ();
+    NautilusFriends *friends = nautilus_friends_get ();
+    GtkWindow *window = GTK_IS_APPLICATION (application)
+                        ? gtk_application_get_active_window (GTK_APPLICATION (application)) : NULL;
+    const char *path = NULL;
+    gint32 days = 0;
+
+    g_variant_get (parameter, "(&si)", &path, &days);
+    if (friends == NULL || window == NULL || !nautilus_friends_offers_links (friends))
+    {
+        return;
+    }
+#ifdef SZFRIENDS_GTK_LINKS
+    {
+        g_autofree char *name = g_path_get_basename (path);
+        g_autofree char *kind = nautilus_friends_kind_label (name);
+        SZFriendsGtkHostItem *item = szfriends_gtk_host_item_new (name, "", kind, path, NULL);
+        GWeakRef *ref = g_new0 (GWeakRef, 1);
+
+        g_weak_ref_init (ref, window);
+        szfriends_gtk_copy_download_link (nautilus_friends_get_link (friends), GTK_WIDGET (window), item, days,
+                                          link_copied, ref);
+        szfriends_gtk_host_item_free (item);
+    }
+#else
+    (void) days;
+#endif
+}
+
+void
+nautilus_friends_sync_link_actions (GActionMap *actions,
+                                    gboolean    offers_links)
+{
+    const char *names[] = { NAUTILUS_FRIENDS_COPY_LINK_ACTION, NAUTILUS_FRIENDS_LINKS_ACTION };
+    const GVariantType *types[] = { G_VARIANT_TYPE ("(si)"), NULL };
+
+    for (gsize i = 0; actions != NULL && i < G_N_ELEMENTS (names); i++)
+    {
+        GAction *action = g_action_map_lookup_action (actions, names[i]);
+
+        if (action == NULL)
+        {
+            g_autoptr (GSimpleAction) added = g_simple_action_new (names[i], types[i]);
+
+            if (types[i] != NULL)
+            {
+                g_signal_connect (added, "activate", G_CALLBACK (copy_link_activated), NULL);
+            }
+            g_action_map_add_action (actions, G_ACTION (added));
+            action = G_ACTION (added);
+        }
+        if (G_IS_SIMPLE_ACTION (action))
+        {
+            g_simple_action_set_enabled (G_SIMPLE_ACTION (action), offers_links);
+        }
+    }
+}
+
+void
+nautilus_friends_selection_menu (GMenu *menu,
+                                 GList *selection)
+{
+    g_autofree char *path = NULL;
+    g_autoptr (GFile) location = NULL;
+    NautilusFile *file;
+
+    /* Added whether or not links are offered now: the item shows and hides with its action. */
+    if (nautilus_friends_get () == NULL || selection == NULL || selection->next != NULL)
+    {
+        return;
+    }
+    file = selection->data;
+    /* A link to a file is not the file: the helper refuses links, so only a regular file gets a download link. */
+    if (!nautilus_file_is_regular_file (file) || nautilus_file_is_symbolic_link (file))
+    {
+        return;
+    }
+    location = nautilus_file_get_location (file);
+    path = g_file_get_path (location);
+    nautilus_friends_add_link_items (menu, path);
+}
+
+/* ---- Opening a link ---------------------------------------------------------------------------------------- */
+
+gboolean
+nautilus_friends_open_uri (GtkApplication *application,
+                           const char     *uri)
+{
+    NautilusFriends *friends = nautilus_friends_get ();
+
+    (void) application;
+    if (friends == NULL)
+    {
+        return g_ascii_strncasecmp (uri != NULL ? uri : "", NAUTILUS_FRIENDS_LINK_SCHEME ":",
+                                    strlen (NAUTILUS_FRIENDS_LINK_SCHEME ":")) == 0;
+    }
+    return nautilus_friends_take_link (friends, uri);
+}
+
+void
+nautilus_friends_show_link_in_window (SZFriendsGtkLink *link,
+                                      const char       *payload)
+{
+#ifdef SZFRIENDS_GTK_LINKS
+    GtkApplication *application = GTK_APPLICATION (g_application_get_default ());
+    GtkWindow *window = application != NULL ? gtk_application_get_active_window (application) : NULL;
+
+    if (window != NULL)
+    {
+        gtk_window_present (window);
+    }
+    /* The active window's dropdown when it has a Friends button, else the first window that has one. */
+    szfriends_gtk_show_link (link, window, payload);
+#else
+    (void) link;
+    (void) payload;
+#endif
+}
+
+static void
+turn_on_answered (AdwAlertDialog *dialog,
+                  GAsyncResult   *result,
+                  gpointer        data)
+{
+    const char *response = adw_alert_dialog_choose_finish (dialog, result);
+
+    if (g_strcmp0 (response, "preferences") == 0)
+    {
+        g_action_group_activate_action (G_ACTION_GROUP (g_application_get_default ()), "preferences", NULL);
+    }
+}
+
+void
+nautilus_friends_ask_to_turn_on (void)
+{
+    GtkApplication *application = GTK_APPLICATION (g_application_get_default ());
+    GtkWindow *window = application != NULL ? gtk_application_get_active_window (application) : NULL;
+    /* The person pressed Open in Shenzhen Files on a link's page and may never have heard of Friends: the page
+     * said what the link is, so this says what is missing and where to turn it on. The link opens by itself once
+     * Friends is on. */
+    AdwDialog *dialog = adw_alert_dialog_new (
+        _("Turn on Friends to open this link"),
+        _("Friends is the part of Shenzhen Files that adds people and receives files from them, and it’s off on "
+          "this Mac. Turn it on in Preferences and the link opens."));
+
+    adw_alert_dialog_add_responses (ADW_ALERT_DIALOG (dialog), "cancel", _("Cancel"), "preferences",
+                                    _("Open Preferences"), NULL);
+    adw_alert_dialog_set_default_response (ADW_ALERT_DIALOG (dialog), "preferences");
+    adw_alert_dialog_choose (ADW_ALERT_DIALOG (dialog), window != NULL ? GTK_WIDGET (window) : NULL, NULL,
+                             (GAsyncReadyCallback) turn_on_answered, NULL);
+}
diff --git a/src/nautilus-friends-placement.c b/src/nautilus-friends-placement.c
new file mode 100644
index 0000000..30c6094
--- /dev/null
+++ b/src/nautilus-friends-placement.c
@@ -0,0 +1,168 @@
+/*
+ * nautilus-friends-placement.c: where a window's Friends button sits.
+ *
+ * Right of the window buttons, just before the edge between the sidebar and the main view: the last item of the
+ * sidebar's header bar while the sidebar shows. When it is hidden (a narrow window, or the sidebar toggled off),
+ * that bar is gone, so the button moves to the start of the main view's header bar, right after the window
+ * buttons and the sidebar toggle, and moves back when the sidebar shows again. The sidebar shown over the files
+ * in a narrow window counts as shown: its header bar then covers the start of the main one, window buttons
+ * included, so the button goes with the window buttons.
+ *
+ * The button is one widget, moved between two slots and never copied, so a window never shows two, and its badge,
+ * drop target and popover (the menu button's child) move with it.
+ */
+
+#define G_LOG_DOMAIN "nautilus-friends"
+
+#include "nautilus-friends.h"
+
+#include "nautilus-toolbar.h"
+
+typedef struct
+{
+    GtkWidget *split_view;         /* owns this record */
+    GtkWidget *sidebar_slot;       /* an AdwBin packed last in the sidebar's header bar */
+    NautilusToolbar *toolbar;
+    GtkWidget *button;             /* weak */
+} Placement;
+
+static GQuark
+placement_quark (void)
+{
+    return g_quark_from_static_string ("nautilus-friends-placement");
+}
+
+static void
+placement_set_button (Placement *placement,
+                      GtkWidget *button)
+{
+    if (placement->button == button)
+    {
+        return;
+    }
+    if (placement->button != NULL)
+    {
+        g_object_remove_weak_pointer (G_OBJECT (placement->button), (gpointer *) &placement->button);
+    }
+    placement->button = button;
+    if (button != NULL)
+    {
+        g_object_add_weak_pointer (G_OBJECT (button), (gpointer *) &placement->button);
+    }
+}
+
+static void
+placement_free (gpointer data)
+{
+    Placement *placement = data;
+
+    placement_set_button (placement, NULL);
+    g_free (placement);
+}
+
+/* Takes the button out of the slot it leaves before giving it to the other: a widget has one parent. */
+static void
+place (Placement *placement)
+{
+    GtkWidget *button = placement->button;
+    gboolean in_sidebar = adw_overlay_split_view_get_show_sidebar (ADW_OVERLAY_SPLIT_VIEW (placement->split_view));
+    GtkWidget *sidebar_button = button != NULL && in_sidebar ? button : NULL;
+    GtkWidget *toolbar_button = button != NULL && !in_sidebar ? button : NULL;
+
+    /* Held while it has no parent, or leaving its slot would destroy it, and its window's dropdown with it. */
+    if (button != NULL)
+    {
+        g_object_ref (button);
+    }
+    if (adw_bin_get_child (ADW_BIN (placement->sidebar_slot)) != sidebar_button)
+    {
+        adw_bin_set_child (ADW_BIN (placement->sidebar_slot), NULL);
+    }
+    if (nautilus_toolbar_get_friends_button (placement->toolbar) != toolbar_button)
+    {
+        nautilus_toolbar_set_friends_button (placement->toolbar, NULL);
+    }
+    if (sidebar_button != NULL && adw_bin_get_child (ADW_BIN (placement->sidebar_slot)) == NULL)
+    {
+        adw_bin_set_child (ADW_BIN (placement->sidebar_slot), sidebar_button);
+    }
+    if (toolbar_button != NULL && nautilus_toolbar_get_friends_button (placement->toolbar) == NULL)
+    {
+        nautilus_toolbar_set_friends_button (placement->toolbar, toolbar_button);
+    }
+    /* Empty, it takes no place, so the sidebar's bar keeps its spacing exactly. */
+    gtk_widget_set_visible (placement->sidebar_slot, sidebar_button != NULL);
+    if (button != NULL)
+    {
+        g_object_unref (button);
+    }
+}
+
+static void
+on_show_sidebar (GObject    *split_view,
+                 GParamSpec *pspec,
+                 gpointer    data)
+{
+    /* A window being destroyed takes its button with it; its slots may already be gone. */
+    if (!gtk_widget_in_destruction (GTK_WIDGET (split_view)))
+    {
+        place (data);
+    }
+}
+
+static Placement *
+placement_get (GtkWidget *split_view,
+               GtkWidget *sidebar_header_bar,
+               GtkWidget *toolbar)
+{
+    Placement *placement = g_object_get_qdata (G_OBJECT (split_view), placement_quark ());
+
+    if (placement == NULL)
+    {
+        placement = g_new0 (Placement, 1);
+        placement->split_view = split_view;
+        placement->toolbar = NAUTILUS_TOOLBAR (toolbar);
+        placement->sidebar_slot = adw_bin_new ();
+        gtk_widget_set_visible (placement->sidebar_slot, FALSE);
+        adw_header_bar_pack_end (ADW_HEADER_BAR (sidebar_header_bar), placement->sidebar_slot);
+        /* Both live as long as the split view: the record is its data, the handler is on it. */
+        g_object_set_qdata_full (G_OBJECT (split_view), placement_quark (), placement, placement_free);
+        g_signal_connect (split_view, "notify::show-sidebar", G_CALLBACK (on_show_sidebar), placement);
+    }
+    return placement;
+}
+
+void
+nautilus_friends_place_button (GtkWidget *split_view,
+                               GtkWidget *sidebar_header_bar,
+                               GtkWidget *toolbar,
+                               GtkWidget *button)
+{
+    Placement *placement;
+
+    g_return_if_fail (ADW_IS_OVERLAY_SPLIT_VIEW (split_view));
+    g_return_if_fail (ADW_IS_HEADER_BAR (sidebar_header_bar));
+    g_return_if_fail (NAUTILUS_IS_TOOLBAR (toolbar));
+    g_return_if_fail (button == NULL || GTK_IS_WIDGET (button));
+
+    placement = placement_get (split_view, sidebar_header_bar, toolbar);
+    if (button != placement->button && placement->button != NULL)
+    {
+        /* Another button replaces this one: the old one leaves both slots first. */
+        placement_set_button (placement, NULL);
+        place (placement);
+    }
+    placement_set_button (placement, button);
+    place (placement);
+}
+
+GtkWidget *
+nautilus_friends_placed_button (GtkWidget *split_view)
+{
+    Placement *placement;
+
+    g_return_val_if_fail (ADW_IS_OVERLAY_SPLIT_VIEW (split_view), NULL);
+
+    placement = g_object_get_qdata (G_OBJECT (split_view), placement_quark ());
+    return placement != NULL ? placement->button : NULL;
+}
diff --git a/src/nautilus-friends-preferences.c b/src/nautilus-friends-preferences.c
new file mode 100644
index 0000000..45623fa
--- /dev/null
+++ b/src/nautilus-friends-preferences.c
@@ -0,0 +1,110 @@
+/*
+ * nautilus-friends-preferences.c: the Friends page of Shenzhen Files' Preferences.
+ *
+ * The switch and what turning it on means for the person (the M1 disclosure the brief asks every host to show,
+ * written for Shenzhen Files) are the host's: they show while Friends is off and no helper runs. While Friends is
+ * on, the views' own section follows them (name, ID, received files folder, automatic acceptance, history and
+ * reset; PROTOCOL.md `settings`).
+ */
+
+#define G_LOG_DOMAIN "nautilus-friends"
+
+#include "nautilus-friends.h"
+#include "nautilus-friends-private.h"
+
+#include <glib/gi18n.h>
+
+#include "nautilus-global-preferences.h"
+
+/* The disclosure is secondary text, as the Friends views draw it: the text colour at 70%, about 4.9:1 on the light
+ * page and 8:1 on the dark one (dim-label's 55% measured 3.2:1 in light, under the 4.5:1 body text needs). With
+ * high contrast on (Increase Contrast in macOS, through libadwaita), it is as strong as libadwaita's own secondary
+ * text there (--dim-opacity, 90%). A colour, not an opacity on the widget, so the stylesheet can change it. */
+static const char disclosure_css[] =
+    ".friends-disclosure { color: color-mix(in srgb, currentColor 70%, transparent); }\n"
+    "@media (prefers-contrast: more) {\n"
+    "  .friends-disclosure { color: color-mix(in srgb, currentColor var(--dim-opacity), transparent); }\n"
+    "}\n";
+
+/* GTK does not apply the system's contrast to a provider of its own: it follows libadwaita's setting from here. */
+static gboolean
+high_contrast_to_contrast (GBinding     *binding,
+                           const GValue *from,
+                           GValue       *to,
+                           gpointer      data)
+{
+    g_value_set_enum (to, g_value_get_boolean (from) ? GTK_INTERFACE_CONTRAST_MORE :
+                      GTK_INTERFACE_CONTRAST_NO_PREFERENCE);
+    return TRUE;
+}
+
+static void
+add_disclosure_style (void)
+{
+    static GdkDisplay *styled;
+    GdkDisplay *display = gdk_display_get_default ();
+    GtkCssProvider *provider;
+
+    if (display == NULL || display == styled)
+    {
+        return;
+    }
+    provider = gtk_css_provider_new ();
+    gtk_css_provider_load_from_string (provider, disclosure_css);
+    g_object_bind_property_full (adw_style_manager_get_for_display (display), "high-contrast", provider,
+                                 "prefers-contrast", G_BINDING_SYNC_CREATE, high_contrast_to_contrast, NULL, NULL,
+                                 NULL);
+    gtk_style_context_add_provider_for_display (display, GTK_STYLE_PROVIDER (provider),
+                                                GTK_STYLE_PROVIDER_PRIORITY_APPLICATION);
+    g_object_unref (provider);
+    styled = display;
+}
+
+AdwPreferencesPage *
+nautilus_friends_preferences_page_new (void)
+{
+    AdwPreferencesPage *page = ADW_PREFERENCES_PAGE (adw_preferences_page_new ());
+    AdwPreferencesGroup *group = ADW_PREFERENCES_GROUP (adw_preferences_group_new ());
+    AdwPreferencesGroup *section_group = ADW_PREFERENCES_GROUP (adw_preferences_group_new ());
+    GtkWidget *enable_row = adw_switch_row_new ();
+    GtkWidget *disclosure;
+
+    adw_preferences_page_set_title (page, _("Friends"));
+    adw_preferences_page_set_name (page, "friends");
+    /* Two people, as on the Friends button: never a speech bubble, which would read as AI chat. */
+    adw_preferences_page_set_icon_name (page, "system-users-symbolic");
+
+    adw_preferences_group_set_title (group, _("Shenzhen Friends"));
+    /* Friends reach each other only nearby in this version, so nothing here promises the Internet. */
+    adw_preferences_group_set_description (group,
+                                           _("Send files and messages to people you add, when they are nearby with "
+                                             "ShenzhenPDF or Shenzhen Files open."));
+
+    adw_preferences_row_set_use_markup (ADW_PREFERENCES_ROW (enable_row), FALSE);
+    adw_preferences_row_set_title (ADW_PREFERENCES_ROW (enable_row), _("Enable Shenzhen Friends"));
+    g_settings_bind (nautilus_preferences, NAUTILUS_PREFERENCES_FRIENDS_ENABLED,
+                     enable_row, "active", G_SETTINGS_BIND_DEFAULT);
+    adw_preferences_group_add (group, enable_row);
+
+    /* What the server sees and what it never sees are separate sentences, so neither list runs into the other. */
+    disclosure = gtk_label_new (_("Shenzhen Files connects to the Friends server whenever it is open and Friends "
+                                  "is on. The server sees your network address, your Friends ID and when "
+                                  "Shenzhen Files is open. It never sees your name, messages or files."));
+    gtk_label_set_wrap (GTK_LABEL (disclosure), TRUE);
+    gtk_label_set_xalign (GTK_LABEL (disclosure), 0.0);
+    gtk_widget_set_margin_top (disclosure, 12);
+    add_disclosure_style ();
+    gtk_widget_add_css_class (disclosure, "friends-disclosure");
+    adw_preferences_group_add (group, disclosure);
+
+    adw_preferences_page_add (page, group);
+    /* Filled and shown only while Friends is attached: with Friends off there is nothing to set. */
+    gtk_widget_set_visible (GTK_WIDGET (section_group), FALSE);
+    adw_preferences_page_add (page, section_group);
+    if (nautilus_friends_get () != NULL)
+    {
+        nautilus_friends_add_settings_group (nautilus_friends_get (), section_group);
+    }
+
+    return page;
+}
diff --git a/src/nautilus-friends-private.h b/src/nautilus-friends-private.h
new file mode 100644
index 0000000..9846397
--- /dev/null
+++ b/src/nautilus-friends-private.h
@@ -0,0 +1,211 @@
+/*
+ * nautilus-friends-private.h: the Shenzhen Friends host adapter's parts, shared by its files and by
+ * test/displayless/test-nautilus-friends.c, which drives each part without a display.
+ */
+
+#pragma once
+
+#include <adwaita.h>
+
+#include "gtk/szfriends_gtk.h"
+#include "nautilus-types.h"
+
+G_BEGIN_DECLS
+
+/* ---- The app bundle (nautilus-macos-friends.m) ------------------------------------------------------------ */
+
+/* Where the app embeds the helper; the same path ShenzhenPDF uses, so both apps' helpers share one identity. */
+#define NAUTILUS_FRIENDS_HELPER_BUNDLE "Contents/Helpers/Shenzhen Friends.app"
+#define NAUTILUS_FRIENDS_HELPER_EXECUTABLE "Contents/MacOS/Shenzhen Friends"
+
+typedef struct
+{
+    char *app_version;           /* the app's CFBundleShortVersionString; PACKAGE_VERSION outside a bundle */
+    char *helper_path;           /* the helper's executable; NULL: nothing to start */
+    char *helper_version;        /* the helper's CFBundleShortVersionString; NULL when unreadable */
+    guint64 helper_build_number; /* the helper's CFBundleVersion, stamped from friends.lock; 0 when unreadable */
+    char *animals_manifest_path; /* NULL for an embedded helper: the views use the app's Resources/Friends */
+} NautilusFriendsBundle;
+
+/* Reads the app at @app_path (an .app, or the build directory of a development run). The helper is the one the
+ * app embeds; only when it embeds none, @dev_helper (NAUTILUS_FRIENDS_HELPER: a standalone Shenzhen Friends.app)
+ * when @overrides_allowed, which is never in a team-signed build. Missing or malformed keys read as NULL or 0, so
+ * such a helper never wins a handover. */
+void nautilus_friends_bundle_read (const char            *app_path,
+                                   const char            *dev_helper,
+                                   gboolean               overrides_allowed,
+                                   NautilusFriendsBundle *out);
+void nautilus_friends_bundle_clear (NautilusFriendsBundle *bundle);
+
+/* The running app's bundle, read once by whichever thread asks first. */
+const NautilusFriendsBundle *nautilus_friends_bundle_get (void);
+
+/* Team-signed builds: szfriends_set_signing_policy() with the app's own Team ID and a Security.framework check of
+ * the helper's signature. Ad hoc and unsigned builds set nothing, so development runs keep SZFRIENDS_STATE_DIR.
+ * Once per process, from any thread; a second caller waits for the first. */
+void nautilus_friends_prepare_signing (void);
+
+/* The Team ID in this process's own signature; NULL for ad hoc, linker-signed and unsigned code. */
+char *nautilus_friends_own_team_identifier (void);
+
+/* The library's szfriends_peer_verifier: TRUE only when the process behind @audit_token (an audit_token_t) is
+ * validly signed and meets @requirement. Every failure, a wrong token length included, is FALSE. */
+gboolean nautilus_friends_verify_peer (void       *context,
+                                       const void *audit_token,
+                                       size_t      length,
+                                       const char *requirement);
+
+/* ---- The host contract (nautilus-friends-host.c) ---------------------------------------------------------- */
+
+#define NAUTILUS_FRIENDS_APP_ID "com.intuition.shenzhenfiles"
+#define NAUTILUS_FRIENDS_APP_NAME "Shenzhen Files"
+
+/* Fills @host for Shenzhen Files; strings point into @bundle and static storage. */
+void nautilus_friends_host_init (SZFriendsGtkHost            *host,
+                                 const NautilusFriendsBundle *bundle,
+                                 gpointer                     host_data);
+
+/* Where a received file is shown: its folder, with the file selected (no selection for "/"). FALSE for a path
+ * that is not absolute. */
+gboolean nautilus_friends_reveal_target (const char  *path,
+                                         GFile      **folder,
+                                         GFile      **selection);
+
+/* Opens @folder with @selection selected. Production: nautilus_application_open_location() on @host_data, the
+ * application. Tests record instead; NULL restores production. */
+typedef void (*NautilusFriendsOpener) (gpointer  host_data,
+                                       GFile    *folder,
+                                       GFile    *selection);
+void nautilus_friends_host_set_opener (NautilusFriendsOpener opener);
+
+/* ---- `#` items (nautilus-friends-items.c) ----------------------------------------------------------------- */
+
+/* One screen of the picker and some scrolling, as in ShenzhenPDF. */
+#define NAUTILUS_FRIENDS_ATTACH_LIMIT 30
+
+/* The selected files that match @query, in selection order, then the other files of the folder that match it,
+ * newest first. Only regular files: links (selected or not, whatever they point to), folders, packages and
+ * unselected hidden files are left out. At most NAUTILUS_FRIENDS_ATTACH_LIMIT. SZFriendsGtkHostItem pointers,
+ * freed with the array. */
+GPtrArray *nautilus_friends_items_collect (GList      *selection,
+                                           GList      *folder_files,
+                                           const char *query);
+
+/* Case- and accent-insensitive substring match; an empty or blank query matches everything. */
+gboolean nautilus_friends_name_matches (const char *name,
+                                        const char *query);
+
+/* The short type name the views draw on a document ("PDF", "Markdown", "ZIP", "File"). */
+char *nautilus_friends_kind_label (const char *name);
+
+/* host->attachable_items: the window's active tab, its selection and its folder. */
+void nautilus_friends_attachable_items (gpointer                host_data,
+                                        GtkWindow              *window,
+                                        const char             *query,
+                                        GCancellable           *cancellable,
+                                        SZFriendsGtkItemsReady  ready,
+                                        gpointer                ready_data);
+
+/* ---- Lifecycle (nautilus-friends.c) ----------------------------------------------------------------------- */
+
+/* Everything the lifecycle does to the outside world, so a test can count it. Production: the views' functions,
+ * the launch spawn on a worker thread and nautilus_friends_prepare_signing(). */
+/* Runs on the main thread when what the helper offers may have changed (nautilus_friends_offers_links). */
+typedef void (*NautilusFriendsLinksChanged) (gpointer data);
+
+typedef struct
+{
+    void (*spawn_at_launch) (void);
+    void (*prepare_signing) (void);
+    SZFriendsGtkLink *(*link_new) (void);
+    void (*link_start) (SZFriendsGtkLink *link);
+    void (*link_stop) (SZFriendsGtkLink *link,
+                       gboolean          friends_disabled);
+    void (*link_free) (SZFriendsGtkLink *link);
+    void (*add_window) (SZFriendsGtkLink *link,
+                        GtkWindow        *window);
+    /* A link that passed the check (nautilus-friends-links.c): its page in a window's Friends dropdown, or, while
+     * Friends is off, the question whether to turn it on. Optional. */
+    void (*show_link) (SZFriendsGtkLink *link,
+                       const char       *payload);
+    void (*ask_to_turn_on) (void);
+    /* Whether the helper offers links now, and a watch on every change of the link's connection, which is when that
+     * can change. Optional: without offers_links, links are never offered. */
+    gboolean (*offers_links) (SZFriendsGtkLink *link);
+    guint (*watch_links) (SZFriendsGtkLink            *link,
+                          NautilusFriendsLinksChanged  changed,
+                          gpointer                     data);
+    void (*unwatch_links) (SZFriendsGtkLink *link,
+                           guint             watch);
+} NautilusFriendsOps;
+
+typedef struct _NautilusFriends NautilusFriends;
+
+/* Follows @settings' friends-enabled. Nothing happens until launch. */
+NautilusFriends  *nautilus_friends_new (const NautilusFriendsOps *ops,
+                                        GSettings                *settings);
+/* While Friends is on: the launch spawn, and nothing else. */
+void              nautilus_friends_launch (NautilusFriends *self);
+/* A browser window: its button arrives once Friends is attached. Forgotten when the window goes. */
+void              nautilus_friends_add_window (NautilusFriends *self,
+                                               GtkWindow       *window);
+/* The first window has painted: attach while Friends is on. */
+void              nautilus_friends_first_paint (NautilusFriends *self);
+/* The link while attached, else NULL. */
+SZFriendsGtkLink *nautilus_friends_get_link (NautilusFriends *self);
+/* A Preferences group that shows the views' Friends settings while attached; refreshed on every change. */
+void              nautilus_friends_add_settings_group (NautilusFriends     *self,
+                                                       AdwPreferencesGroup *group);
+/* A URL handed to the application: FALSE when it is not shenzhenfiles:. A link that passes the check is shown
+ * once Friends is attached (now, or when it attaches); while Friends is off the person is asked to turn it on, and
+ * the link waits. A link that fails is dropped. */
+gboolean          nautilus_friends_take_link (NautilusFriends *self,
+                                              const char      *uri);
+/* TRUE while attached to a helper that offers links (Copy Download Link). */
+gboolean          nautilus_friends_offers_links (NautilusFriends *self);
+/* The action map (the application) that holds Copy Download Link's actions. They are enabled exactly while
+ * nautilus_friends_offers_links(), kept so whenever Friends attaches, detaches or the helper's offer changes, so a
+ * menu already built or open shows or hides the item at once. Forgotten when @actions goes. */
+void              nautilus_friends_set_actions (NautilusFriends *self,
+                                                GActionMap      *actions);
+/* Shutdown: frees the link without turning Friends off, then everything else. */
+void              nautilus_friends_free (NautilusFriends *self);
+
+/* The application's instance (nautilus-friends.c), NULL before startup and after shutdown. */
+NautilusFriends  *nautilus_friends_get (void);
+
+/* ---- Links (nautilus-friends-links.c; shenzhen-pdf PROTOCOL.md § Links) ------------------------------------- */
+
+#define NAUTILUS_FRIENDS_LINK_SCHEME "shenzhenfiles"
+#define NAUTILUS_FRIENDS_LINK_MAX_BYTES 512
+#define NAUTILUS_FRIENDS_COPY_LINK_ACTION "friends-copy-download-link"
+/* Parameterless and never activated: the "Copy Download Link" submenu item hides while it is disabled. */
+#define NAUTILUS_FRIENDS_LINKS_ACTION "friends-download-links"
+
+typedef enum
+{
+    NAUTILUS_FRIENDS_LINK_ACCEPTED,
+    NAUTILUS_FRIENDS_LINK_NOT_OURS,   /* another scheme: not a link for Friends at all */
+    NAUTILUS_FRIENDS_LINK_OVERSIZED,  /* longer than NAUTILUS_FRIENDS_LINK_MAX_BYTES */
+    NAUTILUS_FRIENDS_LINK_MALFORMED,  /* not exactly //friends/link#<kind>.<canonical base64url> */
+    NAUTILUS_FRIENDS_LINK_WRONG_TYPE, /* neither f. nor d., or bytes without that kind's layout */
+} NautilusFriendsLinkRefusal;
+
+/* The payload ("f.…" or "d.…") of shenzhenfiles://friends/link#<payload>, newly allocated, or NULL and why. */
+char *nautilus_friends_link_payload (const char                 *uri,
+                                     NautilusFriendsLinkRefusal *refusal);
+/* Appends "Copy Download Link" with its expiry choice (7 days first, then 1 and 30) to @menu, for the file at @path.
+ * Each choice activates app.friends-copy-download-link with (path, days). The submenu item (on
+ * app.friends-download-links) and its choices are hidden while their action is disabled. */
+void  nautilus_friends_add_link_items (GMenu      *menu,
+                                       const char *path);
+/* Adds both actions to @actions when missing, then enables them exactly when @offers_links. */
+void  nautilus_friends_sync_link_actions (GActionMap *actions,
+                                          gboolean    offers_links);
+/* Production NautilusFriendsOps members: the link's page in the active window's dropdown (once the views have
+ * links), and an alert offering Preferences. */
+void  nautilus_friends_show_link_in_window (SZFriendsGtkLink *link,
+                                            const char       *payload);
+void  nautilus_friends_ask_to_turn_on (void);
+
+G_END_DECLS
diff --git a/src/nautilus-friends.c b/src/nautilus-friends.c
new file mode 100644
index 0000000..8200d4d
--- /dev/null
+++ b/src/nautilus-friends.c
@@ -0,0 +1,495 @@
+/*
+ * nautilus-friends.c: when Shenzhen Friends runs in Shenzhen Files.
+ *
+ * The rules come from the Friends brief's launch gate (shenzhen-pdf docs/plans/shenzhen-friends.md, Product
+ * contract and Release gates), as ShenzhenPDF's SPDFMacFriendsLifecycle applies them:
+ *   - Friends off: nothing runs. No helper, socket, timer or thread; only the setting is read.
+ *   - Friends on, at launch: the helper is started from a worker thread and launch never waits for it.
+ *   - The first window has painted: one link for the whole process (Nautilus windows share a process, unlike
+ *     ShenzhenPDF's), started, and one Friends button per browser window.
+ *   - Turned off: the link tells the helper this app turned Friends off and every button goes.
+ *   - Turned on again: the same link starts again and the buttons come back.
+ *   - Shutdown: the link is freed without turning Friends off.
+ * The lifecycle reaches the views only through NautilusFriendsOps, so test-nautilus-friends counts every call
+ * without a display or a helper.
+ */
+
+#define G_LOG_DOMAIN "nautilus-friends"
+
+#include "nautilus-friends.h"
+#include "nautilus-friends-private.h"
+
+#include "client/szfriends_client.h"
+#include "gtk/szfriends_gtk_link.h"
+#include "nautilus-global-preferences.h"
+#include "nautilus-window.h"
+
+struct _NautilusFriends
+{
+    const NautilusFriendsOps *ops;
+    GSettings *settings;
+    gulong changed_id;
+    gboolean enabled;
+    gboolean painted;
+    gboolean attached;
+    SZFriendsGtkLink *link;     /* from the first attach until shutdown */
+    GPtrArray *windows;         /* GtkWindow, weak */
+    GPtrArray *settings_groups; /* AdwPreferencesGroup, weak */
+    char *pending_link;         /* a link's payload waiting for Friends to attach */
+    GActionMap *actions;        /* Copy Download Link's actions, weak */
+    guint links_watch;          /* while attached */
+};
+
+#define SECTION_KEY "nautilus-friends-section"
+
+static NautilusFriends *app_friends;
+
+/* ---- Lifecycle ---------------------------------------------------------------------------------------------- */
+
+static void
+refresh_settings_group (NautilusFriends     *self,
+                        AdwPreferencesGroup *group)
+{
+    GtkWidget *section = g_object_get_data (G_OBJECT (group), SECTION_KEY);
+
+    /* Attaching or detaching changes what the section talks to, so the old one never stays. */
+    if (section != NULL)
+    {
+        adw_preferences_group_remove (group, section);
+        g_object_set_data (G_OBJECT (group), SECTION_KEY, NULL);
+        section = NULL;
+    }
+    if (self->attached)
+    {
+        section = szfriends_gtk_settings_section_new (self->link);
+        adw_preferences_group_add (group, section);
+        g_object_set_data (G_OBJECT (group), SECTION_KEY, section);
+    }
+    gtk_widget_set_visible (GTK_WIDGET (group), section != NULL);
+}
+
+static void
+refresh_settings_groups (NautilusFriends *self)
+{
+    for (guint i = 0; i < self->settings_groups->len; i++)
+    {
+        refresh_settings_group (self, g_ptr_array_index (self->settings_groups, i));
+    }
+}
+
+/* Shows the waiting link once Friends is attached; while Friends is off, asks to turn it on and keeps it. */
+static void
+deliver_link (NautilusFriends *self)
+{
+    if (self->pending_link == NULL)
+    {
+        return;
+    }
+    if (self->attached)
+    {
+        g_autofree char *payload = g_steal_pointer (&self->pending_link);
+
+        if (self->ops->show_link != NULL)
+        {
+            self->ops->show_link (self->link, payload);
+        }
+    }
+    else if (!self->enabled && self->ops->ask_to_turn_on != NULL)
+    {
+        self->ops->ask_to_turn_on ();
+    }
+}
+
+gboolean
+nautilus_friends_take_link (NautilusFriends *self,
+                            const char      *uri)
+{
+    NautilusFriendsLinkRefusal refusal = NAUTILUS_FRIENDS_LINK_NOT_OURS;
+    g_autofree char *payload = nautilus_friends_link_payload (uri, &refusal);
+
+    if (refusal == NAUTILUS_FRIENDS_LINK_NOT_OURS)
+    {
+        return FALSE;
+    }
+    /* A refused URL is dropped without a word: no link's page made it, and saying anything about it would only let
+     * whoever crafted it put words in front of the person. */
+    if (payload != NULL)
+    {
+        g_free (self->pending_link);
+        self->pending_link = g_steal_pointer (&payload);
+        deliver_link (self);
+    }
+    return TRUE;
+}
+
+gboolean
+nautilus_friends_offers_links (NautilusFriends *self)
+{
+    return self->attached && self->ops->offers_links != NULL && self->ops->offers_links (self->link);
+}
+
+static void
+sync_link_actions (gpointer data)
+{
+    NautilusFriends *self = data;
+
+    nautilus_friends_sync_link_actions (self->actions, nautilus_friends_offers_links (self));
+}
+
+void
+nautilus_friends_set_actions (NautilusFriends *self,
+                              GActionMap      *actions)
+{
+    g_clear_weak_pointer (&self->actions);
+    g_set_weak_pointer (&self->actions, actions);
+    sync_link_actions (self);
+}
+
+static void
+unwatch_links (NautilusFriends *self)
+{
+    if (self->links_watch != 0 && self->ops->unwatch_links != NULL)
+    {
+        self->ops->unwatch_links (self->link, self->links_watch);
+    }
+    self->links_watch = 0;
+}
+
+static void
+apply (NautilusFriends *self,
+       gboolean         disabling)
+{
+    gboolean wanted = self->painted && self->enabled;
+
+    if (wanted && !self->attached)
+    {
+        /* Before the link's first connect: a team-signed app talks only to a helper of its own team. */
+        self->ops->prepare_signing ();
+        if (self->link == NULL)
+        {
+            self->link = self->ops->link_new ();
+        }
+        if (self->link == NULL)
+        {
+            return;
+        }
+        self->attached = TRUE;
+        if (self->ops->watch_links != NULL)
+        {
+            self->links_watch = self->ops->watch_links (self->link, sync_link_actions, self);
+        }
+        self->ops->link_start (self->link);
+        for (guint i = 0; i < self->windows->len; i++)
+        {
+            self->ops->add_window (self->link, g_ptr_array_index (self->windows, i));
+        }
+        refresh_settings_groups (self);
+        sync_link_actions (self);
+        deliver_link (self);
+    }
+    else if (!wanted && self->attached)
+    {
+        /* disabling: the helper hears that this app turned Friends off, and the link removes every button. */
+        self->attached = FALSE;
+        unwatch_links (self);
+        self->ops->link_stop (self->link, disabling);
+        refresh_settings_groups (self);
+        sync_link_actions (self);
+    }
+}
+
+static void
+on_enabled_changed (GSettings  *settings,
+                    const char *key,
+                    gpointer    user_data)
+{
+    NautilusFriends *self = user_data;
+
+    self->enabled = g_settings_get_boolean (settings, NAUTILUS_PREFERENCES_FRIENDS_ENABLED);
+    apply (self, !self->enabled);
+}
+
+NautilusFriends *
+nautilus_friends_new (const NautilusFriendsOps *ops,
+                      GSettings                *settings)
+{
+    NautilusFriends *self = g_new0 (NautilusFriends, 1);
+
+    self->ops = ops;
+    self->settings = g_object_ref (settings);
+    self->windows = g_ptr_array_new ();
+    self->settings_groups = g_ptr_array_new ();
+    self->enabled = g_settings_get_boolean (settings, NAUTILUS_PREFERENCES_FRIENDS_ENABLED);
+    self->changed_id = g_signal_connect (settings, "changed::" NAUTILUS_PREFERENCES_FRIENDS_ENABLED,
+                                         G_CALLBACK (on_enabled_changed), self);
+    return self;
+}
+
+void
+nautilus_friends_launch (NautilusFriends *self)
+{
+    if (self->enabled)
+    {
+        self->ops->spawn_at_launch ();
+    }
+}
+
+static void
+window_gone (gpointer  data,
+             GObject  *where_the_window_was)
+{
+    NautilusFriends *self = data;
+
+    g_ptr_array_remove (self->windows, where_the_window_was);
+}
+
+void
+nautilus_friends_add_window (NautilusFriends *self,
+                             GtkWindow       *window)
+{
+    if (g_ptr_array_find (self->windows, window, NULL))
+    {
+        return;
+    }
+    g_object_weak_ref (G_OBJECT (window), window_gone, self);
+    g_ptr_array_add (self->windows, window);
+    if (self->attached)
+    {
+        self->ops->add_window (self->link, window);
+    }
+}
+
+void
+nautilus_friends_first_paint (NautilusFriends *self)
+{
+    if (!self->painted)
+    {
+        self->painted = TRUE;
+        apply (self, FALSE);
+    }
+}
+
+SZFriendsGtkLink *
+nautilus_friends_get_link (NautilusFriends *self)
+{
+    return self->attached ? self->link : NULL;
+}
+
+static void
+settings_group_gone (gpointer  data,
+                     GObject  *where_the_group_was)
+{
+    NautilusFriends *self = data;
+
+    g_ptr_array_remove (self->settings_groups, where_the_group_was);
+}
+
+void
+nautilus_friends_add_settings_group (NautilusFriends     *self,
+                                     AdwPreferencesGroup *group)
+{
+    g_object_weak_ref (G_OBJECT (group), settings_group_gone, self);
+    g_ptr_array_add (self->settings_groups, group);
+    refresh_settings_group (self, group);
+}
+
+void
+nautilus_friends_free (NautilusFriends *self)
+{
+    g_clear_signal_handler (&self->changed_id, self->settings);
+    g_clear_object (&self->settings);
+    g_clear_weak_pointer (&self->actions);
+    unwatch_links (self);
+    /* Buttons and the Settings section hold their own references to the link; this drops the app's. */
+    if (self->link != NULL)
+    {
+        self->ops->link_free (self->link);
+    }
+    for (guint i = 0; i < self->windows->len; i++)
+    {
+        g_object_weak_unref (g_ptr_array_index (self->windows, i), window_gone, self);
+    }
+    for (guint i = 0; i < self->settings_groups->len; i++)
+    {
+        g_object_weak_unref (g_ptr_array_index (self->settings_groups, i), settings_group_gone, self);
+    }
+    g_ptr_array_unref (self->windows);
+    g_ptr_array_unref (self->settings_groups);
+    g_free (self->pending_link);
+    g_free (self);
+}
+
+NautilusFriends *
+nautilus_friends_get (void)
+{
+    return app_friends;
+}
+
+/* ---- Production ------------------------------------------------------------------------------------------- */
+
+static void
+spawn_in_thread (GTask        *task,
+                 gpointer      source,
+                 gpointer      data,
+                 GCancellable *cancellable)
+{
+    /* Reading the app's signature and its bundle costs milliseconds; here they stay off the launch path. */
+    const NautilusFriendsBundle *bundle = nautilus_friends_bundle_get ();
+
+    if (bundle->helper_path != NULL)
+    {
+        pid_t pid = 0;
+        szfriends_status status = szfriends_spawn_helper (bundle->helper_path, NULL, &pid);
+
+        if (status != SZFRIENDS_OK)
+        {
+            /* Not fatal: the link spawns again once it attaches. */
+            g_debug ("launch spawn: %s", szfriends_status_name (status));
+        }
+    }
+    g_task_return_boolean (task, TRUE);
+}
+
+static void
+production_spawn_at_launch (void)
+{
+    g_autoptr (GTask) task = g_task_new (NULL, NULL, NULL, NULL);
+
+    g_task_set_name (task, "nautilus-friends-spawn");
+    g_task_run_in_thread (task, spawn_in_thread);
+}
+
+static SZFriendsGtkLink *
+production_link_new (void)
+{
+    SZFriendsGtkHost host;
+    SZFriendsGtkLink *link;
+
+    nautilus_friends_host_init (&host, nautilus_friends_bundle_get (), g_application_get_default ());
+    link = szfriends_gtk_link_new (&host);
+    if (link == NULL)
+    {
+        g_warning ("Shenzhen Friends refused this app's host description; Friends stays off");
+    }
+    return link;
+}
+
+#ifdef SZFRIENDS_GTK_LINKS
+typedef struct
+{
+    NautilusFriendsLinksChanged changed;
+    gpointer data;
+} LinksWatch;
+
+static void
+links_state_changed (SZFriendsGtkLink      *link,
+                     SZFriendsGtkLinkState  state,
+                     gpointer               data)
+{
+    LinksWatch *watch = data;
+
+    (void) link;
+    (void) state;
+    watch->changed (watch->data);
+}
+
+/* The helper says whether it offers links in its welcome, before the link is ready, so every change of the link's
+ * state is when the offer can change. The views have no watch for hosts yet, so this uses the one their own
+ * button uses. */
+static guint
+production_watch_links (SZFriendsGtkLink            *link,
+                        NautilusFriendsLinksChanged  changed,
+                        gpointer                     data)
+{
+    LinksWatch *watch = g_new (LinksWatch, 1);
+
+    watch->changed = changed;
+    watch->data = data;
+    return szfriends_gtk_link_add_state_watch (link, links_state_changed, watch, g_free);
+}
+#endif
+
+static const NautilusFriendsOps production_ops =
+{
+    .spawn_at_launch = production_spawn_at_launch,
+    .prepare_signing = nautilus_friends_prepare_signing,
+    .link_new = production_link_new,
+    .link_start = szfriends_gtk_link_start,
+    .link_stop = szfriends_gtk_link_stop,
+    .link_free = szfriends_gtk_link_free,
+    .add_window = szfriends_gtk_link_add_window,
+    .show_link = nautilus_friends_show_link_in_window,
+    .ask_to_turn_on = nautilus_friends_ask_to_turn_on,
+#ifdef SZFRIENDS_GTK_LINKS
+    .offers_links = szfriends_gtk_link_offers_links,
+    .watch_links = production_watch_links,
+    .unwatch_links = szfriends_gtk_link_remove_state_watch,
+#endif
+};
+
+static void
+first_paint_idle (gpointer data)
+{
+    if (app_friends != NULL)
+    {
+        nautilus_friends_first_paint (app_friends);
+    }
+}
+
+static void
+on_after_paint (GdkFrameClock *clock,
+                gpointer       data)
+{
+    g_signal_handlers_disconnect_by_func (clock, on_after_paint, data);
+    /* Outside the frame: attaching adds buttons, which queues a new layout. */
+    g_idle_add_once (first_paint_idle, NULL);
+}
+
+static void
+on_window_map (GtkWidget *widget,
+               gpointer   data)
+{
+    GdkFrameClock *clock = gtk_widget_get_frame_clock (widget);
+
+    g_signal_handlers_disconnect_by_func (widget, on_window_map, data);
+    /* Mapping is not painting: the first frame is drawn after it, and Friends waits for that frame. */
+    if (clock != NULL)
+    {
+        g_signal_connect (clock, "after-paint", G_CALLBACK (on_after_paint), NULL);
+    }
+    else
+    {
+        g_idle_add_once (first_paint_idle, NULL);
+    }
+}
+
+void
+nautilus_friends_startup (GtkApplication *application)
+{
+    g_return_if_fail (app_friends == NULL);
+
+    app_friends = nautilus_friends_new (&production_ops, nautilus_preferences);
+    nautilus_friends_set_actions (app_friends, G_ACTION_MAP (application));
+    nautilus_friends_launch (app_friends);
+}
+
+void
+nautilus_friends_window_added (GtkWindow *window)
+{
+    if (app_friends == NULL || !NAUTILUS_IS_WINDOW (window))
+    {
+        return;
+    }
+    nautilus_friends_add_window (app_friends, window);
+    /* Watched even while Friends is off, so turning it on later attaches at once. */
+    if (!app_friends->painted)
+    {
+        g_signal_connect (window, "map", G_CALLBACK (on_window_map), NULL);
+    }
+}
+
+void
+nautilus_friends_shutdown (void)
+{
+    g_clear_pointer (&app_friends, nautilus_friends_free);
+}
diff --git a/src/nautilus-friends.h b/src/nautilus-friends.h
new file mode 100644
index 0000000..3ef4ca2
--- /dev/null
+++ b/src/nautilus-friends.h
@@ -0,0 +1,118 @@
+/*
+ * nautilus-friends.h: Shenzhen Friends in Shenzhen Files, as the application sees it.
+ *
+ * Shenzhen Friends (private messages and files between Macs) is built in shenzhen-pdf and linked here as its GTK
+ * views (gtk/szfriends_gtk.h). This adapter tells the views what only Shenzhen Files knows: where each window's
+ * Friends button goes, which files `#` offers, how a received file is shown, and whether Friends is on
+ * (docs/friends-integration.md § 3.3 in the Shenzhen Files repository).
+ *
+ * Built only with -Dfriends_root; without it every function below is an empty inline, so the application's
+ * calls need no #ifdef and Friends leaves no code behind.
+ */
+
+#pragma once
+
+#include <adwaita.h>
+
+G_BEGIN_DECLS
+
+#ifdef NAUTILUS_FRIENDS
+
+/* In the application's startup, after the macOS setup: while Friends is on, starts the helper from a worker
+ * thread and returns at once. Nothing else of Friends runs before the first window has painted. */
+void nautilus_friends_startup (GtkApplication *application);
+
+/* Every new window: a browser window gets its Friends button once Friends is attached. */
+void nautilus_friends_window_added (GtkWindow *window);
+
+/* Application shutdown: disconnects from the helper without turning Friends off. */
+void nautilus_friends_shutdown (void);
+
+/* The Preferences page: the "Enable Shenzhen Friends" switch, what turning it on means, and the views' own
+ * Friends settings while Friends is on. */
+AdwPreferencesPage *nautilus_friends_preferences_page_new (void);
+
+/* A browser window's Friends button follows its sidebar; NULL takes it away. While @split_view (the window's
+ * AdwOverlaySplitView) shows the sidebar, docked or over the files in a narrow window, the button is the last item
+ * of @sidebar_header_bar: right of the window buttons, just before the main view. While the sidebar is hidden it
+ * is at the start of @toolbar (a NautilusToolbar), right after the window buttons and the sidebar toggle. It is
+ * one widget, moved and never copied, so its badge, drop target and popover go with it. */
+void       nautilus_friends_place_button (GtkWidget *split_view,
+                                          GtkWidget *sidebar_header_bar,
+                                          GtkWidget *toolbar,
+                                          GtkWidget *button);
+/* The button placed for @split_view, or NULL. */
+GtkWidget *nautilus_friends_placed_button (GtkWidget *split_view);
+
+/* A URL the application was asked to open: TRUE when it was a Friends link (shenzhenfiles:), shown, kept until
+ * Friends is on, or refused; the caller then opens nothing for it. */
+gboolean   nautilus_friends_open_uri (GtkApplication *application,
+                                      const char     *uri);
+/* The files view's selection menu: Copy Download Link for one selected regular file, while Friends offers links. */
+void       nautilus_friends_selection_menu (GMenu *menu,
+                                            GList *selection);
+
+#else
+
+static inline void
+nautilus_friends_startup (GtkApplication *application)
+{
+    (void) application;
+}
+
+static inline void
+nautilus_friends_window_added (GtkWindow *window)
+{
+    (void) window;
+}
+
+static inline void
+nautilus_friends_shutdown (void)
+{
+}
+
+static inline AdwPreferencesPage *
+nautilus_friends_preferences_page_new (void)
+{
+    return NULL;
+}
+
+static inline void
+nautilus_friends_place_button (GtkWidget *split_view,
+                               GtkWidget *sidebar_header_bar,
+                               GtkWidget *toolbar,
+                               GtkWidget *button)
+{
+    (void) split_view;
+    (void) sidebar_header_bar;
+    (void) toolbar;
+    (void) button;
+}
+
+static inline GtkWidget *
+nautilus_friends_placed_button (GtkWidget *split_view)
+{
+    (void) split_view;
+    return NULL;
+}
+
+static inline gboolean
+nautilus_friends_open_uri (GtkApplication *application,
+                           const char     *uri)
+{
+    (void) application;
+    (void) uri;
+    return FALSE;
+}
+
+static inline void
+nautilus_friends_selection_menu (GMenu *menu,
+                                 GList *selection)
+{
+    (void) menu;
+    (void) selection;
+}
+
+#endif /* NAUTILUS_FRIENDS */
+
+G_END_DECLS
