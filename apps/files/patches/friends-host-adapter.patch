diff --git a/src/nautilus-macos-friends.m b/src/nautilus-macos-friends.m
new file mode 100644
index 0000000..1343953
--- /dev/null
+++ b/src/nautilus-macos-friends.m
@@ -0,0 +1,294 @@
+/*
+ * nautilus-macos-friends.m: what the app bundle and its code signature tell Shenzhen Friends.
+ *
+ * The helper: Contents/Helpers/Shenzhen Friends.app, the same place ShenzhenPDF embeds it. Its version keys are
+ * stamped from friends.lock by package/make-app.sh, and the hello sends them so the running helper can tell
+ * whether this app carries newer Friends code (PROTOCOL.md § Lifecycle). Development runs from build/ embed no
+ * helper and take NAUTILUS_FRIENDS_HELPER instead, like NAUTILUS_DOCK_ICON, but never in a team-signed build.
+ *
+ * The signing policy: a team-signed app must talk only to a helper signed by the same team, or any process
+ * running as the person could point it at a socket of its own and read every message (client/szfriends_client.h,
+ * signing policy). The client library is libc only, so the Team ID and the signature check come from here, through
+ * Security.framework, as ShenzhenPDF's SPDFMacFriendsSigning.mm does. Ad hoc builds have no Team ID and set
+ * nothing, so they keep the uid check and SZFRIENDS_STATE_DIR.
+ *
+ * Plain Core Foundation for the signature (this bridge block is compiled without ARC).
+ */
+
+#define G_LOG_DOMAIN "nautilus-friends"
+
+#include <config.h>
+
+#import <Foundation/Foundation.h>
+#import <Security/Security.h>
+#include <bsm/libbsm.h>
+
+#include "client/szfriends_client.h"
+#include "nautilus-friends-private.h"
+
+/* ---- The bundle --------------------------------------------------------------------------------------------- */
+
+static char *
+plist_string (NSDictionary *info,
+              NSString     *key)
+{
+    id value = info[key];
+
+    return [value isKindOfClass:NSString.class] && [value length] > 0 ? g_strdup ([value UTF8String]) : NULL;
+}
+
+static NSDictionary *
+read_info (NSString *bundle)
+{
+    return [NSDictionary dictionaryWithContentsOfFile:[bundle stringByAppendingPathComponent:@"Contents/Info.plist"]];
+}
+
+static BOOL
+is_helper_app (NSString *app)
+{
+    NSString *executable = [app stringByAppendingPathComponent:@NAUTILUS_FRIENDS_HELPER_EXECUTABLE];
+
+    return [NSFileManager.defaultManager isExecutableFileAtPath:executable];
+}
+
+/* CFBundleVersion is the helper's build number, YYMMDDBB; anything else reads as no number. */
+static guint64
+parse_build_number (const char *text)
+{
+    guint64 number = 0;
+
+    if (text == NULL || *text == '\0')
+    {
+        return 0;
+    }
+    for (const char *p = text; *p != '\0'; p++)
+    {
+        if (!g_ascii_isdigit (*p))
+        {
+            return 0;
+        }
+    }
+    return g_ascii_string_to_unsigned (text, 10, 1, G_MAXUINT64, &number, NULL) ? number : 0;
+}
+
+void
+nautilus_friends_bundle_read (const char            *app_path,
+                              const char            *dev_helper,
+                              gboolean               overrides_allowed,
+                              NautilusFriendsBundle *out)
+{
+    memset (out, 0, sizeof *out);
+    @autoreleasepool
+    {
+        NSString *app = app_path != NULL ? [NSString stringWithUTF8String:app_path] : nil;
+        NSString *helper = nil;
+        BOOL embedded = NO;
+
+        if (app.length > 0)
+        {
+            NSString *candidate = [app stringByAppendingPathComponent:@NAUTILUS_FRIENDS_HELPER_BUNDLE];
+
+            out->app_version = plist_string (read_info (app), @"CFBundleShortVersionString");
+            if (is_helper_app (candidate))
+            {
+                helper = candidate;
+                embedded = YES;
+            }
+        }
+        if (helper == nil && overrides_allowed && dev_helper != NULL && *dev_helper != '\0')
+        {
+            NSString *candidate = [NSString stringWithUTF8String:dev_helper];
+
+            if (candidate.isAbsolutePath && is_helper_app (candidate))
+            {
+                helper = candidate;
+            }
+        }
+        if (helper != nil)
+        {
+            NSDictionary *info = read_info (helper);
+            g_autofree char *build = plist_string (info, @"CFBundleVersion");
+
+            out->helper_path = g_strdup ([helper stringByAppendingPathComponent:
+                                          @NAUTILUS_FRIENDS_HELPER_EXECUTABLE].fileSystemRepresentation);
+            out->helper_build_number = parse_build_number (build);
+            /* Both or neither: a version without its number would claim a handover it cannot back. */
+            out->helper_version = out->helper_build_number != 0
+                                  ? plist_string (info, @"CFBundleShortVersionString") : NULL;
+            if (out->helper_version == NULL)
+            {
+                out->helper_build_number = 0;
+            }
+            /* A standalone helper (development) carries its own animal set; an embedded one shares the app's. */
+            if (!embedded)
+            {
+                NSString *manifest = [helper stringByAppendingPathComponent:
+                                      @"Contents/Resources/Friends/animals/manifest.json"];
+
+                if ([NSFileManager.defaultManager fileExistsAtPath:manifest])
+                {
+                    out->animals_manifest_path = g_strdup (manifest.fileSystemRepresentation);
+                }
+            }
+        }
+    }
+    if (out->app_version == NULL)
+    {
+        out->app_version = g_strdup (PACKAGE_VERSION);
+    }
+}
+
+void
+nautilus_friends_bundle_clear (NautilusFriendsBundle *bundle)
+{
+    g_free (bundle->app_version);
+    g_free (bundle->helper_path);
+    g_free (bundle->helper_version);
+    g_free (bundle->animals_manifest_path);
+    memset (bundle, 0, sizeof *bundle);
+}
+
+const NautilusFriendsBundle *
+nautilus_friends_bundle_get (void)
+{
+    static NautilusFriendsBundle bundle;
+    static gsize once = 0;
+
+    if (g_once_init_enter (&once))
+    {
+        /* First: whether NAUTILUS_FRIENDS_HELPER may count depends on the policy. */
+        nautilus_friends_prepare_signing ();
+        @autoreleasepool
+        {
+            nautilus_friends_bundle_read (NSBundle.mainBundle.bundlePath.fileSystemRepresentation,
+                                          g_getenv ("NAUTILUS_FRIENDS_HELPER"),
+                                          szfriends_environment_overrides_allowed (), &bundle);
+        }
+        g_once_init_leave (&once, 1);
+    }
+    return &bundle;
+}
+
+/* ---- The signing policy ------------------------------------------------------------------------------------- */
+
+char *
+nautilus_friends_own_team_identifier (void)
+{
+    SecCodeRef me = NULL;
+    SecStaticCodeRef code = NULL;
+    CFDictionaryRef info = NULL;
+    CFTypeRef team;
+    OSStatus status;
+    char buffer[64];
+    char *result = NULL;
+
+    if (SecCodeCopySelf (kSecCSDefaultFlags, &me) != errSecSuccess || me == NULL)
+    {
+        return NULL;
+    }
+    status = SecCodeCopyStaticCode (me, kSecCSDefaultFlags, &code);
+    CFRelease (me);
+    if (status != errSecSuccess || code == NULL)
+    {
+        return NULL;
+    }
+    status = SecCodeCopySigningInformation (code, kSecCSSigningInformation, &info);
+    CFRelease (code);
+    if (status != errSecSuccess || info == NULL)
+    {
+        return NULL;
+    }
+    /* Ad hoc and linker signatures carry no team; only a real Team ID turns the check on. */
+    team = CFDictionaryGetValue (info, kSecCodeInfoTeamIdentifier);
+    if (team != NULL && CFGetTypeID (team) == CFStringGetTypeID () && CFStringGetLength (team) > 0 &&
+        CFStringGetCString (team, buffer, sizeof buffer, kCFStringEncodingUTF8))
+    {
+        result = g_strdup (buffer);
+    }
+    CFRelease (info);
+    return result;
+}
+
+gboolean
+nautilus_friends_verify_peer (void       *context,
+                              const void *audit_token,
+                              size_t      length,
+                              const char *requirement)
+{
+    const void *keys[] = { kSecGuestAttributeAudit };
+    const void *values[1];
+    CFDataRef token;
+    CFDictionaryRef attributes;
+    CFStringRef text;
+    SecCodeRef code = NULL;
+    SecRequirementRef required = NULL;
+    OSStatus status;
+
+    /* Any doubt is a refusal: a signed app must never fall back to trusting a helper it could not check.
+     * Security refuses a token of another size as well; it is checked here so none ever reaches it. */
+    if (audit_token == NULL || length != sizeof (audit_token_t) || requirement == NULL || *requirement == '\0')
+    {
+        return FALSE;
+    }
+    token = CFDataCreate (NULL, audit_token, (CFIndex) length);
+    values[0] = token;
+    attributes = CFDictionaryCreate (NULL, keys, values, 1, &kCFTypeDictionaryKeyCallBacks,
+                                     &kCFTypeDictionaryValueCallBacks);
+    CFRelease (token);
+    /* The audit token, unlike a pid, names exactly the process holding the socket, even if it has since exited. */
+    status = SecCodeCopyGuestWithAttributes (NULL, attributes, kSecCSDefaultFlags, &code);
+    CFRelease (attributes);
+    if (status != errSecSuccess || code == NULL)
+    {
+        return FALSE;
+    }
+    text = CFStringCreateWithCString (NULL, requirement, kCFStringEncodingUTF8);
+    status = text != NULL ? SecRequirementCreateWithString (text, kSecCSDefaultFlags, &required) : errSecParam;
+    if (text != NULL)
+    {
+        CFRelease (text);
+    }
+    if (status == errSecSuccess && required != NULL)
+    {
+        status = SecCodeCheckValidity (code, kSecCSDefaultFlags, required);
+        CFRelease (required);
+    }
+    else
+    {
+        status = errSecParam;
+    }
+    CFRelease (code);
+    return status == errSecSuccess;
+}
+
+static bool
+verify_peer (void       *context,
+             const void *audit_token,
+             size_t      length,
+             const char *requirement)
+{
+    return nautilus_friends_verify_peer (context, audit_token, length, requirement);
+}
+
+void
+nautilus_friends_prepare_signing (void)
+{
+    static gsize once = 0;
+
+    if (g_once_init_enter (&once))
+    {
+        g_autofree char *team = nautilus_friends_own_team_identifier ();
+
+        if (team != NULL)
+        {
+            szfriends_status status = szfriends_set_signing_policy (team, verify_peer, NULL);
+
+            /* A malformed team still leaves the policy in force: the library then refuses every helper. */
+            if (status != SZFRIENDS_OK)
+            {
+                g_warning ("Shenzhen Friends signing policy: %s", szfriends_status_name (status));
+            }
+        }
+        g_once_init_leave (&once, 1);
+    }
+}
