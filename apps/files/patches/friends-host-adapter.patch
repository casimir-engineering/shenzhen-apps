diff --git a/meson.build b/meson.build
index 1657231..31aa251 100644
--- a/meson.build
+++ b/meson.build
@@ -168,6 +168,37 @@ else
   # the gnome-desktop-4 pkg-config cflags.
   gsettings_desktop_schemas = dependency('gsettings-desktop-schemas')
 endif
+
+# Shenzhen Friends (docs/friends-integration.md § 3.3 in the Shenzhen Files
+# repository): the GTK views, client library and cJSON come prebuilt in one
+# archive from a pinned shenzhen-pdf checkout, which tools/setup-friends.sh
+# builds. The paths are absolute and outside this tree on purpose: a meson
+# subproject could not reach the views' sibling directories (client/, cJSON).
+friends_root = get_option('friends_root')
+friends_enabled = friends_root != ''
+friends_dep = []
+friends_link_depends = []
+if friends_enabled
+  if not macos_port
+    error('friends_root needs -Dmacos_port=true: Shenzhen Friends ships with the macOS port only')
+  endif
+  if not friends_root.startswith('/')
+    error('friends_root must be an absolute path, not "@0@"'.format(friends_root))
+  endif
+  friends_gtk_lib = friends_root / 'portable' / 'build' / 'friends' / 'gtk' / 'libszfriends_gtk.a'
+  if not import('fs').is_file(friends_gtk_lib)
+    error('friends_root: @0@ is missing; run tools/setup-friends.sh first'.format(friends_gtk_lib))
+  endif
+  friends_dep = declare_dependency(
+    compile_args: ['-DNAUTILUS_FRIENDS=1'],
+    include_directories: include_directories(friends_root / 'portable' / 'friends'),
+    link_args: [friends_gtk_lib],
+    dependencies: [dependency('json-glib-1.0'), gtk, libadwaita],
+  )
+  # link_args are not tracked: relink when setup-friends.sh rebuilds the archive.
+  friends_link_depends = [friends_gtk_lib]
+endif
+
 tinysparql = dependency('tinysparql-3.0', version: '>= 3.8')
 icu_dep = dependency('icu-uc', version: '>=56')
 icu_i18n_dep = dependency('icu-i18n', version: '>=56')
