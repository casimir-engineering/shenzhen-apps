+    include_directories: include_directories(friends_root / 'portable' / 'friends'),
+    link_args: [friends_gtk_lib],
+    dependencies: [dependency('json-glib-1.0'), gtk, libadwaita],
+  )
+  # link_args are not tracked: relink when setup-friends.sh rebuilds the archive.
+  friends_link_depends = [friends_gtk_lib]
+endif
+
