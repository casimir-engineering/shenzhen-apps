new file mode 100644
index 0000000..a901dbd
--- /dev/null
+++ b/src/nautilus-macos-window-shortcuts.c
@@ -0,0 +1,126 @@
+/*
+ * nautilus-macos-window-shortcuts.c: the keys each macOS window binds
+ * after the focused widget has had them.
+ *
+ * Copyright (C) 2026 The Nautilus authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Cmd accelerators for widget-scoped actions owned by other source files
+ * (view./slot. groups are inserted on the window), and Backspace for Back.
+ * Bound in the BUBBLE phase on the window: the focused widget — in
+ * particular text entries with their own Cmd-X/C/V/A/Z and Backspace
+ * bindings (rename, path entry, search) — always gets the key first, and
+ * only unconsumed presses fall through to these.
+ *
+ * While a search is open the window forwards every key to the search field
+ * (nautilus_window_slot_handle_event(), from its own bubble-phase key
+ * controller).  That controller runs after this one: GTK runs a widget's
+ * controllers newest first, and this one is added when the app sets the
+ * window up, after the window added its own.  So Backspace is not bound to
+ * slot.back directly: nautilus_macos_window_shortcuts_delete_key() passes
+ * it on while a search is open, and the search field gets it.
+ */
+
+#include "nautilus-macos-window-shortcuts.h"
+
+static const struct
+{
+    const char *trigger;
+    const char *action;
+} shortcuts[] =
+{
+    /* Text-editing-sensitive combos (menu items carry no equivalents) */
+    { "<Meta>z", "win.undo" },
+    { "<Meta><Shift>z", "win.redo" },
+    { "<Meta>x", "view.cut" },
+    { "<Meta>c", "view.copy" },
+    { "<Meta>v", "view.paste" },
+    { "<Meta>a", "view.select-all" },
+    { "<Meta>Up", "slot.up" },
+    /* Finder parity: Cmd-Down opens the selection */
+    { "<Meta>Down", "view.open-with-default-application" },
+    /* Backups/aliases for combos also present as menu key equivalents */
+    { "<Meta>BackSpace", "view.move-to-trash" },
+    { "<Meta><Shift>BackSpace", "view.delete-permanently-shortcut" },
+    { "<Meta>plus|<Meta>KP_Add", "view.zoom-in" },
+    { "<Meta>KP_Subtract", "view.zoom-out" },
+    { "<Meta>KP_0", "view.zoom-standard" },
+    { "<Meta>greater", "view.show-hidden-files" },
+    /* Browser-style bookmark shortcut (Cmd-D duplicates nothing here) */
+    { "<Meta>d", "slot.bookmark-current-directory" },
+    /* GNOME muscle memory: Cmd-L also opens the location bar */
+    { "<Meta>l", "win.macos-edit-location" },
+};
+
+typedef struct
+{
+    NautilusMacosWindowFunc search_open;
+} DeleteKey;
+
+/* As a binding to slot.back would: with no earlier folder the action is
+ * disabled, nothing happens and the key goes on. */
+static gboolean
+go_back (GtkWidget *window)
+{
+    static GtkShortcutAction *back;
+
+    if (g_once_init_enter_pointer (&back))
+    {
+        g_once_init_leave_pointer (&back, gtk_named_action_new ("slot.back"));
+    }
+
+    return gtk_shortcut_action_activate (back, 0, window, NULL);
+}
+
+gboolean
+nautilus_macos_window_shortcuts_delete_key (GtkWidget               *window,
+                                            NautilusMacosWindowFunc  search_open,
+                                            NautilusMacosWindowFunc  back)
+{
+    if (search_open != NULL && search_open (window))
+    {
+        return FALSE;
+    }
+
+    return back (window);
+}
+
+static gboolean
+on_delete_key (GtkWidget *widget,
+               GVariant  *args,
+               gpointer   user_data)
+{
+    DeleteKey *delete_key = user_data;
+
+    return nautilus_macos_window_shortcuts_delete_key (widget, delete_key->search_open, go_back);
+}
+
+GtkEventController *
+nautilus_macos_window_shortcuts_new (NautilusMacosWindowFunc search_open)
+{
+    GtkShortcutController *controller;
+    DeleteKey *delete_key = g_new0 (DeleteKey, 1);
+
+    controller = GTK_SHORTCUT_CONTROLLER (gtk_shortcut_controller_new ());
+    gtk_event_controller_set_propagation_phase (GTK_EVENT_CONTROLLER (controller),
+                                                GTK_PHASE_BUBBLE);
+
+    for (gsize i = 0; i < G_N_ELEMENTS (shortcuts); i++)
+    {
+        gtk_shortcut_controller_add_shortcut (
+            controller,
+            gtk_shortcut_new (gtk_shortcut_trigger_parse_string (shortcuts[i].trigger),
+                              gtk_named_action_new (shortcuts[i].action)));
+    }
+
+    /* Browser-style Back: the Delete key alone (BackSpace; Cmd-Delete above
+     * still moves to the Trash). */
+    delete_key->search_open = search_open;
+    gtk_shortcut_controller_add_shortcut (
+        controller,
+        gtk_shortcut_new (gtk_keyval_trigger_new (GDK_KEY_BackSpace, 0),
+                          gtk_callback_action_new (on_delete_key, delete_key, g_free)));
+
+    return GTK_EVENT_CONTROLLER (controller);
+}
