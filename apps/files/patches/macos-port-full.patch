+static char *
+make_marker_app (const char *name,
+                 const char *bundle_id)
+{
+    return make_marker_app_with (name, bundle_id, "");
+}
+
+/* The document type the drop target app opens: its own UTI, exported by
+ * the app, for the extension .szfdrop.  (LaunchServices ignores a document
+ * type that names only an extension.)  Rank Alternate: the app never
+ * becomes the default for anything. */
+#define DROP_TARGET_DOCUMENT_TYPES \
+    "<key>UTExportedTypeDeclarations</key><array><dict>\n" \
+    "<key>UTTypeIdentifier</key><string>org.shenzhenfiles.test.dropped-document</string>\n" \
+    "<key>UTTypeDescription</key><string>Shenzhen Files test document</string>\n" \
+    "<key>UTTypeConformsTo</key><array><string>public.data</string></array>\n" \
+    "<key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key>" \
+    "<array><string>szfdrop</string></array></dict>\n" \
+    "</dict></array>\n" \
+    "<key>CFBundleDocumentTypes</key><array><dict>\n" \
+    "<key>CFBundleTypeName</key><string>Shenzhen Files test document</string>\n" \
+    "<key>CFBundleTypeRole</key><string>Viewer</string>\n" \
+    "<key>LSHandlerRank</key><string>Alternate</string>\n" \
+    "<key>LSItemContentTypes</key><array>" \
+    "<string>org.shenzhenfiles.test.dropped-document</string></array>\n" \
+    "</dict></array>\n"
+
+static char *
+marker_contents (const char *app)
+{
+    g_autofree char *marker = g_strconcat (app, ".marker", NULL);
+    char *contents = NULL;
+
+    if (!g_file_get_contents (marker, &contents, NULL, NULL))
+    {
+        return NULL;
+    }
+
+    return contents;
+}
+
+static void
+wait_for_launch (const char *app)
+{
+    gint64 end = g_get_monotonic_time () + LAUNCH_DEADLINE_MS * 1000;
+    g_autofree char *contents = NULL;
+
+    while (g_get_monotonic_time () < end)
+    {
+        g_clear_pointer (&contents, g_free);
+        contents = marker_contents (app);
+        if (contents != NULL && g_str_has_prefix (contents, "launched "))
+        {
+            return;
+        }
+        pump ();
+    }
+
+    g_error ("%s was not launched within %d ms", app, LAUNCH_DEADLINE_MS);
+}
