+static void
+assert_row_action (NautilusFile  *row,
+                   const char    *row_name,
+                   const GSList  *dropped,
+                   const char    *what,
+                   GdkDragAction  expected)
+{
+    GdkDragAction action;
+
+    g_assert_cmpint (nautilus_dnd_get_item_drop (row), ==, NAUTILUS_DND_ITEM_DROP_OPEN_WITH_APP);
+    action = nautilus_dnd_get_item_preferred_action (row, dropped);
+    if (action != expected)
+    {
+        g_error ("dropping %s onto %s: action %d, expected %d", what, row_name, action, expected);
+    }
+}
+
+/* The sidebar asks about every row on each pointer motion, so with several
+ * app bookmarks the questions go to the apps in turn.  Each app's answer is
+ * kept for a second, so LaunchServices is not asked every time, and it is
+ * forgotten when the drag ends or other files are dragged.  An answer that
+ * was kept shows once the dropped file is moved away: asked again,
+ * LaunchServices would refuse it. */
+static void
+test_drop_answers_cached (void)
+{
+    g_autofree char *document = fixture_path ("cache docs/Cached Document.szfdrop");
+    g_autofree char *moved = fixture_path ("cache docs/Cached Document (moved).szfdrop");
+    g_autoptr (GSList) dropped = dropped_files ("cache docs/Cached Document.szfdrop", NULL);
+    g_autoptr (GSList) other = dropped_files ("cache docs/Never Created.szfdrop", NULL);
+    const char *paths[] = { document, NULL };
+    g_autofree char *second_app = NULL;
+    const char *names[] = { "Drop Target.app", "Drop Target Two.app", "Decision.app" };
+    const GdkDragAction answers[] = { GDK_ACTION_COPY, GDK_ACTION_COPY, 0 };
+    NautilusFile *rows[G_N_ELEMENTS (names)];
+    gint64 asked_time;
+    gint64 elapsed;
+
+    write_file (document, "cached document\n");
+    second_app = make_marker_app_with ("Drop Target Two.app", "org.shenzhenfiles.test.drop-target-two",
+                                       DROP_TARGET_DOCUMENT_TYPES);
+    {
+        const char *argv[] = { LSREGISTER, "-f", second_app, NULL };
+
+        run_in (NULL, argv);
+    }
+    rows[0] = load_file (drop_target_app);
+    rows[1] = load_file (second_app);
+    rows[2] = load_file (decision_app);
+
+    /* A new drag: every row is asked about once. */
+    nautilus_dnd_item_drag_ended ();
+    asked_time = g_get_monotonic_time ();
+    for (guint i = 0; i < G_N_ELEMENTS (rows); i++)
+    {
+        assert_row_action (rows[i], names[i], dropped, "a document (first time)", answers[i]);
+    }
+
+    g_assert_cmpint (g_rename (document, moved), ==, 0);
+    g_assert_false (nautilus_macos_application_accepts_files (drop_target_app, paths));
+    g_assert_false (nautilus_macos_application_accepts_files (second_app, paths));
+
+    /* Pointer motions within the second: the rows in turn, each answered as
+     * before although the file is gone. */
+    elapsed = g_get_monotonic_time () - asked_time;
+    g_test_message ("asking again %" G_GINT64_FORMAT " ms after the first answers",
+                    elapsed / 1000);
+    g_assert_cmpint (elapsed, <, G_USEC_PER_SEC / 2);
+    for (guint motion = 0; motion < 5; motion++)
+    {
+        for (guint i = 0; i < G_N_ELEMENTS (rows); i++)
+        {
+            assert_row_action (rows[i], names[i], dropped, "a document (kept answer)", answers[i]);
+        }
+    }
+
+    /* The drag ends: the next drag asks again, and the file is gone. */
+    nautilus_dnd_item_drag_ended ();
+    assert_row_action (rows[0], names[0], dropped, "a document that was moved away", 0);
+
+    /* The file is back; the answer stays for a second, then is asked
+     * again. */
+    g_assert_cmpint (g_rename (moved, document), ==, 0);
+    g_assert_true (nautilus_macos_application_accepts_files (drop_target_app, paths));
+    assert_row_action (rows[0], names[0], dropped, "a document that is back (kept answer)", 0);
+    g_usleep (G_USEC_PER_SEC + G_USEC_PER_SEC / 10);
+    assert_row_action (rows[0], names[0], dropped, "a document that is back (a second later)",
+                       GDK_ACTION_COPY);
+
+    /* Other files dragged: asked again at once, and so is the first drop
+     * when it comes back. */
+    g_assert_cmpint (g_rename (document, moved), ==, 0);
+    assert_row_action (rows[0], names[0], other, "a file that does not exist", 0);
+    assert_row_action (rows[0], names[0], dropped, "a document that was moved away again", 0);
+
+    g_assert_cmpint (g_rename (moved, document), ==, 0);
+    nautilus_dnd_item_drag_ended ();
+    for (guint i = 0; i < G_N_ELEMENTS (rows); i++)
+    {
+        nautilus_file_unref (rows[i]);
+    }
+    g_slist_free_full (g_steal_pointer (&dropped), g_object_unref);
+    g_slist_free_full (g_steal_pointer (&other), g_object_unref);
+}
