 gboolean
 nautilus_file_is_archive (NautilusFile *file)
 {
     const char *mime_type = nautilus_file_get_mime_type (file);

+#ifdef __APPLE__
+    return macos_content_type_is_archive (mime_type);
+#else
     return autoar_check_mime_type_supported (mime_type);
+#endif
+}
+
+#ifdef __APPLE__
+/* What the answer was taken for: the file's name (compared by identity: a
+ * rename replaces it), its activation URI (a link's target) and its
+ * modification time.  Its folder does not matter: what an item is depends
+ * on its own name and contents.  Checking these instead of building the
+ * path keeps a sort, which asks on every comparison, cheap. */
+typedef struct
+{
+    GRefString *name;
+    char *activation_uri;
+    time_t mtime;
+    NautilusMacosPackageKind kind;
+} MacosPackageKind;
+
+static void
+macos_package_kind_free (gpointer data)
+{
+    MacosPackageKind *cached = data;
+
+    g_clear_pointer (&cached->name, g_ref_string_release);
+    g_free (cached->activation_uri);
+    g_free (cached);
+}
+
+static GQuark
+macos_package_kind_quark (void)
+{
+    static GQuark quark = 0;
+
+    if (G_UNLIKELY (quark == 0))
+    {
+        quark = g_quark_from_static_string ("nautilus-macos-package-kind");
+    }
+
+    return quark;
+}
+
+static void
+set_macos_package_kind (NautilusFile             *file,
+                        NautilusMacosPackageKind  kind)
+{
+    MacosPackageKind *cached = g_new0 (MacosPackageKind, 1);
+
+    cached->name = file->details->name != NULL ? g_ref_string_acquire (file->details->name) : NULL;
+    cached->activation_uri = g_strdup (file->details->activation_uri);
+    cached->mtime = nautilus_file_get_mtime (file);
+    cached->kind = kind;
+    g_object_set_qdata_full (G_OBJECT (file), macos_package_kind_quark (), cached, macos_package_kind_free);
+}
+
+static guint macos_package_kinds_worked_out;
+
+guint
+nautilus_file_macos_package_kinds_worked_out (void)
+{
+    return macos_package_kinds_worked_out;
+}
+
+/* Loading a folder answers for its subfolders, off the main thread, while
+ * "folders first" is on (nautilus-macos-listing.c): the sort that first
+ * shows the folder asks about every one of them. */
+static void
+take_macos_package_kind (NautilusFile *file,
+                         GFileInfo    *info)
+{
+    NautilusMacosPackageKind kind;
+
+    if (nautilus_macos_listing_get_package_kind (info, &kind) && nautilus_file_is_directory (file))
+    {
+        set_macos_package_kind (file, kind);
+    }
+}
+
+/* Asked for every activation, every selection change and, with folders
+ * first, every comparison of a sort, so the LaunchServices answer is kept on
+ * the file until its name, link target or modification time changes. */
+static NautilusMacosPackageKind
+get_macos_package_kind (NautilusFile *file)
+{
+    MacosPackageKind *cached;
+    NautilusMacosPackageKind kind;
+    const char *path;
+    time_t mtime;
+
+    /* Only folders can be packages. */
+    if (!nautilus_file_is_directory (file))
+    {
+        return NAUTILUS_MACOS_PACKAGE_NONE;
+    }
+
+    mtime = nautilus_file_get_mtime (file);
+    cached = g_object_get_qdata (G_OBJECT (file), macos_package_kind_quark ());
+    if (cached != NULL && cached->mtime == mtime &&
+        cached->name == file->details->name &&
+        g_strcmp0 (cached->activation_uri, file->details->activation_uri) == 0)
+    {
+        return cached->kind;
+    }
+
+    g_autoptr (GFile) location = nautilus_file_get_activation_location (file);
+
+    path = g_file_peek_path (location);
+    if (path == NULL)
+    {
+        return NAUTILUS_MACOS_PACKAGE_NONE;
+    }
+
+    kind = nautilus_macos_get_package_kind (path);
+    macos_package_kinds_worked_out++;
+    set_macos_package_kind (file, kind);
+
+    return kind;
+}
+
+gboolean
+nautilus_file_is_macos_package (NautilusFile *file)
+{
+    g_return_val_if_fail (NAUTILUS_IS_FILE (file), FALSE);
+
+    return get_macos_package_kind (file) != NAUTILUS_MACOS_PACKAGE_NONE;
+}
+
+gboolean
+nautilus_file_is_macos_application (NautilusFile *file)
+{
+    g_return_val_if_fail (NAUTILUS_IS_FILE (file), FALSE);
+
+    return get_macos_package_kind (file) == NAUTILUS_MACOS_PACKAGE_APPLICATION;
 }
+#endif


