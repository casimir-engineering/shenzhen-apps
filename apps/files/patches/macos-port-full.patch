+static void
+test_app_id_is_self (void)
+{
+    /* The test binary is not a bundle, so nothing is "self". */
+    g_assert_false (nautilus_macos_app_id_is_self ("com.apple.archiveutility"));
+    g_assert_false (nautilus_macos_app_id_is_self ("com.intuition.shenzhenfiles"));
+    g_assert_false (nautilus_macos_app_id_is_self (""));
+    g_assert_false (nautilus_macos_app_id_is_self (NULL));
+}
+
+typedef struct
+{
+    GPtrArray *paths;
+    GPtrArray *errors;  /* GError or a NULL entry per report */
+    guint destroyed;
+    gboolean off_main_thread;
+} OpenRecorder;
+
+static void
+error_free0 (gpointer error)
+{
+    if (error != NULL)
+    {
+        g_error_free (error);
+    }
+}
+
+static void
+open_recorder_init (OpenRecorder *recorder)
+{
+    recorder->paths = g_ptr_array_new_with_free_func (g_free);
+    recorder->errors = g_ptr_array_new_with_free_func (error_free0);
+    recorder->destroyed = 0;
+    recorder->off_main_thread = FALSE;
+}
+
+static void
+on_package_opened (const char *path,
+                   GError     *error,
+                   gpointer    user_data)
+{
+    OpenRecorder *recorder = user_data;
+
+    if (g_thread_self () != main_thread)
+    {
+        recorder->off_main_thread = TRUE;
+    }
+    g_ptr_array_add (recorder->paths, g_strdup (path));
+    g_ptr_array_add (recorder->errors, error != NULL ? g_error_copy (error) : NULL);
+}
+
+static void
+on_open_destroy (gpointer user_data)
+{
+    OpenRecorder *recorder = user_data;
+
+    recorder->destroyed++;
+}
+
+static gboolean
+open_and_wait (OpenRecorder      *recorder,
+               const char *const *paths)
+{
+    guint n_paths = g_strv_length ((char **) paths);
+    gint64 end = g_get_monotonic_time () + LAUNCH_DEADLINE_MS * 1000;
+
+    nautilus_macos_open_packages (paths, on_package_opened, recorder, on_open_destroy);
+
+    /* Reports only ever arrive through the main context. */
+    g_assert_cmpuint (recorder->paths->len, ==, 0);
+
+    while (recorder->destroyed == 0 && g_get_monotonic_time () < end)
+    {
+        pump ();
+    }
+
+    g_assert_cmpuint (recorder->destroyed, ==, 1);
+    g_assert_cmpuint (recorder->paths->len, ==, n_paths);
+    g_assert_false (recorder->off_main_thread);
+
+    return TRUE;
+}
+
+static const GError *
+recorded_error_for (OpenRecorder *recorder,
+                    const char   *path)
+{
+    for (guint i = 0; i < recorder->paths->len; i++)
+    {
+        if (g_str_equal (g_ptr_array_index (recorder->paths, i), path))
+        {
+            return g_ptr_array_index (recorder->errors, i);
+        }
+    }
+
+    g_error ("no report for %s", path);
+    return NULL;
+}
+
+static void
+open_recorder_clear (OpenRecorder *recorder)
+{
+    g_clear_pointer (&recorder->paths, g_ptr_array_unref);
+    g_clear_pointer (&recorder->errors, g_ptr_array_unref);
+}
