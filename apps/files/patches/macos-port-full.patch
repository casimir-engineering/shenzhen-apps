+/*
+ * nautilus-macos-window-shortcuts.h: the keys each macOS window binds
+ * after the focused widget has had them.
+ *
+ * Copyright (C) 2026 The Nautilus authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#pragma once
+
+#include <gtk/gtk.h>
+
+G_BEGIN_DECLS
+
+/* A question about, or an action on, @window's current tab. */
+typedef gboolean (*NautilusMacosWindowFunc) (GtkWidget *window);
+
+/* The controller for a window.  @search_open tells whether a search is open
+ * in the window's current tab (NULL: never). */
+GtkEventController *nautilus_macos_window_shortcuts_new (NautilusMacosWindowFunc search_open);
+
+/* The Delete key once the focused widget has passed it on: goes back with
+ * @back and returns what it returns.  While @search_open, returns FALSE so
+ * the window gives the key to the search field.  The controller calls it
+ * with slot.back; exposed for the test. */
+gboolean nautilus_macos_window_shortcuts_delete_key (GtkWidget               *window,
+                                                     NautilusMacosWindowFunc  search_open,
+                                                     NautilusMacosWindowFunc  back);
+
+G_END_DECLS
