+#ifdef __APPLE__
+#define OPEN_WITH_HISTORY_MAX_APPS 8
+#define OPEN_WITH_HISTORY_VISIBLE_APPS 4
+#define OPEN_WITH_HISTORY_MAX_TYPES 64
+#define OPEN_WITH_HISTORY_MAX_BYTES (1024 * 1024)
+
+typedef struct
+{
+    char *app_id;
+    guint count;
+    gint64 last_used;
+} MacosOpenWithHistoryEntry;
+
+static void
+macos_open_with_history_entry_free (MacosOpenWithHistoryEntry *entry)
+{
+    if (entry == NULL)
+    {
+        return;
+    }
+
+    g_free (entry->app_id);
+    g_free (entry);
+}
+
+static char *
+macos_open_with_app_id (GAppInfo *app_info)
+{
+    const char *id = g_app_info_get_id (app_info);
+
+    if (id != NULL && *id != '\0')
+    {
+        return g_strconcat ("id:", id, NULL);
+    }
+
+    if (G_IS_OSX_APP_INFO (app_info))
+    {
+        const char *bundle_url = g_osx_app_info_get_filename (G_OSX_APP_INFO (app_info));
+
+        if (bundle_url != NULL && *bundle_url != '\0')
+        {
+            return g_strconcat ("url:", bundle_url, NULL);
+        }
+    }
+
+    return NULL;
+}
+
+static char *
+macos_open_with_history_path (void)
+{
+    return g_build_filename (g_get_user_config_dir (), "nautilus",
+                             "open-with-history.ini", NULL);
+}
+
+static char *
+macos_open_with_history_group (const char *content_type)
+{
+    g_autofree char *checksum =
+        g_compute_checksum_for_string (G_CHECKSUM_SHA256, content_type, -1);
+
+    return g_strconcat ("type-", checksum, NULL);
+}
+
+static GKeyFile *
+macos_open_with_history_load (void)
+{
+    g_autofree char *path = macos_open_with_history_path ();
+    GKeyFile *key_file = g_key_file_new ();
+    GStatBuf stat_buf;
+
+    /* Ignore unexpectedly large or malformed state instead of allowing a
+     * private convenience file to consume unbounded memory. */
+    if (g_stat (path, &stat_buf) == 0 &&
+        stat_buf.st_size >= 0 && stat_buf.st_size <= OPEN_WITH_HISTORY_MAX_BYTES)
+    {
+        g_autoptr (GError) error = NULL;
+
+        if (!g_key_file_load_from_file (key_file, path, G_KEY_FILE_NONE, &error))
+        {
+            g_debug ("Ignoring invalid Open With history: %s", error->message);
+            g_key_file_unref (key_file);
+            key_file = g_key_file_new ();
+        }
+    }
+
+    return key_file;
+}
+
+static MacosOpenWithHistoryEntry *
+macos_open_with_history_entry_parse (const char *serialized)
+{
+    g_auto (GStrv) fields = g_strsplit (serialized, "|", 3);
+    char *count_end = NULL;
+    char *time_end = NULL;
+    guint64 count;
+    gint64 last_used;
+    gsize decoded_len = 0;
+    g_autofree guchar *decoded = NULL;
+
+    if (g_strv_length (fields) != 3)
+    {
+        return NULL;
+    }
+
+    errno = 0;
+    count = g_ascii_strtoull (fields[0], &count_end, 10);
+    if (errno != 0 || count_end == fields[0] || *count_end != '\0' ||
+        count == 0 || count > G_MAXUINT)
+    {
+        return NULL;
+    }
+
+    errno = 0;
+    last_used = g_ascii_strtoll (fields[1], &time_end, 10);
+    if (errno != 0 || time_end == fields[1] || *time_end != '\0' || last_used <= 0)
+    {
+        return NULL;
+    }
+
+    decoded = g_base64_decode (fields[2], &decoded_len);
+    if (decoded_len == 0 || memchr (decoded, '\0', decoded_len) != NULL)
+    {
+        return NULL;
+    }
+
+    MacosOpenWithHistoryEntry *entry = g_new0 (MacosOpenWithHistoryEntry, 1);
+    entry->app_id = g_strndup ((const char *) decoded, decoded_len);
+    entry->count = (guint) count;
+    entry->last_used = last_used;
+
+    return entry;
+}
+
+static char *
+macos_open_with_history_entry_serialize (MacosOpenWithHistoryEntry *entry)
+{
+    g_autofree char *encoded =
+        g_base64_encode ((const guchar *) entry->app_id, strlen (entry->app_id));
+
+    return g_strdup_printf ("%u|%" G_GINT64_FORMAT "|%s",
+                            entry->count, entry->last_used, encoded);
+}
+
+static gint
+macos_open_with_history_entry_compare (gconstpointer a,
+                                       gconstpointer b)
+{
+    const MacosOpenWithHistoryEntry *entry_a = *(MacosOpenWithHistoryEntry *const *) a;
+    const MacosOpenWithHistoryEntry *entry_b = *(MacosOpenWithHistoryEntry *const *) b;
+
+    if (entry_a->count != entry_b->count)
+    {
+        return entry_a->count > entry_b->count ? -1 : 1;
+    }
+
+    if (entry_a->last_used != entry_b->last_used)
+    {
+        return entry_a->last_used > entry_b->last_used ? -1 : 1;
+    }
+
+    return g_strcmp0 (entry_a->app_id, entry_b->app_id);
+}
+
+static GPtrArray *
+macos_open_with_history_entries (GKeyFile   *key_file,
+                                 const char *content_type,
+                                 const char *group)
+{
+    g_autofree char *stored_type =
+        g_key_file_get_string (key_file, group, "content-type", NULL);
+    gsize serialized_len = 0;
+    g_auto (GStrv) serialized = NULL;
+    GPtrArray *entries =
+        g_ptr_array_new_with_free_func ((GDestroyNotify) macos_open_with_history_entry_free);
+
+    if (g_strcmp0 (stored_type, content_type) != 0)
+    {
+        return entries;
+    }
+
+    serialized = g_key_file_get_string_list (key_file, group, "apps",
+                                             &serialized_len, NULL);
+    for (gsize i = 0; serialized != NULL && i < serialized_len; i++)
+    {
+        MacosOpenWithHistoryEntry *entry =
+            macos_open_with_history_entry_parse (serialized[i]);
+
+        if (entry != NULL)
+        {
+            g_ptr_array_add (entries, entry);
+        }
+    }
+
+    g_ptr_array_sort (entries, macos_open_with_history_entry_compare);
+
+    return entries;
+}
+
+static gboolean
+macos_open_with_history_save (GKeyFile *key_file)
+{
+    g_autofree char *path = macos_open_with_history_path ();
+    g_autofree char *directory = g_path_get_dirname (path);
+    g_autofree char *temporary = g_strconcat (path, ".XXXXXX", NULL);
+    gsize data_len = 0;
+    g_autofree char *data = g_key_file_to_data (key_file, &data_len, NULL);
+    int fd;
+    int saved_errno = 0;
+    gsize written = 0;
+    gboolean success = FALSE;
+
+    if (g_mkdir_with_parents (directory, 0700) != 0)
+    {
+        g_warning ("Could not create private Open With history directory: %s",
+                   g_strerror (errno));
+        return FALSE;
+    }
+
+    fd = g_mkstemp_full (temporary, O_RDWR | O_CLOEXEC, 0600);
+    if (fd < 0)
+    {
+        g_warning ("Could not create Open With history: %s", g_strerror (errno));
+        return FALSE;
+    }
+
+    while (written < data_len)
+    {
+        ssize_t result = write (fd, data + written, data_len - written);
+
+        if (result < 0 && errno == EINTR)
+        {
+            continue;
+        }
+        if (result <= 0)
+        {
+            saved_errno = result < 0 ? errno : EIO;
+            break;
+        }
+
+        written += (gsize) result;
+    }
+
+    if (written == data_len && fsync (fd) != 0)
+    {
+        saved_errno = errno;
+    }
+
+    if (close (fd) != 0 && saved_errno == 0)
+    {
+        saved_errno = errno;
+    }
+    fd = -1;
+
+    if (saved_errno == 0 && g_rename (temporary, path) == 0)
+    {
+        success = TRUE;
+    }
+    else if (saved_errno == 0)
+    {
+        saved_errno = errno;
+    }
+
+    if (!success)
+    {
+        g_unlink (temporary);
+        g_warning ("Could not save Open With history: %s", g_strerror (saved_errno));
+    }
+
+    return success;
+}
+
+static void
+macos_open_with_history_prune_types (GKeyFile   *key_file,
+                                     const char *current_group)
