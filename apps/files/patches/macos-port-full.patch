+}
diff --git a/test/displayless/test-macos-window-shortcuts.c b/test/displayless/test-macos-window-shortcuts.c
new file mode 100644
index 0000000..3555c2f
--- /dev/null
+++ b/test/displayless/test-macos-window-shortcuts.c
@@ -0,0 +1,194 @@
+/*
+ * test-macos-window-shortcuts.c: the keys each macOS window binds after the
+ * focused widget, without a display.
+ *
+ * Copyright (C) 2026 The Nautilus authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * In the file list and the sidebar, the Delete key (BackSpace) goes back,
+ * like the toolbar's Back button; Cmd-Delete still moves the selection to
+ * the Trash and Cmd-Shift-Delete still deletes it.  Text fields (rename,
+ * the path entry, search) keep Backspace for editing: the window's
+ * shortcuts run in the bubble phase, after the focused widget, and GtkText
+ * consumes Backspace.  While a search is open, Delete edits the search even
+ * when the file list has the focus: the window hands every key to the search
+ * field from a key controller that runs after the shortcuts, so the Delete
+ * shortcut must pass the key on then.  Opening a GTK display on macOS makes
+ * the test process a foreground app, so this test creates no widget: it
+ * reads the controller each window gets (nautilus_macos_window_shortcuts_new())
+ * and calls what its Delete shortcut does with a stand-in window.
+ */
+
+#define G_LOG_DOMAIN "test-macos-window-shortcuts"
+
+#include <nautilus-macos-window-shortcuts.h>
+
+#include <gtk/gtk.h>
+
+static void
+collect_actions (GtkShortcutTrigger *trigger,
+                 const char         *action,
+                 guint               keyval,
+                 GdkModifierType     modifiers,
+                 GPtrArray          *found)
+{
+    if (GTK_IS_ALTERNATIVE_TRIGGER (trigger))
+    {
+        GtkAlternativeTrigger *alternative = GTK_ALTERNATIVE_TRIGGER (trigger);
+
+        collect_actions (gtk_alternative_trigger_get_first (alternative), action, keyval, modifiers, found);
+        collect_actions (gtk_alternative_trigger_get_second (alternative), action, keyval, modifiers, found);
+    }
+    else if (GTK_IS_KEYVAL_TRIGGER (trigger) &&
+             gtk_keyval_trigger_get_keyval (GTK_KEYVAL_TRIGGER (trigger)) == keyval &&
+             gtk_keyval_trigger_get_modifiers (GTK_KEYVAL_TRIGGER (trigger)) == modifiers)
+    {
+        g_ptr_array_add (found, g_strdup (action));
+    }
+}
+
+/* The actions the window binds to @keyval with exactly @modifiers. */
+static GPtrArray *
+actions_for (GtkEventController *controller,
+             guint               keyval,
+             GdkModifierType     modifiers)
+{
+    GListModel *model = G_LIST_MODEL (controller);
+    GPtrArray *found = g_ptr_array_new_with_free_func (g_free);
+
+    for (guint i = 0; i < g_list_model_get_n_items (model); i++)
+    {
+        g_autoptr (GtkShortcut) shortcut = g_list_model_get_item (model, i);
+        GtkShortcutAction *action = gtk_shortcut_get_action (shortcut);
+        const char *name = GTK_IS_NAMED_ACTION (action) ?
+                           gtk_named_action_get_action_name (GTK_NAMED_ACTION (action)) :
+                           GTK_IS_CALLBACK_ACTION (action) ? "(callback)" : "(other)";
+
+        collect_actions (gtk_shortcut_get_trigger (shortcut), name, keyval, modifiers, found);
+    }
+
+    return found;
+}
+
+static void
+assert_binds (GtkEventController *controller,
+              guint               keyval,
+              GdkModifierType     modifiers,
+              const char         *action)
+{
+    g_autoptr (GPtrArray) found = actions_for (controller, keyval, modifiers);
+
+    g_assert_cmpuint (found->len, ==, 1);
+    g_assert_cmpstr (g_ptr_array_index (found, 0), ==, action);
+}
+
+/* A stand-in for the window: the Delete shortcut only hands it on. */
+static int window_marker;
+#define WINDOW ((GtkWidget *) &window_marker)
+
+static guint went_back;
+
+static gboolean
+search_closed (GtkWidget *window)
+{
+    g_assert_true (window == WINDOW);
+    return FALSE;
+}
+
+static gboolean
+search_open (GtkWidget *window)
+{
+    g_assert_true (window == WINDOW);
+    return TRUE;
+}
+
+static gboolean
+back (GtkWidget *window)
+{
+    g_assert_true (window == WINDOW);
+    went_back++;
+    return TRUE;
+}
+
+static gboolean
+nothing_to_go_back_to (GtkWidget *window)
+{
+    return FALSE;
+}
+
+static void
+test_backspace_goes_back (void)
+{
+    g_autoptr (GtkEventController) controller = nautilus_macos_window_shortcuts_new (search_closed);
+
+    assert_binds (controller, GDK_KEY_BackSpace, 0, "(callback)");
+
+    went_back = 0;
+    g_assert_true (nautilus_macos_window_shortcuts_delete_key (WINDOW, search_closed, back));
+    g_assert_cmpuint (went_back, ==, 1);
+    /* With no earlier folder the key goes on, as it did. */
+    g_assert_false (nautilus_macos_window_shortcuts_delete_key (WINDOW, search_closed, nothing_to_go_back_to));
+}
+
+static void
+test_backspace_edits_open_search (void)
+{
+    g_autoptr (GtkEventController) controller = nautilus_macos_window_shortcuts_new (search_open);
+    g_autoptr (GPtrArray) found = actions_for (controller, GDK_KEY_BackSpace, 0);
+
+    /* Bound straight to slot.back, Delete would go back before the window
+     * gave it to the search field. */
+    g_assert_false (g_ptr_array_find_with_equal_func (found, "slot.back", g_str_equal, NULL));
+
+    went_back = 0;
+    g_assert_false (nautilus_macos_window_shortcuts_delete_key (WINDOW, search_open, back));
+    g_assert_cmpuint (went_back, ==, 0);
+}
+
+static void
+test_cmd_backspace_still_trashes (void)
+{
+    g_autoptr (GtkEventController) controller = nautilus_macos_window_shortcuts_new (NULL);
+
+    assert_binds (controller, GDK_KEY_BackSpace, GDK_META_MASK, "view.move-to-trash");
+    assert_binds (controller, GDK_KEY_BackSpace, GDK_META_MASK | GDK_SHIFT_MASK,
+                  "view.delete-permanently-shortcut");
+}
+
+static void
+test_forward_delete_is_not_back (void)
+{
+    g_autoptr (GtkEventController) controller = nautilus_macos_window_shortcuts_new (NULL);
+    g_autoptr (GPtrArray) found = actions_for (controller, GDK_KEY_Delete, 0);
+
+    /* Fn-Delete keeps upstream's binding in the files view (Move to Trash). */
+    g_assert_cmpuint (found->len, ==, 0);
+}
+
+static void
+test_text_fields_keep_backspace (void)
+{
+    g_autoptr (GtkEventController) controller = nautilus_macos_window_shortcuts_new (NULL);
+
+    /* After the focused widget: a text field's own Backspace wins. */
+    g_assert_cmpint (gtk_event_controller_get_propagation_phase (controller), ==, GTK_PHASE_BUBBLE);
+    g_assert_cmpint (gtk_shortcut_controller_get_scope (GTK_SHORTCUT_CONTROLLER (controller)), ==,
+                     GTK_SHORTCUT_SCOPE_LOCAL);
+}
+
+int
+main (int   argc,
+      char *argv[])
+{
+    g_test_init (&argc, &argv, NULL);
+    g_log_set_always_fatal (G_LOG_FATAL_MASK | G_LOG_LEVEL_WARNING | G_LOG_LEVEL_CRITICAL);
+
+    g_test_add_func ("/macos-window-shortcuts/backspace/goes-back", test_backspace_goes_back);
+    g_test_add_func ("/macos-window-shortcuts/backspace/edits-open-search", test_backspace_edits_open_search);
+    g_test_add_func ("/macos-window-shortcuts/backspace/cmd-still-trashes", test_cmd_backspace_still_trashes);
+    g_test_add_func ("/macos-window-shortcuts/backspace/forward-delete-is-not-back", test_forward_delete_is_not_back);
+    g_test_add_func ("/macos-window-shortcuts/backspace/text-fields-keep-it", test_text_fields_keep_backspace);
+
+    return g_test_run ();
+}
