diff --git a/src/resources/ui/meson.build b/src/resources/ui/meson.build
new file mode 100644
index 0000000..bb12822
--- /dev/null
+++ b/src/resources/ui/meson.build
@@ -0,0 +1,47 @@
+# One target per blueprint, each with its own .ui file as its output. The one
+# batch-compile target this replaces declared the directory src/resources as
+# its output; a reconfigure writes nautilus.gresource.xml there and has ninja
+# record the directory's new time, so blueprints changed before a reconfigure
+# were never compiled and the resource kept the old UI (macOS port).
+blueprints = []
+foreach name : [
+  'nautilus-app-chooser',
+  'nautilus-app-chooser-widget',
+  'nautilus-batch-rename-dialog',
+  'nautilus-column-chooser',
+  'nautilus-compress-dialog',
+  'nautilus-date-entry-row',
+  'nautilus-date-range-dialog',
+  'nautilus-file-chooser',
+  'nautilus-file-conflict-dialog',
+  'nautilus-file-properties-change-permissions',
+  'nautilus-files-view-select-items',
+  'nautilus-files-view',
+  'nautilus-grid-cell',
+  'nautilus-grid-view-captions-dialog',
+  'nautilus-history-controls',
+  'nautilus-name-cell',
+  'nautilus-network-address-bar',
+  'nautilus-network-cell',
+  'nautilus-new-folder-dialog',
+  'nautilus-preferences-dialog',
+  'nautilus-operations-ui-manager-request-passphrase',
+  'nautilus-progress-indicator',
+  'nautilus-progress-info-widget',
+  'nautilus-properties-widget',
+  'nautilus-properties-window',
+  'nautilus-rename-file-popover',
+  'nautilus-search-popover',
+  'nautilus-search-types-dialog',
+  'nautilus-sidebar-row',
+  'nautilus-toolbar',
+  'nautilus-view-controls',
+  'nautilus-window',
+  'shortcuts-dialog',
+]
+  blueprints += custom_target('blueprint-' + name,
+    input: name + '.blp',
+    output: name + '.ui',
+    command: [blueprint_cmd, 'compile', '--minify', '--output', '@OUTPUT@', '@INPUT@'],
+  )
+endforeach
