+    /* get_selection() returns the items in reverse view order. */
+    selection = g_list_reverse (selection);
+
+    for (GList *l = selection; l != NULL; l = l->next)
+    {
+        g_autoptr (GFile) location = nautilus_file_get_activation_location (NAUTILUS_FILE (l->data));
+        g_autofree char *path = g_file_get_path (location);
+
+        if (path == NULL)
+        {
+            continue;
+        }
+
+        if (text->len > 0)
+        {
+            g_string_append_c (text, '\n');
+        }
+        g_string_append (text, path);
+    }
+
+    if (text->len == 0)
