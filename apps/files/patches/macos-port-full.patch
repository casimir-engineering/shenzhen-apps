+static void
+test_drop_open_with (void)
+{
+    g_autofree char *document = fixture_path ("drop docs/Dropped Document.szfdrop");
+    g_autofree char *unicode_document = fixture_path ("drop docs/Ünïcode 文件 2.szfdrop");
+    g_autofree char *bundle_before = list_tree (drop_target_app);
+    g_autofree char *bundle_after = NULL;
+    g_autoptr (GSList) dropped = dropped_files ("drop docs/Dropped Document.szfdrop",
+                                                "drop docs/Ünïcode 文件 2.szfdrop",
+                                                "Drop Target.app",
+                                                "https://example.com/Dropped.szfdrop", NULL);
+    g_autoptr (GSList) nothing_local = dropped_files ("Drop Target.app",
+                                                      "https://example.com/Dropped.szfdrop", NULL);
+    NautilusFile *app = load_file (drop_target_app);
+
+    /* What the file view and the sidebar call on a drop: the documents are
+     * handed to the app (the app itself and the web address are left
+     * out). */
+    g_assert_true (nautilus_dnd_open_with_app (app, dropped, NULL));
+    wait_for_opened (drop_target_app, document);
+    wait_for_opened (drop_target_app, unicode_document);
+    g_assert_false (marker_opened_path (drop_target_app, drop_target_app));
+
+    /* They stay where they were, and nothing went into the bundle. */
+    assert_file_contents (document, "first dropped document\n");
+    assert_file_contents (unicode_document, "second dropped document\n");
+    bundle_after = list_tree (drop_target_app);
+    g_assert_cmpstr (bundle_after, ==, bundle_before);
+
+    /* Nothing local to open: nothing happens. */
+    g_assert_false (nautilus_dnd_open_with_app (app, nothing_local, NULL));
+    nautilus_file_unref (app);
+
+    /* The bridge reports once, on the main thread through the main context. */
+    {
+        OpenRecorder recorder;
+        const char *paths[] = { document, NULL };
+        gint64 end = g_get_monotonic_time () + LAUNCH_DEADLINE_MS * 1000;
+
+        open_recorder_init (&recorder);
+        nautilus_macos_open_with_application (drop_target_app, paths, on_package_opened,
+                                              &recorder, on_open_destroy);
+        g_assert_cmpuint (recorder.paths->len, ==, 0);
+        while (recorder.destroyed == 0 && g_get_monotonic_time () < end)
+        {
+            pump ();
+        }
+        g_assert_cmpuint (recorder.destroyed, ==, 1);
+        g_assert_cmpuint (recorder.paths->len, ==, 1);
+        g_assert_false (recorder.off_main_thread);
+        g_assert_null (recorded_error_for (&recorder, drop_target_app));
+        open_recorder_clear (&recorder);
+    }
+
+    /* Not an app, gone, damaged. */
+    {
+        g_autofree char *plain = fixture_path ("Plain Folder");
+        g_autofree char *missing = fixture_path ("Gone.app");
+        g_autofree char *empty_app = fixture_path ("Empty.app");
+        g_autofree char *plain_before = list_tree (plain);
+        g_autofree char *plain_after = NULL;
+        const char *paths[] = { document, NULL };
+        const char *const apps[] = { plain, missing, empty_app };
+        const gint codes[] = { G_IO_ERROR_INVALID_ARGUMENT, G_IO_ERROR_NOT_FOUND, G_IO_ERROR_FAILED };
+
+        for (gsize i = 0; i < G_N_ELEMENTS (apps); i++)
+        {
+            OpenRecorder recorder;
+            gint64 end = g_get_monotonic_time () + LAUNCH_DEADLINE_MS * 1000;
+            const GError *error;
+
+            open_recorder_init (&recorder);
+            nautilus_macos_open_with_application (apps[i], paths, on_package_opened,
+                                                  &recorder, on_open_destroy);
+            while (recorder.destroyed == 0 && g_get_monotonic_time () < end)
+            {
+                pump ();
+            }
+            g_assert_cmpuint (recorder.destroyed, ==, 1);
+            error = recorded_error_for (&recorder, apps[i]);
+            g_test_message ("opening a document with %s: %s", apps[i],
+                            error != NULL ? error->message : "no error");
+            g_assert_error (error, G_IO_ERROR, codes[i]);
+            g_assert_cmpstr (error->message, !=, "");
+            open_recorder_clear (&recorder);
+        }
+
+        plain_after = list_tree (plain);
+        g_assert_cmpstr (plain_after, ==, plain_before);
+    }
+
+    g_slist_free_full (g_steal_pointer (&dropped), g_object_unref);
+    g_slist_free_full (g_steal_pointer (&nothing_local), g_object_unref);
+}
