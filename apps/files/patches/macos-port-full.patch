+static void
+macos_setup_menubar (NautilusApplication *self)
+{
+    g_autoptr (GMenu) menubar = g_menu_new ();
+    g_autoptr (GMenuModel) file_menu = macos_build_file_menu ();
+    g_autoptr (GMenuModel) edit_menu = macos_build_edit_menu ();
+    g_autoptr (GMenuModel) view_menu = macos_build_view_menu ();
+    g_autoptr (GMenuModel) go_menu = macos_build_go_menu ();
+    g_autoptr (GMenuModel) window_menu = macos_build_window_menu ();
+    g_autoptr (GMenuModel) help_menu = macos_build_help_menu ();
+    g_autoptr (GMenuItem) window_item = NULL;
+
+    g_menu_append_submenu (menubar, _("File"), file_menu);
+    g_menu_append_submenu (menubar, _("Edit"), edit_menu);
+    g_menu_append_submenu (menubar, _("View"), view_menu);
+    g_menu_append_submenu (menubar, _("Go"), go_menu);
+
+    /* Tag the Window submenu so GTK registers it as the NSApp windows
+     * menu; AppKit then appends the open-window list automatically. */
+    window_item = g_menu_item_new_submenu (_("Window"), window_menu);
+    g_menu_item_set_attribute (window_item, "gtk-macos-special", "s", "window-submenu");
+    g_menu_append_item (menubar, window_item);
+
+    g_menu_append_submenu (menubar, _("Help"), help_menu);
+
+    gtk_application_set_menubar (GTK_APPLICATION (self), G_MENU_MODEL (menubar));
+}
