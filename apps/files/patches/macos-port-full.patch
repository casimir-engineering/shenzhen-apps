+static gboolean
+column_defaults_to_descending (NautilusListView    *self,
+                               GtkColumnViewColumn *column)
+{
+    GtkListItemFactory *factory = gtk_column_view_column_get_factory (column);
+    NautilusColumn *nautilus_column = g_hash_table_lookup (self->factory_to_column_map, factory);
+    GtkSortType sort_order;
+
+    if (nautilus_column == NULL)
+    {
+        return FALSE;
+    }
+
+    g_object_get (nautilus_column, "default-sort-order", &sort_order, NULL);
+
+    return sort_order == GTK_SORT_DESCENDING;
+}
+
+static gboolean
+scroll_to_top_on_sort_idle (gpointer user_data)
+{
+    NautilusListView *self = NAUTILUS_LIST_VIEW (user_data);
+    GtkSelectionModel *model = gtk_column_view_get_model (self->view_ui);
+
+    self->scroll_to_top_idle_id = 0;
+
+    if (model != NULL &&
+        g_list_model_get_n_items (G_LIST_MODEL (model)) > 0)
+    {
+        gtk_column_view_scroll_to (self->view_ui, 0, NULL, GTK_LIST_SCROLL_NONE, NULL);
+    }
+
+    return G_SOURCE_REMOVE;
+}
+
 static void
 on_sorter_changed (GtkSorter       *sorter,
                    GtkSorterChange  change,
                    gpointer         user_data)
 {
     NautilusListView *self = NAUTILUS_LIST_VIEW (user_data);
+    GtkColumnViewSorter *column_view_sorter = GTK_COLUMN_VIEW_SORTER (sorter);
+    GtkColumnViewColumn *primary = gtk_column_view_sorter_get_primary_sort_column (column_view_sorter);
+
+    /* GtkColumnView always sorts ascending on the first click on a column
+     * header. For columns marked GTK_SORT_DESCENDING in their NautilusColumn
+     * :default-sort-order (dates, size, starred), the expected first-click
+     * order is the descending one (newest/largest first, like Finder), with
+     * a second click toggling as usual. Detect the "switched to a new
+     * column" case and invert the initial direction. */
+    if (primary != NULL &&
+        primary != self->current_sort_column &&
+        gtk_column_view_sorter_get_primary_sort_order (column_view_sorter) == GTK_SORT_ASCENDING &&
+        column_defaults_to_descending (self, primary))
+    {
+        g_signal_handlers_block_by_func (column_view_sorter, on_sorter_changed, self);
+        gtk_column_view_sort_by_column (self->view_ui, primary, GTK_SORT_DESCENDING);
