+/* --- Finder-like Dock lifecycle: reopen handler --------------------------- */
+
+/* Reopen-window placement: the window opened by a Dock-icon click must
+ * appear CENTERED on the screen the user clicked on. With a multi-display
+ * Dock the reliable proxy at reopen time is the screen under the mouse
+ * cursor — the pointer is by definition on the Dock icon that was just
+ * clicked. GTK4 has no window-move API, so positioning happens at the
+ * AppKit level: after the new GtkWindow is MAPPED (GDK creates and places
+ * the NSWindow during realize/present; hooking GtkWidget::map avoids any
+ * fixed sleeps), one main-loop idle later (so GDK's own cascade placement
+ * has finished), grab the NSWindow via the public
+ * gdk_macos_surface_get_native_window() and setFrameOrigin: it centered
+ * in the target screen's visibleFrame (menu-bar/Dock insets respected).
+ * ONLY the reopen-with-no-windows path does this; normal window placement
+ * is untouched. */
+
+typedef struct
+{
+    GtkWindow *window;      /* strong ref, released by apply-site/notify */
+    double x, y, w, h;      /* target screen visibleFrame, AppKit coords */
+} ReopenCenterData;
+
+/* visibleFrame of the screen containing the mouse pointer (AppKit
+ * bottom-left-origin global coordinates); main screen as fallback. */
+static NSRect
+macos_mouse_screen_visible_frame (void)
+{
+    NSPoint p = [NSEvent mouseLocation];
+
+    for (NSScreen *screen in [NSScreen screens])
+    {
+        if (NSMouseInRect (p, [screen frame], NO))
+        {
+            return [screen visibleFrame];
+        }
+    }
+
+    return [[NSScreen mainScreen] visibleFrame];
+}
+
+/* Center @window's NSWindow in the visibleFrame stored in @d. Safe to call
+ * any time after the surface exists; a no-op for maximized/fullscreen
+ * windows (position-only override, never size/state). */
+static void
+macos_center_data_apply (const ReopenCenterData *d)
+{
+    if (d->window == NULL ||
+        !gtk_widget_get_realized (GTK_WIDGET (d->window)) ||
+        gtk_window_is_maximized (d->window) ||
+        gtk_window_is_fullscreen (d->window))
+    {
+        return;
+    }
+
+    GdkSurface *surface = gtk_native_get_surface (GTK_NATIVE (d->window));
+
+    if (surface == NULL || !GDK_IS_MACOS_SURFACE (surface))
+    {
+        return;
+    }
+
+    NSWindow *nswindow = (NSWindow *) gdk_macos_surface_get_native_window (GDK_MACOS_SURFACE (surface));
+
+    if (nswindow == nil)
+    {
+        return;
+    }
+
+    NSRect frame = [nswindow frame];
+    NSPoint origin = NSMakePoint (d->x + (d->w - frame.size.width) / 2.0,
+                                  d->y + (d->h - frame.size.height) / 2.0);
+
+    [nswindow setFrameOrigin:origin];
+    /* visible == NO here proves the first frame the user ever sees is
+     * already the centered one (no wrong-screen flash). */
+    g_debug ("Window placement: centered at %.0f,%.0f on screen visibleFrame "
+             "%.0f,%.0f %.0fx%.0f (was visible before move: %s)",
+             origin.x, origin.y, d->x, d->y, d->w, d->h,
+             [nswindow isVisible] ? "YES" : "no");
+}
+
+static void
+reopen_center_on_map (GtkWidget *widget,
+                      gpointer   user_data)
+{
+    ReopenCenterData *d = user_data;
+
+    /* Synchronous on purpose — this is what makes placement flash-free.
+     * The "map" signal's RUN_FIRST class closure (GtkWindow.map →
+     * gdk_toplevel_present) has already run: the NSWindow exists at its
+     * final size and GDK has applied its own (possibly wrong-screen)
+     * placement. But GDK only orders the NSWindow front at the FIRST
+     * BUFFER SWAP (_gdk_macos_surface_show just sets show_on_next_swap;
+     * see gdkmacossurface.c), which happens after this emission when the
+     * frame clock paints. Moving the window here therefore precedes any
+     * visibility; a deferred idle would lose that race and briefly show
+     * the window at GDK's position. */
+    macos_center_data_apply (d);
+
+    /* Disconnecting frees d via the closure's destroy-notify (which also
+     * guards the window-never-mapped case: widget destruction drops the
+     * ref, no leak). */
+    g_signal_handlers_disconnect_by_func (widget, (gpointer) reopen_center_on_map, d);
+}
+
+static void
+reopen_center_data_destroy (gpointer  data,
+                            GClosure *closure)
+{
+    ReopenCenterData *d = data;
+
+    (void) closure;
+    g_clear_object (&d->window);
+    g_free (d);
+}
+
+static void
+macos_schedule_center_window_on_rect (GtkWindow *window,
+                                      NSRect     target)
+{
+    ReopenCenterData *d = g_new0 (ReopenCenterData, 1);
+
+    d->window = g_object_ref (window);
+    d->x = target.origin.x;
+    d->y = target.origin.y;
+    d->w = target.size.width;
+    d->h = target.size.height;
+
+    if (gtk_widget_get_mapped (GTK_WIDGET (window)))
+    {
+        /* Already mapped (reopen path: activation presented the window
+         * synchronously). GDK's delayed show hasn't ordered the NSWindow
+         * front yet — that happens at the first buffer swap, i.e. the next
+         * paint cycle — so moving it synchronously HERE is still before
+         * first visibility. (An idle would run at a lower priority than
+         * the redraw and flash the window at GDK's position first.) */
+        macos_center_data_apply (d);
+        g_clear_object (&d->window);
+        g_free (d);
+    }
+    else
+    {
+        g_signal_connect_data (window, "map",
+                               G_CALLBACK (reopen_center_on_map), d,
+                               reopen_center_data_destroy, 0);
+    }
+}
+
+/* Reopen path: g_application_activate() presents AND paints the new window
+ * before it returns (the first buffer swap — and with it GDK's delayed
+ * orderFront — happens inside the activation cycle), so scheduling the move
+ * after activate is too late: the window is already visible at GDK's
+ * wrong-screen position for a frame or two. Instead a one-shot
+ * "window-added" handler (fires during GtkWindow construction, well before
+ * realize/present) arms the map hook on the new window — same flash-free
+ * ordering as the cold-launch path. */
+static void
+reopen_center_on_window_added (GtkApplication *application,
+                               GtkWindow      *window,
+                               gpointer        user_data)
+{
+    ReopenCenterData *d = user_data;
+    NSRect target = NSMakeRect (d->x, d->y, d->w, d->h);
+
+    macos_schedule_center_window_on_rect (window, target);
+    g_signal_handlers_disconnect_by_func (application,
+                                          (gpointer) reopen_center_on_window_added,
+                                          d);
+}
+
+static void
+macos_center_next_window_on_rect (GtkApplication *app,
+                                  NSRect          target)
+{
+    ReopenCenterData *d = g_new0 (ReopenCenterData, 1);
+
+    d->window = NULL;
+    d->x = target.origin.x;
+    d->y = target.origin.y;
+    d->w = target.size.width;
+    d->h = target.size.height;
+
+    g_signal_connect_data (app, "window-added",
+                           G_CALLBACK (reopen_center_on_window_added), d,
+                           reopen_center_data_destroy, 0);
+}
+
+/* --- Cold-launch first-window placement ------------------------------------
+ *
+ * On a COLD launch GDK places the first window itself
+ * (_gdk_macos_display_position_toplevel), picking "the monitor under the
+ * mouse" — but it feeds raw AppKit bottom-left-origin [NSEvent mouseLocation]
+ * into _gdk_macos_display_get_monitor_at_display_coords(), which expects GDK
+ * top-left display coords. On multi-display setups that lands on the wrong
+ * screen. Same rule as the reopen path applies: center the FIRST window of a
+ * fresh process on the screen under the mouse at launch time (a Dock-click
+ * launch has the pointer on the Dock's screen).
+ *
+ * capture() runs early in GtkApplication::startup (before GTK settles, so a
+ * moving pointer can't skew the target); apply() is called from the window-
+ * creation path and arms the same synchronous-on-map machinery — one-shot,
+ * so session windows and later user-opened windows keep normal placement.
+ * Position only is overridden (maximized/fullscreen windows are skipped). */
+
+static NSRect launch_target_rect;
+static gboolean launch_target_valid = FALSE;
+static gboolean launch_placement_done = FALSE;
+
+void
+nautilus_macos_launch_placement_capture (void)
+{
+    @autoreleasepool
+    {
+        launch_target_rect = macos_mouse_screen_visible_frame ();
+        launch_target_valid = TRUE;
+    }
+}
+
+void
+nautilus_macos_launch_placement_apply (gpointer window)
+{
+    if (launch_placement_done || !launch_target_valid || window == NULL)
+    {
+        return;
+    }
+
+    launch_placement_done = TRUE;
+    g_debug ("Cold launch: centering first window on screen "
+             "visibleFrame %.0f,%.0f %.0fx%.0f",
+             launch_target_rect.origin.x, launch_target_rect.origin.y,
+             launch_target_rect.size.width, launch_target_rect.size.height);
+    macos_schedule_center_window_on_rect (GTK_WINDOW (window), launch_target_rect);
+}
+
+/* Clicking the Dock icon (or `open -a Nautilus`, or AppleScript `reopen`)
+ * sends the application a reopen Apple event, which AppKit routes to the
+ * NSApplicationDelegate's applicationShouldHandleReopen:hasVisibleWindows:.
+ * GTK4's GtkApplicationQuartzDelegate (gtk/gtkapplication-quartz.c) does NOT
+ * implement that method, so with no windows open a Dock click does nothing.
+ *
+ * Because the selector is entirely unimplemented on the delegate class, no
+ * swizzling is needed: class_addMethod() the missing method onto whatever
+ * class the installed [NSApp delegate] instance is. Returning YES lets
+ * AppKit do its normal thing (deminiaturize / raise windows) when windows
+ * exist; when none exist we g_application_activate() — Nautilus's activate
+ * vfunc opens a new browser window at $HOME — and return NO so AppKit
+ * doesn't also try to unhide anything. The AppKit runloop is integrated
+ * with the GLib main context on macOS, so calling into GLib here is safe. */
+static BOOL
+nautilus_reopen_imp (id        self_,
+                     SEL       _cmd,
+                     NSApplication *sender,
+                     BOOL      has_visible_windows)
+{
+    (void) self_;
+    (void) _cmd;
+    (void) sender;
+
+    GApplication *app = g_application_get_default ();
+    GList *windows = NULL;
+
+    if (app != NULL && GTK_IS_APPLICATION (app))
+    {
+        windows = gtk_application_get_windows (GTK_APPLICATION (app));
+    }
+
+    if (windows == NULL)
+    {
+        if (app != NULL)
+        {
+            /* Capture the target screen BEFORE activating: the pointer sits
+             * on the Dock icon the user just clicked. Arm the placement
+             * BEFORE activating too — activation paints (and shows) the
+             * new window before returning, so a post-activate move would
+             * flash it at GDK's position first. */
+            NSRect target = macos_mouse_screen_visible_frame ();
+
+            g_debug ("Dock reopen with no windows: activating application");
+            macos_center_next_window_on_rect (GTK_APPLICATION (app), target);
+            g_application_activate (app);
+        }
+        return NO;
+    }
+
+    /* Windows exist (possibly miniaturized/hidden): let AppKit handle it. */
+    g_debug ("Dock reopen with %u window(s), visible=%d: default AppKit handling",
+             g_list_length (windows), has_visible_windows);
+    return YES;
+}
+
+void
+nautilus_macos_lifecycle_install_reopen_handler (void)
+{
+    @autoreleasepool
+    {
+        id delegate = [NSApp delegate];
+
+        if (delegate == nil)
+        {
+            g_warning ("Dock reopen handler: NSApp has no delegate yet; "
+                       "Dock-click-with-no-windows will not open a window");
+            return;
+        }
+
+        SEL sel = @selector (applicationShouldHandleReopen:hasVisibleWindows:);
+
+        if ([delegate respondsToSelector:sel])
+        {
+            /* Already present (idempotent re-entry, or a future GTK that
+             * implements it — in which case we must not fight it). */
+            g_debug ("Dock reopen handler: delegate already responds; leaving as-is");
+            return;
+        }
+
+        /* Signature: BOOL (id, SEL, NSApplication *, BOOL) */
+        if (!class_addMethod (object_getClass (delegate), sel,
+                              (IMP) nautilus_reopen_imp, "c@:@c"))
+        {
+            g_warning ("Dock reopen handler: class_addMethod failed");
+            return;
+        }
+
+        g_debug ("Dock reopen handler: installed on %s",
+                 class_getName (object_getClass (delegate)));
+    }
+}
+
+void
+nautilus_macos_menu_init (void)
+{
+    /* The menu bar itself is GMenu on the GTK side; AppKit-level tweaks:
+     * the Dock icon, and the app-menu "Check Permissions…" and
+     * "Finder Integration…" items (deferred until GTK has installed the
+     * menubar; the latter also waits for the former so the order is
+     * stable). */
+    macos_set_dock_icon ();
+    nautilus_macos_menu_add_check_permissions_item ();
+    nautilus_macos_menu_add_finder_integration_item ();
+    nautilus_macos_menu_add_check_updates_item ();
+}
diff --git a/src/nautilus-macos-openwith.m b/src/nautilus-macos-openwith.m
new file mode 100644
index 0000000..47332ef
--- /dev/null
+++ b/src/nautilus-macos-openwith.m
@@ -0,0 +1,263 @@
+/*
+ * nautilus-macos-openwith.m: Open With / default apps via NSWorkspace (W2).
+ *
+ * Copyright (C) 2026 The Nautilus authors
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public
+ * License along with this program; if not, see <http://www.gnu.org/licenses/>.
+ *
+ * Replaces the GAppInfo application-chooser contents on macOS with
+ * LaunchServices data: NSWorkspace URLsForApplicationsToOpenContentType: /
+ * openURLs:withApplicationAtURL:, and "Show in Finder" via
+ * activateFileViewerSelectingURLs:.
+ */
+
+#define G_LOG_DOMAIN "nautilus-macos-bridge"
+
+#include <config.h>
+#include "nautilus-macos-bridge.h"
+
+#import <AppKit/AppKit.h>
+#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+
+void
+nautilus_macos_app_candidate_free (NautilusMacosAppCandidate *candidate)
+{
+    if (candidate == NULL)
+    {
+        return;
+    }
+
+    g_free (candidate->display_name);
+    g_free (candidate->bundle_url);
+    g_free (candidate);
+}
+
+static NautilusMacosAppCandidate *
+candidate_new_for_app_url (NSURL    *app_url,
+                           gboolean  is_default)
+{
+    NautilusMacosAppCandidate *candidate = g_new0 (NautilusMacosAppCandidate, 1);
+    NSString *display_name = nil;
+
+    [app_url getResourceValue:&display_name
+                       forKey:NSURLLocalizedNameKey
+                        error:nil];
+    if (display_name == nil)
+    {
+        display_name = [[NSFileManager defaultManager] displayNameAtPath:[app_url path]];
+    }
+
+    /* Strip the ".app" Finder may leave on the localized name. */
+    if ([display_name hasSuffix:@".app"])
+    {
+        display_name = [display_name stringByDeletingPathExtension];
+    }
+
+    candidate->display_name = g_strdup ([display_name UTF8String]);
+    candidate->bundle_url = g_strdup ([[app_url absoluteString] UTF8String]);
+    candidate->is_default = is_default;
+
+    return candidate;
+}
+
+GList *
+nautilus_macos_get_apps_for_file (const char *path)
+{
+    g_return_val_if_fail (path != NULL, NULL);
+
+    @autoreleasepool
+    {
+        NSURL *file_url = [NSURL fileURLWithPath:@(path)];
+        NSWorkspace *workspace = [NSWorkspace sharedWorkspace];
+        GList *candidates = NULL;
+
+        /* Modern API (macOS 12+): per-file candidate list. Unlike the
+         * content-type variant this also honors per-extension overrides. */
+        NSArray<NSURL *> *app_urls = [workspace URLsForApplicationsToOpenURL:file_url];
+        NSURL *default_url = [workspace URLForApplicationToOpenURL:file_url];
+
+        /* Default app first. */
+        if (default_url != nil)
+        {
+            candidates = g_list_prepend (candidates,
+                                         candidate_new_for_app_url (default_url, TRUE));
+        }
+
+        for (NSURL *app_url in app_urls)
+        {
+            if (default_url != nil && [app_url isEqual:default_url])
+            {
+                continue;
+            }
+
+            candidates = g_list_prepend (candidates,
+                                         candidate_new_for_app_url (app_url, FALSE));
+        }
+
+        candidates = g_list_reverse (candidates);
+
+        g_debug ("nautilus_macos_get_apps_for_file: %u candidates for %s",
+                 g_list_length (candidates), path);
+
+        return candidates;
+    }
+}
+
+gboolean
+nautilus_macos_open_file_with (const char *path,
+                               const char *app_url)
+{
+    g_return_val_if_fail (path != NULL, FALSE);
+    g_return_val_if_fail (app_url != NULL, FALSE);
+
+    @autoreleasepool
+    {
+        NSURL *file_url = [NSURL fileURLWithPath:@(path)];
+        NSURL *application_url = [NSURL URLWithString:@(app_url)];
+
+        if (application_url == nil)
+        {
+            g_warning ("nautilus_macos_open_file_with: invalid app URL %s", app_url);
+            return FALSE;
+        }
+
+        NSWorkspaceOpenConfiguration *configuration =
+            [NSWorkspaceOpenConfiguration configuration];
+        configuration.activates = YES;
+
+        /* The completion handler outlives this call; capture NSString
+         * copies, not the caller-owned C strings. */
+        NSString *path_str = @(path);
+        NSString *app_url_str = @(app_url);
+
+        [[NSWorkspace sharedWorkspace]
+                    openURLs:@[file_url]
+         withApplicationAtURL:application_url
+               configuration:configuration
+           completionHandler:^(NSRunningApplication *app, NSError *error)
+        {
+            if (error != nil)
+            {
+                g_warning ("Launching %s with %s failed: %s",
+                           [path_str UTF8String], [app_url_str UTF8String],
+                           [[error localizedDescription] UTF8String]);
+            }
+        }];
+
+        return TRUE;
+    }
+}
+
+gboolean
+nautilus_macos_show_in_finder (const char *path)
+{
+    g_return_val_if_fail (path != NULL, FALSE);
+
+    const char *paths[] = { path, NULL };
+    return nautilus_macos_show_in_finder_files (paths);
+}
+
+GdkTexture *
+nautilus_macos_app_icon_texture (const char *app_path,
+                                 int         size_px)
+{
+    g_return_val_if_fail (app_path != NULL, NULL);
+    g_return_val_if_fail (size_px > 0, NULL);
+
+    @autoreleasepool
+    {
+        NSString *path_or_url = @(app_path);
+        NSString *bundle_path = path_or_url;
+
+        /* g_osx_app_info_get_filename() returns a file:// URL, despite its
+         * name. Passing that string directly to -iconForFile: asks AppKit
+         * for a literal path beginning with "file://", which produces the
+         * blank Open With rows this bridge is meant to avoid. */
+        if ([path_or_url hasPrefix:@"file:"])
+        {
+            NSURL *bundle_url = [NSURL URLWithString:path_or_url];
+
+            if (bundle_url != nil && [bundle_url isFileURL])
+            {
+                bundle_path = [bundle_url path];
+            }
+        }
+
+        NSImage *icon = [[NSWorkspace sharedWorkspace] iconForFile:bundle_path];
+
+        if (icon == nil)
+        {
+            return NULL;
+        }
+
+        const size_t stride = (size_t) size_px * 4;
+        CGColorSpaceRef color_space = CGColorSpaceCreateDeviceRGB ();
+        CGContextRef context =
+            CGBitmapContextCreate (NULL, size_px, size_px, 8, stride, color_space,
+                                   kCGImageAlphaPremultipliedLast | kCGBitmapByteOrder32Big);
+        CGColorSpaceRelease (color_space);
+
+        if (context == NULL)
+        {
+            return NULL;
+        }
+
+        NSGraphicsContext *ns_context =
+            [NSGraphicsContext graphicsContextWithCGContext:context flipped:NO];
+
+        [NSGraphicsContext saveGraphicsState];
+        [NSGraphicsContext setCurrentContext:ns_context];
+        [icon drawInRect:NSMakeRect (0, 0, size_px, size_px)
+                fromRect:NSZeroRect
+               operation:NSCompositingOperationCopy
+                fraction:1.0];
+        [NSGraphicsContext restoreGraphicsState];
+
+        /* Bitmap layout matches GDK_MEMORY_R8G8B8A8_PREMULTIPLIED (R,G,B,A
+         * in memory, premultiplied alpha), so the pixels transfer verbatim. */
+        g_autoptr (GBytes) bytes =
+            g_bytes_new (CGBitmapContextGetData (context), stride * size_px);
+        GdkTexture *texture =
+            gdk_memory_texture_new (size_px, size_px,
+                                    GDK_MEMORY_R8G8B8A8_PREMULTIPLIED,
+                                    bytes, stride);
+
+        CGContextRelease (context);
+
+        return texture;
+    }
+}
+
+gboolean
+nautilus_macos_show_in_finder_files (const char *const *paths)
+{
+    g_return_val_if_fail (paths != NULL && paths[0] != NULL, FALSE);
+
+    @autoreleasepool
+    {
+        NSMutableArray<NSURL *> *urls = [NSMutableArray array];
+
+        for (const char *const *p = paths; *p != NULL; p++)
+        {
+            [urls addObject:[NSURL fileURLWithPath:@(*p)]];
+        }
+
+        [[NSWorkspace sharedWorkspace] activateFileViewerSelectingURLs:urls];
+
+        g_debug ("nautilus_macos_show_in_finder_files: revealed %lu paths",
+                 (unsigned long) [urls count]);
+
+        return TRUE;
+    }
+}
diff --git a/src/nautilus-macos-packages.m b/src/nautilus-macos-packages.m
new file mode 100644
index 0000000..d35f4eb
--- /dev/null
+++ b/src/nautilus-macos-packages.m
@@ -0,0 +1,638 @@
+/*
+ * nautilus-macos-packages.m: applications, file packages and archive types.
+ *
+ * Copyright (C) 2026 The Nautilus authors
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public
+ * License along with this program; if not, see <http://www.gnu.org/licenses/>.
+ *
+ * Finder treats a file package (an application bundle, an .rtfd document, a
+ * Photos library, …) as one item: opening it launches the application or
+ * hands the document to its app, and only "Show Package Contents" shows what
+ * is inside.  GIO reports every package as a plain folder, content type
+ * "public.folder", so Nautilus used to browse into applications.  The
+ * package decision here is LaunchServices' own, and opening goes through
+ * NSWorkspace with the result delivered on the caller's main context.
+ *
+ * GIO's macOS content types are UTIs ("public.zip-archive"), while
+ * gnome-autoar decides what it can extract from freedesktop MIME types
+ * ("application/zip"); nautilus_file_is_archive() asks this file for the
+ * MIME types of a UTI.
+ *
+ * Compiled without ARC, like the rest of the bridge block.
+ */
+
+#define G_LOG_DOMAIN "nautilus-macos-bridge"
+
+#include <config.h>
+#include "nautilus-macos-bridge.h"
+
+#include <glib/gi18n.h>
+
+#import <AppKit/AppKit.h>
+#import <CoreServices/CoreServices.h>
+#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+
+#include <string.h>
+#include <sys/attr.h>
+#include <sys/stat.h>
+#include <sys/vnode.h>
+
+/* Symbolic links are resolved: LaunchServices describes a link to an app
+ * as "public.symlink", but GIO, and so Nautilus, sees the folder it points
+ * to, and Finder opens the app. */
+static NSURL *
+file_url_for_path (const char *path)
+{
+    NSString *string = [[NSFileManager defaultManager]
+                        stringWithFileSystemRepresentation:path
+                                                    length:strlen (path)];
+
+    return (string != nil) ? [[NSURL fileURLWithPath:string] URLByResolvingSymlinksInPath] : nil;
+}
+
+static guint launchservices_lookups;
+
+/* LaunchServices takes 30-45 µs to classify a folder, and "folders first"
+ * asks about every folder a view loads: a folder of 5000 subfolders took
+ * 0.13-0.18 s longer to load than before apps were told apart, one of 2000
+ * folders named like "com.example.app" 85 ms longer.  A few microseconds of
+ * attributes and type lookups answer most folders without it:
+ *   - only folders are packages;
+ *   - a folder whose bundle bit is set, or which has bundle contents (a
+ *     Contents folder: plug-ins, .osax, .spreporter, ... are packages
+ *     through what their Contents say), is left to LaunchServices;
+ *   - otherwise a folder is a package only when its name has an extension
+ *     of a package type (.app, .rtfd, .pages, ...), and an app when that
+ *     type is an application bundle.
+ * Over the 80 000 folders with an extension under /Applications,
+ * /System/Library and /Library, these agree with LaunchServices on every one
+ * that is not left to it.  A symbolic link is classified by its target,
+ * through LaunchServices.  Returns FALSE when LaunchServices must decide. */
+static gboolean
+get_kind_from_attributes (const char               *path,
+                          gboolean                 *is_folder,
+                          NautilusMacosPackageKind *kind)
+{
+    struct attrlist request = {
+        .bitmapcount = ATTR_BIT_MAP_COUNT,
+        .commonattr = ATTR_CMN_OBJTYPE | ATTR_CMN_FNDRINFO,
+    };
+    struct
+    {
+        u_int32_t length;
+        fsobj_type_t type;
+        u_int8_t finder_info[32];
+    } __attribute__ ((aligned (4), packed)) reply;
+    const char *name = strrchr (path, '/');
+    const char *dot;
+    UInt16 finder_flags;
+
+    *is_folder = FALSE;
+    *kind = NAUTILUS_MACOS_PACKAGE_NONE;
+    if (getattrlist (path, &request, &reply, sizeof reply, FSOPT_NOFOLLOW) != 0 ||
+        reply.length < sizeof reply || reply.type == VLNK)
+    {
+        return FALSE;
+    }
+    if (reply.type != VDIR)
+    {
+        return TRUE;
+    }
+    *is_folder = TRUE;
+
+    /* FolderInfo.finderFlags, stored big-endian after the window bounds. */
+    finder_flags = (UInt16) ((reply.finder_info[8] << 8) | reply.finder_info[9]);
+    if ((finder_flags & kHasBundle) != 0)
+    {
+        return FALSE;
+    }
+
+    name = (name != NULL) ? name + 1 : path;
+    dot = (name[0] != '\0') ? strrchr (name + 1, '.') : NULL;
+    if (dot == NULL || dot[1] == '\0')
+    {
+        return TRUE;
+    }
+
+    {
+        g_autofree char *contents = g_build_filename (path, "Contents", NULL);
+        struct stat contents_stat;
+
+        if (lstat (contents, &contents_stat) == 0)
+        {
+            return FALSE;
+        }
+    }
+
+    @autoreleasepool
+    {
+        NSString *extension = [NSString stringWithUTF8String:dot + 1];
+        UTType *type = (extension != nil)
+                       ? [UTType typeWithFilenameExtension:extension conformingToType:UTTypeDirectory]
+                       : nil;
+
+        if (extension == nil)
+        {
+            return FALSE;
+        }
+        if ([type conformsToType:UTTypePackage])
+        {
+            *kind = [type conformsToType:UTTypeApplicationBundle] ? NAUTILUS_MACOS_PACKAGE_APPLICATION
+                                                                  : NAUTILUS_MACOS_PACKAGE_DOCUMENT;
+        }
+    }
+
+    return TRUE;
+}
+
+guint
+nautilus_macos_package_kind_launchservices_lookups (void)
+{
+    return g_atomic_int_get (&launchservices_lookups);
+}
+
+NautilusMacosPackageKind
+nautilus_macos_get_package_kind (const char *path)
+{
+    gboolean is_folder;
+    NautilusMacosPackageKind kind;
+
+    g_return_val_if_fail (path != NULL, NAUTILUS_MACOS_PACKAGE_NONE);
+
+    if (get_kind_from_attributes (path, &is_folder, &kind))
+    {
+        return kind;
+    }
+
+    g_atomic_int_inc (&launchservices_lookups);
+
+    @autoreleasepool
+    {
+        /* A fresh NSURL, so no resource value cached by an earlier lookup
+         * is reused after a rename.  Resolving symbolic links costs a
+         * lookup per path component, so only a link is resolved. */
+        NSURL *url = is_folder
+                     ? [NSURL fileURLWithFileSystemRepresentation:path isDirectory:YES relativeToURL:nil]
+                     : file_url_for_path (path);
+        NSNumber *is_package = nil;
+        NSNumber *is_application = nil;
+
+        if (url == nil ||
+            ![url getResourceValue:&is_package forKey:NSURLIsPackageKey error:NULL] ||
+            ![is_package boolValue])
+        {
+            return NAUTILUS_MACOS_PACKAGE_NONE;
+        }
+
+        if ([url getResourceValue:&is_application forKey:NSURLIsApplicationKey error:NULL] &&
+            [is_application boolValue])
+        {
+            return NAUTILUS_MACOS_PACKAGE_APPLICATION;
+        }
+
+        return NAUTILUS_MACOS_PACKAGE_DOCUMENT;
+    }
+}
+
+/* --- Opening packages ------------------------------------------------------ */
+
+typedef struct
+{
+    NautilusMacosOpenPackageFunc callback;
+    gpointer user_data;
+    GDestroyNotify destroy;
+    GMainContext *context;
+    gint pending;
+} OpenPackagesBatch;
+
+typedef struct
+{
+    OpenPackagesBatch *batch;
+    char *path;
+    GError *error;
+} OpenPackageResult;
+
+static gboolean
+open_package_result_dispatch (gpointer data)
+{
+    OpenPackageResult *result = data;
+    OpenPackagesBatch *batch = result->batch;
+
+    if (batch->callback != NULL)
+    {
+        batch->callback (result->path, result->error, batch->user_data);
+    }
+
+    if (g_atomic_int_dec_and_test (&batch->pending))
+    {
+        if (batch->destroy != NULL)
+        {
+            batch->destroy (batch->user_data);
+        }
+        g_main_context_unref (batch->context);
+        g_free (batch);
+    }
+
+    g_free (result->path);
+    g_clear_error (&result->error);
+    g_free (result);
+
+    return G_SOURCE_REMOVE;
+}
+
+/* Takes ownership of @error.  Runs on whatever queue NSWorkspace calls its
+ * completion handler on, so the result always travels as an idle source:
+ * g_main_context_invoke() would run the callback right here whenever the
+ * main thread does not hold the context at that moment. */
+static void
+open_package_result_post (OpenPackagesBatch *batch,
+                          const char        *path,
+                          GError            *error)
+{
+    OpenPackageResult *result = g_new0 (OpenPackageResult, 1);
+    GSource *source = g_idle_source_new ();
+
+    result->batch = batch;
+    result->path = g_strdup (path);
+    result->error = error;
+
+    g_source_set_priority (source, G_PRIORITY_DEFAULT);
+    g_source_set_callback (source, open_package_result_dispatch, result, NULL);
+    g_source_set_static_name (source, "[nautilus] macOS package opened");
+    g_source_attach (source, batch->context);
+    g_source_unref (source);
+}
+
+static gboolean
+error_is (NSError  *error,
+          NSString *domain,
+          NSInteger code)
+{
+    return error != nil && error.code == code && [error.domain isEqualToString:domain];
+}
+
+static GError *
+open_package_error_new (NSError *error)
+{
+    NSError *underlying = error.userInfo[NSUnderlyingErrorKey];
+    GIOErrorEnum code = G_IO_ERROR_FAILED;
+    NSString *message = error.localizedDescription;
+    NSString *suggestion = error.localizedRecoverySuggestion;
+
+    if (error_is (error, NSCocoaErrorDomain, NSUserCancelledError) ||
+        error_is (error, NSOSStatusErrorDomain, userCanceledErr) ||
+        error_is (underlying, NSOSStatusErrorDomain, userCanceledErr))
+    {
+        code = G_IO_ERROR_CANCELLED;
+    }
+    else if (error_is (error, NSOSStatusErrorDomain, kLSApplicationNotFoundErr) ||
+             error_is (underlying, NSOSStatusErrorDomain, kLSApplicationNotFoundErr))
+    {
+        code = G_IO_ERROR_NOT_SUPPORTED;
+    }
+    else if (error_is (error, NSCocoaErrorDomain, NSFileNoSuchFileError) ||
+             error_is (error, NSCocoaErrorDomain, NSFileReadNoSuchFileError) ||
+             error_is (underlying, NSOSStatusErrorDomain, fnfErr))
+    {
+        code = G_IO_ERROR_NOT_FOUND;
+    }
+
+    if (message == nil)
+    {
+        message = @"";
+    }
+    if (suggestion != nil && suggestion.length > 0)
+    {
+        message = [NSString stringWithFormat:@"%@ %@", message, suggestion];
+    }
+
+    return g_error_new_literal (G_IO_ERROR, code, [message UTF8String]);
+}
+
+/* The report for a @path that is not an app (@app_needed) or not a package,
+ * or that no longer exists. */
+static GError *
+wrong_kind_error_new (const char *path,
+                      gboolean    app_needed)
+{
+    g_autofree char *name = g_filename_display_basename (path);
+
+    if (!g_file_test (path, G_FILE_TEST_EXISTS))
+    {
+        return g_error_new (G_IO_ERROR, G_IO_ERROR_NOT_FOUND, _("“%s” no longer exists."), name);
+    }
+    if (app_needed)
+    {
+        return g_error_new (G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, _("“%s” is not an app."), name);
+    }
+
+    return g_error_new (G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                        _("“%s” is not an app or a package."), name);
+}
+
+static NSWorkspaceOpenConfiguration *
+open_configuration_new (void)
+{
+    NSWorkspaceOpenConfiguration *configuration = [NSWorkspaceOpenConfiguration configuration];
+
+    configuration.activates = YES;
+    /* Report errors to the caller, which shows them like any other launch
+     * error, instead of LaunchServices showing its own alert as well.  This
+     * does not affect Gatekeeper: macOS still asks before an app downloaded
+     * from the internet opens for the first time. */
+    configuration.promptsUserIfNeeded = NO;
+
+    return configuration;
+}
+
+/* The NSWorkspace completion handler: reports to @batch for @path. */
+static void (^open_completion_new (OpenPackagesBatch *batch,
+                                   const char        *path)) (NSRunningApplication *, NSError *)
+{
+    /* Freed by the completion handler, which NSWorkspace always calls. */
+    char *path_copy = g_strdup (path);
+
+    return [[^(NSRunningApplication *application, NSError *error)
+    {
+        if (error != nil)
+        {
+            g_debug ("Opening %s failed: %s", path_copy, [[error description] UTF8String]);
+        }
+        open_package_result_post (batch, path_copy,
+                                  (error != nil) ? open_package_error_new (error) : NULL);
+        g_free (path_copy);
+    } copy] autorelease];
+}
+
+static void
+open_one_package (OpenPackagesBatch *batch,
+                  const char        *path)
+{
+    NautilusMacosPackageKind kind = nautilus_macos_get_package_kind (path);
+    NSURL *url = file_url_for_path (path);
+    NSWorkspaceOpenConfiguration *configuration;
+
+    if (url == nil || kind == NAUTILUS_MACOS_PACKAGE_NONE)
+    {
+        /* openURL: would show a plain folder in Finder. */
+        open_package_result_post (batch, path,
+                                  wrong_kind_error_new (path, FALSE));
+        return;
+    }
+
+    configuration = open_configuration_new ();
+
+    void (^completion) (NSRunningApplication *, NSError *) = open_completion_new (batch, path);
+
+    if (kind == NAUTILUS_MACOS_PACKAGE_APPLICATION)
+    {
+        [[NSWorkspace sharedWorkspace] openApplicationAtURL:url
+                                              configuration:configuration
+                                          completionHandler:completion];
+    }
+    else
+    {
+        [[NSWorkspace sharedWorkspace] openURL:url
+                                 configuration:configuration
+                             completionHandler:completion];
+    }
+}
+
+void
+nautilus_macos_open_packages (const char *const           *paths,
+                              NautilusMacosOpenPackageFunc  callback,
+                              gpointer                      user_data,
+                              GDestroyNotify                destroy)
+{
+    OpenPackagesBatch *batch;
+    guint n_paths = (paths != NULL) ? g_strv_length ((char **) paths) : 0;
+
+    if (n_paths == 0)
+    {
+        if (destroy != NULL)
+        {
+            destroy (user_data);
+        }
+        return;
+    }
+
+    batch = g_new0 (OpenPackagesBatch, 1);
+    batch->callback = callback;
+    batch->user_data = user_data;
+    batch->destroy = destroy;
+    batch->context = g_main_context_ref_thread_default ();
+    batch->pending = (gint) n_paths;
+
+    @autoreleasepool
+    {
+        for (guint i = 0; i < n_paths; i++)
+        {
+            open_one_package (batch, paths[i]);
+        }
+    }
+}
+
+/* --- Files dropped onto an app --------------------------------------------- */
+
+gboolean
+nautilus_macos_application_accepts_files (const char        *app_path,
+                                          const char *const *paths)
+{
+    g_return_val_if_fail (app_path != NULL, FALSE);
+
+    if (paths == NULL || paths[0] == NULL)
+    {
+        return FALSE;
+    }
+
+    @autoreleasepool
+    {
+        NSURL *app_url = file_url_for_path (app_path);
+
+        if (app_url == nil)
+        {
+            return FALSE;
+        }
+
+        for (guint i = 0; paths[i] != NULL; i++)
+        {
+            /* Resolved like the app: Finder follows a link to the file. */
+            NSURL *url = file_url_for_path (paths[i]);
+            Boolean accepts = false;
+
+            if (url == nil ||
+                LSCanURLAcceptURL ((CFURLRef) url, (CFURLRef) app_url, kLSRolesAll,
+                                   kLSAcceptDefault, &accepts) != noErr ||
+                !accepts)
+            {
+                return FALSE;
+            }
+        }
+    }
+
+    return TRUE;
+}
+
+void
+nautilus_macos_open_with_application (const char                   *app_path,
+                                      const char *const            *paths,
+                                      NautilusMacosOpenPackageFunc  callback,
+                                      gpointer                      user_data,
+                                      GDestroyNotify                destroy)
+{
+    OpenPackagesBatch *batch;
+
+    g_return_if_fail (app_path != NULL);
+
+    batch = g_new0 (OpenPackagesBatch, 1);
+    batch->callback = callback;
+    batch->user_data = user_data;
+    batch->destroy = destroy;
+    batch->context = g_main_context_ref_thread_default ();
+    batch->pending = 1;
+
+    @autoreleasepool
+    {
+        NSURL *app_url = file_url_for_path (app_path);
+        NSMutableArray<NSURL *> *urls = [NSMutableArray array];
+
+        if (app_url == nil ||
+            nautilus_macos_get_package_kind (app_path) != NAUTILUS_MACOS_PACKAGE_APPLICATION)
+        {
+            open_package_result_post (batch, app_path,
+                                      wrong_kind_error_new (app_path, TRUE));
+            return;
+        }
+
+        for (guint i = 0; paths != NULL && paths[i] != NULL; i++)
+        {
+            NSString *string = [[NSFileManager defaultManager]
+                                stringWithFileSystemRepresentation:paths[i]
+                                                            length:strlen (paths[i])];
+
+            if (string != nil)
+            {
+                [urls addObject:[NSURL fileURLWithPath:string]];
+            }
+        }
+
+        /* Only when no name could be read: the caller passes local files. */
+        if (urls.count == 0)
+        {
+            open_package_result_post (batch, app_path,
+                                      g_error_new_literal (G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                                                           _("macOS could not read the names of these files.")));
+            return;
+        }
+
+        [[NSWorkspace sharedWorkspace] openURLs:urls
+                           withApplicationAtURL:app_url
+                                  configuration:open_configuration_new ()
+                              completionHandler:open_completion_new (batch, app_path)];
+    }
+}
+
+gboolean
+nautilus_macos_app_id_is_self (const char *app_id)
+{
+    if (app_id == NULL || *app_id == '\0')
+    {
+        return FALSE;
+    }
+
+    @autoreleasepool
+    {
+        NSString *bundle_id = [[NSBundle mainBundle] bundleIdentifier];
+        NSString *other = [NSString stringWithUTF8String:app_id];
+
+        return bundle_id != nil && other != nil &&
+               [bundle_id caseInsensitiveCompare:other] == NSOrderedSame;
+    }
+}
+
+/* --- Archive content types ------------------------------------------------- */
+
+/* Archive UTIs that macOS describes without a MIME type, or only with a name
+ * freedesktop does not use, mapped to the name gnome-autoar lists.  The other
+ * archive types (zip, tar, gzip, bzip2, xz, lzma, zstd, lzip, compress, 7z,
+ * lha) carry a MIME type autoar knows among their own MIME tags.  Exact UTIs
+ * only: following conformance would make every zip-based document (.docx,
+ * .epub, .jar, …) an archive, which autoar does not treat them as either. */
+static const struct
+{
+    const char *uti;
+    const char *mime_type;
+} archive_mime_types[] = {
+    { "org.gnu.gnu-zip-tar-archive", "application/x-compressed-tar" },        /* .tgz */
+    { "public.tar-bzip2-archive", "application/x-bzip-compressed-tar" },       /* .tbz2, .tbz */
+    { "org.tukaani.tar-xz-archive", "application/x-xz-compressed-tar" },       /* .txz */
+    { "com.facebook.zstandard-tar-archive", "application/x-zstd-compressed-tar" }, /* .tzst */
+    { "com.rarlab.rar-archive", "application/vnd.rar" },                       /* .rar */
+    { "public.cpio-archive", "application/x-cpio" },                           /* .cpio, .pax */
+    { "com.apple.xar-archive", "application/x-xar" },                          /* .xar */
+};
+
+static void
+add_mime_type (GPtrArray  *mime_types,
+               const char *mime_type)
+{
+    for (guint i = 0; i < mime_types->len; i++)
+    {
+        if (g_ascii_strcasecmp (g_ptr_array_index (mime_types, i), mime_type) == 0)
+        {
+            return;
+        }
+    }
+
+    g_ptr_array_add (mime_types, g_ascii_strdown (mime_type, -1));
+}
+
+char **
+nautilus_macos_content_type_get_mime_types (const char *content_type)
+{
+    GPtrArray *mime_types = g_ptr_array_new ();
+
+    if (content_type != NULL && *content_type != '\0')
+    {
+        if (strchr (content_type, '/') != NULL)
+        {
+            add_mime_type (mime_types, content_type);
+        }
+        else
+        {
+            @autoreleasepool
+            {
+                NSString *identifier = [NSString stringWithUTF8String:content_type];
+                UTType *type = (identifier != nil) ? [UTType typeWithIdentifier:identifier] : nil;
+
+                for (NSString *mime_type in type.tags[UTTagClassMIMEType])
+                {
+                    add_mime_type (mime_types, [mime_type UTF8String]);
+                }
+            }
+
+            for (gsize i = 0; i < G_N_ELEMENTS (archive_mime_types); i++)
+            {
+                if (g_ascii_strcasecmp (archive_mime_types[i].uti, content_type) == 0)
+                {
+                    add_mime_type (mime_types, archive_mime_types[i].mime_type);
+                }
+            }
+        }
+    }
+
+    g_ptr_array_add (mime_types, NULL);
+
+    return (char **) g_ptr_array_free (mime_types, FALSE);
+}
diff --git a/src/nautilus-macos-previewer.m b/src/nautilus-macos-previewer.m
new file mode 100644
index 0000000..1414a36
--- /dev/null
+++ b/src/nautilus-macos-previewer.m
@@ -0,0 +1,847 @@
+/*
+ * nautilus-macos-previewer.m: QuickLook space-bar preview (W2).
+ *
+ * Copyright (C) 2026 The Nautilus authors
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public
+ * License along with this program; if not, see <http://www.gnu.org/licenses/>.
+ *
+ * Replaces the Sushi D-Bus previewer (nautilus-previewer.c) with the
+ * system QLPreviewPanel (Quartz / QuickLookUI framework).
+ *
+ * QLPreviewPanel normally locates its data source by walking the responder
+ * chain of the main window for an object implementing the
+ * QLPreviewPanelController informal protocol. Nautilus windows are GTK
+ * (GdkMacosWindow) objects that know nothing about QuickLook, so we add a
+ * lightweight NSWindow category that accepts panel control and hands both
+ * dataSource and delegate duties to a process-wide controller singleton.
+ *
+ * Keyboard focus (W17).  GDK hands a key event to GTK only when it was sent
+ * to a GdkMacosWindow, that is when the Files window is the key window.  The
+ * panel therefore opens with -orderFront:, which QuickLookUI implements as
+ * -_orderFrontAndMakeKey:NO, so the Files window stays key as in Finder:
+ * space and Escape reach the file view's shortcuts and close the panel,
+ * Cmd-Y reaches the File menu's Quick Look item, and arrow keys move the
+ * selection, which the panel follows.
+ *
+ * The panel still becomes key when the user clicks into it.  Its controller
+ * then treats space, Escape and Cmd-W as its own close actions and never
+ * offers them to the delegate, so nothing in this file sees them; what it
+ * sees is the panel resigning key or disappearing.  The controller below
+ * reacts to that: when the app is active and no window has the keyboard, the
+ * Files window the panel was opened from is made key again and GTK's focus is
+ * put back on the file view.  Keys Quick Look does offer the delegate are
+ * classified by nautilus_macos_preview_classify_panel_key().
+ *
+ * The controller is plain C over NautilusMacosPreviewBackend; the AppKit
+ * backend at the end of this file is the only code that touches the panel
+ * and windows, so tests can drive the controller without a display.
+ */
+
+#define G_LOG_DOMAIN "nautilus-macos-bridge"
+
+#include <config.h>
+#include "nautilus-macos-bridge.h"
+
+#import <AppKit/AppKit.h>
+#import <Quartz/Quartz.h>
+
+/* Virtual key codes (kVK_* in HIToolbox/Events.h). */
+enum
+{
+    KEY_CODE_ESCAPE = 53,
+    KEY_CODE_LEFT_ARROW = 123,
+    KEY_CODE_RIGHT_ARROW = 124,
+    KEY_CODE_DOWN_ARROW = 125,
+    KEY_CODE_UP_ARROW = 126,
+};
+
+/* -------------------------------------------------------------------------
+ * Controller singleton: owns the item list, feeds the panel, forwards
+ * arrow-key navigation back to the C side.
+ * ------------------------------------------------------------------------- */
+
+@interface NautilusQLController : NSObject <QLPreviewPanelDataSource, QLPreviewPanelDelegate>
+
+@property (strong) NSArray<NSURL *> *items;
+
++ (NautilusQLController *) shared;
+
+@end
+
+static NautilusMacosPreviewSelectionFunc selection_callback = NULL;
+static gpointer selection_callback_data = NULL;
+
+/* Deliver the selection event from an idle so it does not re-enter the
+ * panel (reloadData & co) while it is still dispatching the key event —
+ * doing that synchronously tears the panel window down. */
+static gboolean
+deliver_selection_event (gpointer data)
+{
+    if (selection_callback != NULL)
+    {
+        selection_callback ((NautilusMacosPreviewDirection) GPOINTER_TO_INT (data),
+                            selection_callback_data);
+    }
+
+    return G_SOURCE_REMOVE;
+}
+
+@implementation NautilusQLController
+
++ (NautilusQLController *) shared
+{
+    static NautilusQLController *instance = nil;
+    static dispatch_once_t once;
+
+    dispatch_once (&once, ^{
+        instance = [[NautilusQLController alloc] init];
+        instance.items = @[];
+    });
+
+    return instance;
+}
+
+- (NSInteger) numberOfPreviewItemsInPreviewPanel: (QLPreviewPanel *) panel
+{
+    return (NSInteger) [self.items count];
+}
+
+- (id<QLPreviewItem>) previewPanel: (QLPreviewPanel *) panel
+                previewItemAtIndex: (NSInteger) index
+{
+    if (index < 0 || (NSUInteger) index >= [self.items count])
+    {
+        return nil;
+    }
+
+    return self.items[(NSUInteger) index];
+}
+
+/* Quick Look calls this only for events it has no use for itself (its own
+ * actions, such as closing on space or Escape, cannot be overridden). */
+- (BOOL) previewPanel: (QLPreviewPanel *) panel
+          handleEvent: (NSEvent *) event
+{
+    if ([event type] != NSEventTypeKeyDown)
+    {
+        return NO;
+    }
+
+    NSString *characters = [event charactersIgnoringModifiers];
+    NSEventModifierFlags flags = [event modifierFlags];
+    NautilusMacosPreviewKey key =
+    {
+        .key_code = [event keyCode],
+        .character = [characters length] > 0 ? [characters characterAtIndex:0] : 0,
+        .modifiers = 0,
+        .native_event = event,
+    };
+
+    if (flags & NSEventModifierFlagCommand)
+    {
+        key.modifiers |= NAUTILUS_MACOS_PREVIEW_MODIFIER_COMMAND;
+    }
+    if (flags & NSEventModifierFlagControl)
+    {
+        key.modifiers |= NAUTILUS_MACOS_PREVIEW_MODIFIER_CONTROL;
+    }
+    if (flags & NSEventModifierFlagOption)
+    {
+        key.modifiers |= NAUTILUS_MACOS_PREVIEW_MODIFIER_OPTION;
+    }
+    if (flags & NSEventModifierFlagShift)
+    {
+        key.modifiers |= NAUTILUS_MACOS_PREVIEW_MODIFIER_SHIFT;
+    }
+
+    return nautilus_macos_preview_panel_key_down (&key);
+}
+
+@end
+
+/* -------------------------------------------------------------------------
+ * QLPreviewPanelController adoption for all NSWindows (GTK windows included)
+ * ------------------------------------------------------------------------- */
+
+@interface NSWindow (NautilusQuickLookControl)
+@end
+
+@implementation NSWindow (NautilusQuickLookControl)
+
+- (BOOL) acceptsPreviewPanelControl: (QLPreviewPanel *) panel
+{
+    return YES;
+}
+
+- (void) beginPreviewPanelControl: (QLPreviewPanel *) panel
+{
+    panel.dataSource = [NautilusQLController shared];
+    panel.delegate = [NautilusQLController shared];
+}
+
+- (void) endPreviewPanelControl: (QLPreviewPanel *) panel
+{
+    panel.dataSource = nil;
+    panel.delegate = nil;
+
+    /* Sent when the panel closes or moves to another window. */
+    nautilus_macos_preview_panel_state_changed ();
+}
+
+@end
+
+/* -------------------------------------------------------------------------
+ * Keyboard-focus controller (plain C over the backend)
+ * ------------------------------------------------------------------------- */
+
+static const NautilusMacosPreviewBackend appkit_backend;
+
+static struct
+{
+    const NautilusMacosPreviewBackend *backend;
+    gpointer backend_data;
+    /* The Files window the panel was opened from, where the keyboard goes
+     * back to.  NULL when the panel is closed. */
+    gpointer files_window;
+    guint n_items;
+    guint check_id;
+    NautilusMacosPreviewFocusFunc focus_callback;
+    gpointer focus_callback_data;
+} preview = { &appkit_backend, NULL, NULL, 0, 0, NULL, NULL };
+
+#define BACKEND (preview.backend)
+#define BACKEND_DATA (preview.backend_data)
+
+/* Make the Files window key again if something else (or nothing) is, then
+ * let the C side focus the file view.  FALSE if that window is gone. */
+static gboolean
+give_keyboard_to_files_window (void)
+{
+    gpointer window = preview.files_window;
+
+    if (window == NULL || !BACKEND->window_can_be_key (window, BACKEND_DATA))
+    {
+        return FALSE;
+    }
+
+    if (BACKEND->key_window (BACKEND_DATA) != window)
+    {
+        BACKEND->window_make_key (window, BACKEND_DATA);
+    }
+
+    if (preview.focus_callback != NULL)
+    {
+        preview.focus_callback (preview.focus_callback_data);
+    }
+
+    return TRUE;
+}
+
+static void
+check_keyboard_focus (void)
+{
+    gboolean visible;
+
+    if (preview.files_window == NULL)
+    {
+        return;
+    }
+
+    /* While the app is in the background there is no key window; AppKit
+     * restores one when the app is activated again. */
+    if (!BACKEND->app_is_active (BACKEND_DATA))
+    {
+        return;
+    }
+
+    visible = BACKEND->panel_is_visible (BACKEND_DATA);
+
+    if (visible && BACKEND->panel_is_key (BACKEND_DATA))
+    {
+        /* The user is working in the panel. */
+        return;
+    }
+
+    if (BACKEND->key_window (BACKEND_DATA) == NULL)
+    {
+        /* Nobody has the keyboard: Quick Look closed itself (space, Escape,
+         * Cmd-W or its close button after the user clicked into it) or is
+         * fading out after doing so. */
+        give_keyboard_to_files_window ();
+    }
+
+    if (!visible)
+    {
+        preview.files_window = NULL;
+    }
+}
+
+static gboolean
+check_keyboard_focus_cb (gpointer user_data)
+{
+    preview.check_id = 0;
+    check_keyboard_focus ();
+
+    return G_SOURCE_REMOVE;
+}
+
+void
+nautilus_macos_preview_panel_state_changed (void)
+{
+    if (preview.check_id == 0)
+    {
+        preview.check_id = g_idle_add (check_keyboard_focus_cb, NULL);
+    }
+}
+
+/* Local paths for @uris, skipping non-local ones; @index_out is the
+ * position of @selected_index among them (0 if it was skipped or out of
+ * range).  NULL if nothing is local. */
+static GPtrArray *
+local_paths_for_uris (const char *const *uris,
+                      int                selected_index,
+                      guint             *index_out)
+{
+    g_autoptr (GPtrArray) paths = g_ptr_array_new_with_free_func (g_free);
+    guint index = 0;
+    int i = 0;
+
+    for (const char *const *p = uris; *p != NULL; p++, i++)
+    {
+        char *path = g_filename_from_uri (*p, NULL, NULL);
+
+        if (path == NULL)
+        {
+            g_debug ("Quick Look: skipping non-local uri %s", *p);
+            continue;
+        }
+
+        if (i == selected_index)
+        {
+            index = paths->len;
+        }
+
+        g_ptr_array_add (paths, path);
+    }
+
+    if (paths->len == 0)
+    {
+        return NULL;
+    }
+
+    *index_out = index;
+    g_ptr_array_add (paths, NULL);
+
+    return g_steal_pointer (&paths);
+}
+
+void
+nautilus_macos_preview_show (const char *const *uris,
+                             int                selected_index,
+                             gpointer           files_window)
+{
+    g_autoptr (GPtrArray) paths = NULL;
+    guint index = 0;
+    gboolean make_key;
+
+    g_return_if_fail (uris != NULL);
+
+    paths = local_paths_for_uris (uris, selected_index, &index);
+    if (paths == NULL)
+    {
+        g_debug ("Quick Look: nothing local to preview");
+        return;
+    }
+
+    if (files_window == NULL)
+    {
+        files_window = BACKEND->key_window (BACKEND_DATA);
+    }
+
+    /* Keep the keyboard in the Files window, as Finder does.  The panel
+     * takes it only when there is no window to keep it in. */
+    make_key = files_window == NULL ||
+               !BACKEND->window_can_be_key (files_window, BACKEND_DATA);
+
+    preview.files_window = files_window;
+    preview.n_items = paths->len - 1;
+
+    BACKEND->panel_show ((const char *const *) paths->pdata, preview.n_items,
+                         index, make_key, BACKEND_DATA);
+}
+
+gboolean
+nautilus_macos_preview_close_if_showing (void)
+{
+    gboolean had_keyboard;
+
+    if (!BACKEND->panel_is_visible (BACKEND_DATA))
+    {
+        return FALSE;
+    }
+
+    had_keyboard = BACKEND->panel_is_key (BACKEND_DATA);
+    BACKEND->panel_close (BACKEND_DATA);
+
+    /* Do not wait for the closing animation to give the keyboard back. */
+    if (had_keyboard)
+    {
+        give_keyboard_to_files_window ();
+    }
+
+    preview.files_window = NULL;
+
+    return TRUE;
+}
+
+void
+nautilus_macos_preview_toggle (const char *const *uris,
+                               int                selected_index,
+                               gpointer           files_window)
+{
+    if (nautilus_macos_preview_close_if_showing ())
+    {
+        return;
+    }
+
+    nautilus_macos_preview_show (uris, selected_index, files_window);
+}
+
+NautilusMacosPreviewKeyAction
+nautilus_macos_preview_classify_panel_key (const NautilusMacosPreviewKey *key,
+                                           guint                          n_items,
+                                           NautilusMacosPreviewDirection *direction)
+{
+    gboolean command = (key->modifiers & NAUTILUS_MACOS_PREVIEW_MODIFIER_COMMAND) != 0;
+    gboolean control = (key->modifiers & NAUTILUS_MACOS_PREVIEW_MODIFIER_CONTROL) != 0;
+    gboolean command_only = key->modifiers == NAUTILUS_MACOS_PREVIEW_MODIFIER_COMMAND;
+    gunichar letter = g_unichar_tolower (key->character);
+
+    g_return_val_if_fail (direction != NULL, NAUTILUS_MACOS_PREVIEW_KEY_PASS);
+
+    /* Quick Look closes on space and Escape itself; these only arrive here
+     * in states where it declined them, and they still mean "close". */
+    if (!command && !control &&
+        (key->key_code == KEY_CODE_ESCAPE || key->character == ' '))
+    {
+        return NAUTILUS_MACOS_PREVIEW_KEY_CLOSE;
+    }
+
+    /* Cmd-Y is the File menu's Quick Look item, which toggles the panel.
+     * The menu normally takes it before the panel does. */
+    if (command_only && letter == 'y')
+    {
+        return NAUTILUS_MACOS_PREVIEW_KEY_CLOSE;
+    }
+
+    switch (key->key_code)
+    {
+        case KEY_CODE_UP_ARROW:
+        {
+            *direction = NAUTILUS_MACOS_PREVIEW_DIRECTION_UP;
+        }
+        break;
+
+        case KEY_CODE_DOWN_ARROW:
+        {
+            *direction = NAUTILUS_MACOS_PREVIEW_DIRECTION_DOWN;
+        }
+        break;
+
+        case KEY_CODE_LEFT_ARROW:
+        {
+            *direction = NAUTILUS_MACOS_PREVIEW_DIRECTION_LEFT;
+        }
+        break;
+
+        case KEY_CODE_RIGHT_ARROW:
+        {
+            *direction = NAUTILUS_MACOS_PREVIEW_DIRECTION_RIGHT;
+        }
+        break;
+
+        default:
+        {
+            if (command)
+            {
+                /* Cmd-O opens the selection in the Files window; other
+                 * command keys stay with Quick Look and the menu bar. */
+                return command_only && letter == 'o' ?
+                       NAUTILUS_MACOS_PREVIEW_KEY_GIVE_TO_FILES :
+                       NAUTILUS_MACOS_PREVIEW_KEY_PASS;
+            }
+
+            /* Return, Tab, typing to select by name: what the Files window
+             * would have received if it had kept the keyboard. */
+            return control ? NAUTILUS_MACOS_PREVIEW_KEY_PASS :
+                   NAUTILUS_MACOS_PREVIEW_KEY_GIVE_TO_FILES;
+        }
+    }
+
+    if (command)
+    {
+        /* Cmd-Up (enclosing folder) and Cmd-Down (open) are Files keys. */
+        return NAUTILUS_MACOS_PREVIEW_KEY_GIVE_TO_FILES;
+    }
+
+    if (control)
+    {
+        return NAUTILUS_MACOS_PREVIEW_KEY_PASS;
+    }
+
+    /* The panel pages through its own items with Left/Right when it holds
+     * more than one (a multiple selection); otherwise every arrow moves the
+     * file view's selection and the panel follows (Finder). */
+    if (n_items > 1 &&
+        (*direction == NAUTILUS_MACOS_PREVIEW_DIRECTION_LEFT ||
+         *direction == NAUTILUS_MACOS_PREVIEW_DIRECTION_RIGHT))
+    {
+        return NAUTILUS_MACOS_PREVIEW_KEY_PASS;
+    }
+
+    return NAUTILUS_MACOS_PREVIEW_KEY_MOVE_SELECTION;
+}
+
+gboolean
+nautilus_macos_preview_panel_key_down (const NautilusMacosPreviewKey *key)
+{
+    NautilusMacosPreviewDirection direction = NAUTILUS_MACOS_PREVIEW_DIRECTION_DOWN;
+
+    g_return_val_if_fail (key != NULL, FALSE);
+
+    switch (nautilus_macos_preview_classify_panel_key (key, preview.n_items, &direction))
+    {
+        case NAUTILUS_MACOS_PREVIEW_KEY_CLOSE:
+        {
+            return nautilus_macos_preview_close_if_showing ();
+        }
+
+        case NAUTILUS_MACOS_PREVIEW_KEY_MOVE_SELECTION:
+        {
+            if (selection_callback == NULL)
+            {
+                return FALSE;
+            }
+
+            g_idle_add (deliver_selection_event, GINT_TO_POINTER (direction));
+            return TRUE;
+        }
+
+        case NAUTILUS_MACOS_PREVIEW_KEY_GIVE_TO_FILES:
+        {
+            gpointer window = preview.files_window;
+
+            if (!give_keyboard_to_files_window ())
+            {
+                return FALSE;
+            }
+
+            BACKEND->window_deliver_key (window, key->native_event, BACKEND_DATA);
+            return TRUE;
+        }
+
+        case NAUTILUS_MACOS_PREVIEW_KEY_PASS:
+        default:
+        {
+            return FALSE;
+        }
+    }
+}
+
+void
+nautilus_macos_preview_set_focus_callback (NautilusMacosPreviewFocusFunc callback,
+                                           gpointer                      user_data)
+{
+    preview.focus_callback = callback;
+    preview.focus_callback_data = user_data;
+}
+
+void
+nautilus_macos_preview_set_backend_for_testing (const NautilusMacosPreviewBackend *backend,
+                                                gpointer                           user_data)
+{
+    g_clear_handle_id (&preview.check_id, g_source_remove);
+    preview.backend = backend != NULL ? backend : &appkit_backend;
+    preview.backend_data = user_data;
+    preview.files_window = NULL;
+    preview.n_items = 0;
+}
+
+/* -------------------------------------------------------------------------
+ * C seams (W2)
+ * ------------------------------------------------------------------------- */
+
+void
+nautilus_macos_preview_set_selection_callback (NautilusMacosPreviewSelectionFunc callback,
+                                               gpointer                          user_data)
+{
+    selection_callback = callback;
+    selection_callback_data = user_data;
+}
+
+void
+nautilus_macos_preview_files (const char *const *uris,
+                              int                selected_index)
+{
+    nautilus_macos_preview_show (uris, selected_index, NULL);
+}
+
+void
+nautilus_macos_preview_hide (void)
+{
+    nautilus_macos_preview_close_if_showing ();
+}
+
+gboolean
+nautilus_macos_preview_is_showing (void)
+{
+    return BACKEND->panel_is_visible (BACKEND_DATA);
+}
+
+/* -------------------------------------------------------------------------
+ * AppKit backend
+ * ------------------------------------------------------------------------- */
+
+static QLPreviewPanel *
+appkit_existing_panel (void)
+{
+    /* Asking for the shared panel creates it; state queries must not. */
+    return [QLPreviewPanel sharedPreviewPanelExists] ? [QLPreviewPanel sharedPreviewPanel] : nil;
+}
+
+/* Window handles are NSWindow pointers.  Look them up among the app's
+ * windows by identity, so a window that has been closed and freed is never
+ * messaged. */
+static NSWindow *
+appkit_live_window (gpointer handle)
+{
+    if (handle == NULL)
+    {
+        return nil;
+    }
+
+    for (NSWindow *window in [NSApp windows])
+    {
+        if ((gpointer) window == handle)
+        {
+            return window;
+        }
+    }
+
+    return nil;
+}
+
+static void
+appkit_observe_panel (QLPreviewPanel *panel)
+{
+    static gboolean observing = FALSE;
+    NSNotificationCenter *center = [NSNotificationCenter defaultCenter];
+
+    if (observing)
+    {
+        return;
+    }
+
+    observing = TRUE;
+
+    /* The shared panel lives as long as the process; so do the observers. */
+    for (NSNotificationName name in @[NSWindowDidResignKeyNotification,
+                                      NSWindowWillCloseNotification,
+                                      NSWindowDidChangeOcclusionStateNotification])
+    {
+        [center addObserverForName:name
+                            object:panel
+                             queue:nil
+                        usingBlock:^(NSNotification *notification) {
+            nautilus_macos_preview_panel_state_changed ();
+        }];
+    }
+}
+
+static void
+appkit_panel_show (const char *const *paths,
+                   guint              n_paths,
+                   guint              index,
+                   gboolean           make_key,
+                   gpointer           user_data)
+{
+    @autoreleasepool
+    {
+        NSFileManager *file_manager = [NSFileManager defaultManager];
+        NSMutableArray<NSURL *> *items = [NSMutableArray arrayWithCapacity:n_paths];
+
+        for (guint i = 0; i < n_paths; i++)
+        {
+            NSString *path = [file_manager stringWithFileSystemRepresentation:paths[i]
+                                                                       length:strlen (paths[i])];
+
+            [items addObject:[NSURL fileURLWithPath:path]];
+        }
+
+        NautilusQLController *controller = [NautilusQLController shared];
+        controller.items = items;
+
+        QLPreviewPanel *panel = [QLPreviewPanel sharedPreviewPanel];
+        appkit_observe_panel (panel);
+
+        if ([panel isVisible])
+        {
+            [panel reloadData];
+        }
+        else
+        {
+            [panel updateController];
+
+            /* QuickLookUI implements -orderFront: as
+             * -_orderFrontAndMakeKey:NO: the panel opens and the Files
+             * window keeps the keyboard. */
+            if (make_key)
+            {
+                [panel makeKeyAndOrderFront:nil];
+            }
+            else
+            {
+                [panel orderFront:nil];
+            }
+        }
+
+        /* If the responder-chain search failed (no main window, panel not
+         * yet begun), wire the controller in directly as a fallback. */
+        if (panel.dataSource == nil)
+        {
+            g_debug ("Quick Look: controller not adopted via responder chain, "
+                     "setting dataSource directly");
+            panel.dataSource = controller;
+            panel.delegate = controller;
+            [panel reloadData];
+        }
+
+        panel.currentPreviewItemIndex = (NSInteger) index;
+    }
+}
+
+static void
+appkit_panel_close (gpointer user_data)
+{
+    QLPreviewPanel *panel = appkit_existing_panel ();
+
+    if (panel != nil && [panel isVisible])
+    {
+        /* Closes with Quick Look's animation; the window leaves the screen
+         * when it ends. */
+        [panel orderOut:nil];
+    }
+}
+
+static gboolean
+appkit_panel_is_visible (gpointer user_data)
+{
+    QLPreviewPanel *panel = appkit_existing_panel ();
+
+    return panel != nil && [panel isVisible];
+}
+
+static gboolean
+appkit_panel_is_key (gpointer user_data)
+{
+    QLPreviewPanel *panel = appkit_existing_panel ();
+
+    return panel != nil && [panel isKeyWindow];
+}
+
+static gboolean
+appkit_app_is_active (gpointer user_data)
+{
+    return [NSApp isActive];
+}
+
+static gpointer
+appkit_key_window (gpointer user_data)
+{
+    NSWindow *window = [NSApp keyWindow];
+
+    if (window == nil || window == appkit_existing_panel ())
+    {
+        return NULL;
+    }
+
+    return window;
+}
+
+static gboolean
+appkit_window_can_be_key (gpointer handle,
+                          gpointer user_data)
+{
+    NSWindow *window = appkit_live_window (handle);
+
+    return window != nil &&
+           [window isVisible] &&
+           ![window isMiniaturized] &&
+           [window canBecomeKeyWindow];
+}
+
+static void
+appkit_window_make_key (gpointer handle,
+                        gpointer user_data)
+{
+    /* GdkMacosWindow's -windowDidBecomeKey: then tells GDK, which sends GTK
+     * the focus-in event. */
+    [appkit_live_window (handle) makeKeyWindow];
+}
+
+static void
+appkit_window_deliver_key (gpointer handle,
+                           gpointer native_event,
+                           gpointer user_data)
+{
+    NSWindow *window = appkit_live_window (handle);
+    NSEvent *event = (NSEvent *) native_event;
+    NSEvent *copy;
+
+    if (window == nil || event == nil)
+    {
+        return;
+    }
+
+    /* The same key press, addressed to the Files window.  GDK takes it from
+     * the front of the queue and hands it to GTK. */
+    copy = [NSEvent keyEventWithType:[event type]
+                            location:NSZeroPoint
+                       modifierFlags:[event modifierFlags]
+                           timestamp:[event timestamp]
+                        windowNumber:[window windowNumber]
+                             context:nil
+                          characters:[event characters]
+         charactersIgnoringModifiers:[event charactersIgnoringModifiers]
+                           isARepeat:[event isARepeat]
+                             keyCode:[event keyCode]];
+
+    if (copy != nil)
+    {
+        [NSApp postEvent:copy atStart:YES];
+    }
+}
+
+static const NautilusMacosPreviewBackend appkit_backend =
+{
+    .panel_show = appkit_panel_show,
+    .panel_close = appkit_panel_close,
+    .panel_is_visible = appkit_panel_is_visible,
+    .panel_is_key = appkit_panel_is_key,
+    .app_is_active = appkit_app_is_active,
+    .key_window = appkit_key_window,
+    .window_can_be_key = appkit_window_can_be_key,
+    .window_make_key = appkit_window_make_key,
+    .window_deliver_key = appkit_window_deliver_key,
+};
