+static const char *
+item_drop_name (NautilusDndItemDrop drop)
+{
+    switch (drop)
+    {
+        case NAUTILUS_DND_ITEM_DROP_DEFAULT:
+        {
+            return "default (folder rules)";
+        }
+
+        case NAUTILUS_DND_ITEM_DROP_OPEN_WITH_APP:
+        {
+            return "open with the app";
+        }
+
+        case NAUTILUS_DND_ITEM_DROP_REFUSE:
+        {
+            return "refuse";
+        }
+    }
+
+    return "?";
+}
