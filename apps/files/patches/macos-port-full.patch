+    macos_menu_append (clipboard_section, _("Cut"), "view.cut", NULL);
+    macos_menu_append (clipboard_section, _("Copy"), "view.copy", NULL);
+    macos_menu_append (clipboard_section, _("Paste"), "view.paste", NULL);
+    macos_menu_append (clipboard_section, _("Select All"), "view.select-all", NULL);
