+/* ==========================================================================
+ * Section W15 — mounted volumes sidebar (nautilus-macos-volumes.m)
+ * ========================================================================== */
+
+/* GIO's Unix volume monitor does not report mounted volumes on macOS.  This
+ * small value type mirrors the information the places sidebar needs from
+ * NSFileManager/NSWorkspace without leaking Objective-C types into C. */
+typedef struct
+{
+    char *name;
+    char *path;
+    gboolean is_internal;
+    gboolean is_local;
+    gboolean can_unmount;
+    gboolean can_eject;
+    /* The file system's id (statfs f_fsid as hex).  It survives a rename,
+     * which moves the mount point, so a renamed volume is reported as
+     * changed rather than as removed and added.  Never NULL in a list from
+     * nautilus_macos_get_mounted_volumes(). */
+    char *identifier;
+} NautilusMacosMountedVolume;
+
+/* Return all GUI-browsable mounted volumes (including the startup volume).
+ * Only volumes still mounted when the scan ends are listed: one caught
+ * halfway through unmounting is left out instead of being described by the
+ * startup disk its mount point folder lives on.
+ * Safe to call from any thread; it may block on an unresponsive network
+ * volume, so the sidebar reads nautilus_macos_volume_monitor_get_volumes()
+ * instead.  Free the result with g_list_free_full (list,
+ * (GDestroyNotify) nautilus_macos_mounted_volume_free). */
+GList *nautilus_macos_get_mounted_volumes (void);
+void nautilus_macos_mounted_volume_free (NautilusMacosMountedVolume *volume);
+NautilusMacosMountedVolume *nautilus_macos_mounted_volume_copy (const NautilusMacosMountedVolume *volume);
+
+/* Unmount/eject the volume that contains @path using NSWorkspace. */
+gboolean nautilus_macos_unmount_volume (const char  *path,
+                                        GError     **error);
+
+/* One process-wide source of mounted-volume changes, shared by every
+ * window's sidebar.  It keeps a snapshot of nautilus_macos_get_mounted_volumes()
+ * and rescans when macOS reports a mount, unmount, eject or rename:
+ * NSWorkspace did-mount/did-unmount/did-rename-volume notifications (all
+ * volume kinds, network included) and Disk Arbitration disk and volume-path
+ * changes (disks and disk images, delivered on a private queue, so they do
+ * not depend on the main run loop).  Events are coalesced, the scan runs on a
+ * background queue, and the result is applied on the main context the
+ * monitor was created in: there it is compared with the previous snapshot
+ * and the signals below are emitted, at most once per real change.
+ *
+ * Signals (main context only; volumes are borrowed for the emission):
+ *   "volume-added"   (NautilusMacosMountedVolume *volume)
+ *   "volume-removed" (NautilusMacosMountedVolume *volume)
+ *   "volume-changed" (NautilusMacosMountedVolume *old_volume,
+ *                     NautilusMacosMountedVolume *new_volume)
+ *                    same file system, new name, mount point or flags
+ *   "changed"        () once after each batch of the above
+ *
+ * The per-window /Volumes directory monitor this replaces fired when the
+ * mount point directory was created, before the mount existed, and never
+ * again for the mount itself (see docs/STATUS.md, Mounted volumes). */
+#define NAUTILUS_TYPE_MACOS_VOLUME_MONITOR (nautilus_macos_volume_monitor_get_type ())
+G_DECLARE_FINAL_TYPE (NautilusMacosVolumeMonitor, nautilus_macos_volume_monitor,
+                      NAUTILUS, MACOS_VOLUME_MONITOR, GObject)
+
+typedef enum
+{
+    NAUTILUS_MACOS_VOLUME_EVENTS_WORKSPACE        = 1 << 0,
+    NAUTILUS_MACOS_VOLUME_EVENTS_DISK_ARBITRATION = 1 << 1,
+    NAUTILUS_MACOS_VOLUME_EVENTS_ALL              = (1 << 0) | (1 << 1),
+} NautilusMacosVolumeEvents;
+
+/* The shared monitor (transfer none), created on first use with
+ * NAUTILUS_MACOS_VOLUME_EVENTS_ALL.  Call it from the main thread. */
+NautilusMacosVolumeMonitor *nautilus_macos_volume_monitor_get (void);
+
+/* A separate monitor listening only to @events (transfer full); for tests
+ * that check each event source on its own. */
+NautilusMacosVolumeMonitor *nautilus_macos_volume_monitor_new (NautilusMacosVolumeEvents events);
+
+/* Deep copy of the current snapshot.  Never blocks. */
+GList *nautilus_macos_volume_monitor_get_volumes (NautilusMacosVolumeMonitor *self);
+
+/* The volumes the sidebar adds to its mounts section: the snapshot minus
+ * any root that @gio_monitor already reports as a GMount (GIO stays
+ * authoritative for those), each root once.  Deep copies, snapshot order. */
+GList *nautilus_macos_volume_monitor_get_sidebar_volumes (NautilusMacosVolumeMonitor *self,
+                                                          GVolumeMonitor             *gio_monitor);
+
+/* Ask for a rescan, as if macOS had reported a change (used after the
+ * sidebar ejects a volume itself).  Coalesced like any other event. */
+void nautilus_macos_volume_monitor_refresh (NautilusMacosVolumeMonitor *self);
+
+/* ==========================================================================
+ * End section W15
+ * ========================================================================== */
+
+/* ==========================================================================
+ * Section W16 — applications, file packages and archive types
+ *               (nautilus-macos-packages.m)
+ * ========================================================================== */
+
+/* A file package is a folder that Finder shows and opens as one item: an
+ * application bundle, or a document such as an .rtfd file, a Pages document
+ * or a Photos library.  GIO reports all of them as plain folders
+ * ("public.folder").  The decision is LaunchServices' own (NSURLIsPackageKey,
+ * the same answer as -[NSWorkspace isFilePackageAtPath:]): .app, .bundle,
+ * .plugin, .pkg, .rtfd, .photoslibrary, … are packages; .framework, .lproj
+ * and folders whose names merely contain a dot are folders. */
+typedef enum
+{
+    NAUTILUS_MACOS_PACKAGE_NONE = 0,    /* a folder, a file, or missing */
+    NAUTILUS_MACOS_PACKAGE_APPLICATION, /* opening it launches the app */
+    NAUTILUS_MACOS_PACKAGE_DOCUMENT,    /* any other package: opening it
+                                         * uses its default app */
+} NautilusMacosPackageKind;
+
+/* Classify the item at the local path @path.  Thread-safe.  Most items are
+ * answered from their attributes and the type of their extension (a few
+ * µs); a folder with the bundle bit or a Contents folder, and a symbolic
+ * link, is a LaunchServices lookup that touches the file system (30-45 µs on
+ * a local disk). */
+NautilusMacosPackageKind nautilus_macos_get_package_kind (const char *path);
+
+/* For tests: how many classifications so far asked LaunchServices. */
+guint nautilus_macos_package_kind_launchservices_lookups (void);
+
+/* Called once per path on the main context, with @error NULL when the app
+ * was launched or the document handed to its app.  @error is in the
+ * G_IO_ERROR domain: G_IO_ERROR_CANCELLED when the user declined a prompt
+ * (nothing to report), G_IO_ERROR_NOT_SUPPORTED when no app can open the
+ * package, G_IO_ERROR_NOT_FOUND when it is gone, otherwise
+ * G_IO_ERROR_FAILED; the message is macOS's explanation. */
+typedef void (*NautilusMacosOpenPackageFunc) (const char *path,
+                                              GError     *error,
+                                              gpointer    user_data);
+
+/* Open each package in @paths the way Finder does: an application is
+ * launched (-[NSWorkspace openApplicationAtURL:configuration:
+ * completionHandler:]), any other package is opened with its default app
+ * (-[NSWorkspace openURL:configuration:completionHandler:]).  Asynchronous:
+ * returns at once and reports through @callback on the calling thread's
+ * main context.  Errors go to the caller instead of a second, LaunchServices
+ * alert; Gatekeeper still asks before a downloaded app first opens.
+ * @destroy (may be NULL) is called with @user_data after the last report.
+ * A path that is not a package is reported as an error and never opened, so
+ * a plain folder never ends up in Finder. */
+void nautilus_macos_open_packages (const char *const           *paths,
+                                   NautilusMacosOpenPackageFunc  callback,
+                                   gpointer                      user_data,
+                                   GDestroyNotify                destroy);
+
+/* TRUE when the application at @app_path declares that it opens every file
+ * in @paths (NULL-terminated, at least one), the test Finder applies before
+ * it lets files be dropped onto an app (LSCanURLAcceptURL, default
+ * acceptance: the app's document types).  Symbolic links are resolved.
+ * About 0.1 ms per file. */
+gboolean nautilus_macos_application_accepts_files (const char        *app_path,
+                                                   const char *const *paths);
+
+/* Open the files in @paths with the application at @app_path, as dropping
+ * them onto the app does in Finder (-[NSWorkspace openURLs:
+ * withApplicationAtURL:configuration:completionHandler:]); the files stay
+ * where they are.  Asynchronous like nautilus_macos_open_packages(): one
+ * report, for @app_path, on the calling thread's main context, then
+ * @destroy.  When @app_path is not an application nothing is opened and the
+ * report carries G_IO_ERROR_INVALID_ARGUMENT (or G_IO_ERROR_NOT_FOUND when it
+ * is gone). */
+void nautilus_macos_open_with_application (const char                   *app_path,
+                                           const char *const            *paths,
+                                           NautilusMacosOpenPackageFunc  callback,
+                                           gpointer                      user_data,
+                                           GDestroyNotify                destroy);
+
+/* TRUE when @app_id (a GAppInfo id, which on macOS is a bundle identifier)
+ * names the running Shenzhen Files bundle.  Always FALSE when not running
+ * from a bundle. */
+gboolean nautilus_macos_app_id_is_self (const char *app_id);
+
+/* The MIME types macOS knows for the content type (UTI) @content_type,
+ * preferred first, plus the freedesktop name of archive formats that macOS
+ * describes without one (org.gnu.gnu-zip-tar-archive is
+ * application/x-compressed-tar, com.rarlab.rar-archive is
+ * application/vnd.rar, …).  A content type that already is a MIME type is
+ * returned as is.  Never NULL; free with g_strfreev(). */
+char **nautilus_macos_content_type_get_mime_types (const char *content_type);
+
+/* ==========================================================================
+ * End section W16
+ * ========================================================================== */
+
+/* ==========================================================================
+ * Section W17 — Quick Look keyboard focus (nautilus-macos-previewer.m)
+ * ========================================================================== */
+
+/* Finder keeps its window key while the Quick Look panel is open, so the
+ * keyboard stays on the file view: space, Escape and Cmd-Y close the panel,
+ * arrow keys move the selection and the panel follows it.  The panel takes
+ * the keyboard only when the user clicks into it; when it closes after that,
+ * by a key or by its close button, the keyboard goes back to the Files window
+ * it was opened from.
+ *
+ * Until 2026-10-13 the panel was always made key.  Quick Look then handled
+ * the second space itself (it closes the panel and never offers that key to
+ * its delegate), and nothing gave the keyboard back to the Files window.
+ *
+ * @files_window is the Files window's NSWindow
+ * (gdk_macos_surface_get_native_window()) as a gpointer, or NULL for the
+ * app's key window.  It becomes the window the keyboard returns to. */
+
+/* Space or Cmd-Y in the file view: close the panel if it is showing,
+ * otherwise show @uris (NULL-terminated file URIs; non-local ones are
+ * skipped) at @selected_index without taking the keyboard from
+ * @files_window. */
+void nautilus_macos_preview_toggle (const char *const *uris,
+                                    int                selected_index,
+                                    gpointer           files_window);
+
+/* Show @uris, or replace the panel's contents if it is showing (the
+ * selection changed).  The keyboard stays in @files_window. */
+void nautilus_macos_preview_show (const char *const *uris,
+                                  int                selected_index,
+                                  gpointer           files_window);
+
+/* Close the panel if it is showing; if the panel had the keyboard, give it
+ * back to the Files window.  Returns TRUE if the panel was showing, so that
+ * space and Escape in the file view are consumed only then. */
+gboolean nautilus_macos_preview_close_if_showing (void);
+
+/* Called on the main thread after the keyboard was given back to the Files
+ * window, so the C side can put GTK's focus on the file view. */
+typedef void (*NautilusMacosPreviewFocusFunc) (gpointer user_data);
+
+/* Register the (single) focus callback.  Pass NULL to unset. */
+void nautilus_macos_preview_set_focus_callback (NautilusMacosPreviewFocusFunc callback,
+                                                gpointer                      user_data);
+
+/* --- Panel key handling and the state check, exposed for tests --- */
+
+typedef enum
+{
+    NAUTILUS_MACOS_PREVIEW_MODIFIER_COMMAND = 1 << 0,
+    NAUTILUS_MACOS_PREVIEW_MODIFIER_CONTROL = 1 << 1,
+    NAUTILUS_MACOS_PREVIEW_MODIFIER_OPTION  = 1 << 2,
+    NAUTILUS_MACOS_PREVIEW_MODIFIER_SHIFT   = 1 << 3,
+} NautilusMacosPreviewModifiers;
+
+/* A key press the panel received while it had the keyboard. */
+typedef struct
+{
+    guint16 key_code;      /* virtual key code (kVK_*) */
+    gunichar character;    /* first character ignoring modifiers, 0 if none */
+    guint modifiers;       /* NautilusMacosPreviewModifiers */
+    gpointer native_event; /* the NSEvent, handed to window_deliver_key */
+} NautilusMacosPreviewKey;
+
+/* What to do with a key Quick Look offers its delegate, which it does only
+ * for keys it has no use for itself. */
+typedef enum
+{
+    /* Leave it to Quick Look and AppKit. */
+    NAUTILUS_MACOS_PREVIEW_KEY_PASS,
+    /* Space, Escape, Cmd-Y: close and give the keyboard back. */
+    NAUTILUS_MACOS_PREVIEW_KEY_CLOSE,
+    /* Arrows: move the file view's selection; the panel follows. */
+    NAUTILUS_MACOS_PREVIEW_KEY_MOVE_SELECTION,
+    /* Return, Cmd-O, Cmd-arrows, typing: give the keyboard back to the Files
+     * window and deliver the key there. */
+    NAUTILUS_MACOS_PREVIEW_KEY_GIVE_TO_FILES,
+} NautilusMacosPreviewKeyAction;
+
+/* Pure classification.  @n_items is the number of items in the panel
+ * (Left/Right page through them when there are several).  Sets @direction
+ * for NAUTILUS_MACOS_PREVIEW_KEY_MOVE_SELECTION. */
+NautilusMacosPreviewKeyAction nautilus_macos_preview_classify_panel_key (const NautilusMacosPreviewKey *key,
+                                                                         guint                          n_items,
+                                                                         NautilusMacosPreviewDirection *direction);
+
+/* Act on a key the panel offers its delegate.  Returns TRUE if handled.
+ * Selection moves are delivered from an idle, as before. */
+gboolean nautilus_macos_preview_panel_key_down (const NautilusMacosPreviewKey *key);
+
+/* The panel resigned key, closed or changed visibility.  Schedules a check
+ * on an idle: if the app is active and no window has the keyboard (Quick
+ * Look closed itself after the user clicked into it), the Files window gets
+ * it back. */
+void nautilus_macos_preview_panel_state_changed (void);
+
+/* The panel and window operations the controller uses.  In the app they
+ * drive QLPreviewPanel and NSWindow; tests install fakes.  Windows are
+ * opaque handles (NSWindow pointers in the app). */
+typedef struct
+{
+    /* Show @paths (@n_paths local paths) at @index, or reload them in place
+     * if the panel is showing.  @make_key is FALSE unless there is no window
+     * to keep the keyboard in. */
+    void (*panel_show) (const char *const *paths,
+                        guint              n_paths,
+                        guint              index,
+                        gboolean           make_key,
+                        gpointer           user_data);
+    void (*panel_close) (gpointer user_data);
+    gboolean (*panel_is_visible) (gpointer user_data);
+    gboolean (*panel_is_key) (gpointer user_data);
+    gboolean (*app_is_active) (gpointer user_data);
+    /* The key window, or NULL if there is none or it is the panel. */
+    gpointer (*key_window) (gpointer user_data);
+    /* Still open, on screen and able to become key. */
+    gboolean (*window_can_be_key) (gpointer window,
+                                   gpointer user_data);
+    void (*window_make_key) (gpointer window,
+                             gpointer user_data);
+    void (*window_deliver_key) (gpointer window,
+                                gpointer native_event,
+                                gpointer user_data);
+} NautilusMacosPreviewBackend;
+
+/* Replace the AppKit backend (NULL restores it) and reset the controller's
+ * state.  For tests. */
+void nautilus_macos_preview_set_backend_for_testing (const NautilusMacosPreviewBackend *backend,
+                                                     gpointer                           user_data);
+
+/* ==========================================================================
+ * End section W17
+ * ========================================================================== */
+
+G_END_DECLS
diff --git a/src/nautilus-macos-fda.m b/src/nautilus-macos-fda.m
new file mode 100644
index 0000000..c19a79e
--- /dev/null
+++ b/src/nautilus-macos-fda.m
@@ -0,0 +1,454 @@
+/*
+ * nautilus-macos-fda.m: Full Disk Access onboarding (W6).
+ *
+ * Copyright (C) 2026 The Nautilus authors
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public
+ * License along with this program; if not, see <http://www.gnu.org/licenses/>.
+ *
+ * Why Nautilus wants Full Disk Access (FDA): browsing ~/.Trash is
+ * TCC-blocked without it (PLAN.md §5 Phase 3 task 2), and FDA also unlocks
+ * Desktop/Documents/Downloads without per-folder permission popups, plus
+ * unrestricted search. The flow mirrors shenzhen-pdf
+ * (portable/mac/ShenzhenPDFMac.mm): explain why, deep-link to the Full
+ * Disk Access pane of System Settings, tell the user to relaunch, and
+ * never nag once dismissed.
+ *
+ * ==========================================================================
+ * DEV-VS-BUNDLE TCC CAVEAT — READ BEFORE TRUSTING nautilus_macos_fda_is_granted
+ *
+ * TCC attributes file access to the RESPONSIBLE PROCESS. When the binary is
+ * launched from a terminal or an IDE, that responsible process is the
+ * terminal/IDE — so if e.g. iTerm or Cursor already has Full Disk Access,
+ * the probe below succeeds and this function returns TRUE even though
+ * "Nautilus" has no grant of its own. Conversely a bare Terminal without
+ * FDA makes it return FALSE no matter what. The check is only truthful for
+ * the final signed .app bundle launched via Finder/LaunchServices — which
+ * is the case that matters for the shipped product.
+ * ==========================================================================
+ */
+
+#define G_LOG_DOMAIN "nautilus-macos-bridge"
+
+#include <config.h>
+#include "nautilus-macos-bridge.h"
+
+#include <adwaita.h>
+#include <glib/gi18n.h>
+
+#import <AppKit/AppKit.h>
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+/* --- Detection ----------------------------------------------------------- */
+
+typedef enum
+{
+    PROBE_DENIED,           /* EPERM/EACCES: TCC said no */
+    PROBE_GRANTED,          /* read succeeded */
+    PROBE_INCONCLUSIVE      /* ENOENT etc: try the next location */
+} ProbeResult;
+
+static ProbeResult
+probe_open_file (const char *path)
+{
+    int fd = open (path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+
+    if (fd >= 0)
+    {
+        close (fd);
+        return PROBE_GRANTED;
+    }
+
+    return (errno == EPERM || errno == EACCES) ? PROBE_DENIED : PROBE_INCONCLUSIVE;
+}
+
+static ProbeResult
+probe_list_dir (const char *path)
+{
+    DIR *dir = opendir (path);
+    struct dirent *entry;
+    int saved_errno;
+
+    if (dir == NULL)
+    {
+        return (errno == EPERM || errno == EACCES) ? PROBE_DENIED : PROBE_INCONCLUSIVE;
+    }
+
+    /* opendir alone can succeed on TCC-protected dirs; the denial may only
+     * surface on the first readdir, so force one. */
+    errno = 0;
+    entry = readdir (dir);
+    saved_errno = errno;
+    closedir (dir);
+
+    if (entry != NULL || saved_errno == 0)
+    {
+        return PROBE_GRANTED;
+    }
+
+    return (saved_errno == EPERM || saved_errno == EACCES) ? PROBE_DENIED : PROBE_INCONCLUSIVE;
+}
+
+gboolean
+nautilus_macos_fda_is_granted (void)
+{
+    /* Canonical technique: try to read locations that FDA (and only FDA)
+     * unlocks. The user TCC database always exists; the others are
+     * fallbacks in case a probe is inconclusive (e.g. missing path).
+     * See the dev-vs-bundle caveat in the header comment: under a
+     * terminal/IDE this reports the *responsible process*'s grant. */
+    g_autofree char *user_tcc_db = g_build_filename (g_get_home_dir (),
+                                                     "Library", "Application Support",
+                                                     "com.apple.TCC", "TCC.db", NULL);
+    g_autofree char *user_trash = g_build_filename (g_get_home_dir (), ".Trash", NULL);
+    g_autofree char *user_safari = g_build_filename (g_get_home_dir (),
+                                                     "Library", "Safari", NULL);
+    struct
+    {
+        const char *path;
+        ProbeResult (*probe) (const char *path);
+    } probes[] =
+    {
+        { user_tcc_db, probe_open_file },
+        { user_trash, probe_list_dir },
+        { user_safari, probe_list_dir },
+        { "/Library/Application Support/com.apple.TCC/TCC.db", probe_open_file },
+    };
+
+    for (gsize i = 0; i < G_N_ELEMENTS (probes); i++)
+    {
+        ProbeResult result = probes[i].probe (probes[i].path);
+
+        if (result != PROBE_INCONCLUSIVE)
+        {
+            g_debug ("FDA probe %s: %s", probes[i].path,
+                     result == PROBE_GRANTED ? "granted" : "denied");
+            return result == PROBE_GRANTED;
+        }
+    }
+
+    g_debug ("FDA probes all inconclusive; assuming not granted");
+    return FALSE;
+}
+
+/* --- Bundle path (for "Reveal in Finder" + registering the app) ----------- */
+
+/* Absolute path of the running .app bundle, or NULL when Nautilus is not
+ * running from a bundle (dev/terminal launch). The caller owns the result. */
+static char *
+fda_running_bundle_path (void)
+{
+    @autoreleasepool
+    {
+        NSBundle *main_bundle = [NSBundle mainBundle];
+        NSString *path = [main_bundle bundlePath];
+
+        /* mainBundle resolves to the enclosing .app for a bundled launch and
+         * to the plain executable directory otherwise; the ".app" suffix plus
+         * a non-nil bundle identifier is the reliable discriminator. */
+        if (path != nil && [path hasSuffix:@".app"] &&
+            [main_bundle bundleIdentifier] != nil)
+        {
+            return g_strdup ([path fileSystemRepresentation]);
+        }
+
+        return NULL;
+    }
+}
+
+/* --- Register a TCC access attempt --------------------------------------- */
+
+/* Touch a definitively Full-Disk-Access-gated path so TCC records an access
+ * attempt from this app. That is what makes Nautilus appear (as a togglable,
+ * initially-off row) in System Settings ▸ Privacy & Security ▸ Full Disk
+ * Access — the pane never lists apps that have not yet tried. Requires a
+ * stable code signature (Developer ID) for the record to be keyed on the
+ * bundle identifier and to survive rebuilds; see package/README.md. */
+static void
+fda_register_access_attempt (void)
+{
+    g_autofree char *user_tcc_db = g_build_filename (g_get_home_dir (),
+                                                     "Library", "Application Support",
+                                                     "com.apple.TCC", "TCC.db", NULL);
+    int fd = open (user_tcc_db, O_RDONLY | O_CLOEXEC);
+
+    if (fd >= 0)
+    {
+        close (fd);
+    }
+}
+
+void
+nautilus_macos_fda_register_with_tcc (void)
+{
+    /* Called unconditionally, once per launch, early in application startup
+     * (nautilus_application_startup) — no dialog, result discarded.
+     *
+     * (a) This deliberate denied-or-granted access attempt is what makes
+     *     Nautilus show up in System Settings ▸ Privacy & Security ▸ Full
+     *     Disk Access: the pane only lists apps TCC has seen try.
+     * (b) It only reliably lists the bundled Nautilus.app launched via
+     *     Finder/LaunchServices, where the responsible process is Nautilus
+     *     itself with a stable-ish bundle identity. Terminal/IDE dev runs
+     *     attribute the attempt to the terminal/IDE instead.
+     * (c) Signing is ad-hoc by choice, so the code-signing identity can
+     *     change across rebuilds and TCC may treat a rebuilt app as new
+     *     (the FDA toggle resets). Known + accepted for this port. */
+    static gsize once = 0;
+
+    if (g_once_init_enter (&once))
+    {
+        fda_register_access_attempt ();
+        g_once_init_leave (&once, 1);
+    }
+}
+
+/* --- System Settings deep link ------------------------------------------- */
+
+void
+nautilus_macos_fda_open_settings (void)
+{
+    /* Fire a real access attempt first so TCC has recorded this app before
+     * the pane opens — otherwise a not-yet-granted Nautilus is absent from
+     * the list and the user has nothing to toggle. */
+    fda_register_access_attempt ();
+
+    @autoreleasepool
+    {
+        /* Same deep link shenzhen-pdf uses; still the documented way to reach
+         * Privacy & Security → Full Disk Access on current macOS. */
+        NSURL *url = [NSURL URLWithString:
+                      @"x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles"];
+
+        if (url != nil)
+        {
+            [[NSWorkspace sharedWorkspace] openURL:url];
+        }
+    }
+}
+
+/* --- First-launch persistence (keyfile; no GSettings schema on purpose) --- */
+
+#define FDA_STATE_GROUP "fda"
+#define FDA_STATE_KEY_DISMISSED "prompt-dismissed"
+#define FDA_STATE_KEY_FIRST_LAUNCH_SHOWN "first-launch-prompt-shown"
+
+static char *
+fda_state_file_path (void)
+{
+    return g_build_filename (g_get_user_config_dir (), "nautilus", "macos-fda.ini", NULL);
+}
+
+static gboolean
+fda_prompt_dismissed (void)
+{
+    g_autofree char *path = fda_state_file_path ();
+    g_autoptr (GKeyFile) key_file = g_key_file_new ();
+
+    if (!g_key_file_load_from_file (key_file, path, G_KEY_FILE_NONE, NULL))
+    {
+        return FALSE;
+    }
+
+    return g_key_file_get_boolean (key_file, FDA_STATE_GROUP, FDA_STATE_KEY_DISMISSED, NULL);
+}
+
+void
+nautilus_macos_fda_set_prompt_dismissed (void)
+{
+    g_autofree char *path = fda_state_file_path ();
+    g_autofree char *dir = g_path_get_dirname (path);
+    g_autoptr (GKeyFile) key_file = g_key_file_new ();
+    g_autoptr (GError) error = NULL;
+
+    /* Preserve any other keys a future version may add. */
+    g_key_file_load_from_file (key_file, path, G_KEY_FILE_KEEP_COMMENTS, NULL);
+    g_key_file_set_boolean (key_file, FDA_STATE_GROUP, FDA_STATE_KEY_DISMISSED, TRUE);
+
+    g_mkdir_with_parents (dir, 0700);
+    if (!g_key_file_save_to_file (key_file, path, &error))
+    {
+        g_warning ("Failed to save FDA prompt state to %s: %s", path, error->message);
+    }
+}
+
+gboolean
+nautilus_macos_fda_should_prompt_on_launch (void)
+{
+    if (nautilus_macos_fda_is_granted ())
+    {
+        return FALSE;
+    }
+
+    return !fda_prompt_dismissed ();
+}
+
+/* --- One-time-ever first-launch prompt state ------------------------------ */
+
+static gboolean
+fda_first_launch_prompt_shown (void)
+{
+    g_autofree char *path = fda_state_file_path ();
+    g_autoptr (GKeyFile) key_file = g_key_file_new ();
+
+    if (!g_key_file_load_from_file (key_file, path, G_KEY_FILE_NONE, NULL))
+    {
+        return FALSE;
+    }
+
+    return g_key_file_get_boolean (key_file, FDA_STATE_GROUP,
+                                   FDA_STATE_KEY_FIRST_LAUNCH_SHOWN, NULL);
+}
+
+void
+nautilus_macos_fda_set_first_launch_prompt_shown (void)
+{
+    g_autofree char *path = fda_state_file_path ();
+    g_autofree char *dir = g_path_get_dirname (path);
+    g_autoptr (GKeyFile) key_file = g_key_file_new ();
+    g_autoptr (GError) error = NULL;
+
+    g_key_file_load_from_file (key_file, path, G_KEY_FILE_KEEP_COMMENTS, NULL);
+    g_key_file_set_boolean (key_file, FDA_STATE_GROUP,
+                            FDA_STATE_KEY_FIRST_LAUNCH_SHOWN, TRUE);
+
+    g_mkdir_with_parents (dir, 0700);
+    if (!g_key_file_save_to_file (key_file, path, &error))
+    {
+        g_warning ("Failed to save FDA first-launch state to %s: %s",
+                   path, error->message);
+    }
+}
+
+gboolean
+nautilus_macos_fda_should_show_first_launch_prompt (void)
+{
+    /* The one-time flag wins over everything: once set (which happens the
+     * instant the prompt is first scheduled), no launch ever prompts again,
+     * regardless of what the user chose in the dialog. The legacy
+     * "prompt-dismissed" opt-out is honored too. */
+    if (fda_first_launch_prompt_shown () || fda_prompt_dismissed ())
+    {
+        return FALSE;
+    }
+
+    /* Already granted (e.g. FDA inherited or previously enabled): nothing
+     * to onboard, and the flag stays unset — harmless, since a later launch
+     * that is granted again still returns FALSE here. */
+    return !nautilus_macos_fda_is_granted ();
+}
+
+/* --- The prompt ----------------------------------------------------------- */
+
+/* The dialog is shown ONLY from the explicit "Grant Full Disk Access…" menu
+ * item (app.fda-prompt). There is deliberately no launch-time prompt: the
+ * responsible-process / signing rules make an automatic prompt both annoying
+ * and frequently wrong on dev builds, so FDA is now strictly opt-in from the
+ * menu. */
+
+#define FDA_DIALOG_BUNDLE_PATH_KEY "nautilus-fda-bundle-path"
+
+static void
+fda_dialog_response_cb (AdwAlertDialog *dialog,
+                        const char     *response,
+                        gpointer        user_data)
+{
+    /* Bundle path is attached to the dialog (owned + freed by it); may be
+     * NULL when Nautilus is not running from a .app bundle. */
+    const char *bundle_path = g_object_get_data (G_OBJECT (dialog),
+                                                 FDA_DIALOG_BUNDLE_PATH_KEY);
+
+    if (g_strcmp0 (response, "open-settings") == 0)
+    {
+        nautilus_macos_fda_open_settings ();
+    }
+    else if (g_strcmp0 (response, "reveal") == 0 && bundle_path != NULL)
+    {
+        nautilus_macos_show_in_finder (bundle_path);
+    }
+}
+
+void
+nautilus_macos_fda_show_dialog (GtkWindow *parent)
+{
+    AdwAlertDialog *dialog;
+    g_autofree char *bundle_path = fda_running_bundle_path ();
+
+    if (nautilus_macos_fda_is_granted ())
+    {
+        /* Menu-invoked while already granted: confirm instead of nagging. */
+        dialog = ADW_ALERT_DIALOG (
+            adw_alert_dialog_new (_("Full Disk Access Is Active"),
+                                  _("Shenzhen Files already has Full Disk Access. "
+                                    "Browsing the Trash, opening Desktop, Documents "
+                                    "and Downloads, and searching the whole disk all "
+                                    "work without extra permission prompts.")));
+        adw_alert_dialog_add_response (dialog, "close", _("_Close"));
+        adw_alert_dialog_set_default_response (dialog, "close");
+        adw_alert_dialog_set_close_response (dialog, "close");
+    }
+    else
+    {
+        /* System Settings does not list apps that have never attempted a
+         * protected access, and even after an attempt the user usually has to
+         * add Nautilus with "+" (or a drag). The numbered steps below match
+         * exactly what the pane requires. "Open System Settings…" also fires a
+         * real access attempt (see nautilus_macos_fda_open_settings) so the
+         * app is at least a candidate the pane can resolve. */
+        dialog = ADW_ALERT_DIALOG (
+            adw_alert_dialog_new (_("Grant Full Disk Access"),
+                                  _("Full Disk Access lets Shenzhen Files browse the Trash "
+                                    "and open Desktop, Documents and Downloads without macOS "
+                                    "asking each time.\n\n"
+                                    "1. Click “Open System Settings” below.\n"
+                                    "2. Click the “+” button under the list (click the "
+                                    "lock to unlock first if needed).\n"
+                                    "3. Choose Shenzhen Files under Applications — or drag "
+                                    "Shenzhen Files.app into the list.\n"
+                                    "4. Turn the Shenzhen Files switch on, then quit and "
+                                    "reopen Shenzhen Files.\n\n"
+                                    "If Shenzhen Files is already in the list, just switch "
+                                    "it on and relaunch.")));
+
+        adw_alert_dialog_add_responses (dialog,
+                                        "open-settings", _("_Open System Settings…"),
+                                        NULL);
+
+        /* Reveal button only makes sense for a real .app launch: it points at
+         * the running bundle so the user can drag it into the "+" sheet. */
+        if (bundle_path != NULL)
+        {
+            adw_alert_dialog_add_response (dialog, "reveal",
+                                           _("_Reveal Shenzhen Files.app in Finder"));
+        }
+
+        adw_alert_dialog_add_response (dialog, "close", _("_Close"));
+        adw_alert_dialog_set_response_appearance (dialog, "open-settings",
+                                                  ADW_RESPONSE_SUGGESTED);
+        adw_alert_dialog_set_default_response (dialog, "open-settings");
+        adw_alert_dialog_set_close_response (dialog, "close");
+    }
+
+    g_object_set_data_full (G_OBJECT (dialog), FDA_DIALOG_BUNDLE_PATH_KEY,
+                            g_steal_pointer (&bundle_path), g_free);
+    g_signal_connect (dialog, "response", G_CALLBACK (fda_dialog_response_cb), NULL);
+
+    /* AdwDialog attaches to the parent window; with a NULL parent libadwaita
+     * falls back to presenting it as a standalone window, so early callers
+     * without a window yet still work. */
+    adw_dialog_present (ADW_DIALOG (dialog), parent != NULL ? GTK_WIDGET (parent) : NULL);
+}
diff --git a/src/nautilus-macos-fileicon.m b/src/nautilus-macos-fileicon.m
new file mode 100644
index 0000000..cd39c6a
--- /dev/null
+++ b/src/nautilus-macos-fileicon.m
@@ -0,0 +1,129 @@
+/*
+ * nautilus-macos-fileicon.m: LaunchServices file-type icons (W11).
+ *
+ * Copyright (C) 2026 The Nautilus authors
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public
+ * License along with this program; if not, see <http://www.gnu.org/licenses/>.
+ *
+ * Finder-style document icons: when the icon theme has nothing better than
+ * the generic file icon for a type, nautilus-file.c substitutes the icon of
+ * the app that owns the type, as reported by LaunchServices (NSWorkspace
+ * iconForFile:). The NSImage → GdkTexture conversion is shared with the
+ * app-chooser bridge (nautilus_macos_app_icon_texture, W2).
+ */
+
+#define G_LOG_DOMAIN "nautilus-macos-bridge"
+
+#include <config.h>
+#include "nautilus-macos-bridge.h"
+
+#import <AppKit/AppKit.h>
+
+#include <string.h>
+
+/* Keyed by "<size>|ext:<lowercased extension>" (or "<size>|app:<path>" for
+ * .app bundles); value is an owned GdkTexture ref. Two files sharing an
+ * extension share an icon, so a 10k-file directory costs one AppKit call
+ * per distinct (extension, size) pair. Never evicted: real directory trees
+ * contain at most a few hundred distinct extensions, and entries are small
+ * next to the thumbnail cache. Main-thread only, so no locking. */
+static GHashTable *icon_cache = NULL;
+
+static guint appkit_call_count = 0;
+static guint cache_hit_count = 0;
+
+static char *
+cache_key_for_path (const char *path,
+                    int         size_px)
+{
+    const char *basename = strrchr (path, '/');
+
+    basename = (basename != NULL) ? basename + 1 : path;
+
+    /* App bundles all share the ".app" extension but each has its own
+     * icon: key those by full path. */
+    if (g_str_has_suffix (basename, ".app") || g_str_has_suffix (basename, ".APP"))
+    {
+        return g_strdup_printf ("%d|app:%s", size_px, path);
+    }
+
+    const char *dot = strrchr (basename, '.');
+    /* dot == basename means a dotfile like ".profile", not an extension. */
+    const char *extension = (dot != NULL && dot != basename) ? dot + 1 : "";
+    g_autofree char *lowered = g_ascii_strdown (extension, -1);
+
+    return g_strdup_printf ("%d|ext:%s", size_px, lowered);
+}
+
+GdkTexture *
+nautilus_macos_file_icon_texture (const char *path,
+                                  int         size_px)
+{
+    g_return_val_if_fail (path != NULL, NULL);
+    g_return_val_if_fail (size_px > 0, NULL);
+
+    if (![NSThread isMainThread])
+    {
+        g_warning ("nautilus_macos_file_icon_texture called off the main thread; "
+                   "returning NULL (NSWorkspace icon APIs are main-thread)");
+        return NULL;
+    }
+
+    if (G_UNLIKELY (icon_cache == NULL))
+    {
+        icon_cache = g_hash_table_new_full (g_str_hash, g_str_equal,
+                                            g_free, g_object_unref);
+    }
+
+    g_autofree char *key = cache_key_for_path (path, size_px);
+    GdkTexture *cached = g_hash_table_lookup (icon_cache, key);
+
+    if (cached != NULL)
+    {
+        cache_hit_count++;
+        return g_object_ref (cached);
+    }
+
+    /* Shared NSWorkspace iconForFile: → GdkTexture conversion (W2). */
+    appkit_call_count++;
+    GdkTexture *texture = nautilus_macos_app_icon_texture (path, size_px);
+
+    if (texture == NULL)
+    {
+        return NULL;
+    }
+
+    g_hash_table_insert (icon_cache, g_steal_pointer (&key), g_object_ref (texture));
+
+    return texture;
+}
+
+void
+nautilus_macos_file_icon_debug_stats (guint *out_appkit_calls,
+                                      guint *out_cache_hits,
+                                      guint *out_cache_entries)
+{
+    if (out_appkit_calls != NULL)
+    {
+        *out_appkit_calls = appkit_call_count;
+    }
+    if (out_cache_hits != NULL)
+    {
+        *out_cache_hits = cache_hit_count;
+    }
+    if (out_cache_entries != NULL)
+    {
+        *out_cache_entries = (icon_cache != NULL) ? g_hash_table_size (icon_cache) : 0;
+    }
+}
