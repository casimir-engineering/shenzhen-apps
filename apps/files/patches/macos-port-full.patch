+/* --- Starting Folder preference row (macOS port) ---------------------------
+ *
+ * An AdwActionRow in the General group showing the "starting-location"
+ * preference (where windows open when no explicit location is given: app
+ * launch, Dock reopen, New Window). Folder-picker button (GtkFileDialog
+ * select-folder) plus a reset-to-Home button that only shows for a custom
+ * value. Added in C so the shared .blp stays untouched. */
+
+static char *
+starting_folder_subtitle (void)
+{
+    g_autofree char *path = g_settings_get_string (nautilus_preferences,
+                                                   NAUTILUS_PREFERENCES_STARTING_LOCATION);
+
+    if (path == NULL || path[0] == '\0')
+    {
+        return g_strdup (_("Home"));
+    }
+
+    const char *home = g_get_home_dir ();
+    size_t home_len = strlen (home);
+
+    if (g_str_has_prefix (path, home) &&
+        (path[home_len] == '\0' || path[home_len] == '/'))
+    {
+        return g_strdup_printf ("~%s", path + home_len);
+    }
+
+    return g_steal_pointer (&path);
+}
+
+static void
+starting_folder_refresh_row (GtkWidget *row_widget)
+{
+    AdwActionRow *row = ADW_ACTION_ROW (row_widget);
+    GtkWidget *reset_button = g_object_get_data (G_OBJECT (row), "reset-button");
+    g_autofree char *value = g_settings_get_string (nautilus_preferences,
+                                                    NAUTILUS_PREFERENCES_STARTING_LOCATION);
+    g_autofree char *subtitle = starting_folder_subtitle ();
+
+    adw_action_row_set_subtitle (row, subtitle);
+    gtk_widget_set_visible (reset_button, value != NULL && value[0] != '\0');
+}
+
+static void
+starting_folder_selected_cb (GObject      *source,
+                             GAsyncResult *result,
+                             gpointer      user_data)
+{
+    g_autoptr (GError) error = NULL;
+    g_autoptr (GFile) folder = gtk_file_dialog_select_folder_finish (GTK_FILE_DIALOG (source),
+                                                                     result, &error);
+
+    if (folder != NULL)
+    {
+        g_autofree char *path = g_file_get_path (folder);
+
+        if (path != NULL)
+        {
+            g_settings_set_string (nautilus_preferences,
+                                   NAUTILUS_PREFERENCES_STARTING_LOCATION, path);
+        }
+    }
+}
+
+static void
+starting_folder_pick_cb (GtkButton *button,
+                         gpointer   user_data)
+{
+    GtkWidget *row = user_data;
+    g_autoptr (GtkFileDialog) dialog = gtk_file_dialog_new ();
+    g_autofree char *current = g_settings_get_string (nautilus_preferences,
+                                                      NAUTILUS_PREFERENCES_STARTING_LOCATION);
+    GtkRoot *root = gtk_widget_get_root (row);
+
+    gtk_file_dialog_set_title (dialog, _("Select Starting Folder"));
+
+    if (current != NULL && current[0] != '\0')
+    {
+        g_autoptr (GFile) folder = g_file_new_for_path (current);
+        gtk_file_dialog_set_initial_folder (dialog, folder);
+    }
+
+    gtk_file_dialog_select_folder (dialog,
+                                   GTK_IS_WINDOW (root) ? GTK_WINDOW (root) : NULL,
+                                   NULL, starting_folder_selected_cb, NULL);
+}
+
+static void
+starting_folder_reset_cb (GtkButton *button,
+                          gpointer   user_data)
+{
+    g_settings_reset (nautilus_preferences, NAUTILUS_PREFERENCES_STARTING_LOCATION);
+}
+
+static void
+setup_starting_folder_row (GtkBuilder *builder)
+{
+    /* The General group carries no builder id; reach it from a row it
+     * contains. */
+    GtkWidget *anchor = GTK_WIDGET (gtk_builder_get_object (builder, "sort_folders_first_row"));
+    GtkWidget *group = gtk_widget_get_ancestor (anchor, ADW_TYPE_PREFERENCES_GROUP);
+    GtkWidget *row = adw_action_row_new ();
+    GtkWidget *pick_button = gtk_button_new_from_icon_name ("folder-open-symbolic");
+    GtkWidget *reset_button = gtk_button_new_from_icon_name ("edit-undo-symbolic");
+
+    g_return_if_fail (group != NULL);
+
+    adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), _("Starting Folder"));
+
+    gtk_widget_set_valign (pick_button, GTK_ALIGN_CENTER);
+    gtk_widget_add_css_class (pick_button, "flat");
+    gtk_widget_set_tooltip_text (pick_button, _("Choose Folder…"));
+
+    gtk_widget_set_valign (reset_button, GTK_ALIGN_CENTER);
+    gtk_widget_add_css_class (reset_button, "flat");
+    gtk_widget_set_tooltip_text (reset_button, _("Reset to Home"));
+
+    adw_action_row_add_suffix (ADW_ACTION_ROW (row), reset_button);
+    adw_action_row_add_suffix (ADW_ACTION_ROW (row), pick_button);
+    adw_action_row_set_activatable_widget (ADW_ACTION_ROW (row), pick_button);
+    g_object_set_data (G_OBJECT (row), "reset-button", reset_button);
+
+    g_signal_connect (pick_button, "clicked",
+                      G_CALLBACK (starting_folder_pick_cb), row);
+    g_signal_connect (reset_button, "clicked",
