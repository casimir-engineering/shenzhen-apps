+nautilus_dnd_item_opens_on_drag_hover (NautilusFile *file)
+{
+    g_return_val_if_fail (NAUTILUS_IS_FILE (file), FALSE);
+
+    return get_item_package_kind (file) == NAUTILUS_MACOS_PACKAGE_NONE;
+}
