+static GMenuModel *
+macos_build_go_menu (void)
+{
+    GMenu *menu = g_menu_new ();
+    g_autoptr (GMenu) history_section = g_menu_new ();
+    g_autoptr (GMenu) places_section = g_menu_new ();
+    g_autoptr (GMenu) location_section = g_menu_new ();
+    const char * const *supported_schemes;
