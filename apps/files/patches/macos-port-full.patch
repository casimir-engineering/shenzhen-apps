+/* "Compress…" still produces archives that are detected and extract back. */
+static void
+test_compress_round_trip (void)
+{
+    static const struct
+    {
+        const char *name;
+        AutoarFormat format;
+        AutoarFilter filter;
+    } formats[] = {
+        { "Packed 文件 zip.zip", AUTOAR_FORMAT_ZIP, AUTOAR_FILTER_NONE },
+        { "Packed 文件 xz.tar.xz", AUTOAR_FORMAT_TAR, AUTOAR_FILTER_XZ },
+        { "Packed 文件 7z.7z", AUTOAR_FORMAT_7ZIP, AUTOAR_FILTER_NONE },
+    };
+    g_autofree char *source_dir = fixture_path ("compress-source/Ünïcode Földer");
+    g_autofree char *source_file = g_build_filename (source_dir, "naïve file.txt", NULL);
+
+    write_file (source_file, "hello\n");
+
+    for (gsize i = 0; i < G_N_ELEMENTS (formats); i++)
+    {
+        g_autofree char *archive = fixture_path (formats[i].name);
+        g_autoptr (GFile) output = g_file_new_for_path (archive);
+        g_autoptr (GFile) source = g_file_new_for_path (source_dir);
+        OperationResult result = { 0 };
+        GList files = { .data = source };
+
+        nautilus_file_operations_compress (&files, output, formats[i].format,
+                                           formats[i].filter, NULL, NULL, NULL,
+                                           on_compressed, &result);
+        wait_for_flag (&result.done, 60000);
+        g_assert_true (result.success);
+        g_clear_object (&result.created);
+        assert_archive (formats[i].name, TRUE);
+
+        {
+            g_autofree char *extracted = extract_one (archive);
+            g_autofree char *inner = g_build_filename (extracted, "Ünïcode Földer", "naïve file.txt", NULL);
+            g_autofree char *direct = g_build_filename (extracted, "naïve file.txt", NULL);
+
+            /* Named after the archive or after its one folder, depending
+             * on how autoar counts the entries; the file must come back. */
+            g_test_message ("%s → %s", formats[i].name, extracted);
+            assert_file_contents (g_file_test (inner, G_FILE_TEST_EXISTS) ? inner : direct,
+                                  "hello\n");
+        }
+    }
+}
