+/* "Folders first" puts folders first and keeps apps and other packages with
+ * the files, as Finder's "Keep folders on top" does. */
+static void
+test_folders_first_sort (void)
+{
+    /* Folders, .framework included, before packages and files... */
+    assert_sorts_before ("sort/Zoo Folder", "sort/Zebra.app", TRUE, FALSE);
+    assert_sorts_before ("sort/Zz.framework", "sort/Zebra.app", TRUE, FALSE);
+    assert_sorts_before ("sort/Zoo Folder", "sort/Zebra Notes.rtfd", TRUE, FALSE);
+    assert_sorts_before ("sort/Zoo Folder", "sort/alpha.txt", TRUE, FALSE);
+    assert_sorts_before ("sort/Aardvark Folder", "sort/Zoo Folder", TRUE, FALSE);
+    /* ...and packages sorted by name among the files. */
+    assert_sorts_before ("sort/alpha.txt", "sort/Zebra.app", TRUE, FALSE);
+    assert_sorts_before ("sort/alpha.txt", "sort/Zebra Notes.rtfd", TRUE, FALSE);
+
+    /* Reversed: folders still first, the files and packages reversed. */
+    assert_sorts_before ("sort/Zoo Folder", "sort/Zebra.app", TRUE, TRUE);
+    assert_sorts_before ("sort/Zebra.app", "sort/alpha.txt", TRUE, TRUE);
+
+    /* Without folders first, names alone decide. */
+    assert_sorts_before ("sort/Zebra.app", "sort/Zoo Folder", FALSE, FALSE);
+    assert_sorts_before ("sort/alpha.txt", "sort/Zebra.app", FALSE, FALSE);
+}
+
+static int
+compare_folders_first (gconstpointer a,
+                       gconstpointer b)
+{
+    return nautilus_file_compare_for_sort (NAUTILUS_FILE ((gpointer) a), NAUTILUS_FILE ((gpointer) b),
+                                           NAUTILUS_FILE_SORT_BY_DISPLAY_NAME, TRUE, FALSE);
+}
+
+/* A folders-first sort asks whether every folder it compares is a package.
+ * LaunchServices takes 30-45 µs for each, which made a folder of 5000
+ * subfolders load 0.13-0.18 s slower.  Only a folder with the bundle bit or a
+ * Contents folder may ask it; plain folders, folders with any other
+ * extension, and packages known by their extension's type must not, and
+ * packages still sort with the files. */
+static void
+test_folders_first_sort_without_launchservices (void)
+{
+    const guint plain_count = 300;
+    const guint dotted_count = 100;
+    g_autolist (NautilusFile) files = NULL;
+    guint lookups = nautilus_macos_package_kind_launchservices_lookups ();
+    guint folders = 0;
+    GList *l;
+
+    /* Counted from before the files are loaded, in case loading asks. */
+    for (guint i = 0; i < plain_count + dotted_count; i++)
+    {
+        g_autofree char *name = (i < plain_count)
+                                ? g_strdup_printf ("Many/Folder %03u", i)
+                                : g_strdup_printf ("Many/com.example.folder-%03u", i);
+        g_autofree char *path = fixture_path (name);
+
+        make_dir (path);
+        files = g_list_prepend (files, load_file (path));
+    }
+    {
+        g_autofree char *document = fixture_path ("Many/Notes.rtfd");
+        g_autofree char *app = fixture_path ("Many/Tool.app");
+        g_autofree char *bundled = fixture_path ("Many/Bundled");
+        g_autofree char *contents = fixture_path ("Many/Has.contents/Contents");
+        g_autofree char *has_contents = fixture_path ("Many/Has.contents");
+
+        make_dir (document);
+        make_dir (app);
+        make_dir (bundled);
+        set_bundle_bit (bundled);
+        make_dir (contents);
+        files = g_list_prepend (files, load_file (document));
+        files = g_list_prepend (files, load_file (app));
+        files = g_list_prepend (files, load_file (bundled));
+        files = g_list_prepend (files, load_file (has_contents));
+    }
+
+    files = g_list_sort (files, compare_folders_first);
+    lookups = nautilus_macos_package_kind_launchservices_lookups () - lookups;
+
+    g_test_message ("loading and sorting %u folders and 4 others asked LaunchServices %u times",
+                    plain_count + dotted_count, lookups);
+    /* Bundled and Has.contents only. */
+    g_assert_cmpuint (lookups, ==, 2);
+
+    /* The folders, Has.contents among them, then the packages by name. */
+    for (l = files; l != NULL && !nautilus_file_is_macos_package (l->data); l = l->next)
+    {
+        folders++;
+    }
+    g_assert_cmpuint (folders, ==, plain_count + dotted_count + 1);
+    for (const char *const *name = (const char *const[]) { "Bundled", "Notes.rtfd", "Tool.app", NULL };
+         *name != NULL; name++, l = l->next)
+    {
+        g_assert_nonnull (l);
+        g_assert_cmpstr (nautilus_file_get_name (l->data), ==, *name);
+        g_assert_true (nautilus_file_is_macos_package (l->data));
+        g_assert_true (nautilus_file_is_macos_application (l->data) == g_str_equal (*name, "Tool.app"));
+    }
+    g_assert_null (l);
+}
+
+/* ------------------------------------------------------------------------ */
+/* Setup                                                                     */
+/* ------------------------------------------------------------------------ */
+
+static void
+cleanup (void)
+{
+    /* Launching or querying an app registers it with LaunchServices; take the
+     * throwaway bundles out again before they are deleted. */
+    for (guint i = 0; i < fixture_apps->len; i++)
+    {
+        const char *argv[] = { LSREGISTER, "-u", g_ptr_array_index (fixture_apps, i), NULL };
+
+        g_spawn_sync (NULL, (char **) argv, NULL, G_SPAWN_STDOUT_TO_DEV_NULL | G_SPAWN_STDERR_TO_DEV_NULL,
+                      NULL, NULL, NULL, NULL, NULL, NULL);
+    }
+    {
+        g_autofree char *empty_app = fixture_path ("Empty.app");
+        const char *argv[] = { LSREGISTER, "-u", empty_app, NULL };
+
+        g_spawn_sync (NULL, (char **) argv, NULL, G_SPAWN_STDOUT_TO_DEV_NULL | G_SPAWN_STDERR_TO_DEV_NULL,
+                      NULL, NULL, NULL, NULL, NULL, NULL);
+    }
+
+    if (scratch_is_ours)
+    {
+        const char *argv[] = { "rm", "-rf", scratch, NULL };
+
+        g_spawn_sync (NULL, (char **) argv, NULL, G_SPAWN_SEARCH_PATH,
+                      NULL, NULL, NULL, NULL, NULL, NULL);
+    }
+}
+
+int
+main (int   argc,
+      char *argv[])
+{
+    g_autoptr (NautilusFileUndoManager) undo_manager = NULL;
+    const char *scratch_root = g_getenv ("NAUTILUS_TEST_SCRATCH");
+    int status;
+
+    /* The locale the app runs with: the bundle's launcher sets LANG to
+     * en_US.UTF-8 when it is unset (a Finder launch), and nautilus-main.c
+     * calls setlocale().  libarchive converts entry names to the locale's
+     * character set, so in the "C" locale every archive with a non-ASCII
+     * name fails to extract ("Pathname can't be converted from UTF-8 to
+     * current locale"). */
+    if (g_getenv ("LANG") == NULL)
+    {
+        g_setenv ("LANG", "en_US.UTF-8", TRUE);
+    }
+    setlocale (LC_ALL, "");
+
+    g_test_init (&argc, &argv, NULL);
+    g_test_message ("character set: %s", nl_langinfo (CODESET));
+    main_thread = g_thread_self ();
+    nautilus_ensure_extension_points ();
+    undo_manager = nautilus_file_undo_manager_new ();
+    fixture_apps = g_ptr_array_new_with_free_func (g_free);
+
+    if (scratch_root != NULL)
+    {
+        scratch = g_build_filename (scratch_root, "fixtures", NULL);
+        make_dir (scratch);
+    }
+    else
+    {
+        scratch = g_dir_make_tmp ("szf-apps-archives-XXXXXX", NULL);
+        scratch_is_ours = TRUE;
+    }
+    g_assert_nonnull (scratch);
+
+    make_package_fixtures ();
+    make_archive_fixtures ();
+
+    g_test_add_func ("/macos-apps-archives/packages/classification",
+                     test_package_classification);
+    g_test_add_func ("/macos-apps-archives/packages/activation-decision",
+                     test_activation_decision);
+    g_test_add_func ("/macos-apps-archives/packages/drag-hover",
+                     test_drag_hover);
+    g_test_add_func ("/macos-apps-archives/packages/drop-decision",
+                     test_drop_decision);
+    g_test_add_func ("/macos-apps-archives/packages/drop-answers-cached",
+                     test_drop_answers_cached);
+    g_test_add_func ("/macos-apps-archives/packages/sidebar-drag-hover",
+                     test_sidebar_drag_hover);
+    g_test_add_func ("/macos-apps-archives/packages/drop-open-with",
+                     test_drop_open_with);
+    g_test_add_func ("/macos-apps-archives/packages/list-view-expanders",
+                     test_list_view_expanders);
+    g_test_add_func ("/macos-apps-archives/packages/folders-first-sort",
+                     test_folders_first_sort);
+    g_test_add_func ("/macos-apps-archives/packages/folders-first-sort-without-launchservices",
+                     test_folders_first_sort_without_launchservices);
+    g_test_add_func ("/macos-apps-archives/packages/app-id-is-self",
+                     test_app_id_is_self);
+    g_test_add_func ("/macos-apps-archives/packages/launch-one",
+                     test_launch_one_app);
+    g_test_add_func ("/macos-apps-archives/packages/launch-several",
+                     test_launch_several_apps);
+    g_test_add_func ("/macos-apps-archives/packages/open-errors",
+                     test_open_errors);
+    g_test_add_func ("/macos-apps-archives/archives/mime-types",
+                     test_archive_mime_types);
+    g_test_add_func ("/macos-apps-archives/archives/detection",
+                     test_archive_detection);
+    g_test_add_func ("/macos-apps-archives/archives/extraction",
+                     test_extraction);
+    g_test_add_func ("/macos-apps-archives/archives/compress-round-trip",
+                     test_compress_round_trip);
+
+    status = g_test_run ();
+    cleanup ();
+
+    return status;
+}
diff --git a/test/displayless/test-macos-package-listing.c b/test/displayless/test-macos-package-listing.c
new file mode 100644
index 0000000..527365a
--- /dev/null
+++ b/test/displayless/test-macos-package-listing.c
@@ -0,0 +1,394 @@
+/*
+ * test-macos-package-listing.c: loading a folder tells its subfolders from
+ * packages before the main thread needs to know, without a display.
+ *
+ * Copyright (C) 2026 The Nautilus authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * With "folders first" on, the sort that first shows a folder asks about
+ * every subfolder whether it is an app or another package.  A few µs each
+ * made a folder of 3000 subfolders load 15-35 ms slower than 26.9.14 on the
+ * main thread.  Loading the folder answers instead, on the thread that lists
+ * it (nautilus-macos-listing.c), so the sort works out no answer itself;
+ * only a symbolic link is left to the main thread.  With "folders first"
+ * off, loading asks nothing.  On a network volume (a stubbed volume check)
+ * the folder is not read a second time and the sort asks, as before the
+ * listing answered.  Fixtures go to $NAUTILUS_TEST_SCRATCH
+ * (tools/test-macos-apps-archives.sh) or a temporary directory.
+ */
+
+#define G_LOG_DOMAIN "test-macos-package-listing"
+
+#include <nautilus-directory.h>
+#include <nautilus-file.h>
+#include <nautilus-file-private.h>
+#include <nautilus-file-utilities.h>
+#include <nautilus-global-preferences.h>
+#include <nautilus-macos-bridge.h>
+#include <nautilus-macos-listing.h>
+
+#include <gio/gio.h>
+#include <glib.h>
+#include <glib/gstdio.h>
+#include <string.h>
+#include <sys/attr.h>
+#include <sys/time.h>
+#include <unistd.h>
+
+#define __ASSERT_MACROS_DEFINE_VERSIONS_WITHOUT_UNDERSCORES 0
+#include <CoreServices/CoreServices.h>
+
+#define PLAIN_COUNT 200
+#define DOTTED_COUNT 100
+
+static char *scratch;
+static gboolean scratch_is_ours;
+
+static char *
+fixture_path (const char *name)
+{
+    return g_build_filename (scratch, name, NULL);
+}
+
+static void
+make_dir (const char *path)
+{
+    g_assert_cmpint (g_mkdir_with_parents (path, 0755), ==, 0);
+}
+
+/* The Finder's bundle bit (kHasBundle) makes a folder a package whatever its
+ * name. */
+static void
+set_bundle_bit (const char *path)
+{
+    struct attrlist request = {
+        .bitmapcount = ATTR_BIT_MAP_COUNT,
+        .commonattr = ATTR_CMN_FNDRINFO,
+    };
+    struct
+    {
+        u_int32_t length;
+        u_int8_t finder_info[32];
+    } __attribute__ ((aligned (4), packed)) reply;
+
+    g_assert_cmpint (getattrlist (path, &request, &reply, sizeof reply, 0), ==, 0);
+    reply.finder_info[8] |= kHasBundle >> 8;
+    g_assert_cmpint (setattrlist (path, &request, reply.finder_info, sizeof reply.finder_info, 0), ==, 0);
+}
+
+/* @folder holds @plain plain folders, @dotted folders named like
+ * com.example.folder-N, a folder with Contents (a folder to LaunchServices),
+ * three packages (an .rtfd, an .app and a folder with the bundle bit), a link
+ * to the app and a text file. */
+static char *
+make_listing (const char *folder,
+              guint       plain,
+              guint       dotted)
+{
+    char *root = fixture_path (folder);
+
+    for (guint i = 0; i < plain + dotted; i++)
+    {
+        g_autofree char *name = (i < plain) ? g_strdup_printf ("Folder %03u", i)
+                                            : g_strdup_printf ("com.example.folder-%03u", i);
+        g_autofree char *path = g_build_filename (root, name, NULL);
+
+        make_dir (path);
+    }
+    {
+        g_autofree char *contents = g_build_filename (root, "Has.contents", "Contents", NULL);
+        g_autofree char *document = g_build_filename (root, "Notes.rtfd", NULL);
+        g_autofree char *app = g_build_filename (root, "Tool.app", NULL);
+        g_autofree char *bundled = g_build_filename (root, "Bundled", NULL);
+        g_autofree char *link = g_build_filename (root, "Link to Tool", NULL);
+        g_autofree char *text = g_build_filename (root, "notes.txt", NULL);
+        g_autoptr (GError) error = NULL;
+
+        make_dir (contents);
+        make_dir (document);
+        make_dir (app);
+        make_dir (bundled);
+        set_bundle_bit (bundled);
+        g_assert_cmpint (symlink ("Tool.app", link), ==, 0);
+        g_file_set_contents (text, "text\n", -1, &error);
+        g_assert_no_error (error);
+    }
+
+    return root;
+}
+
+typedef struct
+{
+    gboolean done;
+    GList *files;
+} Listing;
+
+static void
+on_listed (NautilusDirectory *directory,
+           NautilusFileList  *files,
+           gpointer           user_data)
+{
+    Listing *listing = user_data;
+
+    listing->files = nautilus_file_list_copy (files);
+    listing->done = TRUE;
+}
+
+/* Loads the file list of @path as a view does, and returns its files. */
+static GList *
+load_listing (const char *path)
+{
+    g_autoptr (GFile) location = g_file_new_for_path (path);
+    g_autoptr (NautilusDirectory) directory = nautilus_directory_get (location);
+    gint64 end = g_get_monotonic_time () + 30 * G_USEC_PER_SEC;
+    Listing listing = { 0 };
+
+    nautilus_directory_call_when_ready (directory, NAUTILUS_ATTRIBUTE_INFO | NAUTILUS_ATTRIBUTE_FILE_LIST,
+                                        on_listed, &listing);
+    while (!listing.done && g_get_monotonic_time () < end)
+    {
+        g_main_context_iteration (NULL, TRUE);
+    }
+    g_assert_true (listing.done);
+
+    return listing.files;
+}
+
+static int
+compare_folders_first (gconstpointer a,
+                       gconstpointer b)
+{
+    return nautilus_file_compare_for_sort (NAUTILUS_FILE ((gpointer) a), NAUTILUS_FILE ((gpointer) b),
+                                           NAUTILUS_FILE_SORT_BY_DISPLAY_NAME, TRUE, FALSE);
+}
+
+static void
+set_folders_first (gboolean folders_first)
+{
+    g_settings_set_boolean (gtk_filechooser_preferences, NAUTILUS_PREFERENCES_SORT_DIRECTORIES_FIRST,
+                            folders_first);
+}
+
+/* After the folders (Has.contents among them) come the packages and the
+ * file, each package told apart correctly. */
+static void
+assert_sorted (GList *files,
+               guint  folders)
+{
+    guint seen = 0;
+    GList *l;
+
+    for (l = files; l != NULL && nautilus_file_is_directory (l->data) &&
+         !nautilus_file_is_macos_package (l->data); l = l->next)
+    {
+        seen++;
+    }
+    g_assert_cmpuint (seen, ==, folders);
+
+    for (seen = 0; l != NULL; l = l->next, seen++)
+    {
+        const char *name = nautilus_file_get_name (l->data);
+        gboolean app = g_str_equal (name, "Tool.app") || g_str_equal (name, "Link to Tool");
+
+        g_test_message ("after the folders: %s", name);
+        g_assert_true (nautilus_file_is_macos_package (l->data) == !g_str_equal (name, "notes.txt"));
+        g_assert_true (nautilus_file_is_macos_application (l->data) == app);
+    }
+    g_assert_cmpuint (seen, ==, 5);
+}
+
+static void
+test_folders_first_answered_while_listing (void)
+{
+    g_autofree char *root = NULL;
+    g_autolist (NautilusFile) files = NULL;
+    guint lookups, worked_out, reads;
+
+    set_folders_first (TRUE);
+    root = make_listing ("Folders first", PLAIN_COUNT, DOTTED_COUNT);
+
+    reads = nautilus_macos_listing_folders_read ();
+    lookups = nautilus_macos_package_kind_launchservices_lookups ();
+    files = load_listing (root);
+    lookups = nautilus_macos_package_kind_launchservices_lookups () - lookups;
+    g_test_message ("loading asked LaunchServices %u times", lookups);
+    /* Bundled and Has.contents, by the listing thread. */
+    g_assert_cmpuint (lookups, ==, 2);
+    /* The scratch folder is on a local volume: the other thread read it. */
+    g_assert_cmpuint (nautilus_macos_listing_folders_read () - reads, ==, 1);
+
+    lookups = nautilus_macos_package_kind_launchservices_lookups ();
+    worked_out = nautilus_file_macos_package_kinds_worked_out ();
+    files = g_list_sort (files, compare_folders_first);
+    lookups = nautilus_macos_package_kind_launchservices_lookups () - lookups;
+    worked_out = nautilus_file_macos_package_kinds_worked_out () - worked_out;
+    g_test_message ("sorting %u items worked out %u package answers, %u from LaunchServices",
+                    g_list_length (files), worked_out, lookups);
+    /* The link only: it is classified by what it points to. */
+    g_assert_cmpuint (worked_out, ==, 1);
+    g_assert_cmpuint (lookups, ==, 1);
+
+    assert_sorted (files, PLAIN_COUNT + DOTTED_COUNT + 1);
+}
+
+static void
+test_folders_first_off_asks_nothing_while_listing (void)
+{
+    const guint plain = 20;
+    const guint dotted = 10;
+    g_autofree char *root = NULL;
+    g_autolist (NautilusFile) files = NULL;
+    guint lookups, worked_out;
+
+    set_folders_first (FALSE);
+    root = make_listing ("Names only", plain, dotted);
+
+    lookups = nautilus_macos_package_kind_launchservices_lookups ();
+    files = load_listing (root);
+    lookups = nautilus_macos_package_kind_launchservices_lookups () - lookups;
+    g_assert_cmpuint (lookups, ==, 0);
+
+    /* Asked later, every folder is worked out where it is asked. */
+    worked_out = nautilus_file_macos_package_kinds_worked_out ();
+    files = g_list_sort (files, compare_folders_first);
+    worked_out = nautilus_file_macos_package_kinds_worked_out () - worked_out;
+    g_assert_cmpuint (worked_out, ==, plain + dotted + 5);
+
+    assert_sorted (files, plain + dotted + 1);
+}
+
+static gboolean
+on_network_volume (const char *folder_path)
+{
+    return FALSE;
+}
+
+/* On a network volume reading the folder again costs as much as listing it:
+ * loading reads it once and asks nothing, and the sort works every folder
+ * out, as it did before the listing answered. */
+static void
+test_network_volume_read_once (void)
+{
+    const guint plain = 20;
+    const guint dotted = 10;
+    g_autofree char *root = NULL;
+    g_autolist (NautilusFile) files = NULL;
+    guint lookups, worked_out, reads;
+
+    set_folders_first (TRUE);
+    root = make_listing ("On the network", plain, dotted);
+
+    nautilus_macos_listing_set_volume_check_for_testing (on_network_volume);
+    reads = nautilus_macos_listing_folders_read ();
+    lookups = nautilus_macos_package_kind_launchservices_lookups ();
+    files = load_listing (root);
+    lookups = nautilus_macos_package_kind_launchservices_lookups () - lookups;
+    reads = nautilus_macos_listing_folders_read () - reads;
+    nautilus_macos_listing_set_volume_check_for_testing (NULL);
+    g_test_message ("loading read the folder %u more times, asked LaunchServices %u times", reads, lookups);
+    g_assert_cmpuint (reads, ==, 0);
+    g_assert_cmpuint (lookups, ==, 0);
+
+    worked_out = nautilus_file_macos_package_kinds_worked_out ();
+    files = g_list_sort (files, compare_folders_first);
+    worked_out = nautilus_file_macos_package_kinds_worked_out () - worked_out;
+    g_assert_cmpuint (worked_out, ==, plain + dotted + 5);
+
+    assert_sorted (files, plain + dotted + 1);
+}
+
+/* The answer from the listing lasts as long as one worked out on the main
+ * thread: until the folder changes. */
+static void
+test_changed_folder_asked_again (void)
+{
+    g_autofree char *root = NULL;
+    g_autofree char *path = NULL;
+    g_autolist (NautilusFile) files = NULL;
+    g_autoptr (GFile) location = NULL;
+    g_autoptr (GFileInfo) info = NULL;
+    g_autoptr (GError) error = NULL;
+    NautilusFile *folder = NULL;
+    struct timeval later[2];
+    guint worked_out;
+
+    set_folders_first (TRUE);
+    root = make_listing ("Changes", 2, 0);
+    files = load_listing (root);
+    for (GList *l = files; l != NULL; l = l->next)
+    {
+        if (g_str_equal (nautilus_file_get_name (l->data), "Folder 000"))
+        {
+            folder = l->data;
+        }
+    }
+    g_assert_nonnull (folder);
+
+    worked_out = nautilus_file_macos_package_kinds_worked_out ();
+    g_assert_false (nautilus_file_is_macos_package (folder));
+    g_assert_cmpuint (nautilus_file_macos_package_kinds_worked_out (), ==, worked_out);
+
+    /* Its modification time moves on, as when something is added to it. */
+    path = g_build_filename (root, "Folder 000", NULL);
+    gettimeofday (&later[0], NULL);
+    later[0].tv_sec += 10;
+    later[1] = later[0];
+    g_assert_cmpint (utimes (path, later), ==, 0);
+    location = g_file_new_for_path (path);
+    info = g_file_query_info (location, NAUTILUS_FILE_DEFAULT_ATTRIBUTES, G_FILE_QUERY_INFO_NONE, NULL, &error);
+    g_assert_no_error (error);
+    nautilus_file_update_info (folder, info);
+
+    g_assert_false (nautilus_file_is_macos_package (folder));
+    g_assert_cmpuint (nautilus_file_macos_package_kinds_worked_out (), ==, worked_out + 1);
+}
+
+static void
+cleanup (void)
+{
+    if (scratch_is_ours)
+    {
+        const char *argv[] = { "rm", "-rf", scratch, NULL };
+
+        g_spawn_sync (NULL, (char **) argv, NULL, G_SPAWN_SEARCH_PATH, NULL, NULL, NULL, NULL, NULL, NULL);
+    }
+}
+
+int
+main (int   argc,
+      char *argv[])
+{
+    const char *scratch_root = g_getenv ("NAUTILUS_TEST_SCRATCH");
+    int status;
+
+    g_test_init (&argc, &argv, NULL);
+    nautilus_ensure_extension_points ();
+    nautilus_global_preferences_init ();
+
+    if (scratch_root != NULL)
+    {
+        scratch = g_build_filename (scratch_root, "package-listing", NULL);
+        make_dir (scratch);
+    }
+    else
+    {
+        scratch = g_dir_make_tmp ("szf-package-listing-XXXXXX", NULL);
+        scratch_is_ours = TRUE;
+    }
+    g_assert_nonnull (scratch);
+
+    g_test_add_func ("/macos-package-listing/folders-first/answered-while-listing",
+                     test_folders_first_answered_while_listing);
+    g_test_add_func ("/macos-package-listing/folders-first-off/asks-nothing-while-listing",
+                     test_folders_first_off_asks_nothing_while_listing);
+    g_test_add_func ("/macos-package-listing/network-volume/read-once",
+                     test_network_volume_read_once);
+    g_test_add_func ("/macos-package-listing/changed-folder-asked-again",
+                     test_changed_folder_asked_again);
+
+    status = g_test_run ();
+    cleanup ();
+
+    return status;
+}
diff --git a/test/displayless/test-macos-quicklook.m b/test/displayless/test-macos-quicklook.m
new file mode 100644
index 0000000..0733fd4
--- /dev/null
+++ b/test/displayless/test-macos-quicklook.m
@@ -0,0 +1,839 @@
+/*
+ * test-macos-quicklook.m: the Quick Look panel's keyboard-focus controller
+ * (nautilus-macos-previewer.m), without a display.
+ *
+ * The controller reaches QLPreviewPanel and NSWindow only through
+ * NautilusMacosPreviewBackend.  These tests install a fake backend that
+ * models what AppKit and Quick Look do: which window is key, whether the
+ * panel is on screen and has the keyboard, and what happens when Quick Look
+ * closes the panel itself.  No window or panel is created.  The last test
+ * sends real NSEvents through the panel delegate the app installs.
+ */
+
+#define G_LOG_DOMAIN "test-macos-quicklook"
+
+#include <nautilus-macos-bridge.h>
+
+#include <glib.h>
+
+#import <AppKit/AppKit.h>
+#import <Quartz/Quartz.h>
+
+/* Virtual key codes (kVK_* in HIToolbox/Events.h). */
+enum
+{
+    KEY_RETURN = 36,
+    KEY_TAB = 48,
+    KEY_SPACE = 49,
+    KEY_ESCAPE = 53,
+    KEY_A = 0,
+    KEY_C = 8,
+    KEY_O = 31,
+    KEY_W = 13,
+    KEY_Y = 16,
+    KEY_LEFT = 123,
+    KEY_RIGHT = 124,
+    KEY_DOWN = 125,
+    KEY_UP = 126,
+};
+
+/* Two Files windows; the fake's window handles. */
+static int window_a_storage;
+static int window_b_storage;
+#define WINDOW_A ((gpointer) &window_a_storage)
+#define WINDOW_B ((gpointer) &window_b_storage)
+
+typedef struct
+{
+    /* What AppKit and Quick Look would report. */
+    gboolean panel_visible;
+    gboolean panel_key;
+    gboolean app_active;
+    gpointer key_window;   /* NULL: none, or the panel */
+    gboolean window_a_open;
+    gboolean window_b_open;
+    /* The window AppKit makes key when the key panel leaves the screen.
+     * NULL is what the owner saw: no window gets the keyboard. */
+    gpointer appkit_next_key_window;
+
+    /* What the controller asked for. */
+    guint show_calls;
+    gboolean last_show_make_key;
+    GPtrArray *last_paths;
+    guint last_index;
+    guint close_calls;
+    guint make_key_calls;
+    gpointer last_made_key;
+    guint deliver_calls;
+    gpointer last_delivered_to;
+    gpointer last_delivered_event;
+} Fake;
+
+static Fake fake;
+
+static guint focus_calls;
+static GArray *selection_events;
+
+static void
+fake_panel_show (const char *const *paths,
+                 guint              n_paths,
+                 guint              index,
+                 gboolean           make_key,
+                 gpointer           user_data)
+{
+    g_assert_true (user_data == &fake);
+
+    fake.show_calls++;
+    fake.last_show_make_key = make_key;
+    g_ptr_array_set_size (fake.last_paths, 0);
+    for (guint i = 0; i < n_paths; i++)
+    {
+        g_ptr_array_add (fake.last_paths, g_strdup (paths[i]));
+    }
+    g_assert_null (paths[n_paths]);
+    fake.last_index = index;
+
+    if (!fake.panel_visible)
+    {
+        fake.panel_visible = TRUE;
+
+        if (make_key)
+        {
+            /* -makeKeyAndOrderFront: */
+            fake.panel_key = TRUE;
+            fake.key_window = NULL;
+        }
+    }
+}
+
+/* The panel leaving the screen (in the app, at the end of Quick Look's
+ * closing animation). */
+static void
+fake_panel_leaves_screen (void)
+{
+    fake.panel_visible = FALSE;
+
+    if (fake.panel_key)
+    {
+        fake.panel_key = FALSE;
+        fake.key_window = fake.appkit_next_key_window;
+    }
+}
+
+static void
+fake_panel_close (gpointer user_data)
+{
+    fake.close_calls++;
+    fake_panel_leaves_screen ();
+}
+
+static gboolean
+fake_panel_is_visible (gpointer user_data)
+{
+    return fake.panel_visible;
+}
+
+static gboolean
+fake_panel_is_key (gpointer user_data)
+{
+    return fake.panel_key;
+}
+
+static gboolean
+fake_app_is_active (gpointer user_data)
+{
+    return fake.app_active;
+}
+
+static gpointer
+fake_key_window (gpointer user_data)
+{
+    return fake.key_window;
+}
+
+static gboolean
+fake_window_can_be_key (gpointer window,
+                        gpointer user_data)
+{
+    return (window == WINDOW_A && fake.window_a_open) ||
+           (window == WINDOW_B && fake.window_b_open);
+}
+
+static void
+fake_window_make_key (gpointer window,
+                      gpointer user_data)
+{
+    g_assert_true (fake_window_can_be_key (window, user_data));
+
+    fake.make_key_calls++;
+    fake.last_made_key = window;
+    fake.key_window = window;
+    fake.panel_key = FALSE;
+}
+
+static void
+fake_window_deliver_key (gpointer window,
+                         gpointer native_event,
+                         gpointer user_data)
+{
+    fake.deliver_calls++;
+    fake.last_delivered_to = window;
+    fake.last_delivered_event = native_event;
+}
+
+static const NautilusMacosPreviewBackend fake_backend =
+{
+    .panel_show = fake_panel_show,
+    .panel_close = fake_panel_close,
+    .panel_is_visible = fake_panel_is_visible,
+    .panel_is_key = fake_panel_is_key,
+    .app_is_active = fake_app_is_active,
+    .key_window = fake_key_window,
+    .window_can_be_key = fake_window_can_be_key,
+    .window_make_key = fake_window_make_key,
+    .window_deliver_key = fake_window_deliver_key,
+};
+
+static void
+on_focus_returned (gpointer user_data)
+{
+    /* The keyboard is already back when GTK is asked to focus the view. */
+    g_assert_true (fake.key_window == WINDOW_A || fake.key_window == WINDOW_B);
+    focus_calls++;
+}
+
+static void
+on_selection_event (NautilusMacosPreviewDirection direction,
+                    gpointer                      user_data)
+{
+    g_array_append_val (selection_events, direction);
+}
+
+static void
+pump (void)
+{
+    while (g_main_context_iteration (NULL, FALSE))
+    {
+    }
+}
+
+/* Window A is key, the panel closed: the state after the user selected a
+ * file. */
+static void
+setup (void)
+{
+    if (fake.last_paths != NULL)
+    {
+        g_ptr_array_unref (fake.last_paths);
+    }
+
+    fake = (Fake) { 0 };
+    fake.app_active = TRUE;
+    fake.key_window = WINDOW_A;
+    fake.window_a_open = TRUE;
+    fake.window_b_open = TRUE;
+    fake.last_paths = g_ptr_array_new_with_free_func (g_free);
+
+    focus_calls = 0;
+    g_array_set_size (selection_events, 0);
+
+    nautilus_macos_preview_set_backend_for_testing (&fake_backend, &fake);
+    nautilus_macos_preview_set_focus_callback (on_focus_returned, NULL);
+    nautilus_macos_preview_set_selection_callback (on_selection_event, NULL);
+    pump ();
+}
+
+static const char *const two_images[] = { "file:///tmp/szf-ql/a.png", "file:///tmp/szf-ql/b.png", NULL };
+static const char *const one_image[] = { "file:///tmp/szf-ql/a.png", NULL };
+
+/* Space in window A's file view (view.preview-selection). */
+static void
+press_space_in_files (const char *const *uris,
+                      gpointer           window)
+{
+    nautilus_macos_preview_toggle (uris, 0, window);
+}
+
+/* Quick Look closes the panel itself, as it does on space, Escape, Cmd-W or
+ * its close button while it has the keyboard, and the panel's resign-key
+ * and occlusion notifications reach the controller. */
+static void
+quick_look_closes_itself (void)
+{
+    fake_panel_leaves_screen ();
+    nautilus_macos_preview_panel_state_changed ();
+    nautilus_macos_preview_panel_state_changed ();
+    pump ();
+}
+
+static void
+user_clicks_into_panel (void)
+{
+    g_assert_true (fake.panel_visible);
+    fake.panel_key = TRUE;
+    fake.key_window = NULL;
+}
+
+static NautilusMacosPreviewKey
+key (guint16  key_code,
+     gunichar character,
+     guint    modifiers)
+{
+    return (NautilusMacosPreviewKey) {
+        .key_code = key_code, .character = character, .modifiers = modifiers,
+    };
+}
+
+/* ------------------------------------------------------------------------ */
+
+static void
+test_space_opens_without_taking_keyboard (void)
+{
+    setup ();
+
+    press_space_in_files (two_images, WINDOW_A);
+
+    g_assert_cmpuint (fake.show_calls, ==, 1);
+    g_assert_false (fake.last_show_make_key);
+    g_assert_true (fake.panel_visible);
+    g_assert_false (fake.panel_key);
+    g_assert_true (fake.key_window == WINDOW_A);
+    g_assert_true (nautilus_macos_preview_is_showing ());
+    g_assert_cmpuint (fake.last_paths->len, ==, 2);
+    g_assert_cmpstr (fake.last_paths->pdata[0], ==, "/tmp/szf-ql/a.png");
+    g_assert_cmpstr (fake.last_paths->pdata[1], ==, "/tmp/szf-ql/b.png");
+    g_assert_cmpuint (fake.last_index, ==, 0);
+}
+
+static void
+test_space_again_closes_and_keyboard_stays (void)
+{
+    setup ();
+    press_space_in_files (one_image, WINDOW_A);
+
+    press_space_in_files (one_image, WINDOW_A);
+
+    g_assert_cmpuint (fake.show_calls, ==, 1);
+    g_assert_cmpuint (fake.close_calls, ==, 1);
+    g_assert_false (fake.panel_visible);
+    g_assert_true (fake.key_window == WINDOW_A);
+    g_assert_cmpuint (fake.make_key_calls, ==, 0);
+    g_assert_false (nautilus_macos_preview_is_showing ());
+
+    /* A third space opens it again. */
+    press_space_in_files (one_image, WINDOW_A);
+    g_assert_cmpuint (fake.show_calls, ==, 2);
+    g_assert_true (fake.panel_visible);
+    g_assert_true (fake.key_window == WINDOW_A);
+}
+
+static void
+test_escape_and_space_consumed_only_while_open (void)
+{
+    setup ();
+
+    /* The file view's space/Escape shortcut with the panel closed: the key
+     * goes on to the view. */
+    g_assert_false (nautilus_macos_preview_close_if_showing ());
+    g_assert_cmpuint (fake.close_calls, ==, 0);
+
+    press_space_in_files (one_image, WINDOW_A);
+    g_assert_true (nautilus_macos_preview_close_if_showing ());
+    g_assert_cmpuint (fake.close_calls, ==, 1);
+    g_assert_false (fake.panel_visible);
+    g_assert_true (fake.key_window == WINDOW_A);
+
+    /* nautilus_previewer_call_close (last window closed) goes the same way. */
+    nautilus_macos_preview_hide ();
+    g_assert_cmpuint (fake.close_calls, ==, 1);
+}
+
+static void
+test_selection_change_reloads_panel (void)
+{
+    setup ();
+    press_space_in_files (one_image, WINDOW_A);
+
+    /* An arrow key in the file view moved the selection. */
+    nautilus_macos_preview_show (two_images, 1, WINDOW_A);
+
+    g_assert_cmpuint (fake.show_calls, ==, 2);
+    g_assert_false (fake.last_show_make_key);
+    g_assert_cmpuint (fake.last_index, ==, 1);
+    g_assert_true (fake.panel_visible);
+    g_assert_cmpuint (fake.close_calls, ==, 0);
+    g_assert_true (fake.key_window == WINDOW_A);
+}
+
+static void
+test_clicked_panel_closes_itself_keyboard_returns (void)
+{
+    setup ();
+    press_space_in_files (one_image, WINDOW_A);
+    user_clicks_into_panel ();
+
+    /* Space while the panel has the keyboard: Quick Look closes it and
+     * AppKit makes no window key. */
+    quick_look_closes_itself ();
+
+    g_assert_cmpuint (fake.make_key_calls, ==, 1);
+    g_assert_true (fake.last_made_key == WINDOW_A);
+    g_assert_true (fake.key_window == WINDOW_A);
+    g_assert_cmpuint (focus_calls, ==, 1);
+
+    /* The session is over: later notifications change nothing. */
+    nautilus_macos_preview_panel_state_changed ();
+    pump ();
+    g_assert_cmpuint (fake.make_key_calls, ==, 1);
+    g_assert_cmpuint (focus_calls, ==, 1);
+}
+
+static void
+test_clicked_panel_closes_itself_appkit_rekeys (void)
+{
+    setup ();
+    press_space_in_files (one_image, WINDOW_A);
+    user_clicks_into_panel ();
+    fake.appkit_next_key_window = WINDOW_A;
+
+    quick_look_closes_itself ();
+
+    /* AppKit gave the keyboard back already; GTK got its focus-in. */
+    g_assert_cmpuint (fake.make_key_calls, ==, 0);
+    g_assert_cmpuint (focus_calls, ==, 0);
+    g_assert_true (fake.key_window == WINDOW_A);
+}
+
+static void
+test_clicked_panel_fading_out (void)
+{
+    setup ();
+    press_space_in_files (one_image, WINDOW_A);
+    user_clicks_into_panel ();
+
+    /* The panel resigned key when its closing animation started; it is
+     * still on screen and nothing has the keyboard. */
+    fake.panel_key = FALSE;
+    nautilus_macos_preview_panel_state_changed ();
+    pump ();
+
+    g_assert_cmpuint (fake.make_key_calls, ==, 1);
+    g_assert_true (fake.key_window == WINDOW_A);
+    g_assert_cmpuint (focus_calls, ==, 1);
+
+    /* It leaves the screen. */
+    fake.panel_visible = FALSE;
+    nautilus_macos_preview_panel_state_changed ();
+    pump ();
+
+    g_assert_cmpuint (fake.make_key_calls, ==, 1);
+    g_assert_cmpuint (focus_calls, ==, 1);
+}
+
+static void
+test_clicked_panel_cmd_y_from_menu (void)
+{
+    setup ();
+    press_space_in_files (one_image, WINDOW_A);
+    user_clicks_into_panel ();
+
+    /* File > Quick Look (Cmd-Y) activates view.preview-selection. */
+    press_space_in_files (one_image, WINDOW_A);
+
+    /* Given back at once, not after the closing animation. */
+    g_assert_cmpuint (fake.close_calls, ==, 1);
+    g_assert_cmpuint (fake.make_key_calls, ==, 1);
+    g_assert_true (fake.key_window == WINDOW_A);
+    g_assert_cmpuint (focus_calls, ==, 1);
+    g_assert_cmpuint (fake.show_calls, ==, 1);
+}
+
+static void
+test_click_back_into_files_keeps_panel (void)
+{
+    setup ();
+    press_space_in_files (one_image, WINDOW_A);
+    user_clicks_into_panel ();
+
+    /* Clicking the Files window makes it key; the panel stays open. */
+    fake.panel_key = FALSE;
+    fake.key_window = WINDOW_A;
+    nautilus_macos_preview_panel_state_changed ();
+    pump ();
+
+    g_assert_cmpuint (fake.make_key_calls, ==, 0);
+    g_assert_true (fake.panel_visible);
+
+    /* Clicking another file updates it, space then closes it. */
+    nautilus_macos_preview_show (two_images, 1, WINDOW_A);
+    g_assert_true (fake.panel_visible);
+    press_space_in_files (two_images, WINDOW_A);
+    g_assert_false (fake.panel_visible);
+    g_assert_cmpuint (fake.make_key_calls, ==, 0);
+    g_assert_true (fake.key_window == WINDOW_A);
+}
+
+static void
+test_panel_follows_other_window (void)
+{
+    setup ();
+    press_space_in_files (one_image, WINDOW_A);
+
+    /* The user clicks window B and selects a file there. */
+    fake.key_window = WINDOW_B;
+    nautilus_macos_preview_show (two_images, 0, WINDOW_B);
+    user_clicks_into_panel ();
+    quick_look_closes_itself ();
+
+    g_assert_cmpuint (fake.make_key_calls, ==, 1);
+    g_assert_true (fake.last_made_key == WINDOW_B);
+}
+
+static void
+test_app_inactive_leaves_keyboard_alone (void)
+{
+    setup ();
+    press_space_in_files (one_image, WINDOW_A);
+    user_clicks_into_panel ();
+
+    /* Switching to another app: no key window, the panel hides. */
+    fake.app_active = FALSE;
+    fake.panel_key = FALSE;
+    fake.panel_visible = FALSE;
+    nautilus_macos_preview_panel_state_changed ();
+    pump ();
+    g_assert_cmpuint (fake.make_key_calls, ==, 0);
+
+    /* Back again: AppKit shows the panel and makes it key; Quick Look then
+     * closes itself, and the keyboard still goes back to window A. */
+    fake.app_active = TRUE;
+    fake.panel_visible = TRUE;
+    fake.panel_key = TRUE;
+    quick_look_closes_itself ();
+    g_assert_cmpuint (fake.make_key_calls, ==, 1);
+    g_assert_true (fake.last_made_key == WINDOW_A);
+}
+
+static void
+test_files_window_closed_meanwhile (void)
+{
+    setup ();
+    press_space_in_files (one_image, WINDOW_A);
+    user_clicks_into_panel ();
+    fake.window_a_open = FALSE;
+
+    quick_look_closes_itself ();
+
+    g_assert_cmpuint (fake.make_key_calls, ==, 0);
+    g_assert_cmpuint (focus_calls, ==, 0);
+}
+
+static void
+test_no_files_window_panel_takes_keyboard (void)
+{
+    setup ();
+    fake.key_window = NULL;
+
+    nautilus_macos_preview_toggle (one_image, 0, NULL);
+
+    g_assert_cmpuint (fake.show_calls, ==, 1);
+    g_assert_true (fake.last_show_make_key);
+    g_assert_true (fake.panel_key);
+}
+
+static void
+test_null_files_window_means_key_window (void)
+{
+    setup ();
+
+    /* nautilus_macos_preview_files() (W2) passes no window. */
+    nautilus_macos_preview_files (one_image, 0);
+    g_assert_false (fake.last_show_make_key);
+    user_clicks_into_panel ();
+    quick_look_closes_itself ();
+    g_assert_true (fake.last_made_key == WINDOW_A);
+}
+
+static void
+test_non_local_uris_are_skipped (void)
+{
+    const char *const mixed[] =
+    {
+        "https://example.com/x.png",
+        "file:///tmp/szf-ql/a.png",
+        "trash:///b.png",
+        "file:///tmp/szf-ql/c%20d.png",
+        NULL
+    };
+    const char *const remote[] = { "https://example.com/x.png", "trash:///b.png", NULL };
+
+    setup ();
+
+    nautilus_macos_preview_show (mixed, 3, WINDOW_A);
+    g_assert_cmpuint (fake.last_paths->len, ==, 2);
+    g_assert_cmpstr (fake.last_paths->pdata[0], ==, "/tmp/szf-ql/a.png");
+    g_assert_cmpstr (fake.last_paths->pdata[1], ==, "/tmp/szf-ql/c d.png");
+    g_assert_cmpuint (fake.last_index, ==, 1);
+
+    /* The selected item is remote: start at the first local one. */
+    nautilus_macos_preview_show (mixed, 0, WINDOW_A);
+    g_assert_cmpuint (fake.last_index, ==, 0);
+    nautilus_macos_preview_show (mixed, 17, WINDOW_A);
+    g_assert_cmpuint (fake.last_index, ==, 0);
+
+    nautilus_macos_preview_close_if_showing ();
+    nautilus_macos_preview_toggle (remote, 0, WINDOW_A);
+    g_assert_cmpuint (fake.show_calls, ==, 3);
+    g_assert_false (fake.panel_visible);
+}
+
+/* The direction is only read for NAUTILUS_MACOS_PREVIEW_KEY_MOVE_SELECTION. */
+#define NO_DIRECTION NAUTILUS_MACOS_PREVIEW_DIRECTION_UP
+
+static void
+test_classify_panel_keys (void)
+{
+    const guint cmd = NAUTILUS_MACOS_PREVIEW_MODIFIER_COMMAND;
+    const guint ctrl = NAUTILUS_MACOS_PREVIEW_MODIFIER_CONTROL;
+    const guint opt = NAUTILUS_MACOS_PREVIEW_MODIFIER_OPTION;
+    const guint shift = NAUTILUS_MACOS_PREVIEW_MODIFIER_SHIFT;
+    const struct
+    {
+        guint16 key_code;
+        gunichar character;
+        guint modifiers;
+        guint n_items;
+        NautilusMacosPreviewKeyAction action;
+        NautilusMacosPreviewDirection direction;
+    } cases[] =
+    {
+        { KEY_SPACE, ' ', 0, 1, NAUTILUS_MACOS_PREVIEW_KEY_CLOSE, NO_DIRECTION },
+        { KEY_SPACE, ' ', shift, 1, NAUTILUS_MACOS_PREVIEW_KEY_CLOSE, NO_DIRECTION },
+        { KEY_ESCAPE, 0x1b, 0, 1, NAUTILUS_MACOS_PREVIEW_KEY_CLOSE, NO_DIRECTION },
+        { KEY_Y, 'y', cmd, 1, NAUTILUS_MACOS_PREVIEW_KEY_CLOSE, NO_DIRECTION },
+        { KEY_Y, 'Y', cmd, 2, NAUTILUS_MACOS_PREVIEW_KEY_CLOSE, NO_DIRECTION },
+        { KEY_Y, 'Y', cmd | shift, 1, NAUTILUS_MACOS_PREVIEW_KEY_PASS, NO_DIRECTION },
+        { KEY_Y, 'y', 0, 1, NAUTILUS_MACOS_PREVIEW_KEY_GIVE_TO_FILES, NO_DIRECTION },
+        { KEY_DOWN, 0xf701, 0, 1, NAUTILUS_MACOS_PREVIEW_KEY_MOVE_SELECTION, NAUTILUS_MACOS_PREVIEW_DIRECTION_DOWN },
+        { KEY_UP, 0xf700, 0, 3, NAUTILUS_MACOS_PREVIEW_KEY_MOVE_SELECTION, NAUTILUS_MACOS_PREVIEW_DIRECTION_UP },
+        { KEY_LEFT, 0xf702, 0, 1, NAUTILUS_MACOS_PREVIEW_KEY_MOVE_SELECTION, NAUTILUS_MACOS_PREVIEW_DIRECTION_LEFT },
+        { KEY_RIGHT, 0xf703, 0, 1, NAUTILUS_MACOS_PREVIEW_KEY_MOVE_SELECTION, NAUTILUS_MACOS_PREVIEW_DIRECTION_RIGHT },
+        { KEY_RIGHT, 0xf703, shift, 1, NAUTILUS_MACOS_PREVIEW_KEY_MOVE_SELECTION, NAUTILUS_MACOS_PREVIEW_DIRECTION_RIGHT },
+        { KEY_LEFT, 0xf702, 0, 2, NAUTILUS_MACOS_PREVIEW_KEY_PASS, NO_DIRECTION },
+        { KEY_RIGHT, 0xf703, 0, 2, NAUTILUS_MACOS_PREVIEW_KEY_PASS, NO_DIRECTION },
+        { KEY_UP, 0xf700, cmd, 1, NAUTILUS_MACOS_PREVIEW_KEY_GIVE_TO_FILES, NO_DIRECTION },
+        { KEY_DOWN, 0xf701, ctrl, 1, NAUTILUS_MACOS_PREVIEW_KEY_PASS, NO_DIRECTION },
+        { KEY_RETURN, '\r', 0, 1, NAUTILUS_MACOS_PREVIEW_KEY_GIVE_TO_FILES, NO_DIRECTION },
+        { KEY_TAB, '\t', 0, 1, NAUTILUS_MACOS_PREVIEW_KEY_GIVE_TO_FILES, NO_DIRECTION },
+        { KEY_A, 'a', 0, 1, NAUTILUS_MACOS_PREVIEW_KEY_GIVE_TO_FILES, NO_DIRECTION },
+        { KEY_A, 'a', opt, 1, NAUTILUS_MACOS_PREVIEW_KEY_GIVE_TO_FILES, NO_DIRECTION },
+        { KEY_O, 'o', cmd, 1, NAUTILUS_MACOS_PREVIEW_KEY_GIVE_TO_FILES, NO_DIRECTION },
+        { KEY_C, 'c', cmd, 1, NAUTILUS_MACOS_PREVIEW_KEY_PASS, NO_DIRECTION },
+        { KEY_W, 'w', cmd, 1, NAUTILUS_MACOS_PREVIEW_KEY_PASS, NO_DIRECTION },
+        { KEY_A, 'a', ctrl, 1, NAUTILUS_MACOS_PREVIEW_KEY_PASS, NO_DIRECTION },
+        { KEY_SPACE, ' ', ctrl, 1, NAUTILUS_MACOS_PREVIEW_KEY_PASS, NO_DIRECTION },
+    };
+
+    for (gsize i = 0; i < G_N_ELEMENTS (cases); i++)
+    {
+        NautilusMacosPreviewKey k = key (cases[i].key_code, cases[i].character, cases[i].modifiers);
+        NautilusMacosPreviewDirection direction = (NautilusMacosPreviewDirection) -1;
+        NautilusMacosPreviewKeyAction action;
+
+        action = nautilus_macos_preview_classify_panel_key (&k, cases[i].n_items, &direction);
+        if (action != cases[i].action)
+        {
+            g_error ("case %" G_GSIZE_FORMAT " (key code %u, U+%04X, modifiers 0x%x, %u items): "
+                     "action %d, expected %d", i, cases[i].key_code, cases[i].character,
+                     cases[i].modifiers, cases[i].n_items, action, cases[i].action);
+        }
+        if (action == NAUTILUS_MACOS_PREVIEW_KEY_MOVE_SELECTION)
+        {
+            g_assert_cmpint (direction, ==, cases[i].direction);
+        }
+    }
+}
+
+static void
+test_panel_arrows_move_selection (void)
+{
+    NautilusMacosPreviewKey down = key (KEY_DOWN, 0xf701, 0);
+    NautilusMacosPreviewKey left = key (KEY_LEFT, 0xf702, 0);
+
+    setup ();
+    press_space_in_files (one_image, WINDOW_A);
+    user_clicks_into_panel ();
+
+    g_assert_true (nautilus_macos_preview_panel_key_down (&down));
+    /* Never while the panel is still dispatching the key. */
+    g_assert_cmpuint (selection_events->len, ==, 0);
+    pump ();
+    g_assert_cmpuint (selection_events->len, ==, 1);
+    g_assert_cmpint (g_array_index (selection_events, NautilusMacosPreviewDirection, 0), ==,
+                     NAUTILUS_MACOS_PREVIEW_DIRECTION_DOWN);
+    /* The panel keeps the keyboard and follows the selection. */
+    g_assert_true (fake.panel_key);
+    g_assert_cmpuint (fake.make_key_calls, ==, 0);
+
+    /* With a multiple selection Left/Right page inside the panel. */
+    nautilus_macos_preview_show (two_images, 0, WINDOW_A);
+    g_assert_false (nautilus_macos_preview_panel_key_down (&left));
+    g_assert_true (nautilus_macos_preview_panel_key_down (&down));
+    pump ();
+    g_assert_cmpuint (selection_events->len, ==, 2);
+
+    /* Without a callback (no previewer set up) the key stays with Quick Look. */
+    nautilus_macos_preview_set_selection_callback (NULL, NULL);
+    g_assert_false (nautilus_macos_preview_panel_key_down (&down));
+}
+
+static void
+test_panel_keys_go_back_to_files (void)
+{
+    static int return_event;
+    NautilusMacosPreviewKey enter = key (KEY_RETURN, '\r', 0);
+    NautilusMacosPreviewKey cmd_c = key (KEY_C, 'c', NAUTILUS_MACOS_PREVIEW_MODIFIER_COMMAND);
+
+    enter.native_event = &return_event;
+
+    setup ();
+    press_space_in_files (one_image, WINDOW_A);
+    user_clicks_into_panel ();
+
+    g_assert_false (nautilus_macos_preview_panel_key_down (&cmd_c));
+    g_assert_cmpuint (fake.make_key_calls, ==, 0);
+
+    /* Return: window A gets the keyboard and the key itself; the panel stays
+     * open, as it does when the Files window has the keyboard. */
+    g_assert_true (nautilus_macos_preview_panel_key_down (&enter));
+    g_assert_cmpuint (fake.make_key_calls, ==, 1);
+    g_assert_true (fake.key_window == WINDOW_A);
+    g_assert_cmpuint (focus_calls, ==, 1);
+    g_assert_cmpuint (fake.deliver_calls, ==, 1);
+    g_assert_true (fake.last_delivered_to == WINDOW_A);
+    g_assert_true (fake.last_delivered_event == &return_event);
+    g_assert_true (fake.panel_visible);
+
+    /* Cmd-Y reaching the panel closes it like space. */
+    user_clicks_into_panel ();
+    NautilusMacosPreviewKey cmd_y = key (KEY_Y, 'y', NAUTILUS_MACOS_PREVIEW_MODIFIER_COMMAND);
+    g_assert_true (nautilus_macos_preview_panel_key_down (&cmd_y));
+    g_assert_false (fake.panel_visible);
+    g_assert_true (fake.key_window == WINDOW_A);
+    g_assert_cmpuint (focus_calls, ==, 2);
+
+    /* With the Files window gone the key stays with Quick Look. */
+    press_space_in_files (one_image, WINDOW_A);
+    user_clicks_into_panel ();
+    fake.window_a_open = FALSE;
+    g_assert_false (nautilus_macos_preview_panel_key_down (&enter));
+    g_assert_cmpuint (fake.deliver_calls, ==, 1);
+}
+
+static NSEvent *
+make_key_event (NSEventType           type,
+                unsigned short        key_code,
+                NSString             *characters,
+                NSEventModifierFlags  flags)
+{
+    return [NSEvent keyEventWithType:type
+                            location:NSZeroPoint
+                       modifierFlags:flags
+                           timestamp:0
+                        windowNumber:0
+                             context:nil
+                          characters:characters
+         charactersIgnoringModifiers:characters
+                           isARepeat:NO
+                             keyCode:key_code];
+}
+
+static void
+test_panel_delegate_with_real_events (void)
+{
+    @autoreleasepool
+    {
+        /* The data source and delegate the app installs on the panel. */
+        id<QLPreviewPanelDelegate> delegate =
+            [NSClassFromString (@"NautilusQLController") performSelector:@selector (shared)];
+        unichar down_character = NSDownArrowFunctionKey;
+        NSEvent *down = make_key_event (NSEventTypeKeyDown, KEY_DOWN,
+                                        [NSString stringWithCharacters:&down_character length:1], 0);
+        NSEvent *letter = make_key_event (NSEventTypeKeyDown, KEY_A, @"a", 0);
+        NSEvent *letter_up = make_key_event (NSEventTypeKeyUp, KEY_A, @"a", 0);
+        NSEvent *copy = make_key_event (NSEventTypeKeyDown, KEY_C, @"c", NSEventModifierFlagCommand);
+        NSEvent *quick_look = make_key_event (NSEventTypeKeyDown, KEY_Y, @"y", NSEventModifierFlagCommand);
+
+        g_assert_nonnull (delegate);
+
+        setup ();
+        press_space_in_files (one_image, WINDOW_A);
+        user_clicks_into_panel ();
+
+        g_assert_true ([delegate previewPanel:nil handleEvent:down]);
+        pump ();
+        g_assert_cmpuint (selection_events->len, ==, 1);
+
+        g_assert_false ([delegate previewPanel:nil handleEvent:letter_up]);
+        g_assert_false ([delegate previewPanel:nil handleEvent:copy]);
+        g_assert_cmpuint (fake.make_key_calls, ==, 0);
+
+        g_assert_true ([delegate previewPanel:nil handleEvent:letter]);
+        g_assert_true (fake.last_delivered_event == (gpointer) letter);
+        g_assert_true (fake.key_window == WINDOW_A);
+
+        user_clicks_into_panel ();
+        g_assert_true ([delegate previewPanel:nil handleEvent:quick_look]);
+        g_assert_false (fake.panel_visible);
+        g_assert_true (fake.key_window == WINDOW_A);
+    }
+}
+
+int
+main (int   argc,
+      char *argv[])
+{
+    g_test_init (&argc, &argv, NULL);
+    selection_events = g_array_new (FALSE, FALSE, sizeof (NautilusMacosPreviewDirection));
+
+    g_test_add_func ("/macos-quicklook/files-keyboard/space-opens-without-taking-keyboard",
+                     test_space_opens_without_taking_keyboard);
+    g_test_add_func ("/macos-quicklook/files-keyboard/space-again-closes-keyboard-stays",
+                     test_space_again_closes_and_keyboard_stays);
+    g_test_add_func ("/macos-quicklook/files-keyboard/escape-and-space-consumed-only-while-open",
+                     test_escape_and_space_consumed_only_while_open);
+    g_test_add_func ("/macos-quicklook/files-keyboard/selection-change-reloads-panel",
+                     test_selection_change_reloads_panel);
+    g_test_add_func ("/macos-quicklook/files-keyboard/panel-follows-other-window",
+                     test_panel_follows_other_window);
+    g_test_add_func ("/macos-quicklook/files-keyboard/no-files-window-panel-takes-keyboard",
+                     test_no_files_window_panel_takes_keyboard);
+    g_test_add_func ("/macos-quicklook/files-keyboard/null-files-window-means-key-window",
+                     test_null_files_window_means_key_window);
+    g_test_add_func ("/macos-quicklook/files-keyboard/non-local-uris-are-skipped",
+                     test_non_local_uris_are_skipped);
+    g_test_add_func ("/macos-quicklook/panel-keyboard/closes-itself-keyboard-returns",
+                     test_clicked_panel_closes_itself_keyboard_returns);
+    g_test_add_func ("/macos-quicklook/panel-keyboard/closes-itself-appkit-rekeys",
+                     test_clicked_panel_closes_itself_appkit_rekeys);
+    g_test_add_func ("/macos-quicklook/panel-keyboard/fading-out",
+                     test_clicked_panel_fading_out);
+    g_test_add_func ("/macos-quicklook/panel-keyboard/cmd-y-from-menu",
+                     test_clicked_panel_cmd_y_from_menu);
+    g_test_add_func ("/macos-quicklook/panel-keyboard/click-back-into-files-keeps-panel",
+                     test_click_back_into_files_keeps_panel);
+    g_test_add_func ("/macos-quicklook/panel-keyboard/app-inactive",
+                     test_app_inactive_leaves_keyboard_alone);
+    g_test_add_func ("/macos-quicklook/panel-keyboard/files-window-closed",
+                     test_files_window_closed_meanwhile);
+    g_test_add_func ("/macos-quicklook/panel-keys/classify",
+                     test_classify_panel_keys);
+    g_test_add_func ("/macos-quicklook/panel-keys/arrows-move-selection",
+                     test_panel_arrows_move_selection);
+    g_test_add_func ("/macos-quicklook/panel-keys/go-back-to-files",
+                     test_panel_keys_go_back_to_files);
+    g_test_add_func ("/macos-quicklook/panel-keys/delegate-with-real-events",
+                     test_panel_delegate_with_real_events);
+
+    return g_test_run ();
+}
diff --git a/test/displayless/test-macos-search-button-ui.c b/test/displayless/test-macos-search-button-ui.c
new file mode 100644
index 0000000..0104c08
--- /dev/null
+++ b/test/displayless/test-macos-search-button-ui.c
@@ -0,0 +1,439 @@
+/*
+ * test-macos-search-button-ui.c: the toolbar and window UI the search
+ * button lives in, read from the compiled nautilus resource; part of
+ * test-macos-search-button (see test-macos-search-button.c).
+ *
+ * Copyright (C) 2026 The Nautilus authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#define G_LOG_DOMAIN "test-macos-search-button"
+
+#include <gio/gio.h>
+#include <glib.h>
+#include <string.h>
+
+void macos_search_button_add_ui_tests (void);
+
+/* --- The compiled UI ---------------------------------------------------- */
+
+typedef struct UiObject UiObject;
+
+struct UiObject
+{
+    UiObject *parent;   /* the object it is a child of; not owned */
+    char *klass;
+    char *id;
+    /* Property name -> its text, or "bind:<source>.<property>:<flags>" for
+     * a property bound to another object's property. */
+    GHashTable *properties;
+    /* <binding> name -> the names of its lookups, outermost first, joined
+     * with " <- " ("search-visible <- window-slot"). */
+    GHashTable *bindings;
+    char *accessible_label;
+};
+
+typedef struct
+{
+    UiObject *owner;
+    char *name;
+    gboolean accessible;
+    gboolean bound;
+    GString *text;
+} UiProperty;
+
+typedef struct
+{
+    GPtrArray *objects;    /* UiObject *, document order */
+    GPtrArray *open;       /* UiObject *, innermost last */
+    GPtrArray *properties; /* UiProperty *, innermost last */
+    int accessibility_depth;
+    char *binding_name;
+    GString *binding_chain;
+} UiParser;
+
+typedef struct
+{
+    GPtrArray *objects;
+} Ui;
+
+static void
+ui_object_free (UiObject *object)
+{
+    g_free (object->klass);
+    g_free (object->id);
+    g_hash_table_unref (object->properties);
+    g_hash_table_unref (object->bindings);
+    g_free (object->accessible_label);
+    g_free (object);
+}
+
+static void
+ui_property_free (UiProperty *property)
+{
+    g_free (property->name);
+    g_string_free (property->text, TRUE);
+    g_free (property);
+}
+
+static void
+ui_free (Ui *ui)
+{
+    g_ptr_array_unref (ui->objects);
+    g_free (ui);
+}
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (Ui, ui_free)
+
+static const char *
+attribute (const char  *name,
+           const char **names,
+           const char **values)
+{
+    for (int i = 0; names[i] != NULL; i++)
+    {
+        if (strcmp (names[i], name) == 0)
+        {
+            return values[i];
+        }
+    }
+
+    return NULL;
+}
+
+static UiObject *
+innermost_object (UiParser *parser)
+{
+    return parser->open->len > 0 ? g_ptr_array_index (parser->open, parser->open->len - 1) : NULL;
+}
+
+static void
+ui_start_element (GMarkupParseContext  *context,
+                  const char           *element,
+                  const char          **names,
+                  const char          **values,
+                  gpointer              user_data,
+                  GError              **error)
+{
+    UiParser *parser = user_data;
+
+    if (strcmp (element, "object") == 0 || strcmp (element, "template") == 0)
+    {
+        UiObject *object = g_new0 (UiObject, 1);
+
+        object->parent = innermost_object (parser);
+        object->klass = g_strdup (attribute ("class", names, values));
+        object->id = g_strdup (strcmp (element, "template") == 0
+                               ? "template" : attribute ("id", names, values));
+        object->properties = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_free);
+        object->bindings = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_free);
+        g_ptr_array_add (parser->objects, object);
+        g_ptr_array_add (parser->open, object);
+    }
+    else if (strcmp (element, "property") == 0)
+    {
+        UiProperty *property = g_new0 (UiProperty, 1);
+        const char *bind_source = attribute ("bind-source", names, values);
+
+        property->owner = innermost_object (parser);
+        property->name = g_strdup (attribute ("name", names, values));
+        property->accessible = parser->accessibility_depth > 0;
+        property->text = g_string_new (NULL);
+        if (bind_source != NULL && property->owner != NULL)
+        {
+            const char *flags = attribute ("bind-flags", names, values);
+
+            property->bound = TRUE;
+            g_hash_table_replace (property->owner->properties,
+                                  g_strdup (property->name),
+                                  g_strdup_printf ("bind:%s.%s:%s", bind_source,
+                                                   attribute ("bind-property", names, values),
+                                                   flags != NULL ? flags : ""));
+        }
+        g_ptr_array_add (parser->properties, property);
+    }
+    else if (strcmp (element, "accessibility") == 0)
+    {
+        parser->accessibility_depth++;
+    }
+    else if (strcmp (element, "binding") == 0)
+    {
+        g_free (parser->binding_name);
+        parser->binding_name = g_strdup (attribute ("name", names, values));
+        g_string_truncate (parser->binding_chain, 0);
+    }
+    else if (strcmp (element, "lookup") == 0 && parser->binding_name != NULL)
+    {
+        if (parser->binding_chain->len > 0)
+        {
+            g_string_append (parser->binding_chain, " <- ");
+        }
+        g_string_append (parser->binding_chain, attribute ("name", names, values));
+    }
+}
+
+static void
+ui_end_element (GMarkupParseContext  *context,
+                const char           *element,
+                gpointer              user_data,
+                GError              **error)
+{
+    UiParser *parser = user_data;
+
+    if (strcmp (element, "object") == 0 || strcmp (element, "template") == 0)
+    {
+        g_ptr_array_remove_index (parser->open, parser->open->len - 1);
+    }
+    else if (strcmp (element, "property") == 0)
+    {
+        UiProperty *property = g_ptr_array_index (parser->properties, parser->properties->len - 1);
+
+        if (property->owner != NULL && !property->bound)
+        {
+            if (property->accessible)
+            {
+                if (g_strcmp0 (property->name, "label") == 0)
+                {
+                    g_free (property->owner->accessible_label);
+                    property->owner->accessible_label = g_strdup (property->text->str);
+                }
+            }
+            else if (property->text->len > 0)
+            {
+                g_hash_table_replace (property->owner->properties,
+                                      g_strdup (property->name),
+                                      g_strdup (property->text->str));
+            }
+        }
+        g_ptr_array_remove_index (parser->properties, parser->properties->len - 1);
+    }
+    else if (strcmp (element, "accessibility") == 0)
+    {
+        parser->accessibility_depth--;
+    }
+    else if (strcmp (element, "binding") == 0)
+    {
+        UiObject *owner = innermost_object (parser);
+
+        if (owner != NULL && parser->binding_name != NULL)
+        {
+            g_hash_table_replace (owner->bindings, g_strdup (parser->binding_name),
+                                  g_strdup (parser->binding_chain->str));
+        }
+        g_clear_pointer (&parser->binding_name, g_free);
+    }
+}
+
+static void
+ui_text (GMarkupParseContext  *context,
+         const char           *text,
+         gsize                 length,
+         gpointer              user_data,
+         GError              **error)
+{
+    UiParser *parser = user_data;
+
+    if (parser->properties->len > 0)
+    {
+        UiProperty *property = g_ptr_array_index (parser->properties, parser->properties->len - 1);
+
+        g_string_append_len (property->text, text, length);
+    }
+}
+
+/* Parses a .ui file from the nautilus resource, the one the app builds its
+ * widgets from. */
+static Ui *
+load_ui (const char *resource_path)
+{
+    static const GMarkupParser markup_parser =
+    {
+        .start_element = ui_start_element,
+        .end_element = ui_end_element,
+        .text = ui_text,
+    };
+    g_autoptr (GError) error = NULL;
+    g_autoptr (GBytes) bytes = g_resources_lookup_data (resource_path,
+                                                        G_RESOURCE_LOOKUP_FLAGS_NONE,
+                                                        &error);
+    g_assert_no_error (error);
+
+    UiParser parser =
+    {
+        .objects = g_ptr_array_new_with_free_func ((GDestroyNotify) ui_object_free),
+        .open = g_ptr_array_new (),
+        .properties = g_ptr_array_new_with_free_func ((GDestroyNotify) ui_property_free),
+        .binding_chain = g_string_new (NULL),
+    };
+    gsize size;
+    const char *data = g_bytes_get_data (bytes, &size);
+    g_autoptr (GMarkupParseContext) context = g_markup_parse_context_new (&markup_parser, 0,
+                                                                          &parser, NULL);
+
+    g_markup_parse_context_parse (context, data, size, &error);
+    g_assert_no_error (error);
+    g_markup_parse_context_end_parse (context, &error);
+    g_assert_no_error (error);
+    g_assert_cmpuint (parser.open->len, ==, 0);
+
+    Ui *ui = g_new0 (Ui, 1);
+    ui->objects = g_steal_pointer (&parser.objects);
+    g_ptr_array_unref (parser.open);
+    g_ptr_array_unref (parser.properties);
+    g_string_free (parser.binding_chain, TRUE);
+    g_free (parser.binding_name);
+
+    return ui;
+}
+
+static UiObject *
+find_by_id (Ui         *ui,
+            const char *id)
+{
+    for (guint i = 0; i < ui->objects->len; i++)
+    {
+        UiObject *object = g_ptr_array_index (ui->objects, i);
+
+        if (g_strcmp0 (object->id, id) == 0)
+        {
+            return object;
+        }
+    }
+
+    return NULL;
+}
+
+static guint
+count_with_property (Ui         *ui,
+                     const char *name,
+                     const char *value)
+{
+    guint count = 0;
+
+    for (guint i = 0; i < ui->objects->len; i++)
+    {
+        UiObject *object = g_ptr_array_index (ui->objects, i);
+
+        if (g_strcmp0 (g_hash_table_lookup (object->properties, name), value) == 0)
+        {
+            count++;
+        }
+    }
+
+    return count;
+}
+
+#define TOOLBAR_UI "/org/gnome/nautilus/ui/nautilus-toolbar.ui"
+#define WINDOW_UI "/org/gnome/nautilus/ui/nautilus-window.ui"
+
+/* The end button does what upstream's "Search Current Folder" toggle and
+ * Cmd-F do: it turns the slot's search-visible on (and off again). */
+static void
+test_end_button_searches_current_folder (void)
+{
+    g_autoptr (Ui) ui = load_ui (TOOLBAR_UI);
+    UiObject *button = find_by_id (ui, "end_search_button");
+    UiObject *upstream_toggle = find_by_id (ui, "search_button");
+
+    g_assert_nonnull (button);
+    g_assert_nonnull (upstream_toggle);
+    g_assert_cmpstr (button->klass, ==, "GtkToggleButton");
+    g_assert_cmpstr (g_hash_table_lookup (button->properties, "action-name"), ==,
+                     "slot.search-visible");
+    g_assert_cmpstr (g_hash_table_lookup (button->properties, "action-name"), ==,
+                     g_hash_table_lookup (upstream_toggle->properties, "action-name"));
+    /* Pressed while the tab shows a search, like the upstream toggle. */
+    g_assert_cmpstr (g_hash_table_lookup (button->bindings, "active"), ==,
+                     "search-visible <- window-slot");
+    g_assert_cmpstr (g_hash_table_lookup (button->bindings, "active"), ==,
+                     g_hash_table_lookup (upstream_toggle->bindings, "active"));
+    /* What it says it does, to the pointer and to VoiceOver: the words the
+     * upstream toggle and the shortcuts window use for Cmd-F. */
+    g_assert_cmpstr (g_hash_table_lookup (button->properties, "tooltip-text"), ==,
+                     "Search Current Folder");
+    g_assert_cmpstr (button->accessible_label, ==, "Search Current Folder");
+    g_assert_cmpstr (g_hash_table_lookup (upstream_toggle->properties, "tooltip-text"), ==,
+                     "Search Current Folder");
+    g_assert_nonnull (button->parent);
+    g_assert_cmpstr (button->parent->id, ==, "end_search_button_stack");
+    g_assert_cmpstr (g_hash_table_lookup (button->parent->properties, "visible"), ==,
+                     "bind:NautilusToolbar.show-end-search-button:sync-create");
+}
+
+/* During Search Everywhere the toolbar shows neither folder search toggle
+ * (toolbar_update_appearance() in nautilus-toolbar.c swaps each stack to its
+ * empty placeholder): it would look pressed and say "Search Current Folder"
+ * while the results come from everywhere, and pressing it would end the
+ * search.  Each toggle sits in a stack with a placeholder to swap in. */
+static void
+test_toggles_make_way_for_search_everywhere (void)
+{
+    static const char *toggles[][3] =
+    {
+        { "search_button", "search_button_stack", "search_button_placeholder" },
+        { "end_search_button", "end_search_button_stack", "end_search_button_placeholder" },
+    };
+    g_autoptr (Ui) ui = load_ui (TOOLBAR_UI);
+
+    for (gsize i = 0; i < G_N_ELEMENTS (toggles); i++)
+    {
+        UiObject *toggle = find_by_id (ui, toggles[i][0]);
+        UiObject *placeholder = find_by_id (ui, toggles[i][2]);
+
+        g_test_message ("%s", toggles[i][0]);
+        g_assert_nonnull (toggle);
+        g_assert_nonnull (placeholder);
+        g_assert_nonnull (toggle->parent);
+        g_assert_cmpstr (toggle->parent->id, ==, toggles[i][1]);
+        g_assert_cmpstr (toggle->parent->klass, ==, "GtkStack");
+        g_assert_true (placeholder->parent == toggle->parent);
+        g_assert_cmpstr (placeholder->klass, ==, "AdwBin");
+    }
+}
+
+/* No toolbar button starts a search everywhere, and where the end button is
+ * shown the upstream toggle next to the path bar is not, so the toolbar has
+ * one folder search toggle. */
+static void
+test_toolbar_has_one_folder_search_toggle (void)
+{
+    g_autoptr (Ui) ui = load_ui (TOOLBAR_UI);
+    UiObject *stack = find_by_id (ui, "search_button_stack");
+
+    g_assert_cmpuint (count_with_property (ui, "action-name", "slot.search-global"), ==, 0);
+    g_assert_cmpuint (count_with_property (ui, "action-name", "slot.search-visible"), ==, 2);
+    g_assert_nonnull (stack);
+    g_assert_cmpstr (g_hash_table_lookup (stack->properties, "visible"), ==,
+                     "bind:NautilusToolbar.show-end-search-button:sync-create|invert-boolean");
+}
+
+/* The browser window shows the end button, and nothing in its header starts
+ * a search everywhere.  Search Everywhere stays in the menu bar (Shift-Cmd-F)
+ * and on the "No Results Found" page of a folder search. */
+static void
+test_window_shows_end_button (void)
+{
+    g_autoptr (Ui) ui = load_ui (WINDOW_UI);
+    UiObject *toolbar = find_by_id (ui, "toolbar");
+
+    g_assert_nonnull (toolbar);
+    g_assert_cmpstr (toolbar->klass, ==, "NautilusToolbar");
+    g_assert_cmpstr (g_hash_table_lookup (toolbar->properties, "show-end-search-button"), ==,
+                     "true");
+    g_assert_null (g_hash_table_lookup (toolbar->properties, "show-global-search-button"));
+    g_assert_cmpuint (count_with_property (ui, "action-name", "slot.search-global"), ==, 0);
+}
+
+void
+macos_search_button_add_ui_tests (void)
+{
+    g_test_add_func ("/macos-search-button/toolbar/end-button-searches-current-folder",
+                     test_end_button_searches_current_folder);
+    g_test_add_func ("/macos-search-button/toolbar/one-folder-search-toggle",
+                     test_toolbar_has_one_folder_search_toggle);
+    g_test_add_func ("/macos-search-button/toolbar/toggles-make-way-for-search-everywhere",
+                     test_toggles_make_way_for_search_everywhere);
+    g_test_add_func ("/macos-search-button/window/shows-end-button",
+                     test_window_shows_end_button);
+}
diff --git a/test/displayless/test-macos-search-button.c b/test/displayless/test-macos-search-button.c
new file mode 100644
index 0000000..3bbc887
--- /dev/null
+++ b/test/displayless/test-macos-search-button.c
@@ -0,0 +1,392 @@
+/*
+ * test-macos-search-button.c: what the search button at the end of the
+ * macOS toolbar does, without a display.
+ *
+ * Copyright (C) 2026 The Nautilus authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * On macOS the window's content toolbar ends with a magnifier button, where
+ * Finder has its search field.  It must search the current folder and its
+ * subfolders, in the current tab, as Cmd-F does, and not start a search
+ * everywhere.  Opening a GTK display on macOS makes the test process a
+ * foreground app (GDK calls TransformProcessType and activates it), so this
+ * test creates no widget.  It checks the two halves of the route instead:
+ *
+ *   - the button: the toolbar and window UI the app loads (compiled from
+ *     the blueprints into the nautilus resource) wire the button to the
+ *     slot's search-visible action, the action of upstream's "Search
+ *     Current Folder" toggle and of Cmd-F (slot.focus-search turns
+ *     search-visible on).  No toolbar button starts "Search Everywhere"
+ *     (slot.search-global); the upstream toggle next to the path bar is
+ *     hidden where this button is shown, so there is one folder search
+ *     toggle, not two.
+ *
+ *   - the search it opens: with search-visible on, the query editor builds
+ *     its query from the slot's location (create_query() and
+ *     nautilus_query_editor_set_location() in nautilus-query-editor.c), and
+ *     the files view runs it in a search directory
+ *     (nautilus_files_view_set_search_query()).  The test builds the same
+ *     query for a real folder and runs it through a real search directory:
+ *     it is rooted at the folder, recursive under the default search
+ *     settings, finds matches in nested subfolders and nothing outside the
+ *     folder.  Where there is no folder (Recent, Starred, Other Locations),
+ *     the query stays rooted at that place, so the search looks through
+ *     what the place lists, as Cmd-F does there.
+ *
+ * The button half is in test-macos-search-button-ui.c.  What only a display
+ * can show (the button looking pressed while a search
+ * is open, the search field taking the keyboard) is checklist O in
+ * docs/STATUS.md.
+ */
+
+#define G_LOG_DOMAIN "test-macos-search-button"
+
+#include <nautilus-directory.h>
+#include <nautilus-file.h>
+#include <nautilus-file-utilities.h>
+#include <nautilus-global-preferences.h>
+#include <nautilus-query.h>
+#include <nautilus-resources.h>
+#include <nautilus-scheme.h>
+#include <nautilus-search-directory.h>
+#include <nautilus-tag-manager.h>
+
+#include <gio/gio.h>
+#include <glib.h>
+#include <glib/gstdio.h>
+#include <string.h>
+
+/* The button half, in test-macos-search-button-ui.c. */
+void macos_search_button_add_ui_tests (void);
+
+/* --- The search it opens ------------------------------------------------ */
+
+static char *scratch;
+/* Warnings other than the expected Localsearch one; see log_writer_cb(). */
+static guint unexpected_warnings;
+
+static void
+file_ready_cb (NautilusFile *file,
+               gpointer      user_data)
+{
+    *(gboolean *) user_data = TRUE;
+}
+
+/* test-utilities.c has the same helper, but it needs glycin, which macOS
+ * does not have. */
+static void
+load_file_attributes (NautilusFile       *file,
+                      NautilusAttributes  attributes)
+{
+    gboolean done = FALSE;
+
+    nautilus_file_call_when_ready (file, attributes, file_ready_cb, &done);
+    while (!done)
+    {
+        g_main_context_iteration (NULL, TRUE);
+    }
+}
+
+static void
+write_file (const char *relative_path)
+{
+    g_autofree char *path = g_build_filename (scratch, relative_path, NULL);
+    g_autofree char *parent = g_path_get_dirname (path);
+    g_autoptr (GError) error = NULL;
+
+    g_assert_cmpint (g_mkdir_with_parents (parent, 0700), ==, 0);
+    g_file_set_contents (path, "", 0, &error);
+    g_assert_no_error (error);
+}
+
+static void
+remove_tree (const char *path)
+{
+    g_autoptr (GDir) dir = g_dir_open (path, 0, NULL);
+    const char *name;
+
+    while (dir != NULL && (name = g_dir_read_name (dir)) != NULL)
+    {
+        g_autofree char *child = g_build_filename (path, name, NULL);
+
+        if (g_file_test (child, G_FILE_TEST_IS_DIR) && !g_file_test (child, G_FILE_TEST_IS_SYMLINK))
+        {
+            remove_tree (child);
+        }
+        else
+        {
+            g_unlink (child);
+        }
+    }
+    g_rmdir (path);
+}
+
+/* The query the search field builds for a tab showing @location, as
+ * create_query() in nautilus-query-editor.c does once search-visible has
+ * shown it (its location is bound to the slot's). */
+static NautilusQuery *
+folder_search_query (GFile      *location,
+                     const char *text)
+{
+    NautilusQuery *query = nautilus_query_new ();
+
+    nautilus_query_set_text (query, text);
+    nautilus_query_set_location (query, location);
+
+    return query;
+}
+
+/* A search directory for @query, as nautilus_files_view_set_search_query()
+ * makes one. */
+static NautilusSearchDirectory *
+search_directory_for (NautilusQuery *query)
+{
+    g_autofree char *uri = nautilus_search_directory_generate_new_uri ();
+    g_autoptr (GFile) location = g_file_new_for_uri (uri);
+    NautilusDirectory *directory = nautilus_directory_get (location);
+
+    g_assert_true (NAUTILUS_IS_SEARCH_DIRECTORY (directory));
+    nautilus_search_directory_set_query (NAUTILUS_SEARCH_DIRECTORY (directory), query);
+
+    return NAUTILUS_SEARCH_DIRECTORY (directory);
+}
+
+static void
+done_loading_cb (NautilusDirectory *directory,
+                  gpointer           user_data)
+{
+    g_main_loop_quit (user_data);
+}
+
+static gboolean
+search_timeout_cb (gpointer user_data)
+{
+    g_error ("the folder search did not finish within 60 seconds");
+    return G_SOURCE_REMOVE;
+}
+
+static gboolean
+contains_path (GPtrArray  *paths,
+               const char *relative_path)
+{
+    g_autofree char *path = g_build_filename (scratch, relative_path, NULL);
+
+    for (guint i = 0; i < paths->len; i++)
+    {
+        /* Spotlight can report /private/var for /var. */
+        const char *found = g_ptr_array_index (paths, i);
+
+        if (g_str_equal (found, path) ||
+            (g_str_has_prefix (found, "/private") && g_str_equal (found + strlen ("/private"), path)) ||
+            (g_str_has_prefix (path, "/private") && g_str_equal (path + strlen ("/private"), found)))
+        {
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
+
+/* Rooted at the current folder, recursive under the default search settings:
+ * matches in the folder and in nested subfolders, nothing beside it. */
+static void
+test_search_is_rooted_and_recursive (void)
+{
+    g_autofree char *folder_path = g_build_filename (scratch, "Projects", NULL);
+    g_autoptr (GFile) folder = g_file_new_for_path (folder_path);
+    g_autoptr (NautilusFile) shown = NULL;
+    g_autoptr (NautilusQuery) query = NULL;
+    g_autoptr (NautilusSearchDirectory) directory = NULL;
+    g_autoptr (GFile) search_location = NULL;
+    g_autoptr (GMainLoop) loop = g_main_loop_new (NULL, FALSE);
+    g_autoptr (GPtrArray) paths = g_ptr_array_new_with_free_func (g_free);
+    GList *files;
+    gulong done_handler;
+    guint timeout;
+
+    write_file ("Projects/needle top.txt");
+    write_file ("Projects/Sub/needle in sub.txt");
+    write_file ("Projects/Sub/Deeper/needle deep.txt");
+    write_file ("Projects/Sub/haystack.txt");
+    write_file ("Elsewhere/needle elsewhere.txt");
+
+    /* The tab showing the folder holds its loaded file; "local-only"
+     * recursion is decided from it (get_recursion_tradeoff() in
+     * nautilus-query.c). */
+    shown = nautilus_file_get (folder);
+    load_file_attributes (shown, NAUTILUS_ATTRIBUTE_INFO | NAUTILUS_ATTRIBUTE_FILESYSTEM_INFO);
+    g_assert_false (nautilus_file_is_remote (shown));
+
+    query = folder_search_query (folder, "needle");
+    g_assert_false (nautilus_query_is_global (query));
+    g_assert_true (nautilus_query_recursive (query));
+
+    directory = search_directory_for (query);
+    search_location = nautilus_search_directory_get_search_location (directory);
+    g_assert_nonnull (search_location);
+    g_assert_true (g_file_equal (search_location, folder));
+
+    /* Watched the way the files view watches it: a file monitor, until
+     * the search directory reports that it is done loading. */
+    timeout = g_timeout_add_seconds (60, search_timeout_cb, NULL);
+    done_handler = g_signal_connect (directory, "done-loading",
+                                     G_CALLBACK (done_loading_cb), loop);
+    nautilus_directory_file_monitor_add (NAUTILUS_DIRECTORY (directory), &paths, TRUE,
+                                         NAUTILUS_ATTRIBUTE_INFO, NULL, NULL);
+    g_main_loop_run (loop);
+    g_source_remove (timeout);
+    g_signal_handler_disconnect (directory, done_handler);
+
+    files = nautilus_directory_get_file_list (NAUTILUS_DIRECTORY (directory));
+    for (GList *l = files; l != NULL; l = l->next)
+    {
+        g_autoptr (GFile) location = nautilus_file_get_location (l->data);
+        char *path = g_file_get_path (location);
+
+        if (path != NULL)
+        {
+            g_ptr_array_add (paths, path);
+        }
+    }
+    nautilus_file_list_free (files);
+    nautilus_directory_file_monitor_remove (NAUTILUS_DIRECTORY (directory), &paths);
+
+    for (guint i = 0; i < paths->len; i++)
+    {
+        g_test_message ("hit: %s", (char *) g_ptr_array_index (paths, i));
+    }
+    g_assert_true (contains_path (paths, "Projects/needle top.txt"));
+    g_assert_true (contains_path (paths, "Projects/Sub/needle in sub.txt"));
+    g_assert_true (contains_path (paths, "Projects/Sub/Deeper/needle deep.txt"));
+    g_assert_false (contains_path (paths, "Projects/Sub/haystack.txt"));
+    g_assert_false (contains_path (paths, "Elsewhere/needle elsewhere.txt"));
+    g_assert_cmpuint (paths->len, ==, 3);
+    g_assert_cmpuint (unexpected_warnings, ==, 0);
+}
+
+/* From inside search results, the search field keeps the real folder as its
+ * root, not the internal search:/// location
+ * (nautilus_query_editor_set_location() resolves it the same way). */
+static void
+test_search_from_results_keeps_folder (void)
+{
+    g_autofree char *folder_path = g_build_filename (scratch, "Projects", NULL);
+    g_autoptr (GFile) folder = g_file_new_for_path (folder_path);
+    g_autoptr (NautilusQuery) query = folder_search_query (folder, "needle");
+    g_autoptr (NautilusSearchDirectory) directory = search_directory_for (query);
+    g_autoptr (GFile) search_location = nautilus_search_directory_get_search_location (directory);
+
+    g_assert_nonnull (search_location);
+    g_assert_true (g_file_equal (search_location, folder));
+}
+
+/* Where there is no folder (Recent, Starred, Other Locations), the search
+ * stays in the place the tab shows and looks through what it lists, as
+ * Cmd-F does there: it never turns into a search everywhere.  (Trash is not
+ * a tab on macOS: the port opens it in Finder.) */
+static void
+test_places_without_folder_stay_in_place (void)
+{
+    const char *places[] =
+    {
+        SCHEME_RECENT ":///",
+        SCHEME_STARRED ":///",
+        SCHEME_NETWORK_VIEW ":///",
+    };
+
+    for (gsize i = 0; i < G_N_ELEMENTS (places); i++)
+    {
+        g_autoptr (GFile) place = g_file_new_for_uri (places[i]);
+        g_autoptr (NautilusQuery) query = folder_search_query (place, "needle");
+        g_autoptr (NautilusSearchDirectory) directory = search_directory_for (query);
+        g_autoptr (GFile) search_location = nautilus_search_directory_get_search_location (directory);
+        g_autoptr (NautilusDirectory) place_model = nautilus_directory_get (place);
+
+        g_test_message ("place: %s", places[i]);
+        g_assert_false (nautilus_query_is_global (query));
+        g_assert_nonnull (search_location);
+        g_assert_true (g_file_equal (search_location, place));
+        /* The search directory filters this place's own listing
+         * (update_base_model() picks the folder search for it). */
+        g_assert_nonnull (place_model);
+    }
+    g_assert_cmpuint (unexpected_warnings, ==, 0);
+}
+
+/* The search engine warns that Localsearch, GNOME's indexer, is not
+ * available on macOS (Spotlight is used instead); the app logs the same.
+ * Warnings are therefore not fatal here; any other warning is counted and
+ * fails the search tests. */
+static GLogWriterOutput
+log_writer_cb (GLogLevelFlags   log_level,
+               const GLogField *fields,
+               gsize            n_fields,
+               gpointer         user_data)
+{
+    if ((log_level & G_LOG_LEVEL_WARNING) != 0)
+    {
+        const char *domain = NULL;
+        const char *message = NULL;
+
+        for (gsize i = 0; i < n_fields; i++)
+        {
+            if (g_strcmp0 (fields[i].key, "GLIB_DOMAIN") == 0)
+            {
+                domain = fields[i].value;
+            }
+            else if (g_strcmp0 (fields[i].key, "MESSAGE") == 0)
+            {
+                message = fields[i].value;
+            }
+        }
+
+        if (!(g_strcmp0 (domain, "nautilus-search") == 0 &&
+              message != NULL && strstr (message, "Localsearch") != NULL))
+        {
+            unexpected_warnings++;
+        }
+    }
+
+    return g_log_writer_default (log_level, fields, n_fields, user_data);
+}
+
+int
+main (int   argc,
+      char *argv[])
+{
+    g_autoptr (NautilusTagManager) tag_manager = NULL;
+    int status;
+
+    g_log_set_writer_func (log_writer_cb, NULL, NULL);
+    g_test_init (&argc, &argv, NULL);
+    g_log_set_always_fatal (G_LOG_FATAL_MASK | G_LOG_LEVEL_CRITICAL);
+    nautilus_register_resource ();
+    nautilus_ensure_extension_points ();
+    /* Search, starred and network directories, as the application
+     * registers them. */
+    nautilus_ensure_extension_builtins ();
+    /* Starred asks the tag manager; the dummy one keeps no database. */
+    tag_manager = nautilus_tag_manager_new_dummy ();
+    /* The search settings (recursive-search), from the memory backend the
+     * test environment selects: the defaults. */
+    nautilus_global_preferences_init ();
+
+    scratch = g_dir_make_tmp ("szf-search-button-XXXXXX", NULL);
+    g_assert_nonnull (scratch);
+
+    macos_search_button_add_ui_tests ();
+    g_test_add_func ("/macos-search-button/search/rooted-and-recursive",
+                     test_search_is_rooted_and_recursive);
+    g_test_add_func ("/macos-search-button/search/from-results-keeps-folder",
+                     test_search_from_results_keeps_folder);
+    g_test_add_func ("/macos-search-button/search/places-without-folder",
+                     test_places_without_folder_stay_in_place);
+
+    status = g_test_run ();
+
+    remove_tree (scratch);
+    g_free (scratch);
+
+    return status;
+}
diff --git a/test/displayless/test-macos-trash-undo.c b/test/displayless/test-macos-trash-undo.c
new file mode 100644
index 0000000..93dec09
--- /dev/null
+++ b/test/displayless/test-macos-trash-undo.c
@@ -0,0 +1,233 @@
+/*
+ * test-macos-trash-undo.c: Undo after Move to Trash on macOS, without a
+ * display.
+ *
+ * Copyright (C) 2026 The Nautilus authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Local files go to the macOS Trash through NSFileManager
+ * (nautilus-macos-trash.m), which keeps no trash:/// listing of where an item
+ * came from, so upstream's Undo, which looks the item up there, found
+ * nothing and left it in the Trash.  This trashes throwaway files in
+ * $NAUTILUS_TEST_SCRATCH (tools/test-macos-trash-undo.sh) or a temporary
+ * directory through the same file operation as Cmd-Delete, and checks:
+ *
+ *   - Undo moves a file back to where it was, with its contents;
+ *   - Redo trashes it again, and Undo brings it back once more;
+ *   - Undo of several files at once brings each back;
+ *   - a file trashed from a folder that is gone by the time of Undo stays in
+ *     the Trash (Undo reports it could not restore it), it is not lost.
+ *
+ * Every file the test trashes and does not get back is removed from the
+ * Trash at the end, by the path NSFileManager gave.
+ *
+ * It does not use g_test_init(): under GTest, file operations delete instead
+ * of trashing (can_delete_without_confirm() in nautilus-file-operations.c),
+ * and the Trash is what this is about.  Each check prints a TAP line; a
+ * failed one takes the test's files out of the Trash before exiting.
+ */
+
+#include <nautilus-file-operations.h>
+#include <nautilus-file-undo-manager.h>
+#include <nautilus-file-utilities.h>
+#include <nautilus-macos-bridge.h>
+
+#include <gio/gio.h>
+#include <glib.h>
+#include <glib/gstdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static char *scratch;
+static GPtrArray *trashed_originals;
+
+static void forget_all (void);
+
+#define CHECK(condition) \
+    G_STMT_START { \
+        if (!(condition)) \
+        { \
+            g_print ("not ok - %s:%d: %s\n", __FILE__, __LINE__, #condition); \
+            forget_all (); \
+            exit (1); \
+        } \
+    } G_STMT_END
+
+static GFile *
+scratch_file (const char *name,
+              const char *contents)
+{
+    g_autofree char *path = g_build_filename (scratch, name, NULL);
+    GFile *file = g_file_new_for_path (path);
+
+    CHECK (g_file_replace_contents (file, contents, strlen (contents), NULL, FALSE,
+                                    G_FILE_CREATE_NONE, NULL, NULL, NULL));
+    return file;
+}
+
+static void
+wait_for_undo_change (void (*operation) (GtkWindow                      *parent_window,
+                                         NautilusFileOperationsDBusData *dbus_data))
+{
+    g_autoptr (GMainContext) context = g_main_context_new ();
+    g_autoptr (GMainLoop) loop = NULL;
+    gulong handler_id;
+
+    g_main_context_push_thread_default (context);
+    loop = g_main_loop_new (context, FALSE);
+    handler_id = g_signal_connect_swapped (nautilus_file_undo_manager_get (), "undo-changed",
+                                           G_CALLBACK (g_main_loop_quit), loop);
+    operation (NULL, NULL);
+    g_main_loop_run (loop);
+    g_signal_handler_disconnect (nautilus_file_undo_manager_get (), handler_id);
+    g_main_context_pop_thread_default (context);
+}
+
+static void
+trash (GList *files)
+{
+    nautilus_file_operations_trash_or_delete_sync (files);
+    for (GList *l = files; l != NULL; l = l->next)
+    {
+        g_autoptr (GFile) trashed = nautilus_macos_trash_lookup (l->data);
+
+        g_ptr_array_add (trashed_originals, g_object_ref (l->data));
+        CHECK (!g_file_query_exists (l->data, NULL));
+        CHECK (trashed != NULL && g_file_query_exists (trashed, NULL));
+    }
+}
+
+/* Leaves nothing of the test in the Trash or the scratch directory. */
+static void
+forget (GFile *original)
+{
+    g_autoptr (GFile) trashed = nautilus_macos_trash_lookup (original);
+
+    if (trashed != NULL)
+    {
+        g_file_delete (trashed, NULL, NULL);
+    }
+    g_file_delete (original, NULL, NULL);
+}
+
+static void
+forget_all (void)
+{
+    for (guint i = 0; i < trashed_originals->len; i++)
+    {
+        forget (g_ptr_array_index (trashed_originals, i));
+    }
+    g_ptr_array_set_size (trashed_originals, 0);
+}
+
+static void
+assert_contents (GFile      *file,
+                 const char *expected)
+{
+    g_autofree char *contents = NULL;
+
+    CHECK (g_file_load_contents (file, NULL, &contents, NULL, NULL, NULL));
+    CHECK (g_strcmp0 (contents, expected) == 0);
+}
+
+static void
+test_undo_one_file (void)
+{
+    g_autoptr (GFile) file = scratch_file ("Quarterly report.txt", "kept");
+    g_autolist (GFile) files = g_list_prepend (NULL, g_object_ref (file));
+
+    trash (files);
+    wait_for_undo_change (nautilus_file_undo_manager_undo);
+    assert_contents (file, "kept");
+
+    wait_for_undo_change (nautilus_file_undo_manager_redo);
+    CHECK (!g_file_query_exists (file, NULL));
+    wait_for_undo_change (nautilus_file_undo_manager_undo);
+    assert_contents (file, "kept");
+
+    forget_all ();
+}
+
+static void
+test_undo_several_files (void)
+{
+    g_autoptr (GFile) first = scratch_file ("Plan A.txt", "a");
+    g_autoptr (GFile) second = scratch_file ("Plan B 日本.txt", "b");
+    g_autolist (GFile) files = NULL;
+
+    files = g_list_prepend (files, g_object_ref (second));
+    files = g_list_prepend (files, g_object_ref (first));
+    trash (files);
+    wait_for_undo_change (nautilus_file_undo_manager_undo);
+    assert_contents (first, "a");
+    assert_contents (second, "b");
+
+    forget_all ();
+}
+
+static void
+test_undo_into_a_folder_that_is_gone (void)
+{
+    g_autofree char *folder_path = g_build_filename (scratch, "Gone folder", NULL);
+    g_autofree char *path = g_build_filename (folder_path, "inside.txt", NULL);
+    g_autoptr (GFile) file = g_file_new_for_path (path);
+    g_autolist (GFile) files = NULL;
+    g_autoptr (GFile) trashed = NULL;
+
+    CHECK (g_mkdir (folder_path, 0755) == 0);
+    CHECK (g_file_replace_contents (file, "x", 1, NULL, FALSE, G_FILE_CREATE_NONE, NULL, NULL, NULL));
+    files = g_list_prepend (files, g_object_ref (file));
+    trash (files);
+    CHECK (g_rmdir (folder_path) == 0);
+
+    wait_for_undo_change (nautilus_file_undo_manager_undo);
+    CHECK (!g_file_query_exists (file, NULL));
+    trashed = nautilus_macos_trash_lookup (file);
+    CHECK (g_file_query_exists (trashed, NULL));
+
+    forget_all ();
+}
+
+static void
+run (const char *name,
+     void      (*check) (void))
+{
+    static int number;
+
+    check ();
+    g_print ("ok %d - %s\n", ++number, name);
+}
+
+int
+main (void)
+{
+    g_autoptr (NautilusFileUndoManager) undo_manager = NULL;
+    const char *scratch_root = g_getenv ("NAUTILUS_TEST_SCRATCH");
+
+    g_assert_false (g_test_initialized ());
+    trashed_originals = g_ptr_array_new_with_free_func (g_object_unref);
+    nautilus_ensure_extension_points ();
+    undo_manager = nautilus_file_undo_manager_new ();
+    if (scratch_root != NULL)
+    {
+        g_autofree char *template = g_build_filename (scratch_root, "trash-undo.XXXXXX", NULL);
+
+        scratch = g_mkdtemp (g_steal_pointer (&template));
+    }
+    else
+    {
+        scratch = g_dir_make_tmp ("szf-trash-undo.XXXXXX", NULL);
+    }
+    g_assert_nonnull (scratch);
+
+    g_print ("1..3\n");
+    run ("undo one file, redo, undo again", test_undo_one_file);
+    run ("undo several files", test_undo_several_files);
+    run ("undo into a folder that is gone", test_undo_into_a_folder_that_is_gone);
+
+    CHECK (g_rmdir (scratch) == 0);
+    g_free (scratch);
+    g_ptr_array_unref (trashed_originals);
+    return 0;
+}
diff --git a/test/displayless/test-macos-volumes.c b/test/displayless/test-macos-volumes.c
new file mode 100644
index 0000000..2de6948
--- /dev/null
+++ b/test/displayless/test-macos-volumes.c
@@ -0,0 +1,1674 @@
+#define G_LOG_DOMAIN "test-macos-volumes"
+
+#include <nautilus-macos-bridge.h>
+
+#include <CoreFoundation/CoreFoundation.h>
+#include <NetFS/NetFS.h>
+#include <gio/gio.h>
+#include <glib.h>
+#include <glib/gstdio.h>
+#include <sys/mount.h>
+
+/* How long after the mount, unmount or rename command returns the monitor
+ * may take to report it.  The command returns once macOS has finished, so
+ * this bounds what a user sees after plugging a disk in. */
+#define DEADLINE_MS 1000
+
+/* Hot-plug tests attach real throwaway disk images.  hdiutil and diskutil
+ * need no privileges for images the user attached, and the images live in
+ * $NAUTILUS_TEST_SCRATCH when set (tools/test-macos-volumes.sh sets it and
+ * detaches anything left there if a test aborts), else in a temporary
+ * directory.  Nothing here opens a window. */
+
+static void
+test_mounted_volumes_are_browsable_and_unique (void)
+{
+    g_autoptr (GHashTable) paths = g_hash_table_new_full (g_str_hash,
+                                                          g_str_equal,
+                                                          g_free,
+                                                          NULL);
+    GList *volumes = nautilus_macos_get_mounted_volumes ();
+    gboolean found_startup_volume = FALSE;
+
+    g_assert_nonnull (volumes);
+
+    for (GList *l = volumes; l != NULL; l = l->next)
+    {
+        NautilusMacosMountedVolume *volume = l->data;
+
+        g_assert_nonnull (volume->name);
+        g_assert_cmpstr (volume->name, !=, "");
+        g_assert_nonnull (volume->path);
+        g_assert_true (g_path_is_absolute (volume->path));
+        g_assert_true (g_file_test (volume->path, G_FILE_TEST_IS_DIR));
+        g_assert_false (g_str_has_prefix (volume->path, "/System/Volumes/"));
+        g_assert_true (g_hash_table_add (paths, g_strdup (volume->path)));
+
+        if (g_str_equal (volume->path, "/"))
+        {
+            found_startup_volume = TRUE;
+            g_assert_true (volume->is_internal);
+            g_assert_false (volume->can_unmount);
+            g_assert_false (volume->can_eject);
+        }
+    }
+
+    g_assert_true (found_startup_volume);
+    g_list_free_full (volumes, (GDestroyNotify) nautilus_macos_mounted_volume_free);
+}
+
+/* ------------------------------------------------------------------------ */
+/* Main loop                                                                 */
+/* ------------------------------------------------------------------------ */
+
+/* In the app GDK runs the main CFRunLoop inside the GLib main loop, which is
+ * what delivers NSWorkspace notifications.  Tests that want them pump both
+ * loops; the Disk Arbitration test pumps GLib only, to show that source does
+ * not need the run loop. */
+static gboolean pump_run_loop;
+/* Every signal must arrive here, never on the monitor's queue. */
+static GThread *main_thread;
+
+static void
+pump_once (void)
+{
+    while (g_main_context_iteration (NULL, FALSE))
+    {
+    }
+
+    if (pump_run_loop)
+    {
+        CFRunLoopRunInMode (kCFRunLoopDefaultMode, 0.005, TRUE);
+    }
+    else
+    {
+        g_usleep (5000);
+    }
+}
+
+static void
+pump_for (gint64 ms)
+{
+    gint64 end = g_get_monotonic_time () + ms * 1000;
+
+    while (g_get_monotonic_time () < end)
+    {
+        pump_once ();
+    }
+}
+
+/* ------------------------------------------------------------------------ */
+/* Commands                                                                  */
+/* ------------------------------------------------------------------------ */
+
+typedef struct
+{
+    gboolean done;
+    gint64 exit_time;
+    int exit_status;
+    char *output;
+} Command;
+
+static void
+command_done_cb (GObject      *source,
+                 GAsyncResult *result,
+                 gpointer      user_data)
+{
+    Command *command = user_data;
+    g_autoptr (GBytes) output = NULL;
+    g_autoptr (GError) error = NULL;
+
+    g_subprocess_communicate_finish (G_SUBPROCESS (source), result, &output, NULL, &error);
+    g_assert_no_error (error);
+    command->exit_time = g_get_monotonic_time ();
+    command->exit_status = g_subprocess_get_exit_status (G_SUBPROCESS (source));
+    command->output = g_strndup (g_bytes_get_data (output, NULL), g_bytes_get_size (output));
+    command->done = TRUE;
+}
+
+/* Runs @argv while the loops keep turning, so events that arrive during the
+ * command are delivered as they would be in the app. */
+static void
+command_run (Command            *command,
+             const char * const *argv)
+{
+    g_autoptr (GSubprocess) process = NULL;
+    g_autoptr (GError) error = NULL;
+    g_autofree char *joined = g_strjoinv (" ", (char **) argv);
+
+    memset (command, 0, sizeof (*command));
+    process = g_subprocess_newv (argv,
+                                 G_SUBPROCESS_FLAGS_STDOUT_PIPE | G_SUBPROCESS_FLAGS_STDERR_MERGE,
+                                 &error);
+    g_assert_no_error (error);
+    g_subprocess_communicate_async (process, NULL, NULL, command_done_cb, command);
+    while (!command->done)
+    {
+        pump_once ();
+    }
+
+    g_test_message ("%s -> %d: %s", joined, command->exit_status, command->output);
+}
+
+static void
+command_clear (Command *command)
+{
+    g_clear_pointer (&command->output, g_free);
+}
+
+/* Starts every command in @argvs at once and keeps the loops turning until
+ * all of them have exited. */
+static void
+commands_run_parallel (Command                   *commands,
+                       const char * const *const *argvs,
+                       guint                      n_commands)
+{
+    gboolean all_done = FALSE;
+
+    for (guint i = 0; i < n_commands; i++)
+    {
+        g_autoptr (GSubprocess) process = NULL;
+        g_autoptr (GError) error = NULL;
+
+        memset (&commands[i], 0, sizeof (commands[i]));
+        process = g_subprocess_newv (argvs[i],
+                                     G_SUBPROCESS_FLAGS_STDOUT_PIPE | G_SUBPROCESS_FLAGS_STDERR_MERGE,
+                                     &error);
+        g_assert_no_error (error);
+        g_subprocess_communicate_async (process, NULL, NULL, command_done_cb, &commands[i]);
+    }
+
+    while (!all_done)
+    {
+        pump_once ();
+        all_done = TRUE;
+        for (guint i = 0; i < n_commands; i++)
+        {
+            all_done = all_done && commands[i].done;
+        }
+    }
+
+    for (guint i = 0; i < n_commands; i++)
+    {
+        g_autofree char *joined = g_strjoinv (" ", (char **) argvs[i]);
+
+        g_test_message ("%s -> %d: %s", joined, commands[i].exit_status, commands[i].output);
+    }
+}
+
+/* ------------------------------------------------------------------------ */
+/* Throwaway disk image                                                      */
+/* ------------------------------------------------------------------------ */
+
+typedef struct
+{
+    char *directory;
+    char *image_path;
+    char *name;
+    char *device;           /* /dev/diskN, while attached */
+    char *mount_point;      /* while attached */
+    gint64 attached_time;   /* when hdiutil attach returned */
+} TestImage;
+
+static void
+test_image_create (TestImage *image)
+{
+    const char *scratch = g_getenv ("NAUTILUS_TEST_SCRATCH");
+    g_autofree char *stage = NULL;
+    g_autofree char *never_index = NULL;
+    g_autoptr (GError) error = NULL;
+    Command command;
+
+    memset (image, 0, sizeof (*image));
+    if (scratch != NULL)
+    {
+        g_autofree char *template = g_build_filename (scratch, "volumes-XXXXXX", NULL);
+        image->directory = g_mkdtemp (g_steal_pointer (&template));
+    }
+    else
+    {
+        image->directory = g_dir_make_tmp ("nautilus-volumes-XXXXXX", &error);
+        g_assert_no_error (error);
+    }
+    g_assert_nonnull (image->directory);
+
+    /* A space in the name, as real volume names often have. */
+    image->name = g_strdup_printf ("SZF Hotplug %05x", g_random_int_range (0, 0xfffff));
+    image->image_path = g_build_filename (image->directory, "volume.dmg", NULL);
+
+    /* Seed the volume with .metadata_never_index so Spotlight does not hold
+     * it busy when the test detaches it. */
+    stage = g_build_filename (image->directory, "stage", NULL);
+    g_assert_cmpint (g_mkdir (stage, 0700), ==, 0);
+    never_index = g_build_filename (stage, ".metadata_never_index", NULL);
+    g_assert_true (g_file_set_contents (never_index, "", 0, &error));
+    g_assert_no_error (error);
+
+    command_run (&command, (const char * const []) {
+        "hdiutil", "create", "-quiet", "-size", "4m", "-fs", "HFS+", "-format", "UDRW",
+        "-volname", image->name, "-srcfolder", stage, image->image_path, NULL
+    });
+    g_assert_cmpint (command.exit_status, ==, 0);
+    command_clear (&command);
+}
+
+static void
+test_image_attach (TestImage *image)
+{
+    g_auto (GStrv) lines = NULL;
+    Command command;
+
+    command_run (&command, (const char * const []) {
+        "hdiutil", "attach", "-noautoopen", "-noverify", image->image_path, NULL
+    });
+    g_assert_cmpint (command.exit_status, ==, 0);
+    image->attached_time = command.exit_time;
+
+    /* "/dev/disk7\tGUID_partition_scheme\t\n"
+     * "/dev/disk7s1\tApple_HFS\t/Volumes/SZF Hotplug 1a2b3\n" */
+    lines = g_strsplit (command.output, "\n", -1);
+    for (char **line = lines; *line != NULL; line++)
+    {
+        const char *mount_point = strstr (*line, "/Volumes/");
+
+        if (image->device == NULL && g_str_has_prefix (*line, "/dev/disk"))
+        {
+            image->device = g_strndup (*line, strcspn (*line, " \t"));
+        }
+        if (mount_point != NULL)
+        {
+            image->mount_point = g_strchomp (g_strdup (mount_point));
+        }
+    }
+    g_assert_nonnull (image->device);
+    g_assert_nonnull (image->mount_point);
+    command_clear (&command);
+}
+
+static gint64
+test_image_detach (TestImage *image)
+{
+    gint64 exit_time = 0;
+
+    /* Retry briefly if something still has the volume open. */
+    for (int attempt = 0; attempt < 5 && image->device != NULL; attempt++)
+    {
+        Command command;
+
+        command_run (&command, (const char * const []) {
+            "hdiutil", "detach", attempt < 4 ? "-quiet" : "-force", image->device, NULL
+        });
+        if (command.exit_status == 0)
+        {
+            exit_time = command.exit_time;
+            g_clear_pointer (&image->device, g_free);
+        }
+        command_clear (&command);
+        if (image->device != NULL)
+        {
+            pump_for (500);
+        }
+    }
+
+    g_assert_null (image->device);
+    g_clear_pointer (&image->mount_point, g_free);
+    return exit_time;
+}
+
+static void
+test_image_destroy (TestImage *image)
+{
+    g_autofree char *stage = g_build_filename (image->directory, "stage", NULL);
+    g_autofree char *never_index = g_build_filename (stage, ".metadata_never_index", NULL);
+
+    /* An eject through NSWorkspace may already have detached the image. */
+    if (image->device != NULL && g_file_test (image->device, G_FILE_TEST_EXISTS))
+    {
+        test_image_detach (image);
+    }
+    g_clear_pointer (&image->device, g_free);
+    g_unlink (image->image_path);
+    g_unlink (never_index);
+    g_rmdir (stage);
+    g_rmdir (image->directory);
+    g_free (image->directory);
+    g_free (image->image_path);
+    g_free (image->name);
+    g_free (image->mount_point);
+}
+
+/* ------------------------------------------------------------------------ */
+/* Throwaway disk image with one or two volumes                              */
+/* ------------------------------------------------------------------------ */
+
+/* Detaching an image with two partitions unmounts both volumes at once, as
+ * ejecting a partitioned USB disk does. */
+
+typedef struct
+{
+    char *name;
+    char *mount_point;      /* while attached */
+    char *identifier;       /* statfs f_fsid formatted like the monitor's */
+} TestVolume;
+
+typedef struct
+{
+    char *directory;
+    char *image_path;
+    char *device;           /* /dev/diskN, while attached */
+    guint n_volumes;
+    TestVolume volumes[2];
+    gint64 attached_time;   /* when hdiutil attach returned */
+    gint64 detached_time;   /* when hdiutil detach returned */
+} PartitionedImage;
+
+/* Volume names come back from the file system decomposed (HFS+ stores
+ * names in NFD); compare them and paths built from them in one form. */
+static gboolean
+same_name (const char *a,
+           const char *b)
+{
+    g_autofree char *a_nfc = NULL;
+    g_autofree char *b_nfc = NULL;
+
+    if (a == NULL || b == NULL)
+    {
+        return a == b;
+    }
+
+    a_nfc = g_utf8_normalize (a, -1, G_NORMALIZE_NFC);
+    b_nfc = g_utf8_normalize (b, -1, G_NORMALIZE_NFC);
+    return a_nfc != NULL && b_nfc != NULL && g_str_equal (a_nfc, b_nfc);
+}
+
+/* How the mount table spells a mount point with accented or Hangul
+ * characters: as its folder was created.  The volume list must find the
+ * volume either way. */
+typedef enum
+{
+    SPELLING_ANY,
+    SPELLING_PRECOMPOSED,       /* NFC, and not the same as NFD */
+    SPELLING_DECOMPOSED,        /* NFD, and not the same as NFC */
+} Spelling;
+
+/* Checks that the mount table spells the mount point of the volume mounted
+ * at @mount_point (any spelling) as @spelling: what makes the case a test. */
+static void
+assert_mount_table_spelling (const char *label,
+                             const char *mount_point,
+                             Spelling    spelling)
+{
+    struct statfs fs;
+    g_autofree char *nfc = NULL;
+    g_autofree char *nfd = NULL;
+
+    g_assert_cmpint (statfs (mount_point, &fs), ==, 0);
+    nfc = g_utf8_normalize (fs.f_mntonname, -1, G_NORMALIZE_NFC);
+    nfd = g_utf8_normalize (fs.f_mntonname, -1, G_NORMALIZE_NFD);
+    g_test_message ("%s: the mount table spells the mount point %s", label,
+                    g_strcmp0 (nfc, nfd) == 0 ? "without accents or Hangul" :
+                    g_strcmp0 (fs.f_mntonname, nfc) == 0 ? "precomposed (NFC)" :
+                    g_strcmp0 (fs.f_mntonname, nfd) == 0 ? "decomposed (NFD)" : "in neither form");
+
+    switch (spelling)
+    {
+        case SPELLING_PRECOMPOSED:
+        {
+            g_assert_cmpstr (fs.f_mntonname, ==, nfc);
+            g_assert_cmpstr (fs.f_mntonname, !=, nfd);
+        }
+        break;
+
+        case SPELLING_DECOMPOSED:
+        {
+            g_assert_cmpstr (fs.f_mntonname, ==, nfd);
+            g_assert_cmpstr (fs.f_mntonname, !=, nfc);
+        }
+        break;
+
+        case SPELLING_ANY:
+        default:
+        {
+        }
+        break;
+    }
+}
+
+/* hdiutil prints mount points decomposed, while the kernel keeps a folder's
+ * name as it was created (precomposed, for one the test made so). */
+static char *
+mount_point_identifier (const char *mount_point)
+{
+    struct statfs fs;
+
+    g_assert_cmpint (statfs (mount_point, &fs), ==, 0);
+    if (!same_name (fs.f_mntonname, mount_point))
+    {
+        g_error ("statfs (%s) reports the mount point %s", mount_point, fs.f_mntonname);
+    }
+    return g_strdup_printf ("%08x%08x",
+                            (unsigned int) fs.f_fsid.val[0],
+                            (unsigned int) fs.f_fsid.val[1]);
+}
+
+static void
+partitioned_image_create (PartitionedImage *image,
+                          const char       *first_name,
+                          const char       *second_name)
+{
+    const char *scratch = g_getenv ("NAUTILUS_TEST_SCRATCH");
+    g_autoptr (GError) error = NULL;
+    g_auto (GStrv) lines = NULL;
+    g_autofree char *device = NULL;
+    Command command;
+
+    memset (image, 0, sizeof (*image));
+    if (scratch != NULL)
+    {
+        g_autofree char *template = g_build_filename (scratch, "volumes-XXXXXX", NULL);
+        image->directory = g_mkdtemp (g_steal_pointer (&template));
+    }
+    else
+    {
+        image->directory = g_dir_make_tmp ("nautilus-volumes-XXXXXX", &error);
+        g_assert_no_error (error);
+    }
+    g_assert_nonnull (image->directory);
+
+    image->n_volumes = second_name != NULL ? 2 : 1;
+    image->volumes[0].name = g_strdup (first_name);
+    image->volumes[1].name = g_strdup (second_name);
+    image->image_path = g_build_filename (image->directory, "partitioned.dmg", NULL);
+
+    /* A blank image, partitioned once attached: hdiutil create makes only
+     * single-volume images. */
+    command_run (&command, (const char * const []) {
+        "hdiutil", "create", "-quiet", "-size", "12m", "-layout", "NONE", "-type", "UDIF",
+        image->image_path, NULL
+    });
+    g_assert_cmpint (command.exit_status, ==, 0);
+    command_clear (&command);
+
+    command_run (&command, (const char * const []) {
+        "hdiutil", "attach", "-nomount", "-noverify", image->image_path, NULL
+    });
+    g_assert_cmpint (command.exit_status, ==, 0);
+    device = g_strndup (command.output, strcspn (command.output, " \t\n"));
+    g_assert_true (g_str_has_prefix (device, "/dev/disk"));
+    command_clear (&command);
+
+    if (image->n_volumes == 2)
+    {
+        command_run (&command, (const char * const []) {
+            "diskutil", "partitionDisk", device, "GPT",
+            "HFS+", first_name, "5M",
+            "HFS+", second_name, "R", NULL
+        });
+    }
+    else
+    {
+        command_run (&command, (const char * const []) {
+            "diskutil", "partitionDisk", device, "GPT", "HFS+", first_name, "R", NULL
+        });
+    }
+    g_assert_cmpint (command.exit_status, ==, 0);
+    command_clear (&command);
+
+    /* partitionDisk mounted the new volumes ("/dev/disk7s1 on /Volumes/SZF
+     * Pair 1a2b3 (hfs, local, …)"); keep Spotlight off them, so it does not
+     * hold them busy when the test detaches them. */
+    command_run (&command, (const char * const []) { "mount", NULL });
+    g_assert_cmpint (command.exit_status, ==, 0);
+    lines = g_strsplit (command.output, "\n", -1);
+    command_clear (&command);
+    for (char **line = lines; *line != NULL; line++)
+    {
+        const char *on = strstr (*line, " on ");
+        const char *end = g_strrstr (*line, " (");
+
+        if (g_str_has_prefix (*line, device) && (*line)[strlen (device)] == 's' &&
+            on != NULL && end != NULL && end > on)
+        {
+            g_autofree char *mount_point = g_strndup (on + 4, end - on - 4);
+            g_autofree char *never_index = g_build_filename (mount_point, ".metadata_never_index", NULL);
+
+            g_assert_true (g_file_set_contents (never_index, "", 0, &error));
+            g_assert_no_error (error);
+        }
+    }
+
+    command_run (&command, (const char * const []) { "hdiutil", "detach", "-quiet", device, NULL });
+    if (command.exit_status != 0)
+    {
+        command_clear (&command);
+        pump_for (500);
+        command_run (&command, (const char * const []) { "hdiutil", "detach", "-force", device, NULL });
+    }
+    g_assert_cmpint (command.exit_status, ==, 0);
+    command_clear (&command);
+}
+
+/* @mount_point: where to mount a single-volume image, or NULL for
+ * /Volumes/<name>. */
+static void
+partitioned_image_attach_at (PartitionedImage *image,
+                             const char       *mount_point)
+{
+    g_auto (GStrv) lines = NULL;
+    Command command;
+
+    if (mount_point != NULL)
+    {
+        g_assert_cmpuint (image->n_volumes, ==, 1);
+        command_run (&command, (const char * const []) {
+            "hdiutil", "attach", "-noautoopen", "-noverify", "-mountpoint", mount_point,
+            image->image_path, NULL
+        });
+    }
+    else
+    {
+        command_run (&command, (const char * const []) {
+            "hdiutil", "attach", "-noautoopen", "-noverify", image->image_path, NULL
+        });
+    }
+    g_assert_cmpint (command.exit_status, ==, 0);
+    image->attached_time = command.exit_time;
+
+    /* "/dev/disk7\tGUID_partition_scheme\t\n"
+     * "/dev/disk7s1\tApple_HFS\t/Volumes/SZF Pair 1a2b3\n"
+     * "/dev/disk7s2\tApple_HFS\t/Volumes/SZF Pär 文件 1a2b3\n" */
+    lines = g_strsplit (command.output, "\n", -1);
+    for (char **line = lines; *line != NULL; line++)
+    {
+        g_auto (GStrv) fields = g_strsplit (*line, "\t", -1);
+        g_autofree char *point = NULL;
+        g_autofree char *base = NULL;
+
+        if (image->device == NULL && g_str_has_prefix (*line, "/dev/disk"))
+        {
+            image->device = g_strndup (*line, strcspn (*line, " \t"));
+        }
+        if (g_strv_length (fields) < 3 || fields[2][0] != '/')
+        {
+            continue;
+        }
+
+        point = g_strchomp (g_strdup (fields[2]));
+        base = g_path_get_basename (point);
+        for (guint v = 0; v < image->n_volumes; v++)
+        {
+            if (mount_point != NULL || same_name (base, image->volumes[v].name))
+            {
+                image->volumes[v].mount_point = g_strdup (point);
+                image->volumes[v].identifier = mount_point_identifier (point);
+            }
+        }
+    }
+    g_assert_nonnull (image->device);
+    for (guint v = 0; v < image->n_volumes; v++)
+    {
+        g_assert_nonnull (image->volumes[v].mount_point);
+    }
+    command_clear (&command);
+}
+
+static void
+partitioned_image_attach (PartitionedImage *image)
+{
+    partitioned_image_attach_at (image, NULL);
+}
+
+static void
+partitioned_image_forget_mounts (PartitionedImage *image)
+{
+    g_clear_pointer (&image->device, g_free);
+    for (guint v = 0; v < image->n_volumes; v++)
+    {
+        g_clear_pointer (&image->volumes[v].mount_point, g_free);
+        g_clear_pointer (&image->volumes[v].identifier, g_free);
+    }
+}
+
+/* Detaches every image in @images at the same moment (one hdiutil per
+ * image).  An image something still held busy is retried on its own. */
+static void
+partitioned_images_detach_together (PartitionedImage **images,
+                                    guint              n_images)
+{
+    g_autofree Command *commands = g_new0 (Command, n_images);
+    g_autofree const char **argvs = g_new0 (const char *, n_images * 4);
+    g_autofree const char * const **argv_list = g_new0 (const char * const *, n_images);
+
+    for (guint i = 0; i < n_images; i++)
+    {
+        const char **argv = &argvs[i * 4];
+
+        argv[0] = "hdiutil";
+        argv[1] = "detach";
+        argv[2] = images[i]->device;
+        argv[3] = NULL;
+        argv_list[i] = argv;
+    }
+
+    commands_run_parallel (commands, argv_list, n_images);
+
+    for (guint i = 0; i < n_images; i++)
+    {
+        images[i]->detached_time = commands[i].exit_time;
+        if (commands[i].exit_status != 0)
+        {
+            Command retry;
+
+            pump_for (500);
+            command_run (&retry, (const char * const []) {
+                "hdiutil", "detach", "-force", images[i]->device, NULL
+            });
+            g_assert_cmpint (retry.exit_status, ==, 0);
+            images[i]->detached_time = retry.exit_time;
+            command_clear (&retry);
+        }
+        command_clear (&commands[i]);
+        partitioned_image_forget_mounts (images[i]);
+    }
+}
+
+static void
+partitioned_image_destroy (PartitionedImage *image)
+{
+    if (image->device != NULL && g_file_test (image->device, G_FILE_TEST_EXISTS))
+    {
+        PartitionedImage *images[] = { image };
+
+        partitioned_images_detach_together (images, 1);
+    }
+    partitioned_image_forget_mounts (image);
+    g_unlink (image->image_path);
+    g_rmdir (image->directory);
+    g_free (image->directory);
+    g_free (image->image_path);
+    g_free (image->volumes[0].name);
+    g_free (image->volumes[1].name);
+}
+
+/* ------------------------------------------------------------------------ */
+/* What a subscriber (a window's sidebar) sees                               */
+/* ------------------------------------------------------------------------ */
+
+typedef struct
+{
+    const char *label;
+    const char *name;          /* the volume name to watch */
+    const char *new_name;      /* rename target, or NULL */
+    guint added;
+    guint removed;
+    guint renamed;
+    guint changed_signals;
+    gint64 added_time;
+    gint64 removed_time;
+    gint64 renamed_time;
+    char *renamed_to_path;
+} Recorder;
+
+/* Volume names are compared in one normalization form (same_name()): a
+ * share named with precomposed characters may be reported either way. */
+static void
+volume_added_cb (NautilusMacosVolumeMonitor *monitor,
+                 NautilusMacosMountedVolume *volume,
+                 Recorder                   *recorder)
+{
+    g_assert_true (g_thread_self () == main_thread);
+    if (same_name (volume->name, recorder->name))
+    {
+        recorder->added++;
+        recorder->added_time = g_get_monotonic_time ();
+    }
+}
+
+static void
+volume_removed_cb (NautilusMacosVolumeMonitor *monitor,
+                   NautilusMacosMountedVolume *volume,
+                   Recorder                   *recorder)
+{
+    g_assert_true (g_thread_self () == main_thread);
+    if (same_name (volume->name, recorder->name) ||
+        (recorder->new_name != NULL && same_name (volume->name, recorder->new_name)))
+    {
+        recorder->removed++;
+        recorder->removed_time = g_get_monotonic_time ();
+    }
+}
+
+static void
+volume_changed_cb (NautilusMacosVolumeMonitor *monitor,
+                   NautilusMacosMountedVolume *old_volume,
+                   NautilusMacosMountedVolume *new_volume,
+                   Recorder                   *recorder)
+{
+    g_assert_true (g_thread_self () == main_thread);
+    if (recorder->new_name != NULL &&
+        same_name (old_volume->name, recorder->name) &&
+        same_name (new_volume->name, recorder->new_name))
+    {
+        recorder->renamed++;
+        recorder->renamed_time = g_get_monotonic_time ();
+        g_free (recorder->renamed_to_path);
+        recorder->renamed_to_path = g_strdup (new_volume->path);
+    }
+}
+
+static void
+monitor_changed_cb (NautilusMacosVolumeMonitor *monitor,
+                    Recorder                   *recorder)
+{
+    g_assert_true (g_thread_self () == main_thread);
+    recorder->changed_signals++;
+}
+
+static void
+recorder_connect (Recorder                   *recorder,
+                  NautilusMacosVolumeMonitor *monitor)
+{
+    g_signal_connect (monitor, "volume-added", G_CALLBACK (volume_added_cb), recorder);
+    g_signal_connect (monitor, "volume-removed", G_CALLBACK (volume_removed_cb), recorder);
+    g_signal_connect (monitor, "volume-changed", G_CALLBACK (volume_changed_cb), recorder);
+    g_signal_connect (monitor, "changed", G_CALLBACK (monitor_changed_cb), recorder);
+}
+
+static void
+recorder_disconnect (Recorder                   *recorder,
+                     NautilusMacosVolumeMonitor *monitor)
+{
+    g_signal_handlers_disconnect_by_data (monitor, recorder);
+    g_clear_pointer (&recorder->renamed_to_path, g_free);
+}
+
+/* Waits until @counter is non-zero or the deadline after @since passes, then
+ * keeps the loops turning a little longer so a duplicate would show up. */
+static void
+wait_for_count (const guint *counter,
+                gint64       since)
+{
+    gint64 deadline = since + DEADLINE_MS * 1000;
+
+    while (*counter == 0 && g_get_monotonic_time () < deadline)
+    {
+        pump_once ();
+    }
+    pump_for (300);
+}
+
+static void
+assert_within_deadline (const char *label,
+                        const char *what,
+                        gint64      event_time,
+                        gint64      command_time)
+{
+    double latency_ms = (event_time - command_time) / 1000.0;
+
+    g_test_message ("%s: %s %.0f ms after the command returned (negative: before)",
+                    label, what, latency_ms);
+    g_assert_cmpfloat (latency_ms, <=, DEADLINE_MS);
+}
+
+/* ------------------------------------------------------------------------ */
+/* The sidebar's merged list                                                 */
+/* ------------------------------------------------------------------------ */
+
+/* Counts @path among the roots the sidebar lists under mounts: GIO's mounts
+ * plus the monitor's volumes that GIO does not already cover.  Paths that
+ * differ only in normalization form are one folder on macOS and would be
+ * one row twice, so they count as the same. */
+static guint
+merged_list_count (NautilusMacosVolumeMonitor *monitor,
+                   const char                 *path)
+{
+    g_autoptr (GVolumeMonitor) gio_monitor = g_volume_monitor_get ();
+    GList *mounts = g_volume_monitor_get_mounts (gio_monitor);
+    GList *volumes = nautilus_macos_volume_monitor_get_sidebar_volumes (monitor, gio_monitor);
+    guint count = 0;
+
+    for (GList *l = mounts; l != NULL; l = l->next)
+    {
+        g_autoptr (GFile) root = g_mount_get_default_location (l->data);
+        g_autofree char *root_path = root != NULL ? g_file_get_path (root) : NULL;
+
+        count += root_path != NULL && same_name (root_path, path);
+    }
+    for (GList *l = volumes; l != NULL; l = l->next)
+    {
+        count += same_name (((NautilusMacosMountedVolume *) l->data)->path, path);
+    }
+
+    g_list_free_full (mounts, g_object_unref);
+    g_list_free_full (volumes, (GDestroyNotify) nautilus_macos_mounted_volume_free);
+    return count;
+}
+
+/* Counts the rows named @name the sidebar lists under mounts, in the same
+ * merged list as merged_list_count(). */
+static guint
+merged_list_count_named (NautilusMacosVolumeMonitor *monitor,
+                         const char                 *name)
+{
+    g_autoptr (GVolumeMonitor) gio_monitor = g_volume_monitor_get ();
+    GList *mounts = g_volume_monitor_get_mounts (gio_monitor);
+    GList *volumes = nautilus_macos_volume_monitor_get_sidebar_volumes (monitor, gio_monitor);
+    guint count = 0;
+
+    for (GList *l = mounts; l != NULL; l = l->next)
+    {
+        g_autofree char *mount_name = g_mount_get_name (l->data);
+
+        count += same_name (mount_name, name);
+    }
+    for (GList *l = volumes; l != NULL; l = l->next)
+    {
+        count += same_name (((NautilusMacosMountedVolume *) l->data)->name, name);
+    }
+
+    g_list_free_full (mounts, g_object_unref);
+    g_list_free_full (volumes, (GDestroyNotify) nautilus_macos_mounted_volume_free);
+    return count;
+}
+
+/* ------------------------------------------------------------------------ */
+/* Tests                                                                     */
+/* ------------------------------------------------------------------------ */
+
+static void
+check_attach_and_detach (NautilusMacosVolumeEvents events,
+                         const char               *label)
+{
+    g_autoptr (NautilusMacosVolumeMonitor) monitor = nautilus_macos_volume_monitor_new (events);
+    TestImage image;
+    Recorder recorder = { .label = label };
+    g_autofree char *mount_point = NULL;
+    gint64 detached_time;
+
+    test_image_create (&image);
+    recorder.name = image.name;
+    recorder_connect (&recorder, monitor);
+
+    test_image_attach (&image);
+    mount_point = g_strdup (image.mount_point);
+    wait_for_count (&recorder.added, image.attached_time);
+    g_assert_cmpuint (recorder.added, ==, 1);
+    assert_within_deadline (label, "added", recorder.added_time, image.attached_time);
+    g_assert_cmpuint (recorder.changed_signals, >=, 1);
+    g_assert_cmpuint (merged_list_count (monitor, mount_point), ==, 1);
+
+    detached_time = test_image_detach (&image);
+    wait_for_count (&recorder.removed, detached_time);
+    g_assert_cmpuint (recorder.removed, ==, 1);
+    assert_within_deadline (label, "removed", recorder.removed_time, detached_time);
+    g_assert_cmpuint (recorder.added, ==, 1);
+    g_assert_cmpuint (merged_list_count (monitor, mount_point), ==, 0);
+
+    recorder_disconnect (&recorder, monitor);
+    test_image_destroy (&image);
+}
+
+/* NSWorkspace alone (it is the source that also covers network volumes). */
+static void
+test_monitor_workspace_events (void)
+{
+    pump_run_loop = TRUE;
+    check_attach_and_detach (NAUTILUS_MACOS_VOLUME_EVENTS_WORKSPACE, "workspace");
+}
+
+/* Disk Arbitration alone, with no CFRunLoop turning at all. */
+static void
+test_monitor_disk_arbitration_events (void)
+{
+    pump_run_loop = FALSE;
+    check_attach_and_detach (NAUTILUS_MACOS_VOLUME_EVENTS_DISK_ARBITRATION, "disk-arbitration");
+}
+
+/* Two windows share one monitor; each gets every change once, although both
+ * event sources report it.  Ejected the way the sidebar does it. */
+static void
+test_shared_monitor_two_subscribers (void)
+{
+    NautilusMacosVolumeMonitor *monitor = nautilus_macos_volume_monitor_get ();
+    Recorder first = { .label = "first window" };
+    Recorder second = { .label = "second window" };
+    g_autoptr (GError) error = NULL;
+    g_autofree char *mount_point = NULL;
+    TestImage image;
+    gint64 ejected_time;
+    GList *snapshot;
+    gboolean in_snapshot = FALSE;
+
+    pump_run_loop = TRUE;
+    g_assert_true (nautilus_macos_volume_monitor_get () == monitor);
+
+    test_image_create (&image);
+    first.name = second.name = image.name;
+    recorder_connect (&first, monitor);
+    recorder_connect (&second, monitor);
+
+    test_image_attach (&image);
+    mount_point = g_strdup (image.mount_point);
+    wait_for_count (&first.added, image.attached_time);
+    wait_for_count (&second.added, image.attached_time);
+    g_assert_cmpuint (first.added, ==, 1);
+    g_assert_cmpuint (second.added, ==, 1);
+    assert_within_deadline (first.label, "added", first.added_time, image.attached_time);
+    assert_within_deadline (second.label, "added", second.added_time, image.attached_time);
+    g_assert_cmpuint (first.changed_signals, ==, second.changed_signals);
+    g_assert_cmpuint (merged_list_count (monitor, mount_point), ==, 1);
+
+    snapshot = nautilus_macos_volume_monitor_get_volumes (monitor);
+    for (GList *l = snapshot; l != NULL; l = l->next)
+    {
+        NautilusMacosMountedVolume *volume = l->data;
+
+        if (g_str_equal (volume->path, mount_point))
+        {
+            in_snapshot = TRUE;
+            g_assert_cmpstr (volume->name, ==, image.name);
+            g_assert_false (volume->is_internal);
+            g_assert_true (volume->can_eject || volume->can_unmount);
+        }
+    }
+    g_list_free_full (snapshot, (GDestroyNotify) nautilus_macos_mounted_volume_free);
+    g_assert_true (in_snapshot);
+
+    /* The sidebar's eject: NSWorkspace eject, then ask for a rescan. */
+    g_assert_true (nautilus_macos_unmount_volume (mount_point, &error));
+    g_assert_no_error (error);
+    ejected_time = g_get_monotonic_time ();
+    nautilus_macos_volume_monitor_refresh (monitor);
+    wait_for_count (&first.removed, ejected_time);
+    wait_for_count (&second.removed, ejected_time);
+    g_assert_cmpuint (first.removed, ==, 1);
+    g_assert_cmpuint (second.removed, ==, 1);
+    assert_within_deadline (first.label, "removed", first.removed_time, ejected_time);
+    assert_within_deadline (second.label, "removed", second.removed_time, ejected_time);
+    g_assert_cmpuint (merged_list_count (monitor, mount_point), ==, 0);
+
+    recorder_disconnect (&first, monitor);
+    recorder_disconnect (&second, monitor);
+    test_image_destroy (&image);
+}
+
+static void
+test_shared_monitor_rename (void)
+{
+    NautilusMacosVolumeMonitor *monitor = nautilus_macos_volume_monitor_get ();
+    Recorder recorder = { .label = "rename" };
+    g_autofree char *new_name = NULL;
+    g_autofree char *old_mount_point = NULL;
+    TestImage image;
+    Command command;
+    gint64 detached_time;
+
+    pump_run_loop = TRUE;
+    test_image_create (&image);
+    new_name = g_strdup_printf ("SZF Renamed %05x", g_random_int_range (0, 0xfffff));
+    recorder.name = image.name;
+    recorder.new_name = new_name;
+    recorder_connect (&recorder, monitor);
+
+    test_image_attach (&image);
+    old_mount_point = g_strdup (image.mount_point);
+    wait_for_count (&recorder.added, image.attached_time);
+    g_assert_cmpuint (recorder.added, ==, 1);
+
+    command_run (&command, (const char * const []) {
+        "diskutil", "rename", old_mount_point, new_name, NULL
+    });
+    g_assert_cmpint (command.exit_status, ==, 0);
+    wait_for_count (&recorder.renamed, command.exit_time);
+    g_assert_cmpuint (recorder.renamed, ==, 1);
+    assert_within_deadline (recorder.label, "renamed", recorder.renamed_time, command.exit_time);
+    command_clear (&command);
+
+    /* Reported as the same volume changing, not as one leaving and another
+     * arriving, and the merged list follows the new mount point. */
+    g_assert_cmpuint (recorder.removed, ==, 0);
+    g_assert_cmpuint (recorder.added, ==, 1);
+    g_assert_nonnull (recorder.renamed_to_path);
+    g_assert_cmpstr (recorder.renamed_to_path, !=, old_mount_point);
+    g_assert_cmpuint (merged_list_count (monitor, recorder.renamed_to_path), ==, 1);
+    g_assert_cmpuint (merged_list_count (monitor, old_mount_point), ==, 0);
+
+    detached_time = test_image_detach (&image);
+    wait_for_count (&recorder.removed, detached_time);
+    g_assert_cmpuint (recorder.removed, ==, 1);
+    g_assert_cmpuint (merged_list_count (monitor, recorder.renamed_to_path), ==, 0);
+
+    recorder_disconnect (&recorder, monitor);
+    test_image_destroy (&image);
+}
+
+/* A real network volume, mounted the way Finder mounts one (NetFS, mount
+ * point under /Volumes, no UI).  tools/test-macos-volumes.sh serves
+ * throwaway WebDAV shares on 127.0.0.1 and sets @variable to the URL of
+ * one. */
+static void
+check_network_volume (const char *variable,
+                      const char *label,
+                      Spelling    spelling)
+{
+    const char *url_string = g_getenv (variable);
+    NautilusMacosVolumeMonitor *monitor = nautilus_macos_volume_monitor_get ();
+    Recorder recorder = { .label = label };
+    g_autofree char *mount_point = NULL;
+    g_autofree char *base = NULL;
+    g_autofree char *name = NULL;
+    CFURLRef url;
+    CFMutableDictionaryRef open_options;
+    CFArrayRef mount_points = NULL;
+    int status;
+    gint64 mounted_time;
+    Command command;
+
+    if (url_string == NULL)
+    {
+        g_autofree char *message = g_strdup_printf ("Set %s to a WebDAV share without authentication",
+                                                    variable);
+
+        g_test_skip (message);
+        return;
+    }
+
+    pump_run_loop = TRUE;
+    url = CFURLCreateWithBytes (NULL, (const UInt8 *) url_string, strlen (url_string),
+                                kCFStringEncodingUTF8, NULL);
+    open_options = CFDictionaryCreateMutable (NULL, 0, &kCFTypeDictionaryKeyCallBacks,
+                                              &kCFTypeDictionaryValueCallBacks);
+    CFDictionarySetValue (open_options, kNAUIOptionKey, kNAUIOptionNoUI);
+    CFDictionarySetValue (open_options, kNetFSUseGuestKey, kCFBooleanTrue);
+
+    /* The volume is named after the last path component of the share
+     * ("SZF%20Partag%C3%A9" in the URL). */
+    base = g_path_get_basename (url_string);
+    name = g_uri_unescape_string (base, NULL);
+    g_assert_nonnull (name);
+    recorder.name = name;
+    recorder_connect (&recorder, monitor);
+
+    status = NetFSMountURLSync (url, NULL, NULL, NULL, open_options, NULL, &mount_points);
+    mounted_time = g_get_monotonic_time ();
+    CFRelease (open_options);
+    CFRelease (url);
+    g_assert_cmpint (status, ==, 0);
+    g_assert_nonnull (mount_points);
+    g_assert_cmpint (CFArrayGetCount (mount_points), >=, 1);
+    {
+        char buffer[PATH_MAX];
+        CFStringRef path = CFArrayGetValueAtIndex (mount_points, 0);
+
+        g_assert_true (CFStringGetFileSystemRepresentation (path, buffer, sizeof (buffer)));
+        mount_point = g_strdup (buffer);
+    }
+    CFRelease (mount_points);
+    g_test_message ("%s: mounted at %s", label, mount_point);
+    assert_mount_table_spelling (label, mount_point, spelling);
+
+    wait_for_count (&recorder.added, mounted_time);
+    g_assert_cmpuint (recorder.added, ==, 1);
+    assert_within_deadline (recorder.label, "added", recorder.added_time, mounted_time);
+    g_assert_cmpuint (merged_list_count (monitor, mount_point), ==, 1);
+    g_assert_cmpuint (merged_list_count_named (monitor, name), ==, 1);
+
+    command_run (&command, (const char * const []) { "diskutil", "unmount", mount_point, NULL });
+    g_assert_cmpint (command.exit_status, ==, 0);
+    wait_for_count (&recorder.removed, command.exit_time);
+    g_assert_cmpuint (recorder.removed, ==, 1);
+    assert_within_deadline (recorder.label, "removed", recorder.removed_time, command.exit_time);
+    g_assert_cmpuint (recorder.added, ==, 1);
+    g_assert_cmpuint (merged_list_count (monitor, mount_point), ==, 0);
+    g_assert_cmpuint (merged_list_count_named (monitor, name), ==, 0);
+    command_clear (&command);
+
+    recorder_disconnect (&recorder, monitor);
+}
+
+static void
+test_shared_monitor_network_volume (void)
+{
+    check_network_volume ("NAUTILUS_TEST_WEBDAV_URL", "network", SPELLING_ANY);
+}
+
+/* A share named with precomposed (NFC) characters, "é" and Hangul
+ * syllables: the kernel keeps its mount point precomposed, and the volume
+ * list once compared it only with decomposed spellings and dropped it. */
+static void
+test_shared_monitor_network_volume_precomposed (void)
+{
+    check_network_volume ("NAUTILUS_TEST_WEBDAV_NFC_URL", "network, precomposed name",
+                          SPELLING_PRECOMPOSED);
+}
+
+/* ------------------------------------------------------------------------ */
+/* Volumes leaving together                                                  */
+/* ------------------------------------------------------------------------ */
+
+/* The volumes these tests attach, and what each must look like whenever it
+ * is listed: its own name and its own file system id.  A volume caught
+ * halfway through unmounting used to be listed with the startup disk's name
+ * ("Macintosh HD") and no id, or the startup disk's id. */
+typedef struct
+{
+    TestVolume volumes[8];      /* copies: they outlive the detach */
+    guint n_volumes;
+} Watched;
+
+static void
+watched_add_image (Watched                *watched,
+                   const PartitionedImage *image)
+{
+    for (guint v = 0; v < image->n_volumes; v++)
+    {
+        TestVolume *volume;
+
+        g_assert_cmpuint (watched->n_volumes, <, G_N_ELEMENTS (watched->volumes));
+        volume = &watched->volumes[watched->n_volumes++];
+        volume->name = g_strdup (image->volumes[v].name);
+        volume->mount_point = g_strdup (image->volumes[v].mount_point);
+        volume->identifier = g_strdup (image->volumes[v].identifier);
+    }
+}
+
+static void
+watched_clear (Watched *watched)
+{
+    for (guint v = 0; v < watched->n_volumes; v++)
+    {
+        g_free (watched->volumes[v].name);
+        g_free (watched->volumes[v].mount_point);
+        g_free (watched->volumes[v].identifier);
+    }
+    watched->n_volumes = 0;
+}
+
+/* The watched volume @volume's path belongs to, or NULL. */
+static const TestVolume *
+watched_find (const Watched *watched,
+              const char    *path)
+{
+    for (guint v = 0; v < watched->n_volumes; v++)
+    {
+        if (same_name (path, watched->volumes[v].mount_point))
+        {
+            return &watched->volumes[v];
+        }
+    }
+
+    return NULL;
+}
+
+/* NULL when @volume is not a watched mount point or describes it correctly,
+ * else a description of what is wrong. */
+static char *
+watched_check (const Watched                    *watched,
+               const NautilusMacosMountedVolume *volume)
+{
+    const TestVolume *expected = watched_find (watched, volume->path);
+
+    if (expected == NULL ||
+        (same_name (volume->name, expected->name) &&
+         g_strcmp0 (volume->identifier, expected->identifier) == 0))
+    {
+        return NULL;
+    }
+
+    return g_strdup_printf ("%s listed as \"%s\" (fs id %s), but it is \"%s\" (fs id %s)",
+                            volume->path, volume->name,
+                            volume->identifier != NULL ? volume->identifier : "none",
+                            expected->name, expected->identifier);
+}
+
+typedef struct
+{
+    const Watched *watched;
+    gint stop;                  /* atomic */
+    guint scans;                /* owned by the thread until it is joined */
+    guint wrong;
+    char *first_wrong;
+} Scanner;
+
+static gpointer
+scanner_thread (gpointer data)
+{
+    Scanner *scanner = data;
+
+    while (!g_atomic_int_get (&scanner->stop))
+    {
+        GList *volumes = nautilus_macos_get_mounted_volumes ();
+
+        for (GList *l = volumes; l != NULL; l = l->next)
+        {
+            char *problem = watched_check (scanner->watched, l->data);
+
+            if (problem != NULL)
+            {
+                scanner->wrong++;
+                if (scanner->first_wrong == NULL)
+                {
+                    scanner->first_wrong = g_strdup_printf ("scan %u: %s", scanner->scans, problem);
+                }
+                g_free (problem);
+            }
+        }
+
+        g_list_free_full (volumes, (GDestroyNotify) nautilus_macos_mounted_volume_free);
+        g_atomic_int_inc ((gint *) &scanner->scans);
+    }
+
+    return NULL;
+}
+
+static char *
+random_name (const char *prefix)
+{
+    return g_strdup_printf ("%s %05x", prefix, g_random_int_range (0, 0xfffff));
+}
+
+/* nautilus_macos_get_mounted_volumes() called over and over while a
+ * two-partition image and two more images are attached and then detached
+ * together: a listed volume is always the real one. */
+static void
+test_enumeration_simultaneous_detach (void)
+{
+    g_autofree char *pair_name = random_name ("SZF Pair");
+    g_autofree char *pair_other_name = random_name ("SZF Pär 文件");
+    g_autofree char *left_name = random_name ("SZF Left");
+    g_autofree char *right_name = random_name ("SZF Right");
+    PartitionedImage pair, left, right;
+    PartitionedImage *both[] = { &left, &right };
+    Watched watched = { 0 };
+    Scanner scanner = { .watched = &watched };
+    GThread *thread;
+    guint scans_before_detach;
+
+    pump_run_loop = TRUE;
+    partitioned_image_create (&pair, pair_name, pair_other_name);
+    partitioned_image_create (&left, left_name, NULL);
+    partitioned_image_create (&right, right_name, NULL);
+
+    partitioned_image_attach (&pair);
+    partitioned_image_attach (&left);
+    partitioned_image_attach (&right);
+    watched_add_image (&watched, &pair);
+    watched_add_image (&watched, &left);
+    watched_add_image (&watched, &right);
+
+    thread = g_thread_new ("volume scanner", scanner_thread, &scanner);
+    pump_for (200);
+    scans_before_detach = g_atomic_int_get ((gint *) &scanner.scans);
+
+    {
+        PartitionedImage *pair_only[] = { &pair };
+
+        /* One command, two volumes: both partitions go at once. */
+        partitioned_images_detach_together (pair_only, 1);
+    }
+    /* Two commands at once. */
+    partitioned_images_detach_together (both, 2);
+    pump_for (200);
+
+    g_atomic_int_set (&scanner.stop, TRUE);
+    g_thread_join (thread);
+
+    g_test_message ("%u scans, %u while detaching; %u wrong entries%s%s",
+                    scanner.scans, scanner.scans - scans_before_detach, scanner.wrong,
+                    scanner.first_wrong != NULL ? ", first: " : "",
+                    scanner.first_wrong != NULL ? scanner.first_wrong : "");
+    g_assert_cmpuint (scanner.scans - scans_before_detach, >=, 100);
+    g_assert_cmpstr (scanner.first_wrong, ==, NULL);
+    g_assert_cmpuint (scanner.wrong, ==, 0);
+
+    g_free (scanner.first_wrong);
+    watched_clear (&watched);
+    partitioned_image_destroy (&pair);
+    partitioned_image_destroy (&left);
+    partitioned_image_destroy (&right);
+}
+
+/* A volume mounted outside /Volumes, in a folder named @folder_name in the
+ * scratch folder, is listed once with its fs id, and the shared monitor
+ * (every window's sidebar) adds it once and removes it once.  The kernel
+ * keeps the mount point as the folder was created, which differs from the
+ * spellings NSFileManager's paths give: "/private/var/folders/…" is
+ * standardized to "/var/folders/…", and a name written precomposed (NFC)
+ * comes back decomposed (NFD). */
+static void
+check_custom_mount_point (const char *folder_name,
+                          Spelling    spelling)
+{
+    NautilusMacosVolumeMonitor *monitor = nautilus_macos_volume_monitor_get ();
+    g_autofree char *name = random_name ("SZF Custom");
+    g_autofree char *mount_point = NULL;
+    Recorder recorder = { .label = folder_name };
+    PartitionedImage image;
+    PartitionedImage *images[] = { &image };
+    GList *volumes;
+    guint listed = 0;
+
+    pump_run_loop = TRUE;
+    partitioned_image_create (&image, name, NULL);
+    mount_point = g_build_filename (image.directory, folder_name, NULL);
+    g_assert_cmpint (g_mkdir (mount_point, 0700), ==, 0);
+    /* Making the image mounted and unmounted the volume under /Volumes;
+     * let the monitor settle before watching. */
+    pump_for (1000);
+    recorder.name = name;
+    recorder_connect (&recorder, monitor);
+
+    partitioned_image_attach_at (&image, mount_point);
+    g_test_message ("%s: mounted at %s", folder_name, image.volumes[0].mount_point);
+    assert_mount_table_spelling (folder_name, image.volumes[0].mount_point, spelling);
+
+    volumes = nautilus_macos_get_mounted_volumes ();
+    for (GList *l = volumes; l != NULL; l = l->next)
+    {
+        NautilusMacosMountedVolume *volume = l->data;
+
+        if (same_name (volume->name, name))
+        {
+            g_autofree char *base = g_path_get_basename (volume->path);
+
+            listed++;
+            g_test_message ("%s: listed at %s", folder_name, volume->path);
+            g_assert_cmpstr (volume->identifier, ==, image.volumes[0].identifier);
+            g_assert_true (same_name (base, folder_name));
+        }
+    }
+    g_list_free_full (volumes, (GDestroyNotify) nautilus_macos_mounted_volume_free);
+    g_assert_cmpuint (listed, ==, 1);
+
+    wait_for_count (&recorder.added, image.attached_time);
+    g_assert_cmpuint (recorder.added, ==, 1);
+    assert_within_deadline (folder_name, "added", recorder.added_time, image.attached_time);
+    g_assert_cmpuint (merged_list_count_named (monitor, name), ==, 1);
+
+    partitioned_images_detach_together (images, 1);
+    wait_for_count (&recorder.removed, image.detached_time);
+    g_assert_cmpuint (recorder.removed, ==, 1);
+    assert_within_deadline (folder_name, "removed", recorder.removed_time, image.detached_time);
+    g_assert_cmpuint (recorder.added, ==, 1);
+    g_assert_cmpuint (merged_list_count_named (monitor, name), ==, 0);
+
+    recorder_disconnect (&recorder, monitor);
+    partitioned_image_destroy (&image);
+    g_rmdir (mount_point);
+}
+
+static void
+test_enumeration_custom_mount_point (void)
+{
+    check_custom_mount_point ("mount point", SPELLING_ANY);
+}
+
+/* "Données NFC 공유", written precomposed: é is U+00E9, 공 and 유 are
+ * single Hangul syllables. */
+static void
+test_enumeration_custom_mount_point_precomposed (void)
+{
+    check_custom_mount_point ("Donn\xc3\xa9" "es NFC \xea\xb3\xb5\xec\x9c\xa0", SPELLING_PRECOMPOSED);
+}
+
+/* "Données NFD 공유", written decomposed: e and a combining acute accent,
+ * and each syllable as its jamo. */
+static void
+test_enumeration_custom_mount_point_decomposed (void)
+{
+    check_custom_mount_point ("Donne\xcc\x81" "es NFD "
+                              "\xe1\x84\x80\xe1\x85\xa9\xe1\x86\xbc\xe1\x84\x8b\xe1\x85\xb2",
+                              SPELLING_DECOMPOSED);
+}
+
+/* What the sidebars see when volumes leave together. */
+typedef struct
+{
+    NautilusMacosVolumeMonitor *monitor;
+    const Watched *watched;
+    guint removed[8];           /* per watched volume */
+    guint removed_wrong;        /* removals that did not describe the volume */
+    guint added;                /* additions of watched mount points */
+    guint changed;              /* volume-changed on watched mount points */
+    guint changed_signals;
+    guint wrong_rows;           /* wrong snapshot entries at a "changed" */
+    char *first_problem;
+    gint64 last_removed_time;
+} Leaving;
+
+static void
+leaving_problem (Leaving    *leaving,
+                 const char *what,
+                 char       *problem)
+{
+    g_test_message ("%s: %s", what, problem);
+    if (leaving->first_problem == NULL)
+    {
+        leaving->first_problem = g_strdup_printf ("%s: %s", what, problem);
+    }
+    g_free (problem);
+}
+
+static void
+leaving_removed_cb (NautilusMacosVolumeMonitor *monitor,
+                    NautilusMacosMountedVolume *volume,
+                    Leaving                    *leaving)
+{
+    const TestVolume *expected = watched_find (leaving->watched, volume->path);
+    char *problem;
+
+    g_assert_true (g_thread_self () == main_thread);
+    if (expected == NULL)
+    {
+        return;
+    }
+
+    leaving->removed[expected - leaving->watched->volumes]++;
+    leaving->last_removed_time = g_get_monotonic_time ();
+
+    problem = watched_check (leaving->watched, volume);
+    if (problem != NULL)
+    {
+        leaving->removed_wrong++;
+        leaving_problem (leaving, "volume-removed", problem);
+    }
+}
+
+static void
+leaving_added_cb (NautilusMacosVolumeMonitor *monitor,
+                  NautilusMacosMountedVolume *volume,
+                  Leaving                    *leaving)
+{
+    g_assert_true (g_thread_self () == main_thread);
+    if (watched_find (leaving->watched, volume->path) != NULL || volume->identifier == NULL)
+    {
+        leaving->added++;
+        leaving_problem (leaving, "volume-added",
+                         g_strdup_printf ("%s as \"%s\"", volume->path, volume->name));
+    }
+}
+
+static void
+leaving_changed_cb (NautilusMacosVolumeMonitor *monitor,
+                    NautilusMacosMountedVolume *old_volume,
+                    NautilusMacosMountedVolume *new_volume,
+                    Leaving                    *leaving)
+{
+    g_assert_true (g_thread_self () == main_thread);
+    if (watched_find (leaving->watched, old_volume->path) != NULL ||
+        watched_find (leaving->watched, new_volume->path) != NULL)
+    {
+        leaving->changed++;
+        leaving_problem (leaving, "volume-changed",
+                         g_strdup_printf ("%s \"%s\" (fs id %s) -> %s \"%s\" (fs id %s)",
+                                          old_volume->path, old_volume->name,
+                                          old_volume->identifier, new_volume->path,
+                                          new_volume->name,
+                                          new_volume->identifier != NULL ? new_volume->identifier : "none"));
+    }
+}
+
+/* At every "changed" a sidebar rebuilds from the snapshot: it must hold no
+ * row for a volume that is not there. */
+static void
+leaving_monitor_changed_cb (NautilusMacosVolumeMonitor *monitor,
+                            Leaving                    *leaving)
+{
+    GList *snapshot = nautilus_macos_volume_monitor_get_volumes (monitor);
+
+    g_assert_true (g_thread_self () == main_thread);
+    leaving->changed_signals++;
+    for (GList *l = snapshot; l != NULL; l = l->next)
+    {
+        NautilusMacosMountedVolume *volume = l->data;
+        char *problem = watched_check (leaving->watched, volume);
+
+        if (problem == NULL && volume->identifier == NULL)
+        {
+            problem = g_strdup_printf ("%s listed as \"%s\" with no fs id", volume->path, volume->name);
+        }
+        if (problem != NULL)
+        {
+            leaving->wrong_rows++;
+            leaving_problem (leaving, "snapshot row", problem);
+        }
+    }
+    g_list_free_full (snapshot, (GDestroyNotify) nautilus_macos_mounted_volume_free);
+}
+
+/* Several volumes unmounted at the same moment (a two-partition disk and two
+ * more images, three detach commands at once): every sidebar sees each
+ * volume leave once, as itself, never an extra row, and rebuilds at most
+ * once per volume that left. */
+static void
+test_shared_monitor_simultaneous_detach (void)
+{
+    NautilusMacosVolumeMonitor *monitor = nautilus_macos_volume_monitor_get ();
+    g_autofree char *pair_name = random_name ("SZF Pair");
+    g_autofree char *pair_other_name = random_name ("SZF Pär 文件");
+    g_autofree char *left_name = random_name ("SZF Left");
+    g_autofree char *right_name = random_name ("SZF Right");
+    PartitionedImage pair, left, right;
+    PartitionedImage *all[] = { &pair, &left, &right };
+    Watched watched = { 0 };
+    Leaving leaving = { .monitor = monitor, .watched = &watched };
+    gint64 detached_time = 0;
+    gint64 deadline;
+    gboolean all_removed = FALSE;
+
+    pump_run_loop = TRUE;
+    partitioned_image_create (&pair, pair_name, pair_other_name);
+    partitioned_image_create (&left, left_name, NULL);
+    partitioned_image_create (&right, right_name, NULL);
+    partitioned_image_attach (&pair);
+    partitioned_image_attach (&left);
+    partitioned_image_attach (&right);
+    watched_add_image (&watched, &pair);
+    watched_add_image (&watched, &left);
+    watched_add_image (&watched, &right);
+    g_assert_cmpuint (watched.n_volumes, ==, 4);
+
+    /* Wait until the monitor lists all four, then past the settle scan. */
+    deadline = g_get_monotonic_time () + DEADLINE_MS * 1000;
+    for (gboolean listed_all = FALSE; !listed_all && g_get_monotonic_time () < deadline;)
+    {
+        pump_once ();
+        listed_all = TRUE;
+        for (guint v = 0; v < watched.n_volumes; v++)
+        {
+            listed_all = listed_all &&
+                         merged_list_count (monitor, watched.volumes[v].mount_point) == 1;
+        }
+    }
+    pump_for (700);
+    for (guint v = 0; v < watched.n_volumes; v++)
+    {
+        g_assert_cmpuint (merged_list_count (monitor, watched.volumes[v].mount_point), ==, 1);
+    }
+
+    g_signal_connect (monitor, "volume-removed", G_CALLBACK (leaving_removed_cb), &leaving);
+    g_signal_connect (monitor, "volume-added", G_CALLBACK (leaving_added_cb), &leaving);
+    g_signal_connect (monitor, "volume-changed", G_CALLBACK (leaving_changed_cb), &leaving);
+    g_signal_connect (monitor, "changed", G_CALLBACK (leaving_monitor_changed_cb), &leaving);
+
+    partitioned_images_detach_together (all, G_N_ELEMENTS (all));
+    for (guint i = 0; i < G_N_ELEMENTS (all); i++)
+    {
+        detached_time = MAX (detached_time, all[i]->detached_time);
+    }
+
+    deadline = detached_time + DEADLINE_MS * 1000;
+    while (!all_removed && g_get_monotonic_time () < deadline)
+    {
+        pump_once ();
+        all_removed = TRUE;
+        for (guint v = 0; v < watched.n_volumes; v++)
+        {
+            all_removed = all_removed && leaving.removed[v] > 0;
+        }
+    }
+    /* Past the settle scan, so a late extra row would show up. */
+    pump_for (900);
+    g_signal_handlers_disconnect_by_data (monitor, &leaving);
+
+    g_test_message ("%u \"changed\" for %u volumes; first problem: %s",
+                    leaving.changed_signals, watched.n_volumes,
+                    leaving.first_problem != NULL ? leaving.first_problem : "none");
+    g_assert_true (all_removed);
+    assert_within_deadline ("simultaneous", "last removal",
+                            leaving.last_removed_time, detached_time);
+    g_assert_cmpstr (leaving.first_problem, ==, NULL);
+    for (guint v = 0; v < watched.n_volumes; v++)
+    {
+        g_assert_cmpuint (leaving.removed[v], ==, 1);
+        g_assert_cmpuint (merged_list_count (monitor, watched.volumes[v].mount_point), ==, 0);
+    }
+    g_assert_cmpuint (leaving.removed_wrong, ==, 0);
+    g_assert_cmpuint (leaving.added, ==, 0);
+    g_assert_cmpuint (leaving.changed, ==, 0);
+    g_assert_cmpuint (leaving.wrong_rows, ==, 0);
+    /* One sidebar rebuild per real change: at least one, never more than
+     * one per volume that left. */
+    g_assert_cmpuint (leaving.changed_signals, >=, 1);
+    g_assert_cmpuint (leaving.changed_signals, <=, watched.n_volumes);
+
+    g_free (leaving.first_problem);
+    watched_clear (&watched);
+    partitioned_image_destroy (&pair);
+    partitioned_image_destroy (&left);
+    partitioned_image_destroy (&right);
+}
+
+int
+main (int   argc,
+      char *argv[])
+{
+    g_test_init (&argc, &argv, NULL);
+    main_thread = g_thread_self ();
+    g_test_add_func ("/macos-volumes/browsable-and-unique",
+                     test_mounted_volumes_are_browsable_and_unique);
+    g_test_add_func ("/macos-volumes/monitor/workspace-events",
+                     test_monitor_workspace_events);
+    g_test_add_func ("/macos-volumes/monitor/disk-arbitration-events",
+                     test_monitor_disk_arbitration_events);
+    g_test_add_func ("/macos-volumes/monitor/shared-two-subscribers",
+                     test_shared_monitor_two_subscribers);
+    g_test_add_func ("/macos-volumes/monitor/rename",
+                     test_shared_monitor_rename);
+    g_test_add_func ("/macos-volumes/monitor/network-volume",
+                     test_shared_monitor_network_volume);
+    g_test_add_func ("/macos-volumes/monitor/network-volume-precomposed",
+                     test_shared_monitor_network_volume_precomposed);
+    g_test_add_func ("/macos-volumes/enumeration/simultaneous-detach",
+                     test_enumeration_simultaneous_detach);
+    g_test_add_func ("/macos-volumes/enumeration/custom-mount-point",
+                     test_enumeration_custom_mount_point);
+    g_test_add_func ("/macos-volumes/enumeration/custom-mount-point-precomposed",
+                     test_enumeration_custom_mount_point_precomposed);
+    g_test_add_func ("/macos-volumes/enumeration/custom-mount-point-decomposed",
+                     test_enumeration_custom_mount_point_decomposed);
