+/* Pausing a drag over an item in the file view activates it if it is a
+ * folder (open-folder-on-dnd-hover).  Activating an app launches it, so the
+ * drag must open folders only: dragging a file across /Applications must
+ * not start every app it rests on. */
+static void
+assert_drag_hover_opens (const char *name,
+                         gboolean    expected)
+{
+    g_autofree char *path = fixture_path (name);
+    NautilusFile *file = load_file (path);
+
+    g_test_message ("%s: opens on drag hover=%d", name,
+                    nautilus_list_base_file_opens_on_drag_hover (file));
+    g_assert_cmpint (nautilus_list_base_file_opens_on_drag_hover (file), ==, expected);
+
+    nautilus_file_unref (file);
+}
+
+static void
+test_drag_hover (void)
+{
+    assert_drag_hover_opens ("Decision.app", FALSE);
+    assert_drag_hover_opens ("Link to Decision", FALSE);
+    assert_drag_hover_opens ("Empty.app", FALSE);
+    assert_drag_hover_opens ("Doc.rtfd", FALSE);
+    assert_drag_hover_opens ("Thing.bundle", FALSE);
+    assert_drag_hover_opens ("Plain Folder", TRUE);
+    assert_drag_hover_opens ("Fw.framework", TRUE);
+    assert_drag_hover_opens ("folder.with.dots", TRUE);
+    assert_drag_hover_opens ("Ünïcode Földer 文件夹", TRUE);
+    assert_drag_hover_opens ("notes.txt", FALSE);
+    assert_drag_hover_opens ("Archive.zip", FALSE);
+}
