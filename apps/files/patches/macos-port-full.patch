+    /* Finder parity: Cmd-Shift-G opens the location bar. win.macos-edit-location
+     * is injected on each window in macos_setup_window(). */
+    macos_menu_append (location_section, _("Enter Location…"),
+                       "win.macos-edit-location", "<Meta><Shift>g");
