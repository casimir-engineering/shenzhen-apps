+
+void
+nautilus_macos_updater_startup (void)
+{
+    @autoreleasepool
+    {
+        SZFUpdater *updater = [SZFUpdater shared];
+        [updater consumePendingUpdateMarkerAndSweep];
+        [updater scheduleDailyUpdateCheckIfNeeded];
+        [updater armRecurringUpdateCheck];
+    }
+}
+
+void
+nautilus_macos_updater_check_interactive (void)
+{
+    @autoreleasepool
+    {
+        [[SZFUpdater shared] checkForUpdatesUserInitiated:YES];
+    }
+}
diff --git a/src/nautilus-macos-volumes.m b/src/nautilus-macos-volumes.m
new file mode 100644
index 0000000..9294b83
--- /dev/null
+++ b/src/nautilus-macos-volumes.m
@@ -0,0 +1,849 @@
+/*
+ * nautilus-macos-volumes.m: mounted-volume discovery, change monitoring and
+ * eject support.
+ *
+ * Copyright (C) 2026 The Nautilus authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Compiled without ARC, like the rest of the bridge block in src/meson.build.
+ *
+ * Threading model of NautilusMacosVolumeMonitor: every event, whichever
+ * thread reports it, is funnelled onto one private serial dispatch queue.
+ * Disk Arbitration callbacks are scheduled there directly; NSWorkspace
+ * notifications arrive on the main thread and only dispatch_async() there.
+ * The queue coalesces a burst of events into one scan (plus one settle scan
+ * after the burst), runs nautilus_macos_get_mounted_volumes() off the main
+ * thread, and hands the result to the monitor's GMainContext as an idle
+ * source.  Diffing and signal emission happen only there, so subscribers never see a signal off the main thread and never see
+ * the same change twice, even though NSWorkspace and Disk Arbitration both
+ * report every disk mount.
+ */
+
+#define G_LOG_DOMAIN "nautilus-macos-volumes"
+
+#include <config.h>
+#include "nautilus-macos-bridge.h"
+
+#import <AppKit/AppKit.h>
+#import <DiskArbitration/DiskArbitration.h>
+
+#include <sys/mount.h>
+#include <sys/param.h>
+
+/* The first event of a burst schedules a scan this much later, so the
+ * NSWorkspace notification and the Disk Arbitration callbacks for one mount
+ * cost one scan. */
+#define SCAN_DELAY_MS 50
+/* A second scan runs once no event has arrived for this long.  It catches a
+ * change the first scan saw half-done: on a rename, NSWorkspace posts before
+ * the mount table shows the new mount point. */
+#define SETTLE_DELAY_MS 600
+
+static gboolean
+volume_path_is_system_private (NSString *path)
+{
+    return [path hasPrefix:@"/System/Volumes/"] ||
+           [path hasPrefix:@"/private/var/"];
+}
+
+void
+nautilus_macos_mounted_volume_free (NautilusMacosMountedVolume *volume)
+{
+    if (volume == NULL)
+    {
+        return;
+    }
+
+    g_free (volume->name);
+    g_free (volume->path);
+    g_free (volume->identifier);
+    g_free (volume);
+}
+
+NautilusMacosMountedVolume *
+nautilus_macos_mounted_volume_copy (const NautilusMacosMountedVolume *volume)
+{
+    NautilusMacosMountedVolume *copy;
+
+    g_return_val_if_fail (volume != NULL, NULL);
+
+    copy = g_new0 (NautilusMacosMountedVolume, 1);
+    *copy = *volume;
+    copy->name = g_strdup (volume->name);
+    copy->path = g_strdup (volume->path);
+    copy->identifier = g_strdup (volume->identifier);
+
+    return copy;
+}
+
+static gpointer
+mounted_volume_copy_func (gconstpointer volume,
+                          gpointer      user_data)
+{
+    return nautilus_macos_mounted_volume_copy (volume);
+}
+
+static GList *
+mounted_volume_list_copy (GList *volumes)
+{
+    return g_list_copy_deep (volumes, mounted_volume_copy_func, NULL);
+}
+
+static void
+mounted_volume_list_free (GList *volumes)
+{
+    g_list_free_full (volumes, (GDestroyNotify) nautilus_macos_mounted_volume_free);
+}
+
+/* TRUE when a file system is mounted at a volume's mount point right now:
+ * statfs on @mount_points[0] reports one of @mount_points (NULL-terminated,
+ * the same mount point spelled the ways NSFileManager lists it) as its
+ * mount point.  Fills @fs.  NSFileManager lists a volume that is being
+ * unmounted for a moment longer than it exists: its mount point is then
+ * either an empty folder on the startup disk, for which statfs reports the
+ * startup disk ("/System/Volumes/Data", and NSURLVolumeNameKey its name,
+ * "Macintosh HD"), or already removed, so statfs fails.
+ *
+ * The kernel keeps the mount point as it was created, so one spelling is
+ * not enough: standardizing drops "/private" ("/private/var/x" becomes
+ * "/var/x"), and -[NSString fileSystemRepresentation] decomposes accented
+ * and Hangul characters (NFD), while a network share or folder whose name
+ * was written precomposed (NFC) keeps that form in the mount table.
+ * Comparing only decomposed spellings dropped such volumes from the list;
+ * -[NSURL fileSystemRepresentation] keeps the bytes NSFileManager read from
+ * the mount table. */
+static gboolean
+mounted_volume_statfs (const char *const *mount_points,
+                       struct statfs     *fs)
+{
+    if (statfs (mount_points[0], fs) != 0)
+    {
+        return FALSE;
+    }
+
+    for (guint i = 0; mount_points[i] != NULL; i++)
+    {
+        if (strcmp (fs->f_mntonname, mount_points[i]) == 0)
+        {
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
+
+GList *
+nautilus_macos_get_mounted_volumes (void)
+{
+    GList *volumes = NULL;
+
+    @autoreleasepool
+    {
+        NSArray *keys = @[
+            NSURLVolumeNameKey,
+            NSURLVolumeIsBrowsableKey,
+            NSURLVolumeIsInternalKey,
+            NSURLVolumeIsLocalKey,
+            NSURLVolumeIsEjectableKey,
+            NSURLVolumeIsRemovableKey,
+        ];
+        NSArray<NSURL *> *urls =
+            [[NSFileManager defaultManager]
+             mountedVolumeURLsIncludingResourceValuesForKeys:keys
+                                                    options:NSVolumeEnumerationSkipHiddenVolumes];
+        NSMutableSet<NSString *> *seen_paths = [NSMutableSet set];
+
+        for (NSURL *url in urls)
+        {
+            NSNumber *is_browsable = nil;
+            NSNumber *is_internal = nil;
+            NSNumber *is_local = nil;
+            NSNumber *is_ejectable = nil;
+            NSNumber *is_removable = nil;
+            NSString *volume_name = nil;
+            NSString *path = [[url path] stringByStandardizingPath];
+            BOOL removable = NO;
+            BOOL writable = NO;
+            BOOL unmountable = NO;
+            struct statfs fs;
+
+            if (path == nil || [path length] == 0 ||
+                volume_path_is_system_private (path) ||
+                [seen_paths containsObject:path])
+            {
+                continue;
+            }
+
+            [url getResourceValue:&is_browsable forKey:NSURLVolumeIsBrowsableKey error:nil];
+            if (is_browsable != nil && ![is_browsable boolValue])
+            {
+                continue;
+            }
+
+            [url getResourceValue:&volume_name forKey:NSURLVolumeNameKey error:nil];
+            [url getResourceValue:&is_internal forKey:NSURLVolumeIsInternalKey error:nil];
+            [url getResourceValue:&is_local forKey:NSURLVolumeIsLocalKey error:nil];
+            [url getResourceValue:&is_ejectable forKey:NSURLVolumeIsEjectableKey error:nil];
+            [url getResourceValue:&is_removable forKey:NSURLVolumeIsRemovableKey error:nil];
+
+            [[NSWorkspace sharedWorkspace] getFileSystemInfoForPath:path
+                                                        isRemovable:&removable
+                                                           isWritable:&writable
+                                                        isUnmountable:&unmountable
+                                                           description:nil
+                                                                  type:nil];
+
+            if (volume_name == nil || [volume_name length] == 0)
+            {
+                volume_name = [path lastPathComponent];
+            }
+            if (volume_name == nil || [volume_name length] == 0)
+            {
+                volume_name = @"Macintosh HD";
+            }
+
+            /* Checked after everything above was read: if the volume is
+             * still mounted now, it was mounted when its name and flags
+             * were read.  A volume caught halfway through unmounting is
+             * skipped; it would show as an extra "Macintosh HD" row until
+             * the next scan, and cost every sidebar two rebuilds. */
+            {
+                const char *mount_points[] = {
+                    [path fileSystemRepresentation],         /* standardized, NFD */
+                    [[url path] fileSystemRepresentation],   /* keeps "/private", NFD */
+                    [url fileSystemRepresentation],          /* the kernel's bytes */
+                    NULL
+                };
+
+                if (!mounted_volume_statfs (mount_points, &fs))
+                {
+                    continue;
+                }
+            }
+
+            NautilusMacosMountedVolume *volume = g_new0 (NautilusMacosMountedVolume, 1);
+            volume->name = g_strdup ([volume_name UTF8String]);
+            volume->path = g_strdup ([path fileSystemRepresentation]);
+            volume->is_internal = is_internal != nil && [is_internal boolValue];
+            volume->is_local = is_local == nil || [is_local boolValue];
+            volume->can_unmount = unmountable;
+            volume->can_eject = (is_ejectable != nil && [is_ejectable boolValue]) ||
+                                (is_removable != nil && [is_removable boolValue]) ||
+                                removable;
+            volume->identifier = g_strdup_printf ("%08x%08x",
+                                                  (unsigned int) fs.f_fsid.val[0],
+                                                  (unsigned int) fs.f_fsid.val[1]);
+
+            volumes = g_list_prepend (volumes, volume);
+            [seen_paths addObject:path];
+        }
+    }
+
+    return g_list_reverse (volumes);
+}
+
+gboolean
+nautilus_macos_unmount_volume (const char  *path,
+                               GError     **error)
+{
+    g_return_val_if_fail (path != NULL, FALSE);
+
+    @autoreleasepool
+    {
+        NSURL *url = [NSURL fileURLWithPath:@(path) isDirectory:YES];
+        NSError *ns_error = nil;
+
+        if ([[NSWorkspace sharedWorkspace] unmountAndEjectDeviceAtURL:url
+                                                                 error:&ns_error])
+        {
+            return TRUE;
+        }
+
+        g_set_error (error,
+                     G_IO_ERROR,
+                     G_IO_ERROR_FAILED,
+                     "%s",
+                     ns_error != nil ? [[ns_error localizedDescription] UTF8String]
+                                     : "macOS refused to unmount the volume");
+        return FALSE;
+    }
+}
+
+/* ------------------------------------------------------------------------ */
+/* Event source: the part that lives on the serial queue.                    */
+/* ------------------------------------------------------------------------ */
+
+typedef struct
+{
+    GWeakRef monitor;            /* NautilusMacosVolumeMonitor */
+    GMainContext *context;       /* where scan results are applied */
+    dispatch_queue_t queue;      /* serial; owns every field below */
+    gboolean scan_scheduled;
+    gboolean settle_scheduled;
+    gint64 last_event_time;      /* g_get_monotonic_time () */
+    gint generation;             /* atomic: one per scan, in start order */
+} VolumeSource;
+
+static void
+volume_source_free (VolumeSource *source)
+{
+    g_weak_ref_clear (&source->monitor);
+    g_main_context_unref (source->context);
+    dispatch_release (source->queue);
+}
+
+static VolumeSource *
+volume_source_ref (VolumeSource *source)
+{
+    return g_atomic_rc_box_acquire (source);
+}
+
+static void
+volume_source_unref (VolumeSource *source)
+{
+    g_atomic_rc_box_release_full (source, (GDestroyNotify) volume_source_free);
+}
+
+typedef struct
+{
+    VolumeSource *source;
+    gint generation;
+    GList *volumes;
+} ScanResult;
+
+static void
+scan_result_free (gpointer data)
+{
+    ScanResult *result = data;
+
+    mounted_volume_list_free (result->volumes);
+    volume_source_unref (result->source);
+    g_free (result);
+}
+
+static void monitor_apply_snapshot (NautilusMacosVolumeMonitor *self,
+                                    gint                        generation,
+                                    GList                      *volumes);
+
+static gboolean
+apply_scan_result_cb (gpointer data)
+{
+    ScanResult *result = data;
+    NautilusMacosVolumeMonitor *monitor = g_weak_ref_get (&result->source->monitor);
+
+    if (monitor != NULL)
+    {
+        monitor_apply_snapshot (monitor, result->generation, g_steal_pointer (&result->volumes));
+        g_object_unref (monitor);
+    }
+
+    return G_SOURCE_REMOVE;
+}
+
+/* On the queue. */
+static void
+volume_source_scan (VolumeSource *source)
+{
+    ScanResult *result = g_new0 (ScanResult, 1);
+    GSource *idle;
+
+    result->source = volume_source_ref (source);
+    result->generation = g_atomic_int_add (&source->generation, 1) + 1;
+    result->volumes = nautilus_macos_get_mounted_volumes ();
+
+    /* Not g_main_context_invoke(): from a thread with no thread-default
+     * context it acquires the global default context when nobody holds it
+     * and runs the callback right here, on the queue. */
+    idle = g_idle_source_new ();
+    g_source_set_priority (idle, G_PRIORITY_DEFAULT);
+    g_source_set_callback (idle, apply_scan_result_cb, result, scan_result_free);
+    g_source_set_static_name (idle, "[nautilus] volume monitor scan result");
+    g_source_attach (idle, source->context);
+    g_source_unref (idle);
+}
+
+static void volume_source_run_settle (VolumeSource *source);
+
+/* On the queue.  @block runs on the queue after @delay_ms and gets a
+ * reference to @source that it must not drop itself. */
+static void
+volume_source_after (VolumeSource *source,
+                     gint64        delay_ms,
+                     void        (^block) (void))
+{
+    volume_source_ref (source);
+    dispatch_after (dispatch_time (DISPATCH_TIME_NOW, delay_ms * NSEC_PER_MSEC),
+                    source->queue,
+                    ^{
+        block ();
+        volume_source_unref (source);
+    });
+}
+
+static void
+volume_source_run_settle (VolumeSource *source)
+{
+    gint64 quiet_ms = (g_get_monotonic_time () - source->last_event_time) / 1000;
+
+    if (quiet_ms < SETTLE_DELAY_MS)
+    {
+        volume_source_after (source, SETTLE_DELAY_MS - quiet_ms, ^{
+            volume_source_run_settle (source);
+        });
+        return;
+    }
+
+    source->settle_scheduled = FALSE;
+    volume_source_scan (source);
+}
+
+/* On the queue. */
+static void
+volume_source_note_event (VolumeSource *source)
+{
+    source->last_event_time = g_get_monotonic_time ();
+
+    if (!source->scan_scheduled)
+    {
+        source->scan_scheduled = TRUE;
+        volume_source_after (source, SCAN_DELAY_MS, ^{
+            source->scan_scheduled = FALSE;
+            volume_source_scan (source);
+        });
+    }
+
+    if (!source->settle_scheduled)
+    {
+        source->settle_scheduled = TRUE;
+        volume_source_after (source, SETTLE_DELAY_MS, ^{
+            volume_source_run_settle (source);
+        });
+    }
+}
+
+/* Any thread. */
+static void
+volume_source_post_event (VolumeSource *source)
+{
+    volume_source_ref (source);
+    dispatch_async (source->queue, ^{
+        volume_source_note_event (source);
+        volume_source_unref (source);
+    });
+}
+
+/* Disk Arbitration callbacks run on the queue (DASessionSetDispatchQueue). */
+static void
+disk_appeared_cb (DADiskRef disk,
+                  void     *context)
+{
+    volume_source_note_event (context);
+}
+
+static void
+disk_disappeared_cb (DADiskRef disk,
+                     void     *context)
+{
+    volume_source_note_event (context);
+}
+
+static void
+disk_description_changed_cb (DADiskRef  disk,
+                             CFArrayRef keys,
+                             void      *context)
+{
+    volume_source_note_event (context);
+}
+
+/* ------------------------------------------------------------------------ */
+/* The GObject, main context only.                                           */
+/* ------------------------------------------------------------------------ */
+
+struct _NautilusMacosVolumeMonitor
+{
+    GObject parent_instance;
+
+    NautilusMacosVolumeEvents events;
+    VolumeSource *source;
+    GList *volumes;              /* NautilusMacosMountedVolume, the snapshot */
+    gint generation;             /* of the scan that produced the snapshot */
+
+    NSMutableArray *workspace_observers;
+    DASessionRef da_session;
+};
+
+G_DEFINE_FINAL_TYPE (NautilusMacosVolumeMonitor, nautilus_macos_volume_monitor, G_TYPE_OBJECT)
+
+enum
+{
+    VOLUME_ADDED,
+    VOLUME_REMOVED,
+    VOLUME_CHANGED,
+    CHANGED,
+    LAST_SIGNAL
+};
+
+static guint signals[LAST_SIGNAL];
+
+static NautilusMacosVolumeMonitor *shared_monitor;
+
+static gboolean
+mounted_volume_equal (const NautilusMacosMountedVolume *a,
+                      const NautilusMacosMountedVolume *b)
+{
+    return g_strcmp0 (a->name, b->name) == 0 &&
+           g_strcmp0 (a->path, b->path) == 0 &&
+           g_strcmp0 (a->identifier, b->identifier) == 0 &&
+           a->is_internal == b->is_internal &&
+           a->is_local == b->is_local &&
+           a->can_unmount == b->can_unmount &&
+           a->can_eject == b->can_eject;
+}
+
+/* Pairs each volume of @new_volumes with the volume of @old_volumes that is
+ * the same mount: first by mount point (the usual case), then, among the
+ * rest, by file system id (a rename moves the mount point).  Returns an
+ * array parallel to @new_volumes holding the old partner or NULL, and marks
+ * paired old volumes in @old_paired. */
+static NautilusMacosMountedVolume **
+pair_volumes (GPtrArray *old_volumes,
+              GPtrArray *new_volumes,
+              gboolean  *old_paired)
+{
+    NautilusMacosMountedVolume **partner = g_new0 (NautilusMacosMountedVolume *,
+                                                   new_volumes->len + 1);
+
+    for (guint pass = 0; pass < 2; pass++)
+    {
+        for (guint n = 0; n < new_volumes->len; n++)
+        {
+            NautilusMacosMountedVolume *new_volume = new_volumes->pdata[n];
+
+            for (guint o = 0; partner[n] == NULL && o < old_volumes->len; o++)
+            {
+                NautilusMacosMountedVolume *old_volume = old_volumes->pdata[o];
+                gboolean same;
+
+                if (old_paired[o])
+                {
+                    continue;
+                }
+
+                same = pass == 0
+                       ? g_strcmp0 (old_volume->path, new_volume->path) == 0
+                       : (old_volume->identifier != NULL &&
+                          g_strcmp0 (old_volume->identifier, new_volume->identifier) == 0);
+                if (same)
+                {
+                    partner[n] = old_volume;
+                    old_paired[o] = TRUE;
+                }
+            }
+        }
+    }
+
+    return partner;
+}
+
+static GPtrArray *
+volume_list_to_array (GList *volumes)
+{
+    GPtrArray *array = g_ptr_array_new ();
+
+    for (GList *l = volumes; l != NULL; l = l->next)
+    {
+        g_ptr_array_add (array, l->data);
+    }
+
+    return array;
+}
+
+/* Takes ownership of @volumes. */
+static void
+monitor_apply_snapshot (NautilusMacosVolumeMonitor *self,
+                        gint                        generation,
+                        GList                      *volumes)
+{
+    g_autoptr (GPtrArray) old_array = NULL;
+    g_autoptr (GPtrArray) new_array = NULL;
+    g_autofree gboolean *old_paired = NULL;
+    g_autofree NautilusMacosMountedVolume **partner = NULL;
+    GList *old_volumes;
+    gboolean changed = FALSE;
+
+    /* A scan that started before the snapshot we hold is stale. */
+    if (generation <= self->generation)
+    {
+        mounted_volume_list_free (volumes);
+        return;
+    }
+
+    old_volumes = self->volumes;
+    self->volumes = volumes;
+    self->generation = generation;
+
+    old_array = volume_list_to_array (old_volumes);
+    new_array = volume_list_to_array (volumes);
+    old_paired = g_new0 (gboolean, old_array->len + 1);
+    partner = pair_volumes (old_array, new_array, old_paired);
+
+    for (guint o = 0; o < old_array->len; o++)
+    {
+        if (!old_paired[o])
+        {
+            NautilusMacosMountedVolume *old_volume = old_array->pdata[o];
+
+            g_debug ("volume removed: %s", old_volume->path);
+            g_signal_emit (self, signals[VOLUME_REMOVED], 0, old_volume);
+            changed = TRUE;
+        }
+    }
+
+    for (guint n = 0; n < new_array->len; n++)
+    {
+        NautilusMacosMountedVolume *new_volume = new_array->pdata[n];
+
+        if (partner[n] == NULL)
+        {
+            g_debug ("volume added: %s", new_volume->path);
+            g_signal_emit (self, signals[VOLUME_ADDED], 0, new_volume);
+            changed = TRUE;
+        }
+        else if (!mounted_volume_equal (partner[n], new_volume))
+        {
+            g_debug ("volume changed: %s -> %s", partner[n]->path, new_volume->path);
+            g_signal_emit (self, signals[VOLUME_CHANGED], 0, partner[n], new_volume);
+            changed = TRUE;
+        }
+    }
+
+    if (changed)
+    {
+        g_signal_emit (self, signals[CHANGED], 0);
+    }
+
+    mounted_volume_list_free (old_volumes);
+}
+
+static void
+nautilus_macos_volume_monitor_start (NautilusMacosVolumeMonitor *self)
+{
+    VolumeSource *source = self->source;
+
+    @autoreleasepool
+    {
+        if (self->events & NAUTILUS_MACOS_VOLUME_EVENTS_WORKSPACE)
+        {
+            NSNotificationCenter *center = [[NSWorkspace sharedWorkspace] notificationCenter];
+
+            self->workspace_observers = [[NSMutableArray alloc] init];
+            for (NSNotificationName name in @[NSWorkspaceDidMountNotification,
+                                              NSWorkspaceDidUnmountNotification,
+                                              NSWorkspaceDidRenameVolumeNotification])
+            {
+                /* Posted on the main thread; only hand the event to the queue.
+                 * The monitor's reference on @source outlives the observer,
+                 * which finalize removes first. */
+                id observer = [center addObserverForName:name
+                                                  object:nil
+                                                   queue:nil
+                                              usingBlock:^(NSNotification *notification) {
+                    volume_source_post_event (source);
+                }];
+                [self->workspace_observers addObject:observer];
+            }
+        }
+
+        if (self->events & NAUTILUS_MACOS_VOLUME_EVENTS_DISK_ARBITRATION)
+        {
+            self->da_session = DASessionCreate (kCFAllocatorDefault);
+            if (self->da_session != NULL)
+            {
+                CFArrayRef watched = (CFArrayRef) @[(id) kDADiskDescriptionVolumePathKey,
+                                                    (id) kDADiskDescriptionVolumeNameKey];
+
+                /* Disk Arbitration holds this reference until finalize. */
+                volume_source_ref (source);
+                DARegisterDiskAppearedCallback (self->da_session, NULL,
+                                                disk_appeared_cb, source);
+                DARegisterDiskDisappearedCallback (self->da_session, NULL,
+                                                   disk_disappeared_cb, source);
+                DARegisterDiskDescriptionChangedCallback (self->da_session, NULL, watched,
+                                                          disk_description_changed_cb, source);
+                DASessionSetDispatchQueue (self->da_session, source->queue);
+            }
+            else
+            {
+                g_warning ("Disk Arbitration is unavailable; volume changes rely on NSWorkspace");
+            }
+        }
+    }
+}
+
+static void
+nautilus_macos_volume_monitor_finalize (GObject *object)
+{
+    NautilusMacosVolumeMonitor *self = NAUTILUS_MACOS_VOLUME_MONITOR (object);
+    VolumeSource *source = self->source;
+
+    if (self->workspace_observers != nil)
+    {
+        @autoreleasepool
+        {
+            NSNotificationCenter *center = [[NSWorkspace sharedWorkspace] notificationCenter];
+
+            for (id observer in self->workspace_observers)
+            {
+                [center removeObserver:observer];
+            }
+        }
+        [self->workspace_observers release];
+        self->workspace_observers = nil;
+    }
+
+    if (self->da_session != NULL)
+    {
+        DAUnregisterCallback (self->da_session, (void *) disk_appeared_cb, source);
+        DAUnregisterCallback (self->da_session, (void *) disk_disappeared_cb, source);
+        DAUnregisterCallback (self->da_session, (void *) disk_description_changed_cb, source);
+        DASessionSetDispatchQueue (self->da_session, NULL);
+        CFRelease (self->da_session);
+        self->da_session = NULL;
+        /* Callbacks already queued run before this; then drop DA's ref. */
+        dispatch_async (source->queue, ^{
+            volume_source_unref (source);
+        });
+    }
+
+    volume_source_unref (source);
+    mounted_volume_list_free (self->volumes);
+
+    G_OBJECT_CLASS (nautilus_macos_volume_monitor_parent_class)->finalize (object);
+}
+
+static void
+nautilus_macos_volume_monitor_class_init (NautilusMacosVolumeMonitorClass *klass)
+{
+    GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+    object_class->finalize = nautilus_macos_volume_monitor_finalize;
+
+    signals[VOLUME_ADDED] = g_signal_new ("volume-added",
+                                          G_TYPE_FROM_CLASS (klass),
+                                          G_SIGNAL_RUN_LAST,
+                                          0, NULL, NULL, NULL,
+                                          G_TYPE_NONE, 1, G_TYPE_POINTER);
+    signals[VOLUME_REMOVED] = g_signal_new ("volume-removed",
+                                            G_TYPE_FROM_CLASS (klass),
+                                            G_SIGNAL_RUN_LAST,
+                                            0, NULL, NULL, NULL,
+                                            G_TYPE_NONE, 1, G_TYPE_POINTER);
+    signals[VOLUME_CHANGED] = g_signal_new ("volume-changed",
+                                            G_TYPE_FROM_CLASS (klass),
+                                            G_SIGNAL_RUN_LAST,
+                                            0, NULL, NULL, NULL,
+                                            G_TYPE_NONE, 2, G_TYPE_POINTER, G_TYPE_POINTER);
+    signals[CHANGED] = g_signal_new ("changed",
+                                     G_TYPE_FROM_CLASS (klass),
+                                     G_SIGNAL_RUN_LAST,
+                                     0, NULL, NULL, NULL,
+                                     G_TYPE_NONE, 0);
+}
+
+static void
+nautilus_macos_volume_monitor_init (NautilusMacosVolumeMonitor *self)
+{
+}
+
+NautilusMacosVolumeMonitor *
+nautilus_macos_volume_monitor_new (NautilusMacosVolumeEvents events)
+{
+    NautilusMacosVolumeMonitor *self = g_object_new (NAUTILUS_TYPE_MACOS_VOLUME_MONITOR, NULL);
+    VolumeSource *source = g_atomic_rc_box_new0 (VolumeSource);
+
+    g_weak_ref_init (&source->monitor, self);
+    source->context = g_main_context_ref_thread_default ();
+    source->queue = dispatch_queue_create ("org.gnome.Nautilus.volume-monitor",
+                                           DISPATCH_QUEUE_SERIAL);
+    self->source = source;
+    self->events = events;
+
+    /* Start listening before the first scan, so a mount that lands in
+     * between is rescanned rather than missed.  The first snapshot is taken
+     * synchronously: the first sidebar needs it to draw. */
+    nautilus_macos_volume_monitor_start (self);
+    self->generation = g_atomic_int_add (&source->generation, 1) + 1;
+    self->volumes = nautilus_macos_get_mounted_volumes ();
+
+    return self;
+}
+
+NautilusMacosVolumeMonitor *
+nautilus_macos_volume_monitor_get (void)
+{
+    if (shared_monitor == NULL)
+    {
+        shared_monitor = nautilus_macos_volume_monitor_new (NAUTILUS_MACOS_VOLUME_EVENTS_ALL);
+    }
+
+    return shared_monitor;
+}
+
+GList *
+nautilus_macos_volume_monitor_get_volumes (NautilusMacosVolumeMonitor *self)
+{
+    g_return_val_if_fail (NAUTILUS_IS_MACOS_VOLUME_MONITOR (self), NULL);
+
+    return mounted_volume_list_copy (self->volumes);
+}
+
+GList *
+nautilus_macos_volume_monitor_get_sidebar_volumes (NautilusMacosVolumeMonitor *self,
+                                                   GVolumeMonitor             *gio_monitor)
+{
+    g_autoptr (GHashTable) uris = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+    GList *result = NULL;
+
+    g_return_val_if_fail (NAUTILUS_IS_MACOS_VOLUME_MONITOR (self), NULL);
+
+    if (gio_monitor != NULL)
+    {
+        GList *mounts = g_volume_monitor_get_mounts (gio_monitor);
+
+        for (GList *l = mounts; l != NULL; l = l->next)
+        {
+            g_autoptr (GFile) root = g_mount_get_default_location (l->data);
+
+            if (root != NULL)
+            {
+                g_hash_table_add (uris, g_file_get_uri (root));
+            }
+        }
+
+        g_list_free_full (mounts, g_object_unref);
+    }
+
+    for (GList *l = self->volumes; l != NULL; l = l->next)
+    {
+        NautilusMacosMountedVolume *volume = l->data;
+        char *uri = g_filename_to_uri (volume->path, NULL, NULL);
+
+        /* g_hash_table_add() takes @uri either way; FALSE means GIO or an
+         * earlier volume already has this root. */
+        if (uri != NULL && g_hash_table_add (uris, uri))
+        {
+            result = g_list_prepend (result, nautilus_macos_mounted_volume_copy (volume));
+        }
+    }
+
+    return g_list_reverse (result);
+}
+
+void
+nautilus_macos_volume_monitor_refresh (NautilusMacosVolumeMonitor *self)
+{
+    g_return_if_fail (NAUTILUS_IS_MACOS_VOLUME_MONITOR (self));
+
+    volume_source_post_event (self->source);
+}
