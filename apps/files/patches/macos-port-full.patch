diff --git a/test/displayless/test-macos-apps-archives.c b/test/displayless/test-macos-apps-archives.c
new file mode 100644
index 0000000..d9d6b33
--- /dev/null
+++ b/test/displayless/test-macos-apps-archives.c
@@ -0,0 +1,2012 @@
+/*
+ * test-macos-apps-archives.c: applications, file packages and archives on
+ * macOS, without a display.
+ *
+ * Copyright (C) 2026 The Nautilus authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Opening a macOS application bundle must launch it, as Finder does, and an
+ * archive must be offered for extraction.  This test builds throwaway
+ * fixtures in $NAUTILUS_TEST_SCRATCH (tools/test-macos-apps-archives.sh sets
+ * it and cleans up after an aborted run) or in a temporary directory, and
+ * checks:
+ *
+ *   - which folders LaunchServices calls packages, and which of them are apps;
+ *   - the activation decision Nautilus takes for each (launch the app, open
+ *     the package with its default app, browse the folder, or open with the
+ *     default app / extract an archive), and what the context menu offers;
+ *   - that a drag paused over an app or another package does not open it;
+ *   - what a drop onto an item does: files dropped onto an app are opened
+ *     with it (a throwaway app records what it receives) and never moved or
+ *     copied into it, other packages refuse drops, folders take them; what
+ *     each app answered is kept for the drag, so asking about several app
+ *     rows on every pointer motion does not ask LaunchServices each time;
+ *   - that the list view gives packages no expander and that "folders
+ *     first" sorts them with the files, without asking LaunchServices about
+ *     folders that cannot be packages (it takes 30-45 µs a folder);
+ *   - that launching goes through NSWorkspace and reports back on the main
+ *     thread: real throwaway apps are launched, one and several at a time,
+ *     and broken or missing ones are reported as errors;
+ *   - archive detection for every format autoar extracts, and real extraction
+ *     (and compression) with names that contain spaces and non-ASCII
+ *     characters.
+ *
+ * The only apps it launches are its own throwaway bundles, whose executable
+ * (macos-test-marker-app) shows nothing: the bundles are LSBackgroundOnly,
+ * and the executable records its launch next to its bundle and quits.
+ * Nothing here opens a window.
+ */
+
+#define G_LOG_DOMAIN "test-macos-apps-archives"
+
+#include <nautilus-dnd.h>
+#include <nautilus-file.h>
+#include <nautilus-file-operations.h>
+#include <nautilus-file-undo-manager.h>
+#include <nautilus-file-utilities.h>
+#include <nautilus-list-base-private.h>
+#include <nautilus-macos-bridge.h>
+#include <nautilus-mime-actions.h>
+#include <nautilus-view-item.h>
+#include <nautilus-view-model.h>
+
+#include <gio/gio.h>
+#include <glib.h>
+#include <glib/gstdio.h>
+#include <gnome-autoar/gnome-autoar.h>
+#include <langinfo.h>
+#include <locale.h>
+#include <stdarg.h>
+#include <string.h>
+#include <sys/attr.h>
+#include <unistd.h>
+
+#define __ASSERT_MACROS_DEFINE_VERSIONS_WITHOUT_UNDERSCORES 0
+#include <CoreServices/CoreServices.h>
+
+#define LSREGISTER "/System/Library/Frameworks/CoreServices.framework/Frameworks/" \
+                   "LaunchServices.framework/Support/lsregister"
+
+/* LaunchServices starts an app in well under a second; leave room for a
+ * loaded machine. */
+#define LAUNCH_DEADLINE_MS 15000
+
+#define PLAIN_TEXT "This is a plain text file.\nSecond line.\n"
+
+static char *scratch;
+static gboolean scratch_is_ours;
+static GThread *main_thread;
+static GPtrArray *fixture_apps;
+
+/* ------------------------------------------------------------------------ */
+/* Helpers                                                                   */
+/* ------------------------------------------------------------------------ */
+
+static char *
+fixture_path (const char *name)
+{
+    return g_build_filename (scratch, name, NULL);
+}
+
+static void
+make_dir (const char *path)
+{
+    g_assert_cmpint (g_mkdir_with_parents (path, 0755), ==, 0);
+}
+
+/* Sets the Finder's bundle bit (kHasBundle) of the folder @path, which makes
+ * it a package whatever its name. */
+static void
+set_bundle_bit (const char *path)
+{
+    struct attrlist request = {
+        .bitmapcount = ATTR_BIT_MAP_COUNT,
+        .commonattr = ATTR_CMN_FNDRINFO,
+    };
+    struct
+    {
+        u_int32_t length;
+        u_int8_t finder_info[32];
+    } __attribute__ ((aligned (4), packed)) reply;
+
+    g_assert_cmpint (getattrlist (path, &request, &reply, sizeof reply, 0), ==, 0);
+    reply.finder_info[8] |= kHasBundle >> 8;
+    g_assert_cmpint (setattrlist (path, &request, reply.finder_info, sizeof reply.finder_info, 0), ==, 0);
+}
+
+static void
+write_file (const char *path,
+            const char *contents)
+{
+    g_autoptr (GError) error = NULL;
+    g_autofree char *parent = g_path_get_dirname (path);
+
+    make_dir (parent);
+    g_file_set_contents (path, contents, -1, &error);
+    g_assert_no_error (error);
+}
+
+static void
+run_in (const char        *directory,
+        const char *const *argv)
+{
+    g_autoptr (GError) error = NULL;
+    g_autofree char *output = NULL;
+    int status = 0;
+
+    g_spawn_sync (directory, (char **) argv, NULL, G_SPAWN_SEARCH_PATH,
+                  NULL, NULL, &output, &output, &status, &error);
+    g_assert_no_error (error);
+    if (!g_spawn_check_wait_status (status, NULL))
+    {
+        g_error ("%s failed: %s", argv[0], output);
+    }
+}
+
+static void
+pump (void)
+{
+    while (g_main_context_iteration (NULL, FALSE))
+    {
+    }
+    g_usleep (2000);
+}
+
+static void
+wait_for_flag (const gboolean *flag,
+               gint64          timeout_ms)
+{
+    gint64 end = g_get_monotonic_time () + timeout_ms * 1000;
+
+    while (!*flag && g_get_monotonic_time () < end)
+    {
+        pump ();
+    }
+    g_assert_true (*flag);
+}
+
+static void
+on_file_ready (NautilusFile *file,
+               gpointer      user_data)
+{
+    *(gboolean *) user_data = TRUE;
+}
+
+static NautilusFile *
+load_file (const char *path)
+{
+    g_autoptr (GFile) location = g_file_new_for_path (path);
+    NautilusFile *file = nautilus_file_get (location);
+    gboolean ready = FALSE;
+
+    nautilus_file_call_when_ready (file,
+                                   nautilus_mime_actions_get_required_attributes (),
+                                   on_file_ready, &ready);
+    wait_for_flag (&ready, 5000);
+
+    return file;
+}
+
+/* A throwaway application bundle.  Its executable appends "launched <pid>"
+ * (and "open <path>" per document) to "<bundle>.marker", then quits.
+ * @extra_plist goes into its Info.plist dictionary. */
+static char *
+make_marker_app_with (const char *name,
+                      const char *bundle_id,
+                      const char *extra_plist)
+{
+    char *app = fixture_path (name);
+    g_autofree char *macos_dir = g_build_filename (app, "Contents", "MacOS", NULL);
+    g_autofree char *executable = g_build_filename (macos_dir, "marker", NULL);
+    g_autofree char *plist = g_build_filename (app, "Contents", "Info.plist", NULL);
+    g_autofree char *info = NULL;
+    g_autoptr (GFile) source = g_file_new_for_path (MARKER_APP_EXECUTABLE);
+    g_autoptr (GFile) destination = NULL;
+    g_autoptr (GError) error = NULL;
+
+    make_dir (macos_dir);
+    destination = g_file_new_for_path (executable);
+    g_file_copy (source, destination, G_FILE_COPY_OVERWRITE, NULL, NULL, NULL, &error);
+    g_assert_no_error (error);
+    g_assert_cmpint (g_chmod (executable, 0755), ==, 0);
+
+    info = g_strdup_printf ("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+                            "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+                            "\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+                            "<plist version=\"1.0\"><dict>\n"
+                            "<key>CFBundleExecutable</key><string>marker</string>\n"
+                            "<key>CFBundleIdentifier</key><string>%s</string>\n"
+                            "<key>CFBundleName</key><string>Marker</string>\n"
+                            "<key>CFBundlePackageType</key><string>APPL</string>\n"
+                            "<key>CFBundleShortVersionString</key><string>1.0</string>\n"
+                            "<key>LSBackgroundOnly</key><true/>\n"
+                            "%s"
+                            "</dict></plist>\n",
+                            bundle_id, extra_plist);
+    write_file (plist, info);
+
+    g_ptr_array_add (fixture_apps, g_strdup (app));
+
+    return app;
+}
