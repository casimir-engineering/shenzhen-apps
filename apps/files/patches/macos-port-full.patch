+    {
+        gsize oldest_index = G_MAXSIZE;
+        gint64 oldest_time = G_MAXINT64;
+
+        for (gsize i = 0; i < group_count; i++)
+        {
+            gint64 updated;
+
+            if (g_strcmp0 (groups[i], current_group) == 0)
+            {
+                continue;
+            }
+
+            updated = g_key_file_get_int64 (key_file, groups[i], "updated", NULL);
+            if (oldest_index == G_MAXSIZE || updated < oldest_time)
+            {
+                oldest_index = i;
+                oldest_time = updated;
+            }
+        }
