+/* libtinysparql loads its collation/parser module (libtracker-parser-libicu.so)
+ * with g_module_open() and, if that returns NULL, g_assert()s — which aborts
+ * the whole process from inside the library (uncatchable via GError). In the
+ * relocatable .app the module is bundled under Resources/lib/tinysparql-3.0 and
+ * bundle-dylibs.sh rewrites libtinysparql's baked lookup path to
+ * @executable_path/../Resources/lib/tinysparql-3.0. This preflight verifies the
+ * module is actually loadable BEFORE we hand control to libtinysparql, so a
+ * packaging regression degrades to "starring disabled" instead of a crash.
+ * Only meaningful inside the bundle; dev runs (no .app) fall through and use
+ * libtinysparql's own Homebrew default path. */
+static gboolean
+macos_tracker_parser_module_loadable (void)
+{
+    char exe[PATH_MAX];
+    uint32_t size = sizeof exe;
+
+    if (_NSGetExecutablePath (exe, &size) != 0)
+    {
+        return TRUE;  /* can't tell; don't block the normal path */
+    }
+
+    g_autofree char *real_exe = realpath (exe, NULL);
+    if (real_exe == NULL || strstr (real_exe, ".app/Contents/MacOS/") == NULL)
+    {
+        return TRUE;  /* not a bundle run — leave it to libtinysparql */
+    }
+
+    g_autofree char *macos_dir = g_path_get_dirname (real_exe);
+    g_autofree char *module_path =
