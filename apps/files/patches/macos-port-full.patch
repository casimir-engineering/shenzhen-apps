+static gboolean
+location_is_within (GFile *location,
+                    GFile *root)
+{
+    return location != NULL &&
+           (g_file_equal (location, root) || g_file_has_prefix (location, root));
+}
+
+GList *
+nautilus_window_redirect_slots_from_location (NautilusWindow *self,
+                                              GFile          *source_root,
+                                              GFile          *destination)
+{
+    GList *redirected_slots = NULL;
+
+    g_return_val_if_fail (NAUTILUS_IS_WINDOW (self), NULL);
+    g_return_val_if_fail (G_IS_FILE (source_root), NULL);
+    g_return_val_if_fail (G_IS_FILE (destination), NULL);
+
+    for (GList *l = self->slots; l != NULL; l = l->next)
+    {
+        NautilusWindowSlot *slot = l->data;
+        GFile *location = nautilus_window_slot_get_location (slot);
+        GFile *pending_location = nautilus_window_slot_get_pending_location (slot);
+
+        if (!location_is_within (location, source_root) &&
+            !location_is_within (pending_location, source_root))
+        {
+            continue;
+        }
+
+        nautilus_window_slot_open_location_full (slot, destination, NULL);
+        redirected_slots = g_list_prepend (redirected_slots, g_object_ref (slot));
+    }
+
+    return g_list_reverse (redirected_slots);
+}
