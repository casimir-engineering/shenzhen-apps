+static void
+test_drop_decision (void)
+{
+    g_autoptr (GSList) document = dropped_files ("drop docs/Dropped Document.szfdrop", NULL);
+    g_autoptr (GSList) documents = dropped_files ("drop docs/Dropped Document.szfdrop",
+                                                  "drop docs/Ünïcode 文件 2.szfdrop", NULL);
+    g_autoptr (GSList) text = dropped_files ("notes.txt", NULL);
+    g_autoptr (GSList) mixed = dropped_files ("drop docs/Dropped Document.szfdrop", "notes.txt", NULL);
+    g_autoptr (GSList) itself = dropped_files ("Drop Target.app", NULL);
+    g_autoptr (GSList) remote = dropped_files ("https://example.com/Dropped.szfdrop", NULL);
+
+    /* What each kind of item does with a drop. */
+    assert_item_drop ("Decision.app", NAUTILUS_DND_ITEM_DROP_OPEN_WITH_APP);
+    assert_item_drop ("Drop Target.app", NAUTILUS_DND_ITEM_DROP_OPEN_WITH_APP);
+    assert_item_drop ("Link to Drop Target", NAUTILUS_DND_ITEM_DROP_OPEN_WITH_APP);
+    assert_item_drop ("Märker Drei 三.app", NAUTILUS_DND_ITEM_DROP_OPEN_WITH_APP);
+    assert_item_drop ("Empty.app", NAUTILUS_DND_ITEM_DROP_OPEN_WITH_APP);
+    assert_item_drop ("Doc.rtfd", NAUTILUS_DND_ITEM_DROP_REFUSE);
+    assert_item_drop ("Thing.bundle", NAUTILUS_DND_ITEM_DROP_REFUSE);
+    assert_item_drop ("Lib.photoslibrary", NAUTILUS_DND_ITEM_DROP_REFUSE);
+    assert_item_drop ("Notes.pages", NAUTILUS_DND_ITEM_DROP_REFUSE);
+    assert_item_drop ("Plain Folder", NAUTILUS_DND_ITEM_DROP_DEFAULT);
+    assert_item_drop ("Fw.framework", NAUTILUS_DND_ITEM_DROP_DEFAULT);
+    assert_item_drop ("folder.with.dots", NAUTILUS_DND_ITEM_DROP_DEFAULT);
+    assert_item_drop ("Ünïcode Földer 文件夹", NAUTILUS_DND_ITEM_DROP_DEFAULT);
+    assert_item_drop ("notes.txt", NAUTILUS_DND_ITEM_DROP_DEFAULT);
+    assert_item_drop ("Archive.zip", NAUTILUS_DND_ITEM_DROP_DEFAULT);
+
+    /* The bug: to the folder rules an app is a writable folder, so a drop
+     * moved the files into the bundle (copied them here, where the test
+     * does not load the file system ids that make it a move). */
+    {
+        NautilusFile *app = load_file (drop_target_app);
+        GdkDragAction folder_action = nautilus_dnd_get_preferred_action (app, document->data);
+
+        g_test_message ("folder rules for a document dropped onto Drop Target.app: action %d",
+                        folder_action);
+        g_assert_cmpint (folder_action, !=, 0);
+        nautilus_file_unref (app);
+    }
+
+    /* An app takes only files it declares it opens, as in Finder, and only
+     * to open them (copy: the files stay where they are). */
+    assert_item_action ("Drop Target.app", document, "its document", GDK_ACTION_COPY);
+    assert_item_action ("Drop Target.app", documents, "two of its documents", GDK_ACTION_COPY);
+    assert_item_action ("Drop Target.app", NULL, "files not known yet", GDK_ACTION_COPY);
+    assert_item_action ("Link to Drop Target", document, "its document", GDK_ACTION_COPY);
+    assert_item_action ("Drop Target.app", text, "a text file", 0);
+    assert_item_action ("Drop Target.app", mixed, "its document and a text file", 0);
+    assert_item_action ("Drop Target.app", itself, "the app itself", 0);
+    assert_item_action ("Drop Target.app", remote, "a web address", 0);
+    assert_item_action ("Decision.app", document, "a document it does not declare", 0);
+    assert_item_action ("Empty.app", document, "a document", 0);
+
+    /* Other packages take nothing. */
+    assert_item_action ("Doc.rtfd", document, "a document", 0);
+    assert_item_action ("Thing.bundle", text, "a text file", 0);
+    assert_item_action ("Lib.photoslibrary", text, "a text file", 0);
+
+    /* Folders keep the folder rules; files take nothing. */
+    {
+        g_autofree char *folder_path = fixture_path ("Plain Folder");
+        NautilusFile *folder = load_file (folder_path);
+        GdkDragAction folder_action = nautilus_dnd_get_preferred_action (folder, text->data);
+
+        g_assert_cmpint (folder_action, !=, 0);
+        assert_item_action ("Plain Folder", text, "a text file", folder_action);
+        assert_item_action ("Fw.framework", text, "a text file", folder_action);
+        nautilus_file_unref (folder);
+    }
+    assert_item_action ("notes.txt", document, "a document", 0);
+
+    /* A sidebar row's file is often not loaded: the decision still holds. */
+    {
+        g_autofree char *unloaded_app = fixture_path ("Unloaded.app");
+        g_autofree char *unloaded_package = fixture_path ("Unloaded.rtfd");
+        g_autofree char *unloaded_folder = fixture_path ("Unloaded Folder");
+        NautilusFile *app;
+        NautilusFile *package;
+        NautilusFile *folder;
+
+        make_dir (unloaded_app);
+        make_dir (unloaded_package);
+        make_dir (unloaded_folder);
+        app = unloaded_file ("Unloaded.app");
+        package = unloaded_file ("Unloaded.rtfd");
+        folder = unloaded_file ("Unloaded Folder");
+
+        assert_item_drop_for_file ("Unloaded.app (not loaded)", app, NAUTILUS_DND_ITEM_DROP_OPEN_WITH_APP);
+        assert_item_drop_for_file ("Unloaded.rtfd (not loaded)", package, NAUTILUS_DND_ITEM_DROP_REFUSE);
+        assert_item_drop_for_file ("Unloaded Folder (not loaded)", folder, NAUTILUS_DND_ITEM_DROP_DEFAULT);
+
+        nautilus_file_unref (app);
+        nautilus_file_unref (package);
+        nautilus_file_unref (folder);
+    }
+
+    g_slist_free_full (g_steal_pointer (&document), g_object_unref);
+    g_slist_free_full (g_steal_pointer (&documents), g_object_unref);
+    g_slist_free_full (g_steal_pointer (&text), g_object_unref);
+    g_slist_free_full (g_steal_pointer (&mixed), g_object_unref);
+    g_slist_free_full (g_steal_pointer (&itself), g_object_unref);
+    g_slist_free_full (g_steal_pointer (&remote), g_object_unref);
