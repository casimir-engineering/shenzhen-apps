diff --git a/test/display/test-macos-sidebar.c b/test/display/test-macos-sidebar.c
new file mode 100644
index 0000000..1a48df3
--- /dev/null
+++ b/test/display/test-macos-sidebar.c
@@ -0,0 +1,180 @@
+#define G_LOG_DOMAIN "test-macos-sidebar"
+
+#include <nautilus-application.h>
+#include <nautilus-file-utilities.h>
+#include <nautilus-global-preferences.h>
+#include <nautilus-macos-bridge.h>
+#include <nautilus-resources.h>
+#include <nautilus-sidebar.h>
+#include <nautilus-tag-manager.h>
+#include <nautilus-window.h>
+
+#include <glib.h>
+#include <gtk/gtk.h>
+
+static NautilusApplication *test_application;
+
+static void
+test_sidebar_shows_mounted_volumes (void)
+{
+    g_autoptr (NautilusSidebar) sidebar = NAUTILUS_PLACES_SIDEBAR (nautilus_sidebar_new ());
+    GList *volumes = nautilus_macos_get_mounted_volumes ();
+
+    g_object_ref_sink (sidebar);
+    g_assert_nonnull (volumes);
+
+    for (GList *l = volumes; l != NULL; l = l->next)
+    {
+        NautilusMacosMountedVolume *volume = l->data;
+        g_autoptr (GFile) location = g_file_new_for_path (volume->path);
+        g_autoptr (GFile) selected = NULL;
+
+        nautilus_sidebar_set_location (sidebar, location);
+        selected = nautilus_sidebar_get_location (sidebar);
+        g_assert_nonnull (selected);
+        g_assert_true (g_file_equal (selected, location));
+    }
+
+    g_list_free_full (volumes, (GDestroyNotify) nautilus_macos_mounted_volume_free);
+}
+
+typedef struct
+{
+    GMainLoop *loop;
+    gboolean prepared;
+    GError *error;
+} PrepareResult;
+
+static void
+prepare_finished_cb (GObject      *source_object,
+                     GAsyncResult *result,
+                     gpointer      user_data)
+{
+    PrepareResult *prepare_result = user_data;
+
+    prepare_result->prepared =
+        nautilus_application_prepare_location_for_unmount_finish (
+            NAUTILUS_APPLICATION (source_object),
+            result,
+            &prepare_result->error);
+    g_main_loop_quit (prepare_result->loop);
+}
+
+static void
+assert_window_is_idle_at_home (NautilusWindow *window,
+                               guint           expected_tabs)
+{
+    g_autoptr (GFile) home = g_file_new_for_path (g_get_home_dir ());
+    GList *locations = nautilus_window_get_locations (window);
+
+    g_assert_cmpuint (g_list_length (locations), ==, expected_tabs);
+    for (GList *l = locations; l != NULL; l = l->next)
+    {
+        g_assert_true (g_file_equal (l->data, home));
+    }
+
+    g_list_free (locations);
+}
+
+static void
+test_prepare_tabs_and_eject_disposable_volume (void)
+{
+    const char *volume_path = g_getenv ("NAUTILUS_TEST_EJECT_VOLUME");
+    g_autoptr (GFile) volume_root = NULL;
+    g_autoptr (GFile) first_folder = NULL;
+    g_autoptr (GFile) second_folder = NULL;
+    g_autoptr (NautilusWindow) first_window = NULL;
+    g_autoptr (NautilusWindow) second_window = NULL;
+    g_autoptr (GError) error = NULL;
+    PrepareResult result = { 0 };
+
+    if (volume_path == NULL)
+    {
+        g_test_skip ("Set NAUTILUS_TEST_EJECT_VOLUME to a disposable mounted volume");
+        return;
+    }
+
+    g_assert_true (g_file_test (volume_path, G_FILE_TEST_IS_DIR));
+    volume_root = g_file_new_for_path (volume_path);
+    first_folder = g_file_get_child (volume_root, "first");
+    second_folder = g_file_get_child (volume_root, "second");
+    g_assert_true (g_file_make_directory (first_folder, NULL, &error));
+    g_assert_no_error (error);
+    g_assert_true (g_file_make_directory (second_folder, NULL, &error));
+    g_assert_no_error (error);
+
+    first_window = nautilus_application_create_window (test_application);
+    second_window = nautilus_application_create_window (test_application);
+    g_object_ref_sink (first_window);
+    g_object_ref_sink (second_window);
+
+    nautilus_window_open_location_full (first_window,
+                                        volume_root,
+                                        NAUTILUS_OPEN_FLAG_NORMAL,
+                                        NULL);
+    nautilus_window_open_location_full (first_window,
+                                        first_folder,
+                                        NAUTILUS_OPEN_FLAG_NEW_TAB |
+                                        NAUTILUS_OPEN_FLAG_DONT_MAKE_ACTIVE,
+                                        NULL);
+    nautilus_window_open_location_full (second_window,
+                                        second_folder,
+                                        NAUTILUS_OPEN_FLAG_NORMAL,
+                                        NULL);
+    nautilus_window_open_location_full (second_window,
+                                        volume_root,
+                                        NAUTILUS_OPEN_FLAG_NEW_TAB |
+                                        NAUTILUS_OPEN_FLAG_DONT_MAKE_ACTIVE,
+                                        NULL);
+
+    result.loop = g_main_loop_new (NULL, FALSE);
+    nautilus_application_prepare_location_for_unmount_async (
+        test_application,
+        volume_root,
+        NULL,
+        prepare_finished_cb,
+        &result);
+    g_main_loop_run (result.loop);
+    g_main_loop_unref (result.loop);
+
+    g_assert_no_error (result.error);
+    g_assert_true (result.prepared);
+    assert_window_is_idle_at_home (first_window, 2);
+    assert_window_is_idle_at_home (second_window, 2);
+
+    g_assert_true (nautilus_macos_unmount_volume (volume_path, &error));
+    g_assert_no_error (error);
+    g_assert_false (g_file_test (volume_path, G_FILE_TEST_EXISTS));
+
+    gtk_window_destroy (GTK_WINDOW (first_window));
+    gtk_window_destroy (GTK_WINDOW (second_window));
+}
+
+int
+main (int   argc,
+      char *argv[])
+{
+    g_autoptr (NautilusTagManager) tag_manager = NULL;
+    g_autoptr (GError) error = NULL;
+
+    gtk_test_init (&argc, &argv, G_TEST_OPTION_ISOLATE_DIRS, NULL);
+    nautilus_register_resource ();
+    nautilus_ensure_extension_points ();
+    nautilus_global_preferences_init ();
+    tag_manager = nautilus_tag_manager_new_dummy ();
+
+    g_autoptr (NautilusApplication) app = nautilus_application_new ();
+    g_application_set_flags (G_APPLICATION (app),
+                             g_application_get_flags (G_APPLICATION (app)) |
+                             G_APPLICATION_NON_UNIQUE);
+    g_assert_true (g_application_register (G_APPLICATION (app), NULL, &error));
+    g_assert_no_error (error);
+    test_application = app;
+
+    g_test_add_func ("/macos-sidebar/shows-mounted-volumes",
+                     test_sidebar_shows_mounted_volumes);
+    g_test_add_func ("/macos-sidebar/prepare-tabs-and-eject-disposable-volume",
+                     test_prepare_tabs_and_eject_disposable_volume);
+
+    return g_test_run ();
+}
diff --git a/test/displayless/macos-test-marker-app.m b/test/displayless/macos-test-marker-app.m
new file mode 100644
index 0000000..d207aef
--- /dev/null
+++ b/test/displayless/macos-test-marker-app.m
@@ -0,0 +1,66 @@
+/*
+ * macos-test-marker-app.m: the executable of the throwaway application
+ * bundles test-macos-apps-archives builds.  It shows nothing (its bundles are
+ * LSBackgroundOnly): it appends what it was asked to do to "<bundle>.marker"
+ * next to its bundle, then quits.
+ *
+ *   launched <pid>
+ *   open <path>          one line per document LaunchServices handed it
+ */
+
+#import <AppKit/AppKit.h>
+
+#include <stdio.h>
+#include <unistd.h>
+
+static void
+append_marker_line (NSString *line)
+{
+    NSString *marker = [[[NSBundle mainBundle] bundlePath] stringByAppendingString:@".marker"];
+    FILE *file = fopen ([marker fileSystemRepresentation], "a");
+
+    if (file != NULL)
+    {
+        fprintf (file, "%s\n", [line UTF8String]);
+        fclose (file);
+    }
+}
+
+@interface MarkerDelegate : NSObject <NSApplicationDelegate>
+@end
+
+@implementation MarkerDelegate
+
+- (void)application:(NSApplication *)application
+           openURLs:(NSArray<NSURL *> *)urls
+{
+    for (NSURL *url in urls)
+    {
+        append_marker_line ([@"open " stringByAppendingString:[url path]]);
+    }
+}
+
+- (void)applicationDidFinishLaunching:(NSNotification *)notification
+{
+    append_marker_line ([NSString stringWithFormat:@"launched %d", getpid ()]);
+    /* Documents may still be on their way when launching finishes. */
+    [NSApp performSelector:@selector (terminate:) withObject:nil afterDelay:1.5];
+}
+
+@end
+
+int
+main (int   argc,
+      char *argv[])
+{
+    @autoreleasepool
+    {
+        NSApplication *application = [NSApplication sharedApplication];
+        MarkerDelegate *delegate = [[MarkerDelegate alloc] init];
+
+        [application setDelegate:delegate];
+        [application run];
+    }
+
+    return 0;
+}
