+static void
+test_archive_mime_types (void)
+{
+    static const struct
+    {
+        const char *content_type;
+        const char *mime_type;
+    } expected[] = {
+        { "public.zip-archive", "application/zip" },
+        { "org.gnu.gnu-zip-archive", "application/gzip" },
+        { "public.bzip2-archive", "application/x-bzip" },
+        { "org.gnu.gnu-zip-tar-archive", "application/x-compressed-tar" },
+        { "public.tar-bzip2-archive", "application/x-bzip-compressed-tar" },
+        { "org.tukaani.tar-xz-archive", "application/x-xz-compressed-tar" },
+        { "com.rarlab.rar-archive", "application/vnd.rar" },
+        { "org.7-zip.7-zip-archive", "application/x-7z-compressed" },
+        { "application/zip", "application/zip" },
+    };
+
+    for (gsize i = 0; i < G_N_ELEMENTS (expected); i++)
+    {
+        g_auto (GStrv) mime_types = nautilus_macos_content_type_get_mime_types (expected[i].content_type);
+
+        if (!g_strv_contains ((const char * const *) mime_types, expected[i].mime_type))
+        {
+            g_autofree char *got = g_strjoinv (", ", mime_types);
+
+            g_error ("%s: expected %s among [%s]", expected[i].content_type,
+                     expected[i].mime_type, got);
+        }
+    }
+
+    /* Before the fix autoar was asked about the UTI itself, which it never
+     * recognises: this is why no archive offered Extract. */
+    g_assert_false (autoar_check_mime_type_supported ("public.zip-archive"));
+
+    /* Exact types only: a zip-based document is not an archive. */
+    {
+        g_auto (GStrv) docx = nautilus_macos_content_type_get_mime_types ("org.openxmlformats.wordprocessingml.document");
+
+        g_assert_false (g_strv_contains ((const char * const *) docx, "application/zip"));
+    }
+    {
+        g_auto (GStrv) none = nautilus_macos_content_type_get_mime_types (NULL);
+
+        g_assert_nonnull (none);
+        g_assert_null (none[0]);
+    }
+}
