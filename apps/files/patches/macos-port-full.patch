+typedef enum
+{
+    DECISION_LAUNCH_APP,       /* opening launches the app */
+    DECISION_OPEN_PACKAGE,     /* opening hands the package to its app */
+    DECISION_BROWSE,           /* opening shows the folder's contents */
+    DECISION_OPEN_WITH_APP,    /* opening uses the default app */
+    DECISION_EXTRACT,          /* opening extracts (Nautilus is the default app) */
+} Decision;
+
+static void
+assert_decision (const char *name,
+                 Decision    expected)
+{
+    g_autofree char *path = fixture_path (name);
+    NautilusFile *file = load_file (path);
+    gboolean package = nautilus_mime_file_opens_macos_package (file);
+    gboolean application = nautilus_file_is_macos_application (file);
+    gboolean browses = nautilus_file_opens_in_view (file);
+    gboolean extracts = nautilus_mime_file_extracts (file);
+    gboolean external = nautilus_mime_file_opens_in_external_app (file);
+
+    g_test_message ("%s: package=%d application=%d browses=%d extracts=%d external=%d "
+                    "launches=%d archive=%d", name, package, application, browses,
+                    extracts, external, nautilus_mime_file_launches (file),
+                    nautilus_file_is_archive (file));
+
+    /* Exactly one way of opening. */
+    g_assert_cmpint (package + browses + extracts + external, ==, 1);
+    g_assert_false (nautilus_mime_file_launches (file));
+
+    switch (expected)
+    {
+        case DECISION_LAUNCH_APP:
+        {
+            g_assert_true (package);
+            g_assert_true (application);
+        }
+        break;
+
+        case DECISION_OPEN_PACKAGE:
+        {
+            g_assert_true (package);
+            g_assert_false (application);
+        }
+        break;
+
+        case DECISION_BROWSE:
+        {
+            g_assert_true (browses);
+        }
+        break;
+
+        case DECISION_OPEN_WITH_APP:
+        {
+            g_assert_true (external);
+        }
+        break;
+
+        case DECISION_EXTRACT:
+        {
+            g_assert_true (extracts);
+        }
+        break;
+    }
+
+    /* The files view enables "Show Package Contents" exactly for packages,
+     * and never offers to extract one. */
+    g_assert_cmpint (nautilus_file_is_macos_package (file), ==, package);
+    if (package)
+    {
+        g_assert_false (nautilus_file_is_archive (file));
+    }
+
+    nautilus_file_unref (file);
+}
+
+/* An archive keeps doing what the Mac is set up to do on double-click: open
+ * with its default app (Archive Utility, unless the owner chose another), or
+ * extract it when that default app is Shenzhen Files. */
+static Decision
+archive_decision (const char *name)
+{
+    g_autofree char *path = fixture_path (name);
+    NautilusFile *file = load_file (path);
+    g_autoptr (GAppInfo) app = nautilus_mime_get_default_application_for_file (file);
+    gboolean is_self = app != NULL && nautilus_macos_app_id_is_self (g_app_info_get_id (app));
+
+    g_test_message ("default app for %s: %s", name,
+                    app != NULL ? g_app_info_get_id (app) : "(none)");
+    nautilus_file_unref (file);
+
+    return is_self ? DECISION_EXTRACT : DECISION_OPEN_WITH_APP;
+}
+
+static void
+test_activation_decision (void)
+{
+    assert_decision ("Decision.app", DECISION_LAUNCH_APP);
+    assert_decision ("Märker Drei 三.app", DECISION_LAUNCH_APP);
+    assert_decision ("Link to Decision", DECISION_LAUNCH_APP);
+    assert_decision ("Empty.app", DECISION_LAUNCH_APP);
+    assert_decision ("Doc.rtfd", DECISION_OPEN_PACKAGE);
+    assert_decision ("Thing.bundle", DECISION_OPEN_PACKAGE);
+    assert_decision ("Lib.photoslibrary", DECISION_OPEN_PACKAGE);
+    assert_decision ("Plain Folder", DECISION_BROWSE);
+    assert_decision ("Fw.framework", DECISION_BROWSE);
+    assert_decision ("folder.with.dots", DECISION_BROWSE);
+    assert_decision ("Ünïcode Földer 文件夹", DECISION_BROWSE);
+    assert_decision ("notes.txt", DECISION_OPEN_WITH_APP);
+    assert_decision ("Archive.zip", archive_decision ("Archive.zip"));
+    assert_decision ("Archive.tar.gz", archive_decision ("Archive.tar.gz"));
+    assert_decision ("Résumé 文件 2.7z", archive_decision ("Résumé 文件 2.7z"));
+}
