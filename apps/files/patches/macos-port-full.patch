+/* The fixtures named in the NULL-terminated arguments, as the GFile list a
+ * drop carries. */
+static GSList *
+dropped_files (const char *first,
+               ...)
+{
+    GSList *files = NULL;
+    va_list args;
+
+    va_start (args, first);
+    for (const char *name = first; name != NULL; name = va_arg (args, const char *))
+    {
+        if (strstr (name, "://") != NULL)
+        {
+            files = g_slist_prepend (files, g_file_new_for_uri (name));
+        }
+        else
+        {
+            g_autofree char *path = fixture_path (name);
+
+            files = g_slist_prepend (files, g_file_new_for_path (path));
+        }
+    }
+    va_end (args);
+
+    return g_slist_reverse (files);
+}
