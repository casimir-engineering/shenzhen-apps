+/* The local paths of @dropped, without @app_path itself: what dropping them
+ * onto the app opens.  NULL-terminated. */
+static GPtrArray *
+paths_to_open_with_app (const char   *app_path,
+                        const GSList *dropped)
+{
+    GPtrArray *paths = g_ptr_array_new_with_free_func (g_free);
+
+    for (const GSList *l = dropped; l != NULL; l = l->next)
+    {
+        g_autoptr (GFile) file = file_with_repaired_uri (l->data);
+        char *path = g_file_get_path (file);
+
+        if (path != NULL && g_strcmp0 (path, app_path) != 0)
+        {
+            g_ptr_array_add (paths, path);
+        }
+        else
+        {
+            g_free (path);
+        }
+    }
+    g_ptr_array_add (paths, NULL);
+
+    return paths;
+}
+
+/* What each app answered for the drag in progress, so LaunchServices
+ * (about 0.1 ms per file) is not asked again on every pointer motion: the
+ * sidebar asks about every row on each motion, and with several app
+ * bookmarks a single remembered answer was replaced on every call.  An
+ * answer is kept for a second, and all of them are dropped when the drag
+ * ends (nautilus_dnd_item_drag_ended()) or other files are dragged. */
+typedef struct
+{
+    gboolean accepts;
+    gint64 time;                /* g_get_monotonic_time () when asked */
+} AppAnswer;
+
+static char *app_answers_drop;      /* the dropped URIs, one per line */
+static GHashTable *app_answers;     /* app path -> AppAnswer */
+
+void
+nautilus_dnd_item_drag_ended (void)
+{
+    g_clear_pointer (&app_answers, g_hash_table_unref);
+    g_clear_pointer (&app_answers_drop, g_free);
+}
+
+/* Whether the app @app_file takes the drop @dropped: every dropped file is
+ * local, is not the app itself, and is a file the app declares it opens. */
+static gboolean
+app_accepts_dropped (NautilusFile *app_file,
+                     const GSList *dropped)
+{
+    g_autoptr (GFile) app_location = nautilus_file_get_activation_location (app_file);
+    const char *app_path = g_file_peek_path (app_location);
+    g_autoptr (GPtrArray) paths = NULL;
+    g_autoptr (GString) drop = NULL;
+    AppAnswer *answer;
+    guint length = 0;
+    gint64 now = g_get_monotonic_time ();
+
+    if (app_path == NULL || dropped == NULL)
+    {
+        return FALSE;
+    }
+
+    drop = g_string_new (NULL);
+    for (const GSList *l = dropped; l != NULL; l = l->next, length++)
+    {
+        g_autofree char *uri = g_file_get_uri (l->data);
+
+        g_string_append (drop, uri);
+        g_string_append_c (drop, '\n');
+    }
+
+    if (app_answers_drop == NULL || !g_str_equal (app_answers_drop, drop->str))
+    {
+        nautilus_dnd_item_drag_ended ();
+        app_answers_drop = g_string_free (g_steal_pointer (&drop), FALSE);
+        app_answers = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_free);
+    }
+
+    answer = g_hash_table_lookup (app_answers, app_path);
+    if (answer != NULL && now - answer->time < G_USEC_PER_SEC)
+    {
+        return answer->accepts;
+    }
+
+    if (answer == NULL)
+    {
+        answer = g_new0 (AppAnswer, 1);
+        g_hash_table_insert (app_answers, g_strdup (app_path), answer);
+    }
+
+    paths = paths_to_open_with_app (app_path, dropped);
+    answer->time = now;
+    /* A file that is not local, or the app itself, is not opened: the drop
+     * is refused rather than opening only some of the files. */
+    answer->accepts = paths->len - 1 == length &&
+                      nautilus_macos_application_accepts_files (app_path,
+                                                                (const char *const *) paths->pdata);
+
+    return answer->accepts;
+}
+
+GdkDragAction
+nautilus_dnd_get_item_preferred_action (NautilusFile *target_file,
+                                        const GSList *dropped)
+{
+    g_return_val_if_fail (NAUTILUS_IS_FILE (target_file), 0);
+
+    switch (nautilus_dnd_get_item_drop (target_file))
+    {
+        case NAUTILUS_DND_ITEM_DROP_OPEN_WITH_APP:
+        {
+            /* Until the files are known (a drop from another app), offer
+             * the drop; the files decide when they arrive. */
+            if (dropped == NULL || app_accepts_dropped (target_file, dropped))
+            {
+                return GDK_ACTION_COPY;
+            }
+            return 0;
+        }
+
+        case NAUTILUS_DND_ITEM_DROP_REFUSE:
+        {
+            return 0;
+        }
+
+        case NAUTILUS_DND_ITEM_DROP_DEFAULT:
+        default:
+        {
+            return nautilus_dnd_get_preferred_action (target_file,
+                                                      dropped != NULL ? dropped->data : NULL);
+        }
+    }
+}
+
+typedef struct
+{
+    GWeakRef parent;
+    char *first_name;
+    guint n_files;
+} OpenWithAppData;
+
+static void
+open_with_app_data_free (gpointer user_data)
+{
+    OpenWithAppData *data = user_data;
+
+    g_weak_ref_clear (&data->parent);
+    g_free (data->first_name);
+    g_free (data);
+}
+
+static void
+on_opened_with_app (const char *app_path,
+                    GError     *error,
+                    gpointer    user_data)
+{
+    OpenWithAppData *data = user_data;
+    g_autoptr (GtkWidget) parent = NULL;
+    g_autofree char *app_name = NULL;
+    g_autofree char *heading = NULL;
+
+    /* Cancelled: the user declined a macOS prompt, such as the one shown
+     * before an app downloaded from the internet first opens. */
+    if (error == NULL || g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    {
+        return;
+    }
+
+    parent = g_weak_ref_get (&data->parent);
+    app_name = g_filename_display_basename (app_path);
+    if (data->n_files == 1)
+    {
+        heading = g_strdup_printf (_("Unable to open “%s” with “%s”"), data->first_name, app_name);
+    }
+    else
+    {
+        heading = g_strdup_printf (ngettext ("Unable to open %u item with “%s”",
+                                             "Unable to open %u items with “%s”",
+                                             data->n_files),
+                                   data->n_files, app_name);
+    }
+
+    nautilus_show_ok_dialog (heading, error->message, parent);
+}
+
+gboolean
+nautilus_dnd_open_with_app (NautilusFile *app_file,
+                            const GSList *dropped,
+                            GtkWidget    *parent)
+{
+    g_autoptr (GFile) app_location = NULL;
+    g_autoptr (GPtrArray) paths = NULL;
+    const char *app_path;
+    OpenWithAppData *data;
+
+    g_return_val_if_fail (NAUTILUS_IS_FILE (app_file), FALSE);
+
+    app_location = nautilus_file_get_activation_location (app_file);
+    app_path = g_file_peek_path (app_location);
+    if (app_path == NULL)
+    {
+        return FALSE;
+    }
+
+    paths = paths_to_open_with_app (app_path, dropped);
+    if (paths->len == 1)
+    {
+        return FALSE;
+    }
+
+    data = g_new0 (OpenWithAppData, 1);
+    g_weak_ref_init (&data->parent, parent);
+    data->first_name = g_filename_display_basename (g_ptr_array_index (paths, 0));
+    data->n_files = paths->len - 1;
+
+    g_debug ("Opening %u dropped files with %s", data->n_files, app_path);
+    nautilus_macos_open_with_application (app_path, (const char *const *) paths->pdata,
+                                          on_opened_with_app, data, open_with_app_data_free);
+
+    return TRUE;
+}
