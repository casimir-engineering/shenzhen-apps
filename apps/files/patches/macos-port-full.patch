+ * ============================================================================
+ * PHASE 3 CONTRACT — READ docs/phase3-conventions.md BEFORE EDITING
+ *
+ * This header is the single shared seam between Nautilus C code and the
+ * Objective-C bridge files (src/nautilus-macos-*.m, darwin-only).
+ *
+ * Rules:
+ *   - Pure C prototypes only. No Objective-C types may appear here.
+ *     GLib / GdkPixbuf / GdkTexture types are OK.
+ *   - APPEND-ONLY, and only inside your own worker section below. Never
+ *     reorder, rename, or edit another worker's section.
+ *   - Implementations live in the matching .m file; every non-static
+ *     function in a .m file must be declared here (missing-prototypes).
+ * ============================================================================
+ */
+
+#pragma once
+
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <gio/gio.h>
+#include <glib.h>
+
+G_BEGIN_DECLS
+
+/* ==========================================================================
+ * Section W1 — Menu bar & LaunchServices (nautilus-macos-menu.m)
+ * ========================================================================== */
+
+/* Placeholder seam. The native menu bar is expected to come from
+ * gtk_application_set_menubar() on the GTK side; this exists so W1 has a
+ * bridge file if any NSApplication/NSMenu-level tweaking turns out to be
+ * needed. Currently a no-op. */
+void nautilus_macos_menu_init (void);
+
+/* Insert a native "Check Permissions…" NSMenuItem into the application
+ * (app-name) menu — the bold "Nautilus" menu AppKit synthesizes, which
+ * GTK's quartz backend builds from a fixed template with no GMenu
+ * extension point. The item activates the app.fda-prompt GAction (the
+ * Full Disk Access check-and-prompt flow). Insertion is deferred until
+ * the menubar exists and is idempotent (safe to call more than once).
+ * Called from nautilus_macos_menu_init(); exposed for completeness. */
+void nautilus_macos_menu_add_check_permissions_item (void);
+
+/* Finder-like Dock lifecycle: adds an
+ * applicationShouldHandleReopen:hasVisibleWindows: implementation to GTK's
+ * NSApplicationDelegate (which does not implement it) so that clicking the
+ * Dock icon while the app is running with no windows activates the
+ * GApplication (opens a new browser window at $HOME). Must be called after
+ * GtkApplication::startup chained up (the delegate is installed there).
+ * Idempotent; degrades to a warning if the delegate is missing. */
+void nautilus_macos_lifecycle_install_reopen_handler (void);
+
+/* Cold-launch first-window placement: GDK's own placement picks the wrong
+ * monitor on multi-display setups (it feeds AppKit bottom-left mouse coords
+ * into a GDK top-left-coords lookup), so the first window of a fresh process
+ * is centered on the screen under the mouse at launch time — same rule as
+ * the Dock-reopen path. capture() must run early in startup (stores the
+ * target screen's visibleFrame); apply() takes the new GtkWindow* (as
+ * gpointer to keep this header GTK-free) and is one-shot: only the first
+ * window of the process is repositioned, and only if not maximized or
+ * fullscreen. */
+void nautilus_macos_launch_placement_capture (void);
+void nautilus_macos_launch_placement_apply (gpointer window);
+
+/* ==========================================================================
+ * End section W1
+ * ========================================================================== */
+
+/* ==========================================================================
+ * Section W2 — Selection actions: Trash / Open With / QuickLook preview
+ * (nautilus-macos-trash.m, nautilus-macos-openwith.m,
+ *  nautilus-macos-previewer.m)
+ * ========================================================================== */
+
+/* --- Trash (nautilus-macos-trash.m) --- */
+
+/* Reveal Finder's Trash window (v1 stand-in for browsing trash:///).
+ * Returns TRUE on success. Stub: logs and returns FALSE. */
+gboolean nautilus_macos_trash_open_in_finder (void);
+
+/* Move a native file into the Trash managed by macOS/Finder. Unlike GIO's
+ * Unix trash implementation, this uses NSFileManager so the item appears in
+ * Finder's Trash (including the appropriate per-volume Trash). */
+gboolean nautilus_macos_trash_file (GFile         *file,
+                                    GCancellable  *cancellable,
+                                    GError       **error);
+
+/* Where nautilus_macos_trash_file() last put @original in this session, or
+ * NULL. macOS has no trash:/// listing that names an item's original path,
+ * so undoing Move to Trash finds the item through this. Transfer full. */
+GFile *nautilus_macos_trash_lookup (GFile *original);
+
+/* --- Open With (nautilus-macos-openwith.m) --- */
+
+/* One application capable of opening a given file, as reported by
+ * LaunchServices/NSWorkspace. */
+typedef struct
+{
+    char *display_name;     /* e.g. "Preview" */
+    char *bundle_url;       /* file:// URL of the .app bundle */
+    gboolean is_default;    /* TRUE for the LaunchServices default app */
+} NautilusMacosAppCandidate;
+
+void nautilus_macos_app_candidate_free (NautilusMacosAppCandidate *candidate);
+
+/* Returns a GList of NautilusMacosAppCandidate* for the file at @path
+ * (a local filesystem path, not a URI), default app first. Free with
+ * g_list_free_full (list, (GDestroyNotify) nautilus_macos_app_candidate_free).
+ * Stub: logs and returns NULL. */
+GList *nautilus_macos_get_apps_for_file (const char *path);
+
+/* Open the file at @path with the application bundle at @app_url (a
+ * file:// URL as returned in NautilusMacosAppCandidate.bundle_url).
+ * Returns TRUE if the launch was dispatched. Stub: logs, returns FALSE. */
+gboolean nautilus_macos_open_file_with (const char *path,
+                                        const char *app_url);
+
+/* Reveal @path in a Finder window (activateFileViewerSelectingURLs:).
+ * Returns TRUE on success. Stub: logs and returns FALSE. */
+gboolean nautilus_macos_show_in_finder (const char *path);
+
+/* --- QuickLook preview panel (nautilus-macos-previewer.m) --- */
+
+/* Show the QLPreviewPanel for @uris (NULL-terminated array of file URIs),
+ * initially displaying the item at @selected_index. Replaces the panel's
+ * contents if it is already visible. Stub: logs and does nothing. */
+void nautilus_macos_preview_files (const char *const *uris,
+                                   int                selected_index);
+
+/* Hide the QLPreviewPanel if visible. Stub: no-op. */
+void nautilus_macos_preview_hide (void);
+
+/* TRUE if the QLPreviewPanel is currently visible. Stub: returns FALSE. */
+gboolean nautilus_macos_preview_is_showing (void);
+
+/* Reveal several files at once in a Finder window
+ * (activateFileViewerSelectingURLs:). @paths is a NULL-terminated array of
+ * local filesystem paths. Returns TRUE if the reveal was dispatched. */
+gboolean nautilus_macos_show_in_finder_files (const char *const *paths);
+
+/* Direction of a keyboard-navigation event received by the QuickLook panel
+ * (so the file view can move its selection like Finder does). Mirrors
+ * GtkDirectionType without leaking GTK types into the bridge. */
+typedef enum
+{
+    NAUTILUS_MACOS_PREVIEW_DIRECTION_UP,
+    NAUTILUS_MACOS_PREVIEW_DIRECTION_DOWN,
+    NAUTILUS_MACOS_PREVIEW_DIRECTION_LEFT,
+    NAUTILUS_MACOS_PREVIEW_DIRECTION_RIGHT,
+} NautilusMacosPreviewDirection;
+
+/* Called on the GLib/AppKit main thread whenever the user presses an arrow
+ * key while the QLPreviewPanel is frontmost. */
+typedef void (*NautilusMacosPreviewSelectionFunc) (NautilusMacosPreviewDirection direction,
+                                                   gpointer                      user_data);
+
+/* Register the (single) selection-navigation callback. Pass NULL to unset. */
+void nautilus_macos_preview_set_selection_callback (NautilusMacosPreviewSelectionFunc callback,
+                                                    gpointer                          user_data);
+
+/* --- App icons (nautilus-macos-openwith.m; appended by the integrator) --- */
+
+#include <gdk/gdk.h>    /* GdkTexture (C API only) */
+
+/* Render the LaunchServices icon of the app bundle at @app_path (a native
+ * path or file:// URL) into a @size_px × @size_px texture. Bridges the gap
+ * left by gdk-pixbuf, which cannot decode modern .icns files. Returns a new
+ * GdkTexture reference, or NULL if the icon cannot be rendered. */
+GdkTexture *nautilus_macos_app_icon_texture (const char *app_path,
+                                             int         size_px);
+
+/* ==========================================================================
+ * End section W2
+ * ========================================================================== */
+
+/* ==========================================================================
+ * Section W3 — QuickLook thumbnails (nautilus-macos-thumbnailer.m)
+ *
+ * Backend for the seam in nautilus-thumbnails-macos.c
+ * (backend_can_thumbnail / backend_generate_async).
+ * ========================================================================== */
+
+/* Delivered on the GLib main loop. @pixbuf is a new reference (or NULL on
+ * failure, in which case @error is set); @error is owned by the bridge and
+ * valid only for the duration of the call. */
+typedef void (*NautilusMacosThumbnailCallback) (GdkPixbuf *pixbuf,
+                                                GError    *error,
+                                                gpointer   user_data);
+
+/* TRUE if QuickLook can plausibly thumbnail the file at @path with MIME
+ * type @mime_type. Stub: returns FALSE. */
+gboolean nautilus_macos_thumbnail_can_thumbnail (const char *path,
+                                                 const char *mime_type);
+
+/* Generate a thumbnail of at most @size pixels (longest edge, in device
+ * pixels) for the file at @path. @callback is always invoked exactly once,
+ * from a main-loop idle. Stub: calls back with NULL + G_IO_ERROR_NOT_SUPPORTED. */
+void nautilus_macos_thumbnail_generate_async (const char                     *path,
+                                              int                             size,
+                                              NautilusMacosThumbnailCallback  callback,
+                                              gpointer                        user_data);
+
+/* Instrumentation for tests/benchmarks (main thread only): current number
+ * of in-flight QuickLook requests, requests waiting in the FIFO, and the
+ * peak in-flight count since startup. Any out-parameter may be NULL. */
+void nautilus_macos_thumbnail_debug_stats (guint *out_in_flight,
+                                           guint *out_queued,
+                                           guint *out_peak_in_flight);
+
+/* ==========================================================================
+ * End section W3
+ * ========================================================================== */
+
+/* ==========================================================================
+ * Section W4 — Spotlight search (nautilus-macos-spotlight.m)
+ *
+ * NSMetadataQuery-backed provider used by nautilus-search-engine-spotlight.c.
+ * ========================================================================== */
+
+/* Opaque handle for one running Spotlight query. */
+typedef struct _NautilusMacosSpotlightQuery NautilusMacosSpotlightQuery;
+
+/* Called once per hit, on the GLib main loop. @path is a local filesystem
+ * path; valid only for the duration of the call. @mtime/@atime/@ctime are
+ * Unix timestamps taken from the Spotlight index (content-change,
+ * last-used and creation dates); 0 means "unknown". They are passed here
+ * so the consumer does not need an extra stat per hit. */
+typedef void (*NautilusMacosSpotlightHitFunc) (const char *path,
+                                               gint64      mtime,
+                                               gint64      atime,
+                                               gint64      ctime,
+                                               gpointer    user_data);
+
+/* Called exactly once when the query finishes or is stopped. @error is
+ * NULL on success (including "stopped"), otherwise owned by the bridge and
+ * valid only for the duration of the call. */
+typedef void (*NautilusMacosSpotlightFinishedFunc) (GError   *error,
+                                                    gpointer  user_data);
+
+/* Start a Spotlight (NSMetadataQuery) search for @query_text scoped to the
+ * directory @scope_path (recursive). Returns a handle, or NULL if the
+ * backend is unavailable (callers must then fall back to another engine;
+ * no callbacks will be delivered). Stub: logs and returns NULL. */
+NautilusMacosSpotlightQuery *nautilus_macos_spotlight_query_start (const char                         *query_text,
+                                                                   const char                         *scope_path,
+                                                                   NautilusMacosSpotlightHitFunc       hit_func,
+                                                                   NautilusMacosSpotlightFinishedFunc  finished_func,
+                                                                   gpointer                            user_data);
+
+/* Stop @query and release it. Safe to call with NULL. No callbacks are
+ * delivered after this returns (the finished callback, if still pending,
+ * fires before or during this call). Stub: no-op. */
+void nautilus_macos_spotlight_query_stop (NautilusMacosSpotlightQuery *query);
+
+/* ==========================================================================
+ * End section W4
+ * ========================================================================== */
+
+/* ==========================================================================
+ * Section W5 — Finder drag & drop (reserved)
+ *
+ * No bridge entry points yet: GTK4's macOS backend is expected to handle
+ * pasteboard interop. W5 appends here if native pasteboard access is needed.
+ * ========================================================================== */
+
+/* ==========================================================================
+ * End section W5
+ * ========================================================================== */
+
+/* ==========================================================================
+ * Section W6 — Full Disk Access onboarding (nautilus-macos-fda.m)
+ *
+ * First-launch prompt asking the user to grant Full Disk Access (FDA),
+ * mirroring shenzhen-pdf's flow. FDA unlocks ~/.Trash browsing (TCC-blocked
+ * otherwise) and Desktop/Documents/Downloads without per-folder prompts.
+ * ========================================================================== */
+
+#include <gtk/gtk.h>    /* GtkWindow, for the dialog parent (C API, W6 only) */
+
+/* TRUE if this process can currently read TCC-protected locations that only
+ * Full Disk Access unlocks (probes TCC.db / ~/.Trash / ~/Library/Safari).
+ *
+ * CAVEAT (dev vs bundle): TCC checks the RESPONSIBLE PROCESS. Run from a
+ * terminal or IDE, this reports the terminal/IDE's own FDA grant, not
+ * "Nautilus"'s. It is truthful for the final .app bundle launched via
+ * Finder/LaunchServices. */
+gboolean nautilus_macos_fda_is_granted (void);
+
+/* Open System Settings on Privacy & Security → Full Disk Access
+ * (x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles). */
+void nautilus_macos_fda_open_settings (void);
+
+/* TRUE when the launch prompt should be shown: FDA not granted AND the user
+ * has not previously chosen "Don't Ask Again". State lives in a keyfile at
+ * $XDG_CONFIG_HOME/nautilus/macos-fda.ini (no GSettings schema). */
+gboolean nautilus_macos_fda_should_prompt_on_launch (void);
+
+/* Persist the "Don't Ask Again" choice (sets the dismissed flag in the
+ * keyfile). Called by the dialog; exposed for completeness/testing. */
+void nautilus_macos_fda_set_prompt_dismissed (void);
+
+/* Present the FDA prompt as an AdwAlertDialog attached to @parent (may be
+ * NULL for a standalone window). If FDA is not granted: explains why
+ * Nautilus wants it, with "Open System Settings…" / "Not Now" /
+ * "Don't Ask Again" responses (only the last one sets the dismissed flag).
+ * If FDA is already granted (e.g. re-launched from the menu): shows an
+ * "access is active" confirmation instead. Safe to call unconditionally
+ * from a menu action. Does not block. */
+void nautilus_macos_fda_show_dialog (GtkWindow *parent);
+
+/* Fire one deliberate access attempt on a TCC/FDA-protected path (result
+ * discarded, no UI). This is what makes Nautilus appear as an off-by-default
+ * row in System Settings ▸ Privacy & Security ▸ Full Disk Access — the pane
+ * only lists apps TCC has seen try. Call unconditionally once per launch,
+ * early in startup; further calls in the same process are no-ops. Only
+ * reliably lists the bundled .app (see the responsible-process caveat on
+ * nautilus_macos_fda_is_granted), and with ad-hoc signing the identity may
+ * change across rebuilds. */
+void nautilus_macos_fda_register_with_tcc (void);
+
+/* One-time-ever first-launch prompt gate. should_show returns TRUE only if
+ * FDA is not granted AND the "first-launch-prompt-shown" flag (keyfile
+ * $XDG_CONFIG_HOME/nautilus/macos-fda.ini, [fda] group) has never been set
+ * AND the legacy "prompt-dismissed" opt-out is not set. Callers must set
+ * the flag (set_first_launch_prompt_shown) the moment they schedule the
+ * prompt, so it can never fire on a second launch regardless of the user's
+ * response. */
+gboolean nautilus_macos_fda_should_show_first_launch_prompt (void);
+void nautilus_macos_fda_set_first_launch_prompt_shown (void);
+
+/* ==========================================================================
+ * End section W6
+ * ========================================================================== */
+
+/* ==========================================================================
+ * Section W11 — LaunchServices file icons & Open in Terminal
+ * (nautilus-macos-fileicon.m, nautilus-macos-terminal.m)
+ * ========================================================================== */
+
+/* --- File type icons (nautilus-macos-fileicon.m) --- */
+
+/* Return the LaunchServices icon for the file at @path (NSWorkspace
+ * iconForFile: — the icon Finder would show, i.e. the owning app's document
+ * icon) rendered into a @size_px × @size_px GdkTexture (new reference), or
+ * NULL if it cannot be rendered.
+ *
+ * Cached per (lowercased filename extension, size) — two files sharing an
+ * extension are assumed to share an icon, so a 10k-file directory costs one
+ * AppKit call per distinct extension per icon size. Paths ending in ".app"
+ * are cached per full path instead (every app bundle has its own icon).
+ * Extensionless files share the "" key (the generic document icon).
+ *
+ * MAIN THREAD ONLY: must be called on the AppKit/GTK main thread (returns
+ * NULL with a warning elsewhere). All Nautilus icon resolution happens on
+ * the main thread (cell binding in the views). */
+GdkTexture *nautilus_macos_file_icon_texture (const char *path,
+                                              int         size_px);
+
+/* Instrumentation for the headless harness: cumulative NSWorkspace
+ * iconForFile: calls, cache hits, and current cache entry count. Any
+ * out-parameter may be NULL. Main thread only. */
+void nautilus_macos_file_icon_debug_stats (guint *out_appkit_calls,
+                                           guint *out_cache_hits,
+                                           guint *out_cache_entries);
+
+/* --- Open in Terminal (nautilus-macos-terminal.m) --- */
+
+/* Open Terminal.app with a new window cd'd to the directory @path (a local
+ * filesystem path): NSWorkspace URLForApplicationWithBundleIdentifier:
+ * "com.apple.Terminal" + openURLs:withApplicationAtURL:. Returns TRUE if
+ * the launch was dispatched (the open itself completes asynchronously). */
+gboolean nautilus_macos_open_in_terminal (const char *path);
