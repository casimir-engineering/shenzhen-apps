+/* The package kind of the item @file.  A file in a view has its info, and
+ * nautilus-file.c keeps LaunchServices' answer on it; a sidebar row's file is
+ * often not loaded, so it is asked about its location directly. */
+static NautilusMacosPackageKind
+get_item_package_kind (NautilusFile *file)
+{
+    g_autoptr (GFile) location = NULL;
+    const char *path;
+
+    if (nautilus_file_get_file_type (file) != G_FILE_TYPE_UNKNOWN)
+    {
+        return nautilus_file_is_macos_application (file) ? NAUTILUS_MACOS_PACKAGE_APPLICATION :
+               nautilus_file_is_macos_package (file) ? NAUTILUS_MACOS_PACKAGE_DOCUMENT :
+               NAUTILUS_MACOS_PACKAGE_NONE;
+    }
+
+    location = nautilus_file_get_activation_location (file);
+    path = g_file_peek_path (location);
+
+    return path != NULL ? nautilus_macos_get_package_kind (path) : NAUTILUS_MACOS_PACKAGE_NONE;
+}
+
+NautilusDndItemDrop
+nautilus_dnd_get_item_drop (NautilusFile *target_file)
+{
+    g_return_val_if_fail (NAUTILUS_IS_FILE (target_file), NAUTILUS_DND_ITEM_DROP_DEFAULT);
+
+    switch (get_item_package_kind (target_file))
+    {
+        case NAUTILUS_MACOS_PACKAGE_APPLICATION:
+        {
+            return NAUTILUS_DND_ITEM_DROP_OPEN_WITH_APP;
+        }
+
+        case NAUTILUS_MACOS_PACKAGE_DOCUMENT:
+        {
+            return NAUTILUS_DND_ITEM_DROP_REFUSE;
+        }
+
+        case NAUTILUS_MACOS_PACKAGE_NONE:
+        default:
+        {
+            return NAUTILUS_DND_ITEM_DROP_DEFAULT;
+        }
+    }
+}
