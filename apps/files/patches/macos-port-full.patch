+static gboolean
+nothing_opens (const char *path)
+{
+    g_autoptr (GFile) location = g_file_new_for_path (path);
+    g_autofree char *uri = g_file_get_uri (location);
+    CFURLRef url = CFURLCreateWithBytes (NULL, (const UInt8 *) uri, strlen (uri),
+                                         kCFStringEncodingUTF8, NULL);
+    CFURLRef app = LSCopyDefaultApplicationURLForURL (url, kLSRolesAll, NULL);
+    gboolean none = (app == NULL);
+
+    if (app != NULL)
+    {
+        CFRelease (app);
+    }
+    CFRelease (url);
+
+    return none;
+}
+
+static void
+test_open_errors (void)
+{
+    OpenRecorder recorder;
+    g_autofree char *empty_app = fixture_path ("Empty.app");
+    g_autofree char *missing = fixture_path ("Gone.app");
+    g_autofree char *plain = fixture_path ("Plain Folder");
+    g_autofree char *bundle = fixture_path ("Thing.bundle");
+    gboolean try_bundle = nothing_opens (bundle);
+    const char *paths[] = { empty_app, missing, plain, try_bundle ? bundle : NULL, NULL };
+    const GError *error;
+
+    open_recorder_init (&recorder);
+    open_and_wait (&recorder, paths);
+
+    /* A damaged app: macOS's own explanation, naming it. */
+    error = recorded_error_for (&recorder, empty_app);
+    g_assert_error (error, G_IO_ERROR, G_IO_ERROR_FAILED);
+    g_test_message ("Empty.app: %s", error->message);
+    g_assert_nonnull (strstr (error->message, "Empty"));
+
+    error = recorded_error_for (&recorder, missing);
+    g_assert_error (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND);
+
+    /* Not a package: refused without asking NSWorkspace, which would have
+     * shown the folder in Finder. */
+    error = recorded_error_for (&recorder, plain);
+    g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT);
+
+    if (try_bundle)
+    {
+        /* A document package no app claims: opened through openURL:, which
+         * reports that no app can open it, and nothing is launched. */
+        error = recorded_error_for (&recorder, bundle);
+        g_assert_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED);
+        g_test_message ("Thing.bundle: %s", error->message);
+    }
+    else
+    {
+        g_test_message ("an app on this Mac opens .bundle packages; not opening one");
+    }
+
+    open_recorder_clear (&recorder);
+}
