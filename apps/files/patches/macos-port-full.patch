+static gboolean
+macos_search_open (GtkWidget *window)
+{
+    g_autoptr (NautilusWindowSlot) slot = NULL;
+
+    g_object_get (window, "active-slot", &slot, NULL);
+
+    return slot != NULL && nautilus_window_slot_get_search_visible (slot);
+}
+
+static void
+macos_setup_window (NautilusWindow *window)
+{
+    g_autoptr (GSimpleAction) edit_location = NULL;
+
+    edit_location = g_simple_action_new ("macos-edit-location", NULL);
+    g_signal_connect (edit_location, "activate",
+                      G_CALLBACK (macos_edit_location_activate), window);
+    g_action_map_add_action (G_ACTION_MAP (window), G_ACTION (edit_location));
+
+    /* Cmd accelerators and Backspace for Back, after the focused widget
+     * (see nautilus-macos-window-shortcuts.c). */
+    gtk_widget_add_controller (GTK_WIDGET (window), nautilus_macos_window_shortcuts_new (macos_search_open));
+}
