+typedef struct
+{
+    gboolean done;
+    GList *outputs;
+    GFile *created;
+    gboolean success;
+} OperationResult;
+
+static void
+on_extracted (GList    *outputs,
+              gpointer  user_data)
+{
+    OperationResult *result = user_data;
+
+    result->outputs = g_list_copy_deep (outputs, (GCopyFunc) g_object_ref, NULL);
+    result->done = TRUE;
+}
+
+static void
+on_compressed (GFile    *new_file,
+               gboolean  success,
+               gpointer  user_data)
+{
+    OperationResult *result = user_data;
+
+    result->created = new_file != NULL ? g_object_ref (new_file) : NULL;
+    result->success = success;
+    result->done = TRUE;
+}
+
+static void
+assert_file_contents (const char *path,
+                      const char *expected)
+{
+    g_autofree char *contents = NULL;
+    g_autoptr (GError) error = NULL;
+
+    g_file_get_contents (path, &contents, NULL, &error);
+    g_assert_no_error (error);
+    g_assert_cmpstr (contents, ==, expected);
+}
+
+/* Extract @archive into a fresh folder and return the single output. */
+static char *
+extract_one (const char *archive)
+{
+    static guint counter = 0;
+    g_autofree char *destination_name = g_strdup_printf ("extracted-%u", ++counter);
+    g_autofree char *destination_path = fixture_path (destination_name);
+    g_autoptr (GFile) destination = g_file_new_for_path (destination_path);
+    g_autoptr (GFile) source = g_file_new_for_path (archive);
+    OperationResult result = { 0 };
+    GList files = { .data = source };
+    char *output;
+
+    make_dir (destination_path);
+    nautilus_file_operations_extract_files (&files, destination, NULL, NULL,
+                                            on_extracted, &result);
+    wait_for_flag (&result.done, 60000);
+    g_assert_cmpuint (g_list_length (result.outputs), ==, 1);
+    output = g_file_get_path (result.outputs->data);
+    g_list_free_full (result.outputs, g_object_unref);
+
+    return output;
+}
+
+static void
+assert_extracts_tree (const char *archive_name,
+                      const char *expected_folder)
+{
+    g_autofree char *archive = fixture_path (archive_name);
+    g_autofree char *output = extract_one (archive);
+    g_autofree char *top = g_build_filename (output, "a.txt", NULL);
+    g_autofree char *nested = g_build_filename (output, "sub dir", "über 文件.txt", NULL);
+    g_autofree char *output_name = g_path_get_basename (output);
+
+    g_test_message ("%s → %s", archive_name, output);
+    g_assert_cmpstr (output_name, ==, expected_folder);
+    assert_file_contents (top, "hello\n");
+    assert_file_contents (nested, "nested\n");
+}
+
+/* An archive holding a single file, or a compressed file.  Nautilus names
+ * the output after the archive, and the file lands in a folder of that name,
+ * as on GNOME. */
+static void
+assert_extracts_file (const char *archive_name,
+                      const char *expected_name,
+                      const char *expected_contents)
+{
+    g_autofree char *archive = fixture_path (archive_name);
+    g_autofree char *output = extract_one (archive);
+    g_autofree char *output_name = g_path_get_basename (output);
+
+    g_test_message ("%s → %s%s", archive_name, output,
+                    g_file_test (output, G_FILE_TEST_IS_DIR) ? "/" : "");
+    g_assert_cmpstr (output_name, ==, expected_name);
+    if (g_file_test (output, G_FILE_TEST_IS_DIR))
+    {
+        g_autoptr (GDir) dir = g_dir_open (output, 0, NULL);
+        const char *member_name = (dir != NULL) ? g_dir_read_name (dir) : NULL;
+        g_autofree char *member = NULL;
+
+        g_assert_nonnull (member_name);
+        member = g_build_filename (output, member_name, NULL);
+        g_test_message ("  holding %s", member_name);
+        assert_file_contents (member, expected_contents);
+        g_assert_null (g_dir_read_name (dir));
+    }
+    else
+    {
+        assert_file_contents (output, expected_contents);
+    }
+}
+
+static void
+test_extraction (void)
+{
+    assert_extracts_tree ("Archive.zip", "Archive");
+    assert_extracts_tree ("Ünïcode Ärchive 档案.zip", "Ünïcode Ärchive 档案");
+    assert_extracts_tree ("My Photos 2026.tar.gz", "My Photos 2026");
+    assert_extracts_tree ("Résumé 文件 2.7z", "Résumé 文件 2");
+    assert_extracts_tree ("Archive.tar", "Archive");
+    assert_extracts_file ("Archive.tar.bz2", "Archive", "hello\n");
+    assert_extracts_file ("Archive.txz", "Archive", "hello\n");
+    assert_extracts_file ("Archive.tar.zst", "Archive", "hello\n");
+    assert_extracts_file ("single file.txt.gz", "single file.txt", PLAIN_TEXT);
+    assert_extracts_file ("single.txt.bz2", "single.txt", PLAIN_TEXT);
+    assert_extracts_file ("single.txt.xz", "single.txt", PLAIN_TEXT);
+}
