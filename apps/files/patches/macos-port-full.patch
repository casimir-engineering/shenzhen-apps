+typedef struct
+{
+    GFile *mount_root;
+    GFile *home;
+    GList *redirected_slots;
+    gint64 deadline;
+} PrepareUnmountData;
+
+static void
+prepare_unmount_data_free (PrepareUnmountData *data)
+{
+    g_clear_object (&data->mount_root);
+    g_clear_object (&data->home);
+    g_list_free_full (data->redirected_slots, g_object_unref);
+    g_free (data);
+}
+
+static gboolean
+prepare_unmount_poll (gpointer user_data)
+{
+    GTask *task = G_TASK (user_data);
+    PrepareUnmountData *data = g_task_get_task_data (task);
+
+    if (g_task_return_error_if_cancelled (task))
+    {
+        return G_SOURCE_REMOVE;
+    }
+
+    for (GList *l = data->redirected_slots; l != NULL; l = l->next)
+    {
+        NautilusWindowSlot *slot = l->data;
+        GFile *location = nautilus_window_slot_get_location (slot);
+        GFile *pending_location = nautilus_window_slot_get_pending_location (slot);
+
+        if (location == NULL || !g_file_equal (location, data->home) ||
+            pending_location != NULL || nautilus_window_slot_get_loading (slot))
+        {
+            if (g_get_monotonic_time () >= data->deadline)
+            {
+                g_task_return_new_error (task,
+                                         G_IO_ERROR,
+                                         G_IO_ERROR_BUSY,
+                                         "Timed out waiting for tabs to leave the volume");
+                return G_SOURCE_REMOVE;
+            }
+
+            return G_SOURCE_CONTINUE;
+        }
+    }
+
+    nautilus_fd_holders_release_for_location (data->mount_root);
+    g_task_return_boolean (task, TRUE);
+    return G_SOURCE_REMOVE;
+}
+
+void
+nautilus_application_prepare_location_for_unmount_async (NautilusApplication *self,
+                                                         GFile               *mount_root,
+                                                         GCancellable        *cancellable,
+                                                         GAsyncReadyCallback  callback,
+                                                         gpointer             user_data)
+{
+    g_autoptr (GTask) task = NULL;
+    PrepareUnmountData *data;
+
+    g_return_if_fail (NAUTILUS_IS_APPLICATION (self));
+    g_return_if_fail (G_IS_FILE (mount_root));
+
+    task = g_task_new (self, cancellable, callback, user_data);
+    g_task_set_source_tag (task, nautilus_application_prepare_location_for_unmount_async);
+
+    data = g_new0 (PrepareUnmountData, 1);
+    data->mount_root = g_object_ref (mount_root);
+    data->home = g_file_new_for_path (g_get_home_dir ());
+    data->deadline = g_get_monotonic_time () + 10 * G_TIME_SPAN_SECOND;
+    g_task_set_task_data (task, data, (GDestroyNotify) prepare_unmount_data_free);
+
+    if (g_file_equal (data->home, mount_root) ||
+        g_file_has_prefix (data->home, mount_root))
+    {
+        g_task_return_new_error (task,
+                                 G_IO_ERROR,
+                                 G_IO_ERROR_BUSY,
+                                 "Home is located on the volume being ejected");
+        return;
+    }
+
+    for (GList *l = self->windows; l != NULL; l = l->next)
+    {
+        GList *window_slots =
+            nautilus_window_redirect_slots_from_location (l->data,
+                                                          mount_root,
+                                                          data->home);
+        data->redirected_slots = g_list_concat (data->redirected_slots, window_slots);
+    }
+
+    /* Poll through at least one main-loop turn even when no tab was moved.
+     * This lets queued file-view cleanup finish before enumerators are closed. */
+    g_timeout_add_full (G_PRIORITY_DEFAULT,
+                        25,
+                        prepare_unmount_poll,
+                        g_object_ref (task),
+                        g_object_unref);
+}
+
+gboolean
+nautilus_application_prepare_location_for_unmount_finish (NautilusApplication *self,
+                                                          GAsyncResult        *result,
+                                                          GError             **error)
+{
+    g_return_val_if_fail (g_task_is_valid (result, self), FALSE);
+    g_return_val_if_fail (g_async_result_is_tagged (
+                              result,
+                              nautilus_application_prepare_location_for_unmount_async),
+                          FALSE);
+
+    return g_task_propagate_boolean (G_TASK (result), error);
+}
