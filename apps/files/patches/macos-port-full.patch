+/* The documents the marker app at @app recorded ("open <path>" lines). */
+static GPtrArray *
+marker_opened (const char *app)
+{
+    g_autofree char *contents = marker_contents (app);
+    g_auto (GStrv) lines = g_strsplit (contents != NULL ? contents : "", "\n", -1);
+    GPtrArray *opened = g_ptr_array_new_with_free_func (g_free);
+
+    for (char **line = lines; *line != NULL; line++)
+    {
+        if (g_str_has_prefix (*line, "open "))
+        {
+            g_ptr_array_add (opened, g_utf8_normalize (*line + 5, -1, G_NORMALIZE_NFC));
+        }
+    }
+
+    return opened;
+}
+
+/* @path with symbolic links resolved ("/var" is "/private/var"), as the app
+ * gets it, in NFC. */
+static char *
+resolved_path (const char *path)
+{
+    char buffer[PATH_MAX];
+
+    return g_utf8_normalize (realpath (path, buffer) != NULL ? buffer : path, -1, G_NORMALIZE_NFC);
+}
+
+static gboolean
+marker_opened_path (const char *app,
+                    const char *path)
+{
+    g_autoptr (GPtrArray) opened = marker_opened (app);
+    g_autofree char *wanted = resolved_path (path);
+
+    for (guint i = 0; i < opened->len; i++)
+    {
+        if (g_str_equal (g_ptr_array_index (opened, i), wanted))
+        {
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
+
+static void
+wait_for_opened (const char *app,
+                 const char *path)
+{
+    gint64 end = g_get_monotonic_time () + LAUNCH_DEADLINE_MS * 1000;
+
+    while (!marker_opened_path (app, path))
+    {
+        if (g_get_monotonic_time () > end)
+        {
+            g_autofree char *contents = marker_contents (app);
+
+            g_error ("%s did not receive %s within %d ms; it recorded: %s", app, path,
+                     LAUNCH_DEADLINE_MS, contents != NULL ? contents : "(nothing)");
+        }
+        pump ();
+    }
+}
+
+/* Every path under @root, sorted, one per line. */
+static char *
+list_tree (const char *root)
+{
+    g_autoptr (GPtrArray) entries = g_ptr_array_new_with_free_func (g_free);
+    g_autoptr (GPtrArray) pending = g_ptr_array_new_with_free_func (g_free);
+    g_autoptr (GString) listing = g_string_new (NULL);
+
+    g_ptr_array_add (pending, g_strdup (root));
+    while (pending->len > 0)
+    {
+        g_autofree char *directory = g_ptr_array_steal_index (pending, pending->len - 1);
+        g_autoptr (GDir) dir = g_dir_open (directory, 0, NULL);
+        const char *name;
+
+        while (dir != NULL && (name = g_dir_read_name (dir)) != NULL)
+        {
+            char *child = g_build_filename (directory, name, NULL);
+
+            g_ptr_array_add (entries, g_strdup (child + strlen (root)));
+            if (g_file_test (child, G_FILE_TEST_IS_DIR) && !g_file_test (child, G_FILE_TEST_IS_SYMLINK))
+            {
+                g_ptr_array_add (pending, child);
+            }
+            else
+            {
+                g_free (child);
+            }
+        }
+    }
+
+    g_ptr_array_sort_values (entries, (GCompareFunc) g_strcmp0);
+    for (guint i = 0; i < entries->len; i++)
+    {
+        g_string_append_printf (listing, "%s\n", (char *) g_ptr_array_index (entries, i));
+    }
+
+    return g_string_free (g_steal_pointer (&listing), FALSE);
+}
