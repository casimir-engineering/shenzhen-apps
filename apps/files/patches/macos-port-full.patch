+static void
+assert_sorts_before (const char *first,
+                     const char *second,
+                     gboolean    directories_first,
+                     gboolean    reversed)
+{
+    g_autofree char *first_path = fixture_path (first);
+    g_autofree char *second_path = fixture_path (second);
+    NautilusFile *file_1 = load_file (first_path);
+    NautilusFile *file_2 = load_file (second_path);
+    int order = nautilus_file_compare_for_sort (file_1, file_2, NAUTILUS_FILE_SORT_BY_DISPLAY_NAME,
+                                                directories_first, reversed);
+    int order_back = nautilus_file_compare_for_sort (file_2, file_1, NAUTILUS_FILE_SORT_BY_DISPLAY_NAME,
+                                                     directories_first, reversed);
+
+    g_test_message ("%s %s %s (folders first=%d, reversed=%d)", first,
+                    order < 0 ? "before" : "not before", second, directories_first, reversed);
+    if (order >= 0 || order_back <= 0)
+    {
+        g_error ("%s should sort before %s (folders first=%d, reversed=%d): %d, %d",
+                 first, second, directories_first, reversed, order, order_back);
+    }
+
+    nautilus_file_unref (file_1);
+    nautilus_file_unref (file_2);
+}
