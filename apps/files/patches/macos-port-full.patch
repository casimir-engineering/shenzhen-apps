+        answers = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+    }
+    answer = g_hash_table_lookup (answers, content_type);
+    g_mutex_unlock (&lock);
+
+    if (answer != NULL)
+    {
+        return GPOINTER_TO_INT (answer) == 2;
+    }
+
+    g_auto (GStrv) mime_types = nautilus_macos_content_type_get_mime_types (content_type);
+
+    for (char **mime_type = mime_types; *mime_type != NULL && !is_archive; mime_type++)
+    {
+        is_archive = autoar_check_mime_type_supported (*mime_type);
+    }
+
+    g_mutex_lock (&lock);
+    g_hash_table_replace (answers, g_strdup (content_type), GINT_TO_POINTER (is_archive ? 2 : 1));
+    g_mutex_unlock (&lock);
+
+    return is_archive;
+}
