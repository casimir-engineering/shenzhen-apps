+     * damaged app); opening it reports an error. */
+    assert_package_kind ("Empty.app", NAUTILUS_MACOS_PACKAGE_APPLICATION);
+    assert_package_kind ("Link to Decision", NAUTILUS_MACOS_PACKAGE_APPLICATION);
